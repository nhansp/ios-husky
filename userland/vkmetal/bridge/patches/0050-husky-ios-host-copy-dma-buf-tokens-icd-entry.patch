+++ b/crates/metal2vulkan-runtime/src/dma_buf.rs
@@ -440,8 +440,17 @@ fn dma_buf_length(fd: BorrowedFd<'_>) -> Option<u64> {
     u64::try_from(end).ok()
 }
 
+/// On Apple systems nothing identifies a dma-buf by its file: the source's contract (a token the
+/// driver's own import resolves, such as the husky IOSurface tokens) is trusted, the driver
+/// refusing a chunk it cannot import and the runtime then copying the pages as it does without
+/// a source.
+#[cfg(target_vendor = "apple")]
+fn dma_buf_length(_fd: BorrowedFd<'_>) -> Option<u64> {
+    Some(u64::MAX)
+}
+
 /// No file is a dma-buf on this system.
-#[cfg(not(target_os = "linux"))]
+#[cfg(not(any(target_os = "linux", target_vendor = "apple")))]
 fn dma_buf_length(_fd: BorrowedFd<'_>) -> Option<u64> {
     None
 }

+/// The entry of a Vulkan driver library that exports `vk_icdGetInstanceProcAddr` (the ICD interface's `vkGetInstanceProcAddr`) and not
+/// `vkGetInstanceProcAddr`: its global commands (`vkCreateInstance`, the instance enumerations) come from that function with a null
+/// instance. The library stays open for the life of the process.
+///
+/// # Safety
+///
+/// Opening the library runs its initialization.
+#[cfg(target_vendor = "apple")]
+unsafe fn icd_entry(path: &Path) -> Option<ash::Entry> {
+    use std::os::unix::ffi::OsStrExt;
+    let path = std::ffi::CString::new(path.as_os_str().as_bytes()).ok()?;
+    // SAFETY: a nul-terminated path.
+    let library = unsafe { libc::dlopen(path.as_ptr(), libc::RTLD_NOW | libc::RTLD_LOCAL) };
+    if library.is_null() {
+        return None;
+    }
+    // SAFETY: the library is open; a nul-terminated name.
+    let symbol = unsafe { libc::dlsym(library, c"vk_icdGetInstanceProcAddr".as_ptr()) };
+    if symbol.is_null() {
+        return None;
+    }
+    // SAFETY: the ICD interface's function has `vkGetInstanceProcAddr`'s signature.
+    let get_instance_proc_addr: vk::PFN_vkGetInstanceProcAddr = unsafe { std::mem::transmute(symbol) };
+    // SAFETY: the function is a driver's own, valid while the library stays open.
+    Some(unsafe { ash::Entry::from_static_fn(ash::StaticFn { get_instance_proc_addr }) })
+}
+
 /// `vkCreateInstance` of `info` from `entry`: every instance the runtime creates, its devices' and
 /// the drivers' keeper's (`keeper.rs`), is made here, and the exit guard's hook registers again
 /// after it, whatever it answered ([`exit_guard::instance_made`]): a layer registers an exit

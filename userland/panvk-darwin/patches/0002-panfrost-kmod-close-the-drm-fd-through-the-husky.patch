# panfrost/kmod: close the DRM fd through the husky shim
diff --git a/src/panfrost/lib/kmod/pan_kmod_backend.h b/src/panfrost/lib/kmod/pan_kmod_backend.h
index e53ae1a..66a0956 100644
--- a/src/panfrost/lib/kmod/pan_kmod_backend.h
+++ b/src/panfrost/lib/kmod/pan_kmod_backend.h
@@ -97,6 +97,10 @@ pan_kmod_drm_drv_match(int fd, char *drv_name, struct pan_kmod_driver *drv_info)
    return ret;
 }
 
+#ifdef HUSKY_DRM_SHIM
+void husky_drm_close(int fd);
+#endif
+
 static inline int
 pan_kmod_dev_init(struct pan_kmod_dev *dev, int fd, uint32_t flags,
                   const struct pan_kmod_driver *drv_info,
@@ -125,8 +129,13 @@ pan_kmod_dev_init(struct pan_kmod_dev *dev, int fd, uint32_t flags,
 static inline void
 pan_kmod_dev_cleanup(struct pan_kmod_dev *dev)
 {
-   if (dev->flags & PAN_KMOD_DEV_FLAG_OWNS_FD)
+   if (dev->flags & PAN_KMOD_DEV_FLAG_OWNS_FD) {
+#ifdef HUSKY_DRM_SHIM
+      husky_drm_close(dev->fd);
+#else
       close(dev->fd);
+#endif
+   }
 
    util_dynarray_fini(&dev->pending_bo_syncs.array);
    util_sparse_array_finish(&dev->handle_to_bo.array);

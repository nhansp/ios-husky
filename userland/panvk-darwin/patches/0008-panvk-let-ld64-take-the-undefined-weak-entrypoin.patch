# panvk: let ld64 take the undefined weak entrypoint declarations
diff --git a/src/panfrost/vulkan/meson.build b/src/panfrost/vulkan/meson.build
index 7c87fe4..5a89f71 100644
--- a/src/panfrost/vulkan/meson.build
+++ b/src/panfrost/vulkan/meson.build
@@ -203,6 +203,8 @@ if with_platform_android
   libpanvk_files += files('panvk_android.c')
 endif
 
+# The entrypoint tables take the address of every Vulkan function through weak declarations that ld64 must accept
+# as undefined.
 libvulkan_panfrost = shared_library(
   'vulkan_panfrost',
   [libpanvk_files, panvk_entrypoints, panvk_tracepoints, panvk_drirc],
@@ -234,7 +236,8 @@ libvulkan_panfrost = shared_library(
     idep_mesautil,
   ],
   c_args : [no_override_init_args, panvk_flags, soong_compat_c_args],
-  link_args : [vulkan_icd_link_args, ld_args_bsymbolic, ld_args_gc_sections, ld_args_build_id],
+  link_args : [vulkan_icd_link_args, ld_args_bsymbolic, ld_args_gc_sections, ld_args_build_id,
+               host_machine.system() == 'darwin' ? ['-Wl,-undefined,dynamic_lookup'] : []],
   link_depends: vulkan_icd_link_depends,
   gnu_symbol_visibility : 'hidden',
   install : true,

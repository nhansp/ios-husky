# SPDX-License-Identifier: MIT
# common/mesa_defs.mk - preprocessor defines for compiling the Mesa header-only /
# util subset (genxml packers, cs_builder.h, ralloc, u_dynarray) on Linux/glibc.
#
# Derived from a `meson setup` of Mesa 27.0.0-devel (commit 1f9035d) on Linux x86-64:
# the -D flags of the decode_csf.c compile line, minus the GL/Vulkan/video/LLVM feature
# switches that do not affect these headers.  Only valid for the HOST test tier; the
# iOS device build gets its own flags from the plug-in build (spec 06 section 8).
# On Darwin (the CI's macOS host-test runner) glibc-specific HAVE_* switches are dropped; that reduced
# set is UNTESTED here (no Mac available): if a Darwin build breaks, start by adding to MESA_DEFS_DARWIN.
# NDEBUG is intentionally NOT defined: Mesa's cs_builder asserts (register file
# overflow, 64-bit alignment, "Out of CS space", pan_pack range checks) are test oracles.
MESA_DEFS := \
  -D_FILE_OFFSET_BITS=64 \
  -D__STDC_CONSTANT_MACROS \
  -D__STDC_FORMAT_MACROS \
  -D__STDC_LIMIT_MACROS \
  -DHAVE___BUILTIN_BSWAP32 \
  -DHAVE___BUILTIN_BSWAP64 \
  -DHAVE___BUILTIN_CLZ \
  -DHAVE___BUILTIN_CLZLL \
  -DHAVE___BUILTIN_CTZ \
  -DHAVE___BUILTIN_EXPECT \
  -DHAVE___BUILTIN_FFS \
  -DHAVE___BUILTIN_FFSLL \
  -DHAVE___BUILTIN_POPCOUNT \
  -DHAVE___BUILTIN_POPCOUNTLL \
  -DHAVE___BUILTIN_UNREACHABLE \
  -DHAVE___BUILTIN_TYPES_COMPATIBLE_P \
  -DHAVE___BUILTIN_ADD_OVERFLOW \
  -DHAVE___BUILTIN_ADD_OVERFLOW_P \
  -DHAVE___BUILTIN_SUB_OVERFLOW_P \
  -DHAVE_FUNC_ATTRIBUTE_CONST \
  -DHAVE_FUNC_ATTRIBUTE_FLATTEN \
  -DHAVE_FUNC_ATTRIBUTE_MALLOC \
  -DHAVE_FUNC_ATTRIBUTE_PURE \
  -DHAVE_FUNC_ATTRIBUTE_UNUSED \
  -DHAVE_FUNC_ATTRIBUTE_WARN_UNUSED_RESULT \
  -DHAVE_FUNC_ATTRIBUTE_WEAK \
  -DHAVE_FUNC_ATTRIBUTE_FORMAT \
  -DHAVE_FUNC_ATTRIBUTE_PACKED \
  -DHAVE_FUNC_ATTRIBUTE_RETURNS_NONNULL \
  -DHAVE_FUNC_ATTRIBUTE_ALIAS \
  -DHAVE_FUNC_ATTRIBUTE_NORETURN \
  -DHAVE_FUNC_ATTRIBUTE_OPTIMIZE \
  -DHAVE_FUNC_ATTRIBUTE_COLD \
  -DHAVE_FUNC_ATTRIBUTE_VISIBILITY \
  -DHAVE_UINT128 \
  -DHAVE_REALLOCARRAY \
  -DHAVE_FMEMOPEN \
  -DHAVE_MALLINFO2 \
  -D_GNU_SOURCE \
  -DUSE_SSE41 \
  -DHAVE___BUILTIN_IA32_CLFLUSHOPT \
  -DUSE_GCC_ATOMIC_BUILTINS \
  -DMAJOR_IN_SYSMACROS \
  -DHAS_SCHED_H \
  -DHAS_SCHED_GETAFFINITY \
  -DHAVE_LINUX_FUTEX_H \
  -DHAVE_ENDIAN_H \
  -DHAVE_DLFCN_H \
  -DHAVE_SYS_SHM_H \
  -DHAVE_CET_H \
  -DHAVE_POLL_H \
  -DHAVE_SYS_INOTIFY_H \
  -DHAVE_LINUX_UDMABUF_H \
  -DHAVE_STRTOF \
  -DHAVE_MKOSTEMP \
  -DHAVE_MEMFD_CREATE \
  -DHAVE_RANDOM_R \
  -DHAVE_FLOCK \
  -DHAVE_STRTOK_R \
  -DHAVE_GETRANDOM \
  -DHAVE_POSIX_FALLOCATE \
  -DHAVE_SECURE_GETENV \
  -DHAVE_SYSCONF \
  -DHAVE_SC_PHYS_PAGES \
  -DHAVE_GNU_QSORT_R \
  -DHAVE_STRUCT_TIMESPEC \
  -DHAVE_PROGRAM_INVOCATION_NAME \
  -DHAVE_ISSIGNALING \
  -DHAVE_POSIX_MEMALIGN \
  -DHAVE_DIRENT_D_TYPE \
  -DHAVE_STRTOD_L \
  -DHAVE_DLADDR \
  -DHAVE_DL_ITERATE_PHDR \
  -DHAVE_ZLIB \
  -DHAVE_ZSTD \
  -DHAVE_COMPRESSION \
  -DHAVE_PTHREAD \
  -DHAVE_PTHREAD_SETAFFINITY \
  -DHAVE_OPENMP \
  -DXXH_FORCE_ALIGN_CHECK=0 \
  -DXXH_FORCE_MEMORY_ACCESS=0

UNAME_S := $(shell uname -s)
ifeq ($(UNAME_S),Darwin)
MESA_DEFS_DARWIN := -D__STDC_CONSTANT_MACROS -D__STDC_FORMAT_MACROS -D__STDC_LIMIT_MACROS \
  -DHAVE___BUILTIN_BSWAP32 -DHAVE___BUILTIN_BSWAP64 -DHAVE___BUILTIN_CLZ -DHAVE___BUILTIN_CLZLL -DHAVE___BUILTIN_CTZ \
  -DHAVE___BUILTIN_EXPECT -DHAVE___BUILTIN_FFS -DHAVE___BUILTIN_FFSLL -DHAVE___BUILTIN_POPCOUNT -DHAVE___BUILTIN_POPCOUNTLL \
  -DHAVE___BUILTIN_UNREACHABLE -DHAVE___BUILTIN_TYPES_COMPATIBLE_P -DHAVE___BUILTIN_ADD_OVERFLOW \
  -DHAVE_FUNC_ATTRIBUTE_CONST -DHAVE_FUNC_ATTRIBUTE_FLATTEN -DHAVE_FUNC_ATTRIBUTE_MALLOC -DHAVE_FUNC_ATTRIBUTE_PURE \
  -DHAVE_FUNC_ATTRIBUTE_UNUSED -DHAVE_FUNC_ATTRIBUTE_WARN_UNUSED_RESULT -DHAVE_FUNC_ATTRIBUTE_FORMAT -DHAVE_FUNC_ATTRIBUTE_PACKED \
  -DHAVE_FUNC_ATTRIBUTE_RETURNS_NONNULL -DHAVE_FUNC_ATTRIBUTE_NORETURN -DHAVE_UINT128 -DHAVE_STRTOK_R -DHAVE_POSIX_MEMALIGN \
  -DHAVE_STRUCT_TIMESPEC -DHAVE_PTHREAD -DHAVE_DLADDR -DHAVE_DLFCN_H
MESA_DEFS := $(MESA_DEFS_DARWIN)
endif

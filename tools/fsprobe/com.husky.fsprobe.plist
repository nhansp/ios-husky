<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.husky.fsprobe</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/fsprobe</string>
		<string>/private/var/mobile/Library/Application Support/PRBPosterExtensionDataStore/59</string>
		<string>/private/var/mobile/Library/Application Support/PRBPosterExtensionDataStore/59/Extensions</string>
		<string>/private/var/mobile/Library/Preferences</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>LaunchOnlyOnce</key>
	<true/>
	<key>UserName</key>
	<string>mobile</string>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>

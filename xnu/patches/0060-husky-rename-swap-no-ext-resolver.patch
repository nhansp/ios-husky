diff --git a/bsd/vfs/kpi_vfs.c b/bsd/vfs/kpi_vfs.c
index b4a5832..272ad01 100644
--- a/bsd/vfs/kpi_vfs.c
+++ b/bsd/vfs/kpi_vfs.c
@@ -4660,6 +4660,21 @@ vn_rename(struct vnode *fdvp, struct vnode **fvpp, struct componentname *fcnp, s
 					_err = VNOP_RENAME(fdvp, *fvpp, fcnp, tdvp, *tvpp, tcnp, ctx);
 				}
 			}
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+			/*
+			 * HUSKY (ios-sweet 0052): HFS has no RENAME_SWAP, which
+			 * Foundation's atomic writes use (usermanagerd cannot save its
+			 * persona keybags, so containermanagerd finds no personas and
+			 * every container path is NULL). Swapping two regular files on
+			 * one volume is what exchangedata does: each name ends up with
+			 * the other file's data and attributes.
+			 */
+			if (_err == ENOTSUP && flags == VFS_RENAME_SWAP && *tvpp != NULLVP &&
+			    vnode_isreg(*fvpp) && vnode_isreg(*tvpp) &&
+			    vnode_mount(*fvpp) == vnode_mount(*tvpp)) {
+				_err = VNOP_EXCHANGE(*fvpp, *tvpp, 0, ctx);
+			}
+#endif
 		} else {
 			_err = VNOP_RENAME(fdvp, *fvpp, fcnp, tdvp, *tvpp, tcnp, ctx);
 		}

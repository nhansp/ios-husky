+/*
+ * First render jobs (huskygpu=5), generated by tools/gpu/gen-husky-render.cpp (agy package P2 with
+ * the review fixes: identity swizzle 0x688, wait before BLEND, half warp limit for the position
+ * shader, exact k/255 colours). Each job's executable and read-write pages are copied into the
+ * render area, its CS words appended to the ring:
+ *   clear:    RUN_FRAGMENT clears the 256x256 framebuffer to colour A (0xff804020).
+ *   triangle: RUN_IDVS (pass-through position shader, tiler heap) + RUN_FRAGMENT with a constant
+ *             colour-B (0xff4080ff) fragment shader over colour A; 18432 pixels expected.
+ * The framebuffer is read through a write-combined (non-cacheable) CPU alias after the job's
+ * cache flush.
+ */
+#define TRI_EXPECTED_PIXELS     18432u
+
+static void
+husky_gpu_render_job(vm_offset_t t, vm_offset_t csout, vm_offset_t csgout, unsigned ring_used,
+    unsigned ra, unsigned rv, uint32_t waitall)
+{
+	vm_offset_t r = ml_io_map_wcomb((vm_offset_t)render_pa, RENDER_SIZE);
+	if (!r) {
+		HU_LOG("HUSKY GPU: render area map failed\n");
+		return;
+	}
+	vm_offset_t fb = r + R_FB;
+	for (unsigned i = 0; i < HUSKY_FB_WIDTH * HUSKY_FB_HEIGHT; i++) {
+		*(volatile uint32_t *)(fb + 4 * i) = 0x11111111u;      /* poison: not A, not B */
+	}
+
+	unsigned us, na, nb, other;
+	copy_bytes((volatile uint8_t *)(r + R_EXEC), husky_clear_exec_bytes, HUSKY_CLEAR_EXEC_BYTES);
+	copy_bytes((volatile uint8_t *)(r + R_DESC), husky_clear_rw_bytes, HUSKY_CLEAR_RW_BYTES);
+	HU_LOG("HUSKY GPU: clear job: %u CS instructions at ring +0x%x, framebuffer at 0x%x\n",
+	    HUSKY_CLEAR_CS_NUM_INSTR, 8 * ring_used, HUSKY_GPU_FB_VA);
+	ring_used = husky_gpu_ring_job(t, ring_used, 0, NULL, 0, husky_clear_cs, HUSKY_CLEAR_CS_NUM_INSTR, 4, 32,
+	    ra, rv, waitall, &us);
+	fb_count(fb, HUSKY_COLOR_A_PACKED, HUSKY_COLOR_B_PACKED, &na, &nb, &other);
+	HU_LOG("HUSKY GPU: CLEAR JOB %s after %u us: sync %llu; colour A %u, colour B %u, other %u of %u\n",
+	    ring_used ? "COMPLETED" : "did not complete", us, rd64(t, TEST_SYNC), na, nb, other,
+	    HUSKY_FB_WIDTH * HUSKY_FB_HEIGHT);
+	cs_state_dump("after the clear job", csout, csgout, t);
+	if (!ring_used) {
+		gpu_fault_dump("clear job");
+		return;
+	}
+
+	copy_bytes((volatile uint8_t *)(r + R_EXEC), husky_tri_exec_bytes, HUSKY_TRI_EXEC_BYTES);
+	copy_bytes((volatile uint8_t *)(r + R_DESC), husky_tri_rw_bytes, HUSKY_TRI_RW_BYTES);
+	HU_LOG("HUSKY GPU: triangle job: %u CS instructions at ring +0x%x\n", HUSKY_TRI_CS_NUM_INSTR, 8 * ring_used);
+	ring_used = husky_gpu_ring_job(t, ring_used, 0, NULL, 0, husky_tri_cs, HUSKY_TRI_CS_NUM_INSTR, 5, 40,
+	    ra, rv, waitall, &us);
+	fb_count(fb, HUSKY_COLOR_A_PACKED, HUSKY_COLOR_B_PACKED, &na, &nb, &other);
+	HU_LOG("HUSKY GPU: TRIANGLE JOB %s after %u us: sync %llu; colour A %u, colour B %u (want %u), other %u\n",
+	    ring_used ? "COMPLETED" : "did not complete", us, rd64(t, TEST_SYNC), na, nb, TRI_EXPECTED_PIXELS, other);
+	/* a coarse picture: one character per 16x16 block, A '.', B '#', mixed '+', other '?' */
+	for (unsigned by = 0; by < HUSKY_FB_HEIGHT / 16; by++) {
+		char line[HUSKY_FB_WIDTH / 16 + 1];
+		for (unsigned bx = 0; bx < HUSKY_FB_WIDTH / 16; bx++) {
+			unsigned a = 0, b = 0;
+			for (unsigned y = 0; y < 16; y++) {
+				for (unsigned x = 0; x < 16; x++) {
+					uint32_t px = *(volatile uint32_t *)(fb + 4 * ((by * 16 + y) * HUSKY_FB_WIDTH + bx * 16 + x));
+					a += px == HUSKY_COLOR_A_PACKED;
+					b += px == HUSKY_COLOR_B_PACKED;
+				}
+			}
+			line[bx] = a == 256 ? '.' : b == 256 ? '#' : a + b == 256 ? '+' : '?';
+		}
+		line[HUSKY_FB_WIDTH / 16] = 0;
+		HU_LOG("HUSKY GPU:   |%s|\n", line);
+	}
+	cs_state_dump("after the triangle job", csout, csgout, t);
+	if (!ring_used || nb != TRI_EXPECTED_PIXELS || other != 0) {
+		gpu_fault_dump("triangle job");
+	}
 }
 

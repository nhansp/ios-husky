+/* Count framebuffer pixels equal to a and b; log the first pixel that is neither. */
+static void
+fb_count(vm_offset_t fb, uint32_t a, uint32_t b, unsigned *na, unsigned *nb, unsigned *other)
+{
+	*na = *nb = *other = 0;
+	for (unsigned i = 0; i < HUSKY_FB_WIDTH * HUSKY_FB_HEIGHT; i++) {
+		uint32_t px = *(volatile uint32_t *)(fb + 4 * i);
+		if (px == a) {
+			(*na)++;
+		} else if (px == b) {
+			(*nb)++;
+		} else if ((*other)++ == 0) {
+			HU_LOG("HUSKY GPU:   first other pixel (%u,%u) = 0x%08x\n", i % HUSKY_FB_WIDTH, i / HUSKY_FB_WIDTH, px);
+		}
+	}
+}

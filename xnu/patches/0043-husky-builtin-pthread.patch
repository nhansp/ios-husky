diff --git a/bsd/conf/Makefile.template b/bsd/conf/Makefile.template
index c4cbbe9..fab9506 100644
--- a/bsd/conf/Makefile.template
+++ b/bsd/conf/Makefile.template
@@ -44,6 +44,15 @@ CFLAGS+= -include meta_features.h -DDRIVER_PRIVATE \
         -Warray-bounds-pointer-arithmetic
 SFLAGS+= -include meta_features.h
 
+# libpthread is built into HUSKY (no kext loading); other boards use the kext.
+ifeq ($(CURRENT_MACHINE_CONFIG),HUSKY)
+HUSKY_PTHREAD_ROOT = $(SRCROOT)/bsd/pthread/husky_libpthread
+HUSKY_PTHREAD_INC = -I$(HUSKY_PTHREAD_ROOT) -I$(HUSKY_PTHREAD_ROOT)/private -I$(HUSKY_PTHREAD_ROOT)/include
+husky_pthread_init.o_INCFLAGS = $(HUSKY_PTHREAD_INC)
+husky_pthread_support.o_INCFLAGS = $(HUSKY_PTHREAD_INC)
+husky_pthread_synch.o_INCFLAGS = $(HUSKY_PTHREAD_INC)
+endif
+
 #
 # Directories for mig generated files
 #

diff --git a/bsd/pthread/husky_pthread_compat.h b/bsd/pthread/husky_pthread_compat.h
new file mode 100644
index 0000000..2aa778d
--- /dev/null
+++ b/bsd/pthread/husky_pthread_compat.h
@@ -0,0 +1,29 @@
+/*
+ * Compile the matching libpthread provider with its kext view of BSD headers
+ * (ported from ios-sweet 0019). It owns its full ksyn_waitq_element layout;
+ * the kernel's opaque counterpart reserves that much. All communication with
+ * private BSD state goes through the pthread callbacks.
+ */
+#ifndef HUSKY_PTHREAD_COMPAT_H
+#define HUSKY_PTHREAD_COMPAT_H
+#undef BSD_KERNEL_PRIVATE
+#undef XNU_KERNEL_PRIVATE
+#define __PTHREAD_EXPOSE_INTERNALS__ 1
+#define NEEDS_SCHED_CALL_T 1
+
+/*
+ * HUSKY is VMAPPLE-class with CONFIG_PV_TICKET, so kern/locks.h declares
+ * lck_init_pv() __startup_func; that macro comes from kern/startup.h's
+ * XNU_KERNEL_PRIVATE view, which this kext view does not have.
+ */
+#ifndef __startup_func
+#define __startup_func
+#define HUSKY_PTHREAD_STARTUP_FUNC_STUB 1
+#endif
+
+/* Avoid collisions with the kernel side of the callback interface. */
+#define pthread_kern husky_pthread_kern
+#define current_uthread husky_pthread_current_uthread
+#define pthread_start husky_pthread_start
+#define pthread_stop husky_pthread_stop
+#endif
diff --git a/bsd/pthread/husky_pthread_init.c b/bsd/pthread/husky_pthread_init.c
new file mode 100644
index 0000000..b96f946
--- /dev/null
+++ b/bsd/pthread/husky_pthread_init.c
@@ -0,0 +1,30 @@
+/* Built-in provider: Apple libpthread-539.100.4, paired with xnu-12377.121.6. */
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+#include "husky_pthread_compat.h"
+#include "husky_libpthread/kern/kern_init.c"
+
+/* Keep the provider's full layout within the kernel's reserved storage. */
+_Static_assert(sizeof(struct ksyn_waitq_element) == 56,
+    "update HUSKY ksyn storage in sys/pthread_internal.h");
+
+/* Restore the startup interface after compiling the provider's kext code. */
+#ifdef HUSKY_PTHREAD_STARTUP_FUNC_STUB
+#undef __startup_func
+#endif
+#define XNU_KERNEL_PRIVATE 1
+#include <kern/startup.h>
+#include <pexpert/pexpert.h>
+
+/* What kext loading would do: register the provider's function table. */
+__startup_func
+static void
+husky_pthread_register(void)
+{
+	kern_return_t kr = husky_pthread_start(NULL, NULL);
+	if (kr != KERN_SUCCESS || husky_pthread_kern == NULL) {
+		panic("HUSKY: pthread provider registration failed: %d", kr);
+	}
+	kprintf("HUSKY pthread: libpthread-539.100.4 registered\n");
+}
+STARTUP(EARLY_BOOT, STARTUP_RANK_SECOND, husky_pthread_register);
+#endif /* ARM64_BOARD_CONFIG_HUSKY */

 		ch &= ~(CH_RXCH_ON | CH_TXCH_ON);
 		spi_wr(REG_CH_CFG, ch);
 		spi_wr(REG_PACKET_CNT, 0);
 
 		if (received < chunk) {
-			HU_LOG("HUSKY SPI: transfer timeout (expected %zu, got %zu)\n",
-			    chunk, received);
+			HU_LOG("HUSKY SPI: transfer timeout (expected %zu, got %zu) STATUS 0x%x "
+			    "(tx lvl %u rx lvl %u) CH_CFG 0x%x MODE_CFG 0x%x PACKET_CNT 0x%x\n",
+			    chunk, received, st_end, ST_TX_FIFO_LVL(st_end),
+			    ST_RX_FIFO_LVL(st_end), ch, mode_end, pkt_end);
 			husky_spi_flush();
 			err = ETIMEDOUT;
 			break;
@@ -510,31 +615,51 @@ int

+int
+husky_spi_loopback_test(void)
+{
+	static const uint8_t pattern[8] = {0xa5, 0x5a, 0x00, 0xff, 0x36, 0x40, 0x81, 0x7e};
+	uint8_t in[sizeof(pattern)];
+
+	if (!husky_spi_initialized || !spi_base) {
+		return ENXIO;
+	}
+	bzero(in, sizeof(in));
+	spi_wr(REG_MODE_CFG, spi_rd(REG_MODE_CFG) | MODE_SELF_LOOPBACK);
+	int err = husky_spi_transfer(pattern, in, sizeof(pattern));
+	spi_wr(REG_MODE_CFG, spi_rd(REG_MODE_CFG) & ~MODE_SELF_LOOPBACK);
+
+	bool match = !err && memcmp(in, pattern, sizeof(pattern)) == 0;
+	HU_LOG("HUSKY SPI: loopback %s (err %d): %02x %02x %02x %02x %02x %02x %02x %02x\n",
+	    match ? "OK" : "FAILED", err, in[0], in[1], in[2], in[3], in[4], in[5], in[6], in[7]);
+	return match ? 0 : (err ? err : EIO);
+}
+

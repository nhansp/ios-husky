diff --git a/bsd/dev/husky_spi.c b/bsd/dev/husky_spi.c
index 7496d05..97f165f 100644
--- a/bsd/dev/husky_spi.c
+++ b/bsd/dev/husky_spi.c
@@ -40,6 +40,29 @@ extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 #define HUSKY_CMU_HSI0_PA       0x11000000ULL
 #define HUSKY_CMU_HSI0_SIZE     0x8000ULL
 
+/*
+ * spi@111D0000 is USI2_HSI0; its ipclk comes from CMU_HSI0 (zuma cal-if
+ * cmucal-sfr.c): MUX_CLK_HSI0_USI2 (bit 0: 0 = CLKCMU_HSI0_PERI from CMU_TOP,
+ * 1 = OSCCLK 24.576 MHz) -> GATE_CLK_HSI0_USI2 -> DIV_CLK_HSI0_USI2 (bits 3:0)
+ * -> the IPCLK/RSTNSYNC gates; PCLK hangs off the HSI0 NOC. Gates: bit 20 =
+ * MANUAL, bit 21 = CG_VAL (pass when MANUAL). QCH: bit 0 ENABLE (hardware
+ * handshake), bit 1 CLOCK_REQ. The SPI divides ipclk by 4 for SCLK.
+ */
+#define CMU_PERI_USER_CON0      0x0680u
+#define CMU_MUX_USI2            0x101cu
+#define CMU_DIV_USI2            0x181cu
+#define CMU_GATE_USI2           0x2120u
+#define CMU_GATE_USI2_IPCLK     0x20fcu
+#define CMU_GATE_USI2_PCLK      0x2100u
+#define CMU_GATE_USI2_RSTNSYNC  0x20bcu
+#define CMU_QCH_USI2            0x30ccu
+#define CMU_BUSY                (1u << 16)
+#define CMU_GATE_MANUAL         (1u << 20)
+#define CMU_GATE_CG_VAL         (1u << 21)
+#define CMU_QCH_ENABLE          (1u << 0)
+#define CMU_QCH_CLOCK_REQ       (1u << 1)
+#define CMU_MUX_USI2_OSCCLK     1u
+
 /* Physical addresses for USI & SPI */
 #define HUSKY_SPI_PA            0x111d0000ULL
 #define HUSKY_SPI_SIZE          0x1000ULL
@@ -98,6 +121,9 @@ extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
 #define ST_RX_FIFORDY          (1u << 1)
 #define ST_TX_FIFORDY          (1u << 0)
 
+/* MODE_CFG: internal TX -> RX loopback */
+#define MODE_SELF_LOOPBACK     (1u << 3)
+
 /* PACKET_CNT */
 #define PACKET_CNT_EN          (1u << 16)
 
@@ -245,6 +271,75 @@ husky_spi_probe_dump(void)
 	return 0;
 }
 
+static void
+husky_cmu_dump(vm_offset_t cmu, const char *when)
+{
+	HU_LOG("HUSKY SPI: CMU_HSI0 USI2 %s: peri_user 0x%x mux 0x%x div 0x%x gate 0x%x "
+	    "ipclk 0x%x pclk 0x%x rstnsync 0x%x qch 0x%x\n", when,
+	    *(volatile uint32_t *)(cmu + CMU_PERI_USER_CON0),
+	    *(volatile uint32_t *)(cmu + CMU_MUX_USI2),
+	    *(volatile uint32_t *)(cmu + CMU_DIV_USI2),
+	    *(volatile uint32_t *)(cmu + CMU_GATE_USI2),
+	    *(volatile uint32_t *)(cmu + CMU_GATE_USI2_IPCLK),
+	    *(volatile uint32_t *)(cmu + CMU_GATE_USI2_PCLK),
+	    *(volatile uint32_t *)(cmu + CMU_GATE_USI2_RSTNSYNC),
+	    *(volatile uint32_t *)(cmu + CMU_QCH_USI2));
+}
+
+static void
+husky_cmu_wait_idle(vm_offset_t cmu, uint32_t off)
+{
+	for (unsigned i = 0; i < 1000; i++) {
+		if (!(*(volatile uint32_t *)(cmu + off) & CMU_BUSY)) {
+			return;
+		}
+		delay(1);
+	}
+	HU_LOG("HUSKY SPI: CMU 0x%x stays busy\n", off);
+}
+
+static void
+husky_cmu_rmw(vm_offset_t cmu, uint32_t off, uint32_t clear, uint32_t set)
+{
+	volatile uint32_t *reg = (volatile uint32_t *)(cmu + off);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*reg = (*reg & ~clear) | set;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+/*
+ * Give USI2 a running ipclk that does not depend on CMU_TOP: OSCCLK through
+ * the mux, divide by 1 (SCLK = 24.576 MHz / 4 = 6.1 MHz, FTM5 takes up to
+ * 10 MHz), every gate on the path forced on, Q-channel handshake off with the
+ * clock requested. Linux leaves these gates to hardware auto-gating and only
+ * sets the mux/divider rate; boot 0081's transfers never clocked a byte.
+ */
+static void
+husky_spi_clock_setup(void)
+{
+	vm_offset_t cmu = ml_io_map(HUSKY_CMU_HSI0_PA, HUSKY_CMU_HSI0_SIZE);
+	if (!cmu) {
+		HU_LOG("HUSKY SPI: failed to map CMU_HSI0\n");
+		return;
+	}
+	husky_cmu_dump(cmu, "before");
+
+	husky_cmu_rmw(cmu, CMU_MUX_USI2, 0x1u, CMU_MUX_USI2_OSCCLK);
+	husky_cmu_wait_idle(cmu, CMU_MUX_USI2);
+	husky_cmu_rmw(cmu, CMU_DIV_USI2, 0xfu, 0);
+	husky_cmu_wait_idle(cmu, CMU_DIV_USI2);
+
+	const uint32_t gates[] = {CMU_GATE_USI2, CMU_GATE_USI2_IPCLK,
+		                  CMU_GATE_USI2_PCLK, CMU_GATE_USI2_RSTNSYNC};
+	for (unsigned i = 0; i < sizeof(gates) / sizeof(gates[0]); i++) {
+		husky_cmu_rmw(cmu, gates[i], 0, CMU_GATE_MANUAL | CMU_GATE_CG_VAL);
+	}
+	husky_cmu_rmw(cmu, CMU_QCH_USI2, CMU_QCH_ENABLE, CMU_QCH_CLOCK_REQ);
+	delay(10);
+
+	husky_cmu_dump(cmu, "after");
+}
+
 static void
 husky_spi_flush(void)
 {

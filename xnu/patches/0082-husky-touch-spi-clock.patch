@@ -429,7 +526,9 @@ husky_spi_transfer(const uint8_t *tx, uint8_t *rx, size_t len)
 		spi_wr(REG_PENDING_CLR, 0x1fu);
 		spi_wr(REG_PENDING_CLR, 0);
 
-		/* Set packet count for the chunk */

+/*
+ * HUSKY: the iOS 26 digitizer layout (IOHIDFamily 2222+), 0xa0 bytes with
+ * double coordinates. iOS 26's IOHIDLib rejects a digitizer event smaller
+ * than this. Offsets read from the iOS 26 shared cache: x/y/z 0x10/0x18/0x20,
+ * transducerIndex 0x28, transducerType 0x2c, identity 0x30, eventMask 0x34,
+ * buttonMask 0x3c, pressure 0x40, auxPressure 0x50 (IOKit
+ * IOHIDEventCreateDigitizerEvent); orientationType 0x58, quality union 0x60..0x88
+ * (HID +[HIDEvent qualityDigitizerEvent:...]). childEventMask 0x38, twist 0x48
+ * and the trailing counters fill the remaining slots in 1915's order (inferred).
+ */
 typedef struct {
     uint32_t size;
     IOHIDEventType type;
@@ -336,9 +346,9 @@ typedef struct {
     uint8_t depth;
     uint8_t reserved[3];
     struct {
-        IOFixed x;
-        IOFixed y;
-        IOFixed z;
+        double x;
+        double y;
+        double z;
     } position;
     uint32_t transducerIndex;
     uint32_t transducerType;
@@ -346,30 +356,30 @@ typedef struct {
     uint32_t eventMask;
     uint32_t childEventMask;
     uint32_t buttonMask;
-    IOFixed pressure;
-    IOFixed auxPressure;
-    IOFixed twist;
+    double pressure;
+    double twist;
+    double auxPressure;
     uint32_t orientationType;
     union  {
         struct {
-            IOFixed x;
-            IOFixed y;
+            double x;
+            double y;
         } tilt;
         struct {
-            IOFixed altitude;
-            IOFixed azimuth;
-            IOFixed quality;
-            IOFixed density;
-            IOFixed majorRadius;
-            IOFixed minorRadius;
+            double altitude;
+            double azimuth;
+            double quality;
+            double density;
+            double majorRadius;
+            double minorRadius;

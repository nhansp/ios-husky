         struct {
-            IOFixed quality;
-            IOFixed density;
-            IOFixed irregularity;
-            IOFixed majorRadius;
-            IOFixed minorRadius;
-            IOFixed accuracy;
+            double quality;
+            double density;
+            double irregularity;
+            double majorRadius;
+            double minorRadius;
+            double accuracy;

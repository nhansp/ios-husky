+
+#if defined(HUSKY)
+/*
+ * Bring-up: snapshot everything between the vtimer and the CPU, to see why
+ * PPI 27 never reaches sleh_irq. SGI-frame offsets as in VMAPPLE.h.
+ */
+#define HUSKY_GICR_ISPENDR0     0x10200
+#define HUSKY_GICR_ISACTIVER0   0x10300
+#define HUSKY_GICR_IPRIORITYR   0x10400
+#define HUSKY_GICR_IGRPMODR0    0x10D00
+void husky_gic_dump(const char *tag);
+void
+husky_gic_dump(const char *tag)
+{
+	if (!gicd_base) {
+		kprintf("husky gic[%s]: not mapped\n", tag);
+		return;
+	}
+	vm_offset_t gicr_pe_base = find_gicr_pe_base();
+	kprintf("husky gic[%s]: GICD_CTLR=%x IGROUPR0=%x IGRPMODR0=%x ISENABLER0=%x ISPENDR0=%x ISACTIVER0=%x IPRIO[24..27]=%x WAKER=%x\n",
+	    tag, gicd_read32(GICD_CTLR), gicr_read32(GICR_IGROUPR0), gicr_read32(HUSKY_GICR_IGRPMODR0),
+	    gicr_read32(GICR_ISENABLER0), gicr_read32(HUSKY_GICR_ISPENDR0), gicr_read32(HUSKY_GICR_ISACTIVER0),
+	    gicr_read32(HUSKY_GICR_IPRIORITYR + 24), gicr_read32(GICR_WAKER));
+	kprintf("husky gic[%s]: IGRPEN1=%llx PMR=%llx CTLR=%llx SRE=%llx RPR=%llx HPPIR1=%llx HPPIR0=%llx\n",
+	    tag, __builtin_arm_rsr64("ICC_IGRPEN1_EL1"), __builtin_arm_rsr64("ICC_PMR_EL1"),
+	    __builtin_arm_rsr64("ICC_CTLR_EL1"), __builtin_arm_rsr64("ICC_SRE_EL1"),
+	    __builtin_arm_rsr64("ICC_RPR_EL1"), __builtin_arm_rsr64("ICC_HPPIR1_EL1"),
+	    __builtin_arm_rsr64("ICC_HPPIR0_EL1"));
+	kprintf("husky gic[%s]: DAIF=%llx ISR=%llx CNTV_CTL=%llx CNTV_CVAL=%llx CNTVCT=%llx CNTFRQ=%llx\n",
+	    tag, __builtin_arm_rsr64("DAIF"), __builtin_arm_rsr64("ISR_EL1"),
+	    __builtin_arm_rsr64("CNTV_CTL_EL0"), __builtin_arm_rsr64("CNTV_CVAL_EL0"),
+	    __builtin_arm_rsr64("CNTVCT_EL0"), __builtin_arm_rsr64("CNTFRQ_EL0"));
+}
+#endif /* HUSKY */
 #else

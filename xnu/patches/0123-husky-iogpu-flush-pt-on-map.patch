+/* CS status fields are only refreshed on request: ask for CSG_REQ STATUS_UPDATE before reading them. */
+static void
+queue_dump_state(mali_queue_t *q)
+{
+	lck_mtx_lock(&g_glb_lock);
+	const uint32_t want = ~rd32(q->csgout, CSG_OUT_ACK) & CSG_REQ_STATUS_UPDATE;
+	wr32(q->csgin, CSG_IN_REQ, (rd32(q->csgin, CSG_IN_REQ) & ~CSG_REQ_STATUS_UPDATE) | want);
+	glb_group_doorbell(q->csg);
+	lck_mtx_unlock(&g_glb_lock);
+	unsigned us = 0;
+	while (us < 10000 && (rd32(q->csgout, CSG_OUT_ACK) & CSG_REQ_STATUS_UPDATE) != want) {
+		delay(10);
+		us += 10;
+	}
+	const uint32_t as_reg = AS0 + (uint32_t)q->vm->as_slot * AS_STRIDE;
+	BR_LOG("HUSKY IOGPU bridge: CSG%u ack 0x%x state 0x%x irq req/ack 0x%x/0x%x (status %s) | CS req 0x%x ack 0x%x "
+	    "cmd_ptr 0x%llx wait 0x%x res 0x%x sb 0x%x blocked %u fault 0x%x/0x%llx fatal 0x%x/0x%llx | heap vt %u/%u frag %u "
+	    "| MMU irq 0x%x AS%d fault 0x%x at 0x%llx\n", q->csg, rd32(q->csgout, CSG_OUT_ACK),
+	    rd32(q->csgout, CSG_OUT_STATUS_STATE), rd32(q->csgout, CSG_OUT_IRQ_REQ), rd32(q->csgin, CSG_IN_IRQ_ACK),
+	    us < 10000 ? "fresh" : "stale", rd32(q->csin, CS_IN_REQ), rd32(q->csout, CS_OUT_ACK),
+	    (unsigned long long)rd64(q->csout, CS_OUT_CMD_PTR), rd32(q->csout, CS_OUT_STATUS_WAIT),
+	    rd32(q->csout, CS_OUT_REQ_RESOURCE), rd32(q->csout, CS_OUT_SCOREBOARDS), rd32(q->csout, CS_OUT_BLOCKED_REASON),
+	    rd32(q->csout, CS_OUT_FAULT), (unsigned long long)rd64(q->csout, CS_OUT_FAULT_INFO), rd32(q->csout, CS_OUT_FATAL),
+	    (unsigned long long)rd64(q->csout, CS_OUT_FATAL_INFO), rd32(q->csout, CS_OUT_HEAP_VT_START),
+	    rd32(q->csout, CS_OUT_HEAP_VT_END), rd32(q->csout, CS_OUT_HEAP_FRAG_END), grd(MMU_IRQ_RAWSTAT), q->vm->as_slot,
+	    grd(as_reg + AS_FAULTSTATUS), (unsigned long long)(grd(as_reg + AS_FAULTADDRESS) |
+	    ((uint64_t)grd(as_reg + AS_FAULTADDRESS + 4) << 32)));
+}

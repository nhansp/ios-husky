diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index f01702d..1b6de04 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -355,40 +355,60 @@ arm_auxkc_init(void *mh, void *base)
 void husky_vp_bc(const char *s);
 /* TTBR0 at the first crumb: the bootstrap V=P tables this path relies on. */
 uint64_t husky_vp_ttbr0;
+
+#define HUSKY_RING_PA	0xfd5ff000UL
+#define HUSKY_RING_SIG	0x43474244U
+#define HUSKY_RING_CAP	(0x200000U - 12U)	/* pmsg zone minus header */
+
+/* Refetch a line from RAM (clean+invalidate). */
+static inline void
+husky_vp_civac(uintptr_t a)
+{
+	__asm__ volatile ("dc civac, %0; dsb sy" :: "r" (a) : "memory");
+}
+
+/* Push a line to PoC so pstore sees it after a reset. */
+static inline void
+husky_vp_cvac(uintptr_t a)
+{
+	__asm__ volatile ("dc cvac, %0; dsb sy" :: "r" (a) : "memory");
+}
+
 void
 husky_vp_bc(const char *s)
 {
 	volatile struct { uint32_t sig, start, size; uint8_t data[]; } *p =
-	    (void *)0xfd5ff000UL;
+	    (void *)HUSKY_RING_PA;
 	if (husky_vp_ttbr0 == 0) {
 		__asm__ volatile ("mrs %0, TTBR0_EL1" : "=r" (husky_vp_ttbr0));
 	}
 	/*
-	 * The ring is also written through Device mappings (pe_serial's console),
-	 * so drop any stale cached copy before reading the header or merging bytes
-	 * into partly-written lines.
+	 * This alias is cacheable, but the ring is also written through Device
+	 * mappings (pe_serial) and read from RAM by pstore after the reset. So
+	 * refetch each line before touching it and clean it to PoC after. The
+	 * header in RAM is the only write position; wrap like Linux's
+	 * persistent_ram (start = next write, size = valid bytes).
 	 */
-	for (uintptr_t a = 0xfd5ff000UL; a < 0xfd5ff000UL + 12 + 0x3000U; a += 64) {
-		__asm__ volatile ("dc civac, %0" :: "r" (a) : "memory");
-	}
-	__asm__ volatile ("dsb sy" ::: "memory");
-	if (p->sig != 0x43474244U || p->size > 0x3000U) {
-		p->sig = 0x43474244U;
+	husky_vp_civac(HUSKY_RING_PA);
+	if (p->sig != HUSKY_RING_SIG || p->size > HUSKY_RING_CAP || p->start >= HUSKY_RING_CAP) {
+		p->sig = HUSKY_RING_SIG;
 		p->start = 0;
 		p->size = 0;
 	}
-	uint32_t pos = p->size;
-	while (*s && pos < 0x3000U) {
-		p->data[pos++] = (uint8_t)*s++;
-	}
-	p->start = pos;
-	p->size = pos;
-	/* The ring is mapped cacheable here, so clean to PoC or a watchdog reset
-	 * loses the writes before pstore reads physical RAM. */
-	for (uintptr_t a = 0xfd5ff000UL; a < 0xfd5ff000UL + 12 + pos; a += 64) {
-		__asm__ volatile ("dc cvac, %0" :: "r" (a) : "memory");
+	uint32_t start = p->start, size = p->size;
+	while (*s) {
+		uintptr_t a = (uintptr_t)&p->data[start];
+		husky_vp_civac(a);
+		p->data[start] = (uint8_t)*s++;
+		husky_vp_cvac(a);
+		start = (start + 1 == HUSKY_RING_CAP) ? 0 : start + 1;
+		if (size < HUSKY_RING_CAP) {
+			size++;
+		}
 	}
-	__asm__ volatile ("dsb sy" ::: "memory");
+	p->start = start;
+	p->size = size;
+	husky_vp_cvac(HUSKY_RING_PA);
 }
 

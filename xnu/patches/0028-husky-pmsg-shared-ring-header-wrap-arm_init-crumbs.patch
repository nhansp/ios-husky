@@ -773,14 +811,23 @@ arm_init(
 	}
 
 	ml_map_cpu_pio();
+#if defined(HUSKY)
+	husky_early_bc("arm_init: ml_map_cpu_pio ok\n");
+#endif
 
 #if APPLE_ARM64_ARCH_FAMILY
 	configure_late_apple_regs(true);
 #endif
+#if defined(HUSKY)
+	husky_early_bc("arm_init: late apple regs ok\n");
+#endif
 
 #endif
 
 	cpu_timebase_init(TRUE);
+#if defined(HUSKY)
+	husky_early_bc("arm_init: cpu_timebase_init ok\n");
+#endif
 
 #if KPERF
 	/* kptimer_curcpu_up() must be called after cpu_timebase_init */
@@ -788,11 +835,20 @@ arm_init(
 #endif /* KPERF */
 
 	PE_init_cpu();
+#if defined(HUSKY)
+	husky_early_bc("arm_init: PE_init_cpu ok\n");
+#endif
 #if __arm64__
 	apt_msg_init();
 	apt_msg_init_cpu();
+#endif
+#if defined(HUSKY)
+	husky_early_bc("arm_init: apt_msg ok\n");
 #endif
 	fiq_context_init(TRUE);
+#if defined(HUSKY)
+	husky_early_bc("arm_init: fiq_context_init ok\n");
+#endif
 
 
 #if HIBERNATION
@@ -811,6 +867,9 @@ arm_init(
 	 * against string vulnerabilities
 	 */
 	__stack_chk_guard &= ~(0xFFULL << 8);
+#if defined(HUSKY)
+	husky_early_bc("arm_init: machine_startup\n");
+#endif

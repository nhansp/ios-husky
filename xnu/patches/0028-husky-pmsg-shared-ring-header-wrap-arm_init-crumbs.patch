diff --git a/pexpert/arm/pe_serial.c b/pexpert/arm/pe_serial.c
index ad50ac8..d983281 100644
--- a/pexpert/arm/pe_serial.c
+++ b/pexpert/arm/pe_serial.c
@@ -815,9 +815,29 @@ struct husky_prz {
 };
 
 static volatile struct husky_prz *husky_prz;
-static uint32_t husky_pmsg_pos;
 #define HUSKY_PMSG_CAP		(HUSKY_PMSG_SIZE - sizeof(struct husky_prz))
 
+/*
+ * Append one byte. The header in RAM is the only write position, shared with
+ * the shim and the V=P breadcrumbs; wraps like Linux's persistent_ram
+ * (start = next write, size = valid bytes) so the newest output survives.
+ */
+static void
+husky_ring_putc(volatile struct husky_prz *z, uint8_t c)
+{
+	if (z->sig != HUSKY_PMSG_SIG || z->size > HUSKY_PMSG_CAP || z->start >= HUSKY_PMSG_CAP) {
+		z->sig = HUSKY_PMSG_SIG;
+		z->start = 0;
+		z->size = 0;
+	}
+	uint32_t start = z->start, size = z->size;
+	z->data[start] = c;
+	z->start = (start + 1 == HUSKY_PMSG_CAP) ? 0 : start + 1;
+	if (size < HUSKY_PMSG_CAP) {
+		z->size = size + 1;
+	}
+}
+
 /*
  * husky bring-up breadcrumb usable from early C (arm_init/arm_vm_init), once
  * the VM is far enough along for ml_io_map (i.e. from just after arm_vm_init).

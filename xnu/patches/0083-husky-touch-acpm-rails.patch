+	    husky_gpio_irq_get());
 	husky_gpio_reset_set(1);
 
 	/* The IC queues CONTROLLER_READY once its firmware is up. */
@@ -168,6 +233,7 @@ husky_fts_thread(__unused void *arg, __unused wait_result_t wr)
 	uint32_t poll_ms = 10;
 	uint32_t invert = 0;
 	uint32_t debug_log = 0;
+	uint32_t power = 1;

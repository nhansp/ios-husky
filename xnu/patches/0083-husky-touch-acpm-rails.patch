+	(void)PE_parse_boot_argn("huskytouchpwr", &power, sizeof(power));
 
 	if (enabled == 0) {
 		HU_LOG("HUSKY TOUCH: idle (opt-in via boot-arg huskytouch=1 or huskytouch=2)\n");
@@ -196,7 +263,7 @@ husky_fts_thread(__unused void *arg, __unused wait_result_t wr)
 	}
 	(void)husky_gpio_probe_dump();
 
-	err = fts_bringup();
+	err = fts_bringup(power != 0);
 	if (enabled == 2 || err) {
 		HU_LOG("HUSKY TOUCH: %s (bring-up %d)\n",
 		    enabled == 2 ? "probe finished, no scanning" : "giving up", err);

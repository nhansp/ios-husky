  *   0..1343 x 0..2991, DT st,max-coords).
  * - huskytouchdebug=1: verbose event logging.
+ * - huskytouchpwr=0: only read the touch rails over ACPM, never enable them
+ *   (default 1: enable LDO25M/LDO4M if they are off).
  *
  * FTM5 SPI protocol (google-modules touch/fts/ftm5, SPI build): hardware
  * registers are read with 0xFB and written with 0xFA, each followed by a
@@ -37,6 +39,7 @@
 #include "husky_spi.h"
 #include "husky_gpio.h"
 #include "husky_fts.h"
+#include "husky_acpm.h"
 #include "../../iokit/Kernel/arm/hid/HuskyHIDTouch.h"
 
 extern kern_return_t thread_terminate(thread_t);
@@ -100,12 +103,71 @@ fts_fifo_read(uint8_t ev[FTS_EVENT_SIZE])
 	return husky_spi_write_read_dummy(&cmd, 1, ev, FTS_EVENT_SIZE, 1);
 }
 
+/*
+ * Touch rails on the S2MPG14 (zuma-common-touch.dtsi / zuma-husky-touch.dtsi):
+ * DVDD = LDO25M 1.8 V, AVDD = LDO4M 3.3 V, enabled in that order like the
+ * FTM5 driver. Neither is boot-on in the DT, and ABL leaves the IC in reset.
+ * Control registers (PM bank): bit 7 enable, bits 5:0 voltage selector;
+ * LDO25M 0.7 V + 25 mV steps -> 0x2c, LDO4M 1.8 V + 25 mV steps -> 0x3c.
+ * A rail that is already on keeps its voltage.
+ */
+#define PMIC_LDO_EN             0x80u
+#define PMIC_LDO_VSEL           0x3fu
+
+static const struct {
+	const char *name;
+	uint8_t reg;
+	uint8_t vsel;
+} fts_rails[] = {
+	{"LDO25M DVDD 1.8V", 0x43, 0x2c},
+	{"LDO4M AVDD 3.3V", 0x2e, 0x3c},
+};
+
+static void
+fts_power_on(bool enable)
+{
+	uint8_t chipid = 0;
+	int err = husky_acpm_init();
+	if (err) {
+		HU_LOG("HUSKY TOUCH: ACPM unavailable (%d); rails untouched\n", err);
+		return;
+	}
+	err = husky_pmic_read(HUSKY_PMIC_TYPE_COMMON, 0x0b, &chipid);
+	HU_LOG("HUSKY TOUCH: S2MPG14 CHIPID 0x%02x (err %d)\n", chipid, err);
+	if (err) {
+		return;
+	}
+
+	for (unsigned i = 0; i < sizeof(fts_rails) / sizeof(fts_rails[0]); i++) {
+		uint8_t v = 0;
+		err = husky_pmic_read(HUSKY_PMIC_TYPE_PM, fts_rails[i].reg, &v);
+		HU_LOG("HUSKY TOUCH: %s ctrl 0x%02x = 0x%02x (err %d)\n",
+		    fts_rails[i].name, fts_rails[i].reg, v, err);
+		if (err || !enable || (v & PMIC_LDO_EN)) {
+			continue;
+		}
+		if ((v & PMIC_LDO_VSEL) != fts_rails[i].vsel) {
+			err = husky_pmic_update(HUSKY_PMIC_TYPE_PM, fts_rails[i].reg,
+			    fts_rails[i].vsel, PMIC_LDO_VSEL);
+		}
+		if (!err) {
+			err = husky_pmic_update(HUSKY_PMIC_TYPE_PM, fts_rails[i].reg,
+			    PMIC_LDO_EN, PMIC_LDO_EN);
+		}
+		uint8_t after = 0;
+		(void)husky_pmic_read(HUSKY_PMIC_TYPE_PM, fts_rails[i].reg, &after);
+		HU_LOG("HUSKY TOUCH: %s enable err %d, ctrl now 0x%02x\n",
+		    fts_rails[i].name, err, after);
+		fts_sleep_ms(1);
+	}
+}
+

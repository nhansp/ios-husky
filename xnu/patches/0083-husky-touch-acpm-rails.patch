diff --git a/bsd/dev/husky_acpm.c b/bsd/dev/husky_acpm.c
new file mode 100644
index 0000000..a2d4636
--- /dev/null
+++ b/bsd/dev/husky_acpm.c
@@ -0,0 +1,319 @@
+/*
+ * HUSKY: polled ACPM IPC client for Google Tensor G3 ("zuma", Pixel 8 Pro).
+ *
+ * The PMICs (S2MPG14 main, S2MPG15 sub) sit behind the APM core: the AP asks
+ * the ACPM firmware to do speedy register accesses through a queue in APM SRAM
+ * and a mailbox doorbell. Facts from the zuma DT and Google's acpm_ipc.c /
+ * acpm_mfd.c / framework.h (gs-6.1 google-modules):
+ *
+ * - mailbox AP<->APM at 0x15110000; APM SRAM at 0x15700000 (0x58000);
+ *   firmware initdata at SRAM + 0xA000.
+ * - initdata: +0x08 ipc_channels (SRAM offset), +0x18 ipc_ap_max. Each
+ *   ipc_channel is 72 bytes: id, field bits, owner, type, then channel_info
+ *   (rx_rear, rx_front, rx_base, rx_indr_buf, rx_indr_buf_base,
+ *   rx_indr_buf_size, tx_rear, tx_front, tx_base, q_len, q_elem_size, credit,
+ *   mbox_addr), then ap_poll. Names are APM-side: the AP sends through the
+ *   rx_* queue and receives through the tx_* queue. All pointers are SRAM
+ *   offsets; front/rear are slot indices.
+ * - send: cmd[0] gets a 6-bit sequence number at bit 16, the element goes in
+ *   slot front, front advances, doorbell = 1 << channel id at mailbox + 0x40.
+ *   The answer comes back in the AP's receive queue with the same sequence
+ *   number; the AP moves its rear up and clears mailbox + 0x24 bit id.
+ * - MFD command: cmd[0] = reg | type << 8 | speedy channel << 12; cmd[1] bits
+ *   7:0 function (0 read, 2 update), 15:8 value, 23:16 mask; the reply has the
+ *   value in cmd[1] bits 15:8 and the status (0 = OK) in bits 31:24.
+ *
+ * Polled only: no mailbox interrupt is taken. Every SRAM-derived offset is
+ * range-checked before use, and timeouts return errors instead of panicking.
+ */
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/locks.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include "husky_acpm.h"
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define HU_LOG(...)     do { printf(__VA_ARGS__); kprintf(__VA_ARGS__); } while (0)
+
+#define ACPM_MBOX_PA            0x15110000ULL
+#define ACPM_MBOX_SIZE          0x1000ULL
+#define ACPM_SRAM_PA            0x15700000ULL
+#define ACPM_SRAM_SIZE          0x58000u
+#define ACPM_INITDATA_OFF       0xa000u
+
+#define MBOX_AP_INTCR           0x24u   /* INTCR0: clear APM -> AP pending */
+#define MBOX_APM_INTGR          0x40u   /* INTGR1: AP -> APM doorbell */
+
+#define INIT_IPC_CHANNELS       0x08u
+#define INIT_NUM_IPC_CHANNELS   0x0cu
+#define INIT_IPC_AP_MAX         0x18u
+
+#define IPC_CH_SIZE             72u
+#define IPC_CH_ID               0x00u
+#define IPC_CH_RX_REAR          0x10u
+#define IPC_CH_RX_FRONT         0x14u
+#define IPC_CH_RX_BASE          0x18u
+#define IPC_CH_TX_REAR          0x28u
+#define IPC_CH_TX_FRONT         0x2cu
+#define IPC_CH_TX_BASE          0x30u
+#define IPC_CH_Q_LEN            0x34u
+#define IPC_CH_Q_ELEM_SIZE      0x38u
+#define IPC_CH_AP_POLL          0x44u
+
+#define ACPM_SEQ_SHIFT          16u
+#define ACPM_SEQ_MASK           0x3fu
+
+/* S2MPG14: acpm-ipc-channel 2, acpm-speedy-channel 0 (zuma-pmic.dtsi) */
+#define PMIC_IPC_CHANNEL        2u
+#define PMIC_SPEEDY_CHANNEL     0u
+#define MFD_FUNC_READ           0u
+#define MFD_FUNC_UPDATE         2u
+
+#define ACPM_TIMEOUT_US         100000u
+
+static vm_offset_t acpm_mbox;
+static vm_offset_t acpm_sram;
+static bool acpm_ready;
+static uint32_t acpm_seq;
+
+/* AP send queue (APM rx_*) and AP receive queue (APM tx_*), SRAM offsets */
+static uint32_t snd_front, snd_rear, snd_base;
+static uint32_t rcv_front, rcv_rear, rcv_base;
+static uint32_t q_len, q_elem;
+
+static LCK_GRP_DECLARE(husky_acpm_grp, "husky_acpm");
+static LCK_MTX_DECLARE(husky_acpm_lock, &husky_acpm_grp);
+
+static inline uint32_t
+sram_rd(uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(acpm_sram + off);
+	__asm__ volatile("dmb osh" ::: "memory");
+	return v;
+}
+
+static inline void
+sram_wr(uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb osh" ::: "memory");
+	*(volatile uint32_t *)(acpm_sram + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static inline void
+mbox_wr(uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dsb osh" ::: "memory");
+	*(volatile uint32_t *)(acpm_mbox + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+sram_range_ok(uint32_t off, uint32_t len)
+{
+	return off < ACPM_SRAM_SIZE && len <= ACPM_SRAM_SIZE - off;
+}
+
+int
+husky_acpm_init(void)
+{
+	lck_mtx_lock(&husky_acpm_lock);
+	if (acpm_ready) {
+		lck_mtx_unlock(&husky_acpm_lock);
+		return 0;
+	}
+
+	acpm_mbox = ml_io_map(ACPM_MBOX_PA, ACPM_MBOX_SIZE);
+	acpm_sram = ml_io_map(ACPM_SRAM_PA, ACPM_SRAM_SIZE);
+	if (!acpm_mbox || !acpm_sram) {
+		HU_LOG("HUSKY ACPM: map failed\n");
+		lck_mtx_unlock(&husky_acpm_lock);
+		return ENXIO;
+	}
+
+	uint32_t channels = sram_rd(ACPM_INITDATA_OFF + INIT_IPC_CHANNELS);
+	uint32_t num = sram_rd(ACPM_INITDATA_OFF + INIT_NUM_IPC_CHANNELS);
+	uint32_t ap_max = sram_rd(ACPM_INITDATA_OFF + INIT_IPC_AP_MAX);
+	HU_LOG("HUSKY ACPM: initdata ipc_channels 0x%x num %u ap_max %u\n",
+	    channels, num, ap_max);
+	if (ap_max <= PMIC_IPC_CHANNEL || ap_max > 32 || ap_max > num ||
+	    !sram_range_ok(channels, ap_max * IPC_CH_SIZE)) {
+		HU_LOG("HUSKY ACPM: initdata implausible; not using ACPM\n");
+		lck_mtx_unlock(&husky_acpm_lock);
+		return ENODEV;
+	}
+
+	uint32_t ch = 0;
+	bool found = false;
+	for (uint32_t i = 0; i < ap_max; i++) {
+		if (sram_rd(channels + i * IPC_CH_SIZE + IPC_CH_ID) == PMIC_IPC_CHANNEL) {
+			ch = channels + i * IPC_CH_SIZE;
+			found = true;
+			break;
+		}
+	}
+	if (!found) {
+		HU_LOG("HUSKY ACPM: no channel %u\n", PMIC_IPC_CHANNEL);
+		lck_mtx_unlock(&husky_acpm_lock);
+		return ENODEV;
+	}
+
+	snd_rear = sram_rd(ch + IPC_CH_RX_REAR);
+	snd_front = sram_rd(ch + IPC_CH_RX_FRONT);
+	snd_base = sram_rd(ch + IPC_CH_RX_BASE);
+	rcv_rear = sram_rd(ch + IPC_CH_TX_REAR);
+	rcv_front = sram_rd(ch + IPC_CH_TX_FRONT);
+	rcv_base = sram_rd(ch + IPC_CH_TX_BASE);
+	q_len = sram_rd(ch + IPC_CH_Q_LEN);
+	q_elem = sram_rd(ch + IPC_CH_Q_ELEM_SIZE);
+	HU_LOG("HUSKY ACPM: ch %u snd rear/front/base 0x%x/0x%x/0x%x rcv 0x%x/0x%x/0x%x "
+	    "len %u elem %u ap_poll %u\n", PMIC_IPC_CHANNEL, snd_rear, snd_front, snd_base,
+	    rcv_rear, rcv_front, rcv_base, q_len, q_elem, sram_rd(ch + IPC_CH_AP_POLL));
+
+	if (q_len < 3 || q_len > 64 || q_elem < 8 || q_elem > 64 || (q_elem & 3) ||
+	    !sram_range_ok(snd_base, q_len * q_elem) || !sram_range_ok(rcv_base, q_len * q_elem) ||
+	    !sram_range_ok(snd_rear, 4) || !sram_range_ok(snd_front, 4) ||
+	    !sram_range_ok(rcv_rear, 4) || !sram_range_ok(rcv_front, 4)) {
+		HU_LOG("HUSKY ACPM: channel layout implausible; not using ACPM\n");
+		lck_mtx_unlock(&husky_acpm_lock);
+		return ENODEV;
+	}
+
+	acpm_ready = true;
+	lck_mtx_unlock(&husky_acpm_lock);
+	return 0;
+}
+
+/* Consume everything in the receive queue; copy out the element tagged seq. */
+static bool
+acpm_drain(uint32_t seq, uint32_t *reply)
+{
+	bool got = false;
+	uint32_t front = sram_rd(rcv_front);
+	uint32_t i = sram_rd(rcv_rear);
+
+	if (front >= q_len || i >= q_len) {
+		return false;
+	}
+	while (i != front) {
+		uint32_t slot = rcv_base + i * q_elem;
+		uint32_t w0 = sram_rd(slot);
+		if (seq && ((w0 >> ACPM_SEQ_SHIFT) & ACPM_SEQ_MASK) == seq) {
+			for (uint32_t w = 0; w < 4; w++) {
+				reply[w] = sram_rd(slot + w * 4);
+			}
+			got = true;
+		}
+		i = (i + 1) % q_len;
+	}
+	sram_wr(rcv_rear, front);
+	mbox_wr(MBOX_AP_INTCR, 1u << PMIC_IPC_CHANNEL);
+	return got;
+}
+
+static int
+acpm_send(uint32_t cmd[4], uint32_t reply[4])
+{
+	unsigned waited;
+
+	if (!acpm_ready) {
+		return ENXIO;
+	}
+	lck_mtx_lock(&husky_acpm_lock);
+
+	/* Keep two slots free, as Google's driver does. */
+	uint32_t front;
+	for (waited = 0;; waited += 10) {
+		front = sram_rd(snd_front);
+		if (front < q_len && (front + 2) % q_len != sram_rd(rcv_front)) {
+			break;
+		}
+		if (waited >= ACPM_TIMEOUT_US) {
+			HU_LOG("HUSKY ACPM: send queue stuck (front %u)\n", front);
+			lck_mtx_unlock(&husky_acpm_lock);
+			return EBUSY;
+		}
+		delay(10);
+	}
+	if ((front + 1) % q_len == sram_rd(snd_rear)) {
+		HU_LOG("HUSKY ACPM: send queue full\n");
+		lck_mtx_unlock(&husky_acpm_lock);
+		return EBUSY;
+	}
+
+	(void)acpm_drain(0, NULL);
+
+	acpm_seq = (acpm_seq % ACPM_SEQ_MASK) + 1;      /* 1..63 */
+	uint32_t seq = acpm_seq;
+	cmd[0] = (cmd[0] & ~(ACPM_SEQ_MASK << ACPM_SEQ_SHIFT)) | (seq << ACPM_SEQ_SHIFT);
+
+	uint32_t slot = snd_base + front * q_elem;
+	for (uint32_t w = 0; w < q_elem / 4; w++) {
+		sram_wr(slot + w * 4, w < 4 ? cmd[w] : 0);
+	}
+	sram_wr(snd_front, (front + 1) % q_len);
+	mbox_wr(MBOX_APM_INTGR, 1u << PMIC_IPC_CHANNEL);
+
+	int err = ETIMEDOUT;
+	for (waited = 0; waited < ACPM_TIMEOUT_US; waited += 10) {
+		if (acpm_drain(seq, reply)) {
+			err = 0;
+			break;
+		}
+		delay(10);
+	}
+	lck_mtx_unlock(&husky_acpm_lock);
+	if (err) {
+		HU_LOG("HUSKY ACPM: no reply to seq %u (cmd %08x %08x)\n", seq, cmd[0], cmd[1]);
+	}
+	return err;
+}
+
+static uint32_t
+mfd_cmd0(uint8_t type, uint8_t reg)
+{
+	return (uint32_t)reg | ((uint32_t)(type & 0xf) << 8) | (PMIC_SPEEDY_CHANNEL << 12);
+}
+
+int
+husky_pmic_read(uint8_t type, uint8_t reg, uint8_t *val)
+{
+	uint32_t cmd[4] = {mfd_cmd0(type, reg), MFD_FUNC_READ, 0, 0};
+	uint32_t reply[4] = {0, 0, 0, 0};
+	int err = acpm_send(cmd, reply);
+	if (err) {
+		return err;
+	}
+	uint32_t status = reply[1] >> 24;
+	if (status) {
+		HU_LOG("HUSKY ACPM: PMIC read %x:%02x status %u\n", type, reg, status);
+		return EIO;
+	}
+	*val = (uint8_t)(reply[1] >> 8);
+	return 0;
+}
+
+int
+husky_pmic_update(uint8_t type, uint8_t reg, uint8_t val, uint8_t mask)
+{
+	uint32_t cmd[4] = {mfd_cmd0(type, reg),
+		           MFD_FUNC_UPDATE | ((uint32_t)val << 8) | ((uint32_t)mask << 16), 0, 0};
+	uint32_t reply[4] = {0, 0, 0, 0};
+	int err = acpm_send(cmd, reply);
+	if (err) {
+		return err;
+	}
+	uint32_t status = reply[1] >> 24;
+	if (status) {
+		HU_LOG("HUSKY ACPM: PMIC update %x:%02x status %u\n", type, reg, status);
+		return EIO;
+	}
+	return 0;
+}
+
+#endif /* ARM64_BOARD_CONFIG_HUSKY */
diff --git a/bsd/dev/husky_acpm.h b/bsd/dev/husky_acpm.h
new file mode 100644
index 0000000..d8f5268
--- /dev/null
+++ b/bsd/dev/husky_acpm.h
@@ -0,0 +1,32 @@
+/*
+ * HUSKY: polled ACPM IPC client and S2MPG14 PMIC register access
+ * (bsd/dev/husky_acpm.h), Google Tensor G3 ("zuma").
+ */
+#ifndef _HUSKY_ACPM_H
+#define _HUSKY_ACPM_H
+
+#include <sys/types.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* S2MPG14 register banks (ACPM MFD "type" field) */
+#define HUSKY_PMIC_TYPE_COMMON  0x0u
+#define HUSKY_PMIC_TYPE_PM      0x1u
+
+/*
+ * Map the APM SRAM and mailbox and find the PMIC channel in the firmware's
+ * initdata. Returns 0 when the channel looks sane; nothing is sent.
+ */
+int husky_acpm_init(void);
+
+/* One S2MPG14 register read / masked update over ACPM (speedy channel 0). */
+int husky_pmic_read(uint8_t type, uint8_t reg, uint8_t *val);
+int husky_pmic_update(uint8_t type, uint8_t reg, uint8_t val, uint8_t mask);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _HUSKY_ACPM_H */

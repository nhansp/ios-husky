  */
 void husky_vp_bc(const char *s);
+/* TTBR0 at the first crumb: the bootstrap V=P tables this path relies on. */
+uint64_t husky_vp_ttbr0;
 void
 husky_vp_bc(const char *s)
 {
 	volatile struct { uint32_t sig, start, size; uint8_t data[]; } *p =
 	    (void *)0xfd5ff000UL;
+	if (husky_vp_ttbr0 == 0) {
+		__asm__ volatile ("mrs %0, TTBR0_EL1" : "=r" (husky_vp_ttbr0));
+	}
+	/*
+	 * The ring is also written through Device mappings (pe_serial's console),
+	 * so drop any stale cached copy before reading the header or merging bytes
+	 * into partly-written lines.
+	 */
+	for (uintptr_t a = 0xfd5ff000UL; a < 0xfd5ff000UL + 12 + 0x3000U; a += 64) {
+		__asm__ volatile ("dc civac, %0" :: "r" (a) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
 	if (p->sig != 0x43474244U || p->size > 0x3000U) {
 		p->sig = 0x43474244U;
 		p->start = 0;

diff --git a/osfmk/arm64/pac_asm.h b/osfmk/arm64/pac_asm.h
index d211433..a7af9e7 100644
--- a/osfmk/arm64/pac_asm.h
+++ b/osfmk/arm64/pac_asm.h
@@ -97,7 +97,9 @@
  *   tmp - scratch register
  */
 .macro SET_JOP_KEY_REGISTERS	new_jop_key, tmp
-#if HAS_PARAVIRTUALIZED_PAC
+#if defined(HUSKY)
+	/* husky: fixed, shared architected keys; no per-process EL0 key swap */
+#elif HAS_PARAVIRTUALIZED_PAC
 	SAVE_SMCCC_CLOBBERED_REGISTERS
 	/*
 	 * We're deliberately calling PAC_SET_EL0_DIVERSIFIER here, even though the
@@ -127,7 +129,9 @@
  *   tmp - scratch register
  */
 .macro SET_ROP_KEY_REGISTERS	new_rop_key, tmp
-#if HAS_PARAVIRTUALIZED_PAC
+#if defined(HUSKY)
+	/* husky: fixed, shared architected keys; no per-process EL0 key swap */
+#elif HAS_PARAVIRTUALIZED_PAC
 	SAVE_SMCCC_CLOBBERED_REGISTERS
 	MOV64	x0, VMAPPLE_PAC_SET_B_KEYS
 	mov		x1, \new_rop_key
@@ -146,7 +150,31 @@
  *   tmp2 - scratch register
  */
 .macro PAC_INIT_KEY_STATE	tmp, tmp2
-#if HAS_PARAVIRTUALIZED_PAC
+#if defined(HUSKY)
+	/*
+	 * husky: program the architected PAC key registers directly (the
+	 * primitive was validated on-device by the P0c spike). Bring-up keys
+	 * are a single fixed 128-bit value in every key register -- PAC still
+	 * round-trips so arm64e boots, but keys are shared across EL/process
+	 * (INSECURE); real per-boot, per-process keys are a follow-up. Only
+	 * TMP is clobbered, and x0-x3 are safe here per the macro contract.
+	 */
+	movz	\tmp, #0x4331
+	movk	\tmp, #0x5041, lsl #16
+	movk	\tmp, #0x534b, lsl #32
+	movk	\tmp, #0x4855, lsl #48
+	msr		S3_0_C2_C1_0, \tmp	/* APIAKeyLo_EL1 */
+	msr		S3_0_C2_C1_1, \tmp	/* APIAKeyHi_EL1 */
+	msr		S3_0_C2_C1_2, \tmp	/* APIBKeyLo_EL1 */
+	msr		S3_0_C2_C1_3, \tmp	/* APIBKeyHi_EL1 */
+	msr		S3_0_C2_C2_0, \tmp	/* APDAKeyLo_EL1 */
+	msr		S3_0_C2_C2_1, \tmp	/* APDAKeyHi_EL1 */
+	msr		S3_0_C2_C2_2, \tmp	/* APDBKeyLo_EL1 */
+	msr		S3_0_C2_C2_3, \tmp	/* APDBKeyHi_EL1 */
+	msr		S3_0_C2_C3_0, \tmp	/* APGAKeyLo_EL1 */
+	msr		S3_0_C2_C3_1, \tmp	/* APGAKeyHi_EL1 */
+	isb
+#elif HAS_PARAVIRTUALIZED_PAC
 #if HIBERNATION
 	#error PAC_INIT_KEY_STATE is not implemented for HAS_PARAVIRTUALIZED_PAC && HIBERNATION
 #endif

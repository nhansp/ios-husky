 	}
+
+	uint32_t boost = 0;
+	if (PE_parse_boot_argn("huskyboost", &boost, sizeof(boost)) && boost) {
+		thread_t thread;
+		boost_enabled = true;
+		if (kernel_thread_start(husky_boost_thread, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		} else {
+			boost_enabled = false;
+		}
+	}
 }
 

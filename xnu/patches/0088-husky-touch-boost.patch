+/*
+ * Touch boost (boot-arg huskyboost=1), after Pixel's power HAL: no load-based
+ * governor here, so idle at a modest base and jump to launch-like levels on
+ * touch, back to base HUSKY_BOOST_MS after the last touch event. Levels are
+ * OPPs from the phone's /vendor/etc/powerhint.json (cpufreq/devfreq tables;
+ * LAUNCH raises every cluster and MIF to max and DSU to >= 1.8 GHz). The
+ * boot-arg rates (huskycl0.., huskymif) become the boost levels when given.
+ * The thermal guard caps A715/X3 independently.
+ */
+#define HUSKY_BOOST_MS          1500u
+
+static const struct {
+	uint32_t domain;
+	uint32_t base_khz;
+	uint32_t boost_khz;
+} boost_levels[] = {
+	{HUSKY_DVFS_CPUCL0, 1197000, 1704000},
+	{HUSKY_DVFS_CPUCL1, 1328000, 2130000},
+	{HUSKY_DVFS_CPUCL2, 1557000, 2363000},
+	{HUSKY_DVFS_DSU, 1197000, 1800000},
+	{HUSKY_DVFS_MIF, 1014000, 3172000},
+};
+
+static uint64_t _Atomic boost_until;     /* mach_absolute_time deadline */
+static int boost_chan;
+
+static uint32_t
+boost_rate(unsigned i, bool boost)
+{
+	uint32_t khz = boost ? boost_levels[i].boost_khz : boost_levels[i].base_khz;
+	if (boost) {
+		uint32_t req = 0;
+		if (boost_levels[i].domain == HUSKY_DVFS_CPUCL1 && dvfs_req_cl1) {
+			req = dvfs_req_cl1;
+		} else if (boost_levels[i].domain == HUSKY_DVFS_CPUCL2 && dvfs_req_cl2) {
+			req = dvfs_req_cl2;
+		}
+		khz = req ? req : khz;
+	}
+	if (boost_thermal_cap && (boost_levels[i].domain == HUSKY_DVFS_CPUCL1 ||
+	    boost_levels[i].domain == HUSKY_DVFS_CPUCL2) && khz > HUSKY_THROTTLE_KHZ) {
+		khz = HUSKY_THROTTLE_KHZ;
+	}
+	return khz;
+}
+
+static void
+boost_apply(bool boost)
+{
+	for (unsigned i = 0; i < sizeof(boost_levels) / sizeof(boost_levels[0]); i++) {
+		(void)husky_dvfs_set(boost_levels[i].domain, boost_rate(i, boost));
+	}
+}
+
+static void
+husky_boost_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	bool boosted = false;
+	unsigned boosts = 0;
+
+	boost_apply(false);
+	HU_LOG("HUSKY BOOST: touch boost on (base A510/A715/X3 %u/%u/%u kHz, MIF %u)\n",
+	    boost_levels[0].base_khz, boost_levels[1].base_khz, boost_levels[2].base_khz,
+	    boost_levels[4].base_khz);
+	for (;;) {
+		uint64_t until = os_atomic_load(&boost_until, relaxed);
+		uint64_t now = mach_absolute_time();
+		if (until > now) {
+			if (!boosted) {
+				boosted = true;
+				boost_apply(true);
+				if ((boosts++ % 50) == 0) {
+					HU_LOG("HUSKY BOOST: boost #%u\n", boosts);
+				}
+			}
+			(void)assert_wait_deadline((event_t)&boost_chan, THREAD_UNINT, until);
+		} else {
+			if (boosted) {
+				boosted = false;
+				boost_apply(false);
+			}
+			(void)assert_wait((event_t)&boost_chan, THREAD_UNINT);
+		}
+		(void)thread_block(THREAD_CONTINUE_NULL);
+	}
+}
+
+void
+husky_boost_kick(void)
+{
+	if (!boost_enabled) {
+		return;
+	}
+	uint64_t interval;
+	nanoseconds_to_absolutetime((uint64_t)HUSKY_BOOST_MS * NSEC_PER_MSEC, &interval);
+	uint64_t until = mach_absolute_time() + interval;
+	uint64_t old = os_atomic_xchg(&boost_until, until, relaxed);
+	if (old < mach_absolute_time()) {
+		thread_wakeup((event_t)&boost_chan);
+	}
+}

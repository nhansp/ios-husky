+/* Freed table pages (pool indices); a table is zeroed when it goes back. */
+static uint16_t pt_free_stack[PT_PAGES];
+static unsigned pt_free_count;
+
+#define PT_ADDR_MASK            0x0000fffffffff000ULL
+
 uint64_t
 pt_alloc(void)
 {
+	if (pt_free_count > 0) {
+		return pt_pa + (uint64_t)pt_free_stack[--pt_free_count] * GPU_PAGE;
+	}
 	if (pt_used >= PT_PAGES) {
 		return 0;
 	}
 	return pt_pa + (uint64_t)(pt_used++) * GPU_PAGE;
 }
 
+static void
+pt_release(uint64_t table)
+{
+	bzero(pt_entry_table(table), GPU_PAGE);
+	pt_free_stack[pt_free_count++] = (uint16_t)((table - pt_pa) / GPU_PAGE);
+}
+
+static bool
+pt_table_empty(const uint64_t *t)
+{
+	for (unsigned i = 0; i < GPU_PAGE / 8; i++) {
+		if (t[i] != 0) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Clear the leaves of [va, va + size); tables left empty go back to the pool, the root stays. */
+void
+pt_unmap_range(uint64_t root, uint64_t va, uint64_t size)
+{
+	for (uint64_t off = 0; off < size; off += GPU_PAGE) {
+		const uint64_t a = va + off;
+		uint64_t table[4] = {root};
+		unsigned idx[4], level;
+		for (level = 0; level < 3; level++) {
+			idx[level] = (unsigned)((a >> (39 - 9 * level)) & 0x1ff);
+			const uint64_t e = pt_entry_table(table[level])[idx[level]];
+			if ((e & 3) != 3) {
+				break;
+			}
+			table[level + 1] = e & PT_ADDR_MASK;
+		}
+		if (level < 3) {
+			continue;
+		}
+		pt_entry_table(table[3])[(a >> 12) & 0x1ff] = 0;
+		if (((a + GPU_PAGE) & 0x1fffffULL) != 0 && off + GPU_PAGE < size) {
+			continue;               /* emptiness is checked once per L3 table */
+		}
+		for (int l = 3; l > 0 && pt_table_empty(pt_entry_table(table[l])); l--) {
+			pt_entry_table(table[l - 1])[idx[l - 1]] = 0;
+			pt_release(table[l]);
+		}
+	}
+}
+
+static void
+pt_free_level(uint64_t table, int level)
+{
+	uint64_t *t = pt_entry_table(table);
+	for (unsigned i = 0; level < 3 && i < GPU_PAGE / 8; i++) {
+		if ((t[i] & 3) == 3) {
+			pt_free_level(t[i] & PT_ADDR_MASK, level + 1);
+		}
+	}
+	pt_release(table);
+}
+
+/* Every table under root, root included; the AS must no longer translate through it. */
+void
+pt_free_tree(uint64_t root)
+{
+	pt_free_level(root, 0);
+}
+
+unsigned
+pt_pages_in_use(void)
+{
+	return pt_used - pt_free_count;
+}

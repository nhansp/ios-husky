diff --git a/osfmk/arm/arm_init.c b/osfmk/arm/arm_init.c
index 1f85732..cba1c81 100644
--- a/osfmk/arm/arm_init.c
+++ b/osfmk/arm/arm_init.c
@@ -376,6 +376,27 @@ husky_vp_bc(const char *s)
 	}
 	__asm__ volatile ("dsb sy" ::: "memory");
 }
+
+/* "<label>=0x<16 hex digits>\n" through husky_vp_bc. */
+void husky_vp_hex(const char *label, uint64_t v);
+void
+husky_vp_hex(const char *label, uint64_t v)
+{
+	char buf[64];
+	unsigned int n = 0;
+	while (*label && n < sizeof(buf) - 21) {
+		buf[n++] = *label++;
+	}
+	buf[n++] = '=';
+	buf[n++] = '0';
+	buf[n++] = 'x';
+	for (int sh = 60; sh >= 0; sh -= 4) {
+		buf[n++] = "0123456789abcdef"[(v >> sh) & 0xf];
+	}
+	buf[n++] = '\n';
+	buf[n] = '\0';
+	husky_vp_bc(buf);
+}
 #endif /* HUSKY */
 
 __startup_func

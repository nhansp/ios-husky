+	    (unsigned long long)expected_sync);
 	gwr(DOORBELL(BRIDGE_DOORBELL(q->csg)), 1);
 
 	/* Poll sync object for hardware completion [husky_gpu.c:672-678] */
@@ -1482,7 +1479,7 @@ op_queue_submit(mali_queue_t *q, const mali_submit_desc_t *desc)
 	if (us >= 500000 && q->csout != 0 && q->csgout != 0) {
 		queue_dump_state(q);
 	}
-	q->ring_used += total;
+	q->ring_insert = new_in;
 	return (us < 500000) ? 0 : ETIMEDOUT;
 }
 

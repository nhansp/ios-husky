diff --git a/bsd/dev/husky_fts.c b/bsd/dev/husky_fts.c
index 3ab42c6..03478da 100644
--- a/bsd/dev/husky_fts.c
+++ b/bsd/dev/husky_fts.c
@@ -143,10 +143,21 @@ husky_fts_thread(__unused void *arg, __unused wait_result_t wr)
 		(void)husky_gpio_probe_dump();
 
 		/*
-		 * No chip-ID transfer here: it needs husky_spi_init, which writes USI
-		 * SW_CONF at a sysreg address the DT gives only as a phandle (0x183).
-		 * The SW_CONF read above confirms the address first.
+		 * One chip-ID transfer, only when the USI is already in SPI mode: that
+		 * confirms the sysreg address (the DT gives it only as a phandle) and
+		 * husky_spi_init then leaves SW_CONF alone. No reset, no sense-on.
 		 */
+		if ((husky_spi_probe_swconf & 0x7u) == 0x2u) {
+			HU_LOG("HUSKY TOUCH: probe mode: USI in SPI mode; reading chip ID\n");
+			if (husky_gpio_power_check()) {
+				HU_LOG("HUSKY TOUCH: probe mode: chip ID 0x36 0x40 - controller alive\n");
+			} else {
+				HU_LOG("HUSKY TOUCH: probe mode: no chip ID (unpowered or protocol)\n");
+			}
+		} else {
+			HU_LOG("HUSKY TOUCH: probe mode: USI SW_CONF 0x%x not SPI; no transfer\n",
+			    husky_spi_probe_swconf);
+		}
 
 		HU_LOG("HUSKY TOUCH: probe mode finished; stopping without modifying hardware state\n");
 		goto out;

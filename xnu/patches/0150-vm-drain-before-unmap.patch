+/*
+ * A client that dies drops its resources in no fixed order against its queues (each queue is its own user
+ * client): wait for the VM's stream to retire everything before they are unmapped, or the GPU takes a
+ * translation fault that nothing services and the stream can no longer stop (bootE shutdown, bootI). A VM
+ * whose stream does not drain is wedged: its pages stay.
+ */
+static bool
+op_vm_wait_idle(mali_vm_t *vm, uint64_t timeout_us)
+{
+	if (vm == NULL) {
+		return true;
+	}
+	lck_mtx_lock(&g_grp_lock);
+	mali_queue_t *q = vm->group != NULL ? vm->group->queue : NULL;
+	bool idle = true;
+	if (q != NULL && q->done_cpu != NULL) {
+		lck_mtx_lock(q->lock);
+		const uint64_t want = q->submitted;
+		lck_mtx_unlock(q->lock);
+		uint64_t us = 0;
+		while (*q->done_cpu < want && us < timeout_us) {
+			delay(100);
+			us += 100;
+		}
+		idle = *q->done_cpu >= want;
+		if (!idle) {
+			BR_LOG("HUSKY IOGPU bridge: CSG%u CS%u did not drain in %llu us (%llu of %llu): AS%d wedged\n", q->csg, q->cs,
+			    (unsigned long long)timeout_us, (unsigned long long)*q->done_cpu, (unsigned long long)want, vm->as_slot);
+			queue_dump_state(q);
+			__atomic_store_n(&vm->wedged, true, __ATOMIC_RELEASE);
+		}
+	}
+	lck_mtx_unlock(&g_grp_lock);
+	return idle;
+}
+
+static bool
+op_vm_is_wedged(const mali_vm_t *vm)
+{
+	return vm != NULL && __atomic_load_n(&vm->wedged, __ATOMIC_ACQUIRE);
+}

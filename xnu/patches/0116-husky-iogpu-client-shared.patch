+/* IOGPUMetalResource init releases a resource whose client-shared block is 0 (DSC:IOGPU:0x1cc846770-0x1cc846778). */
+bool
+IOGPUResource::attachClientShared()
+{
+	uint32_t slot;
+	fClientShared = fDevice->allocClientShared(&slot);
+	if (fClientShared == 0) {
+		return false;
+	}
+	fCSSlot = slot + 1;
+	return true;
+}

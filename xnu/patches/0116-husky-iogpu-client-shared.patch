 /* Resource namespace */
+uint64_t
+IOGPUDevice::allocClientShared(uint32_t *slot)
+{
+	uint64_t va = 0;
+	IOLockLock(fLock);
+	if (fCSPool == NULL) {
+		fCSPool = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+		    kIOMemoryKernelUserShared | kIODirectionInOut, IOGPU_CS_SLOTS * IOGPU_CS_SLOT_SIZE, page_size);
+		fCSMap = fCSPool ? fCSPool->createMappingInTask(fOwner, 0, kIOMapAnywhere) : NULL;
+		if (fCSMap == NULL) {
+			OSSafeReleaseNULL(fCSPool);
+		} else {
+			bzero(fCSPool->getBytesNoCopy(), IOGPU_CS_SLOTS * IOGPU_CS_SLOT_SIZE);
+		}
+	}
+	for (uint32_t i = 0; fCSMap != NULL && i < IOGPU_CS_SLOTS; i++) {
+		if (!(fCSUsed[i / 32] & (1u << (i % 32)))) {
+			fCSUsed[i / 32] |= 1u << (i % 32);
+			bzero((uint8_t *)fCSPool->getBytesNoCopy() + i * IOGPU_CS_SLOT_SIZE, IOGPU_CS_SLOT_SIZE);
+			*slot = i;
+			va = fCSMap->getAddress() + i * IOGPU_CS_SLOT_SIZE;
+			break;
+		}
+	}
+	IOLockUnlock(fLock);
+	return va;
+}
+
+void
+IOGPUDevice::freeClientShared(uint32_t slot)
+{
+	if (slot >= IOGPU_CS_SLOTS) {
+		return;
+	}
+	IOLockLock(fLock);
+	fCSUsed[slot / 32] &= ~(1u << (slot % 32));
+	IOLockUnlock(fLock);
+}

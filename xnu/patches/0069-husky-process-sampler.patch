diff --git a/bsd/dev/husky_sample.c b/bsd/dev/husky_sample.c
new file mode 100644
index 0000000..134b624
--- /dev/null
+++ b/bsd/dev/husky_sample.c
@@ -0,0 +1,86 @@
+/*
+ * HUSKY process sampler: where is a daemon stuck? (ported from ios-sweet 0054)
+ *
+ * The phone has no debugger and daemons log nowhere readable. Every
+ * interval a kernel thread prints, for each process named in boot-arg
+ * huskysample (comma separated, default "usermanagerd,backboardd"; "-" = off)
+ * and for each of its threads, the user pc/lr/sp and a frame-pointer
+ * backtrace as "SMP name tN pc ... lr ... bt ..." (header line with the
+ * shared region slide and the main binary's mach header). A thread blocked
+ * in a syscall shows the syscall stub in pc and its caller in lr/bt.
+ *
+ * First sample 20 s after start, then every 30 s, 12 samples at most.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc.h>
+#include <sys/proc_internal.h>
+#include <kern/task.h>
+#include <kern/thread.h>
+#include <pexpert/pexpert.h>
+
+extern task_t proc_task(proc_t);
+extern int hz;
+extern void husky_sample_start(void);
+extern void husky_sample_task(const char *name, int pid, task_t task);  /* osfmk/kern/exception.c */
+
+static char husky_sample_names[128];
+
+static bool
+husky_sample_wanted(const char *name)
+{
+	size_t n = strlen(name);
+	for (const char *t = husky_sample_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+
+static int
+husky_sample_proc(proc_t p, __unused void *arg)
+{
+	char name[32];
+	proc_name(proc_pid(p), name, sizeof(name));
+	if (husky_sample_wanted(name)) {
+		task_t task = proc_task(p);
+		if (task != TASK_NULL) {
+			husky_sample_task(name, proc_pid(p), task);
+		}
+	}
+	return PROC_RETURNED;
+}
+
+static void
+husky_sample_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static int chan;
+	if (!PE_parse_boot_argn("huskysample", husky_sample_names, sizeof(husky_sample_names))) {
+		strlcpy(husky_sample_names, "usermanagerd,backboardd", sizeof(husky_sample_names));
+	}
+	if (husky_sample_names[0] == '-') {
+		return;
+	}
+	(void)tsleep(&chan, PZERO, "huskysmp", 20 * hz);
+	for (int i = 0; i < 12; i++) {
+		printf("SMP --- sample %d\n", i);
+		proc_iterate(PROC_ALLPROCLIST, husky_sample_proc, NULL, NULL, NULL);
+		(void)tsleep(&chan, PZERO, "huskysmp", 30 * hz);
+	}
+}
+
+void
+husky_sample_start(void)
+{
+	thread_t thread;
+	if (kernel_thread_start(husky_sample_thread, NULL, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}

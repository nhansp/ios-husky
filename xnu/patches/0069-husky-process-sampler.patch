@@ -63,6 +63,7 @@ extern kern_return_t kernel_thread_start(thread_continue_t, void *, thread_t *);
 extern void thread_deallocate(thread_t);
 extern int hz;
 static void husky_log_start(void);
+extern void husky_sample_start(void);
 
 /* Console (panel) and kprintf (pmsg, readable from Android after the reset). */
 #define HU_LOG(...)     do { printf(__VA_ARGS__); kprintf(__VA_ARGS__); } while (0)
@@ -685,6 +686,7 @@ husky_ufs_init(void)
 		HU_LOG("HUSKY UFS: DMA through the fixed low dma-region\n");
 	}
 	husky_log_start();
+	husky_sample_start();
 	return 0;
 }
 
diff --git a/osfmk/kern/exception.c b/osfmk/kern/exception.c
index 14bb4ee..4e8afb3 100644
--- a/osfmk/kern/exception.c
+++ b/osfmk/kern/exception.c
@@ -1012,6 +1012,57 @@ husky_crash_log(const char *name, int pid, int sig, uint64_t code, uint64_t subc
 	}
 	printf("%s\n", line);
 }
+
+/*
+ * HUSKY process sampler (bsd/dev/husky_sample.c, ported from ios-sweet 0054):
+ * user pc/lr/sp and a frame-pointer backtrace of every thread of a task, from
+ * the saved user state. A thread blocked in a syscall shows the stub in pc.
+ */
+void husky_sample_task(const char *name, int pid, task_t task);
+
+void
+husky_sample_task(const char *name, int pid, task_t task)
+{
+	vm_map_t map = get_task_map(task);
+	uint64_t slide = 0, mh = task->mach_header_vm_address;
+	int tn = 0;
+	thread_t thread;
+
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	if (sr != NULL) {
+		slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	printf("SMP %s[%d] slide 0x%llx mh 0x%llx\n", name, pid, slide, mh);
+
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		arm_saved_state_t *ss = find_user_regs(thread);
+		char line[220];
+		int n;
+		uint64_t fp;
+
+		if (ss == NULL || !is_saved_state64(ss)) {
+			continue;
+		}
+		fp = get_saved_state_fp(ss);
+		n = snprintf(line, sizeof(line), "SMP %s t%d pc 0x%llx lr 0x%llx sp 0x%llx bt", name, tn++,
+		    get_saved_state_pc(ss), get_saved_state_lr(ss), get_saved_state_sp(ss));
+		for (int i = 0; i < 10 && fp != 0 && (fp & 7) == 0 && n < (int)sizeof(line) - 20; i++) {
+			uint64_t frame[2];
+			if (vm_map_read_user(map, (vm_map_address_t)fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+				break;
+			}
+			n += snprintf(line + n, sizeof(line) - n, " 0x%llx", frame[1]);
+			if (frame[0] <= fp) {
+				break;
+			}
+			fp = frame[0];
+		}
+		printf("%s\n", line);
+	}
+	task_unlock(task);
+}
 #endif /* ARM64_BOARD_CONFIG_HUSKY */
 
 kern_return_t

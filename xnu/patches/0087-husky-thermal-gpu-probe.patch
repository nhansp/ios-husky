+int
+husky_tmu_read(uint32_t zone, int *celsius)
+{
+	uint32_t cmd[4] = {0, TMU_IPC_READ_TEMP | ((zone & 0xffu) << 16), 0, 0};
+	uint32_t reply[4] = {0, 0, 0, 0};
+	int err = acpm_send(&ch_tmu, cmd, reply);
+	if (err) {
+		return err;
+	}
+	int8_t ret = (int8_t)((reply[1] >> 8) & 0xffu);
+	if (ret) {
+		return EIO;
+	}
+	*celsius = (int)((reply[1] >> 24) & 0xffu);
+	return 0;
+}
+
+/*
+ * Thermal watch: nothing else manages temperature here. Every 10 s read the
+ * CPU and GPU zones, log them every 30 s, and when a CPU zone reaches
+ * huskytemphot (default 85 C) step the A715 and X3 clusters down to
+ * HUSKY_THROTTLE_KHZ; back to the requested rates 10 C below.
+ */
+#define HUSKY_THROTTLE_KHZ      1500000u
+
+static uint32_t dvfs_req_cl1, dvfs_req_cl2;
+
+static void
+husky_thermal_thread(__unused void *arg, __unused wait_result_t wr)
+{
+	static const char *names[] = {"BIG", "MID", "LITTLE", "G3D"};
+	uint32_t hot = 85;
+	bool throttled = false;
+	int chan;
+
+	(void)PE_parse_boot_argn("huskytemphot", &hot, sizeof(hot));
+	for (unsigned tick = 0;; tick++) {
+		int t[4] = {0, 0, 0, 0};
+		int cpu_max = 0;
+		for (unsigned z = 0; z < 4; z++) {
+			if (husky_tmu_read(z, &t[z])) {
+				t[z] = -1;
+			}
+			if (z < 3 && t[z] > cpu_max) {
+				cpu_max = t[z];
+			}
+		}
+		if (tick % 3 == 0) {
+			HU_LOG("HUSKY TEMP: %s %d %s %d %s %d %s %d C%s\n", names[0], t[0], names[1], t[1],
+			    names[2], t[2], names[3], t[3], throttled ? " (throttled)" : "");
+		}
+		if (!throttled && cpu_max >= (int)hot) {
+			throttled = true;
+			(void)husky_dvfs_set(HUSKY_DVFS_CPUCL1, HUSKY_THROTTLE_KHZ);
+			(void)husky_dvfs_set(HUSKY_DVFS_CPUCL2, HUSKY_THROTTLE_KHZ);
+			HU_LOG("HUSKY TEMP: %d C >= %u: A715/X3 to %u kHz\n", cpu_max, hot, HUSKY_THROTTLE_KHZ);
+		} else if (throttled && cpu_max < (int)hot - 10) {
+			throttled = false;
+			if (dvfs_req_cl1) {
+				(void)husky_dvfs_set(HUSKY_DVFS_CPUCL1, dvfs_req_cl1);
+			}
+			if (dvfs_req_cl2) {
+				(void)husky_dvfs_set(HUSKY_DVFS_CPUCL2, dvfs_req_cl2);
+			}
+			HU_LOG("HUSKY TEMP: %d C: A715/X3 back to the requested rates\n", cpu_max);
+		}
+		(void)assert_wait_timeout((event_t)&chan, THREAD_UNINT, 10, NSEC_PER_SEC);
+		(void)thread_block(THREAD_CONTINUE_NULL);
+	}
+}

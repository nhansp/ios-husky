diff --git a/bsd/dev/husky_gpu.c b/bsd/dev/husky_gpu.c
new file mode 100644
index 0000000..a1194cd
--- /dev/null
+++ b/bsd/dev/husky_gpu.c
@@ -0,0 +1,164 @@
+/*
+ * HUSKY: Mali-G715 (Valhall CSF, arch 11.8, 7 cores; Android gpuinfo
+ * "Mali-G715 7 cores r1p2 0x0B080A02") bring-up probe, Google Tensor G3.
+ *
+ * Boot-arg huskygpu:
+ *   1  read-only: the G3D power domains' state; GPU_ID and friends only if
+ *      the top domain is already on.
+ *   2  also power the top domain on (if off) and then read the registers.
+ *
+ * Facts (zuma-gpu.dtsi, zuma-pm-domains.dtsi, cal-if zuma
+ * flexpmu_cal_local_zuma.h, exynos-pd_el3.c, Arm Mali CSF register map as in
+ * Linux panthor_regs.h):
+ * - GPU registers at 0x1F000000 (0x480000). Two power domains: "top" pd_g3d
+ *   (PMU 0x15461A80 CONFIGURATION / +4 STATUS, bit 0; need_smc 0x1EE10204)
+ *   and "cores" pd_embedded_g3d (0x15461C80, child of top). CMU_G3D is at
+ *   0x1EE00000, inside the top domain: never touched while it is off.
+ * - top power-on = CONFIGURATION bit 0, wait STATUS bit 0, then the EL3 call
+ *   SMC_CMD_PREPARE_PD_ONOFF (0x82000410, EXYNOS_WAKEUP_PD_DOWN 1, need_smc
+ *   address, RUNTIME_PM_TZPC_GROUP 2) that restores the block's TZPC setup.
+ *   After power-on CMU_G3D is at reset values (core-clock muxes on OSCCLK);
+ *   the cores domain also needs the G3D PLLs and is left alone here.
+ * - GPU_CONTROL: GPU_ID 0x00, L2_FEATURES 0x04, CORE_FEATURES 0x08,
+ *   TILER_FEATURES 0x0C, MEM_FEATURES 0x10, MMU_FEATURES 0x14, AS_PRESENT
+ *   0x18, CSF_ID 0x1C, SHADER_PRESENT 0x100/0x104, TILER_PRESENT 0x110,
+ *   L2_PRESENT 0x120, GPU_STATUS 0x34.
+ *
+ * Every step is logged (kprintf too) before it runs, so an SError leaves a
+ * trail in pmsg.
+ */
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+
+#define HU_LOG(...)     do { printf(__VA_ARGS__); kprintf(__VA_ARGS__); } while (0)
+
+#define PMU_PA                  0x15460000ULL
+#define PMU_SIZE                0x4000ULL
+#define PMU_G3D_CONFIG          0x1a80u
+#define PMU_G3D_STATUS          0x1a84u
+#define PMU_EMB_G3D_CONFIG      0x1c80u
+#define PMU_EMB_G3D_STATUS      0x1c84u
+#define PMU_PWR_ON              0x1u
+
+#define G3D_NEED_SMC            0x1EE10204u
+#define SMC_CMD_PREPARE_PD_ONOFF 0x82000410u
+#define EXYNOS_WAKEUP_PD_DOWN   1u
+#define RUNTIME_PM_TZPC_GROUP   2u
+
+#define GPU_PA                  0x1F000000ULL
+#define GPU_SIZE                0x1000ULL
+
+static inline uint32_t
+rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr32(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static int64_t
+husky_smc4(uint64_t fid, uint64_t a1, uint64_t a2, uint64_t a3)
+{
+	register uint64_t x0 __asm__("x0") = fid;
+	register uint64_t x1 __asm__("x1") = a1;
+	register uint64_t x2 __asm__("x2") = a2;
+	register uint64_t x3 __asm__("x3") = a3;
+	__asm__ volatile ("smc #0" : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3) : :
+	    "x4", "x5", "x6", "x7", "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+	    "x16", "x17", "memory");
+	return (int64_t)x0;
+}
+
+static void
+husky_gpu_dump(void)
+{
+	static const struct {
+		uint32_t off;
+		const char *name;
+	} regs[] = {
+		{0x000, "GPU_ID"}, {0x004, "L2_FEATURES"}, {0x008, "CORE_FEATURES"},
+		{0x00c, "TILER_FEATURES"}, {0x010, "MEM_FEATURES"}, {0x014, "MMU_FEATURES"},
+		{0x018, "AS_PRESENT"}, {0x01c, "CSF_ID"}, {0x034, "GPU_STATUS"},
+		{0x100, "SHADER_PRESENT_LO"}, {0x104, "SHADER_PRESENT_HI"},
+		{0x110, "TILER_PRESENT_LO"}, {0x120, "L2_PRESENT_LO"},
+	};
+	HU_LOG("HUSKY GPU: mapping registers at 0x%llx\n", GPU_PA);
+	vm_offset_t gpu = ml_io_map(GPU_PA, GPU_SIZE);
+	if (!gpu) {
+		HU_LOG("HUSKY GPU: map failed\n");
+		return;
+	}
+	HU_LOG("HUSKY GPU: reading GPU_ID\n");
+	for (unsigned i = 0; i < sizeof(regs) / sizeof(regs[0]); i++) {
+		HU_LOG("HUSKY GPU: %s = 0x%08x\n", regs[i].name, rd32(gpu, regs[i].off));
+	}
+	uint32_t id = rd32(gpu, 0x000);
+	HU_LOG("HUSKY GPU: arch %u.%u rev r%up%u product 0x%x\n", (id >> 28) & 0xf, (id >> 24) & 0xf,
+	    (id >> 12) & 0xf, (id >> 4) & 0xf, (id >> 16) & 0xff);
+}
+
+void
+husky_gpu_probe(void)
+{
+	uint32_t mode = 0;
+
+	if (!PE_parse_boot_argn("huskygpu", &mode, sizeof(mode)) || mode == 0) {
+		return;
+	}
+	HU_LOG("HUSKY GPU: probe mode %u\n", mode);
+	vm_offset_t pmu = ml_io_map(PMU_PA, PMU_SIZE);
+	if (!pmu) {
+		HU_LOG("HUSKY GPU: PMU map failed\n");
+		return;
+	}
+	uint32_t top_cfg = rd32(pmu, PMU_G3D_CONFIG), top_st = rd32(pmu, PMU_G3D_STATUS);
+	uint32_t emb_cfg = rd32(pmu, PMU_EMB_G3D_CONFIG), emb_st = rd32(pmu, PMU_EMB_G3D_STATUS);
+	HU_LOG("HUSKY GPU: pd_g3d CFG 0x%x STATUS 0x%x, pd_embedded_g3d CFG 0x%x STATUS 0x%x\n",
+	    top_cfg, top_st, emb_cfg, emb_st);
+
+	if (!(top_st & PMU_PWR_ON)) {
+		if (mode < 2) {
+			HU_LOG("HUSKY GPU: top domain off; huskygpu=2 powers it on\n");
+			return;
+		}
+		HU_LOG("HUSKY GPU: powering on pd_g3d\n");
+		wr32(pmu, PMU_G3D_CONFIG, rd32(pmu, PMU_G3D_CONFIG) | PMU_PWR_ON);
+		unsigned us;
+		for (us = 0; us < 10000 && !(rd32(pmu, PMU_G3D_STATUS) & PMU_PWR_ON); us += 10) {
+			delay(10);
+		}
+		top_st = rd32(pmu, PMU_G3D_STATUS);
+		HU_LOG("HUSKY GPU: pd_g3d STATUS 0x%x after %u us\n", top_st, us);
+		if (!(top_st & PMU_PWR_ON)) {
+			HU_LOG("HUSKY GPU: pd_g3d did not come up; stopping\n");
+			return;
+		}
+		HU_LOG("HUSKY GPU: TZPC restore SMC (0x%x)\n", G3D_NEED_SMC);
+		int64_t rc = husky_smc4(SMC_CMD_PREPARE_PD_ONOFF, EXYNOS_WAKEUP_PD_DOWN, G3D_NEED_SMC,
+		    RUNTIME_PM_TZPC_GROUP);
+		HU_LOG("HUSKY GPU: TZPC restore rc %lld\n", (long long)rc);
+		if (rc != 0) {
+			HU_LOG("HUSKY GPU: TZPC restore failed; not touching the block\n");
+			return;
+		}
+	}
+	husky_gpu_dump();
+}
+
+#endif /* ARM64_BOARD_CONFIG_HUSKY */

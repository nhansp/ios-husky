diff --git a/libkern/crypto/corecrypto_md5.c b/libkern/crypto/corecrypto_md5.c
index 242dcdb..9e55a25 100644
--- a/libkern/crypto/corecrypto_md5.c
+++ b/libkern/crypto/corecrypto_md5.c
@@ -16,6 +16,63 @@ setCount(MD5_CTX *ctx, uint64_t count)
 	ctx->count[1] = (uint32_t)count;
 }
 
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+/*
+ * The HUSKY bring-up crypto table (register_crypto.c) has no ccmd5_di. MD5
+ * uses BearSSL's portable implementation (libkern/crypto/husky_md5.c), with
+ * MD5_CTX carrying exactly its state: chaining value, byte count and the
+ * partial block, converted around each call like the corecrypto path does
+ * (ported from ios-sweet 0027). HFS needs it for volume UUIDs.
+ */
+#include "bearssl_hash.h"
+
+static void
+MD5ToBr(MD5_CTX *md5_ctx, br_md5_context *br_ctx)
+{
+	br_md5_init(br_ctx);
+	memcpy(br_ctx->val, md5_ctx->state, sizeof(br_ctx->val));
+	br_ctx->count = getCount(md5_ctx);
+	memcpy(br_ctx->buf, md5_ctx->buffer, sizeof(br_ctx->buf));
+}
+
+static void
+BrToMD5(const br_md5_context *br_ctx, MD5_CTX *md5_ctx)
+{
+	memcpy(md5_ctx->state, br_ctx->val, sizeof(md5_ctx->state));
+	setCount(md5_ctx, br_ctx->count);
+	memcpy(md5_ctx->buffer, br_ctx->buf, sizeof(md5_ctx->buffer));
+}
+
+void
+MD5Init(MD5_CTX *ctx)
+{
+	br_md5_context br_ctx;
+
+	br_md5_init(&br_ctx);
+	BrToMD5(&br_ctx, ctx);
+}
+
+void
+MD5Update(MD5_CTX *ctx, const void *data, unsigned int len)
+{
+	br_md5_context br_ctx;
+
+	MD5ToBr(ctx, &br_ctx);
+	br_md5_update(&br_ctx, data, len);
+	BrToMD5(&br_ctx, ctx);
+}
+
+void
+MD5Final(unsigned char digest[MD5_DIGEST_LENGTH], MD5_CTX *ctx)
+{
+	br_md5_context br_ctx;
+
+	MD5ToBr(ctx, &br_ctx);
+	br_md5_out(&br_ctx, digest);
+}
+
+#else /* !ARM64_BOARD_CONFIG_HUSKY */
+
 /* Copy a ccdigest ctx into a legacy MD5 context */
 static void
 DiToMD5(const struct ccdigest_info *di, struct ccdigest_ctx *di_ctx, MD5_CTX *md5_ctx)
@@ -68,3 +125,5 @@ MD5Final(unsigned char digest[MD5_DIGEST_LENGTH], MD5_CTX *ctx)
 	MD5ToDi(di, ctx, di_ctx);
 	ccdigest_final(di, di_ctx, digest);
 }
+
+#endif /* !ARM64_BOARD_CONFIG_HUSKY */
diff --git a/libkern/crypto/corecrypto_sha1.c b/libkern/crypto/corecrypto_sha1.c
index 5fd982b..05130f8 100644
--- a/libkern/crypto/corecrypto_sha1.c
+++ b/libkern/crypto/corecrypto_sha1.c
@@ -16,6 +16,63 @@ setCount(SHA1_CTX *ctx, uint64_t count)
 	ctx->c.b64[0] = count;
 }
 
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+/*
+ * The HUSKY bring-up crypto table (register_crypto.c) has no ccsha1_di.
+ * SHA-1 uses BearSSL's portable implementation (libkern/crypto/husky_sha1.c),
+ * with SHA1_CTX carrying exactly its state: chaining value, byte count and
+ * the partial block, converted around each call like the corecrypto path
+ * does (ported from ios-sweet 0032).
+ */
+#include "bearssl_hash.h"
+
+static void
+SHA1ToBr(SHA1_CTX *sha1_ctx, br_sha1_context *br_ctx)
+{
+	br_sha1_init(br_ctx);
+	memcpy(br_ctx->val, sha1_ctx->h.b32, sizeof(br_ctx->val));
+	br_ctx->count = getCount(sha1_ctx);
+	memcpy(br_ctx->buf, sha1_ctx->m.b8, sizeof(br_ctx->buf));
+}
+
+static void
+BrToSHA1(const br_sha1_context *br_ctx, SHA1_CTX *sha1_ctx)
+{
+	memcpy(sha1_ctx->h.b32, br_ctx->val, sizeof(sha1_ctx->h.b32));
+	setCount(sha1_ctx, br_ctx->count);
+	memcpy(sha1_ctx->m.b8, br_ctx->buf, sizeof(sha1_ctx->m.b8));
+}
+
+void
+SHA1Init(SHA1_CTX *ctx)
+{
+	br_sha1_context br_ctx;
+
+	br_sha1_init(&br_ctx);
+	BrToSHA1(&br_ctx, ctx);
+}
+
+void
+SHA1Update(SHA1_CTX *ctx, const void *data, size_t len)
+{
+	br_sha1_context br_ctx;
+
+	SHA1ToBr(ctx, &br_ctx);
+	br_sha1_update(&br_ctx, data, len);
+	BrToSHA1(&br_ctx, ctx);
+}
+
+void
+SHA1Final(void *digest, SHA1_CTX *ctx)
+{
+	br_sha1_context br_ctx;
+
+	SHA1ToBr(ctx, &br_ctx);
+	br_sha1_out(&br_ctx, digest);
+}
+
+#else /* !ARM64_BOARD_CONFIG_HUSKY */
+
 /* Copy a ccdigest ctx into a legacy SHA1 context */
 static void
 DiToSHA1(const struct ccdigest_info *di, struct ccdigest_ctx *di_ctx, SHA1_CTX *sha1_ctx)
@@ -69,6 +126,8 @@ SHA1Final(void *digest, SHA1_CTX *ctx)
 	ccdigest_final(di, di_ctx, digest);
 }
 
+#endif /* !ARM64_BOARD_CONFIG_HUSKY */
+
 /* This is not publicised in header, but exported in libkern.exports */
 void SHA1Final_r(SHA1_CTX *context, void *digest);
 void

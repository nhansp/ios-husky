diff --git a/libkern/conf/Makefile.template b/libkern/conf/Makefile.template
index b6ea01d..bb13649 100644
--- a/libkern/conf/Makefile.template
+++ b/libkern/conf/Makefile.template
@@ -35,6 +35,11 @@ husky_aes_ct_enc.o_CFLAGS_ADD += -mgeneral-regs-only
 husky_aes_ct_dec.o_CFLAGS_ADD += -mgeneral-regs-only
 husky_aes_ct_cbcenc.o_CFLAGS_ADD += -mgeneral-regs-only
 husky_aes_ct_cbcdec.o_CFLAGS_ADD += -mgeneral-regs-only
+# BearSSL MD5 and SHA-1 behind the legacy MD5*/SHA1* APIs (corecrypto_md5.c,
+# corecrypto_sha1.c); the HUSKY table has no ccmd5_di/ccsha1_di.
+HUSKY_HASH_OBJS = husky_md5.o husky_dec32le.o husky_enc32le.o husky_sha1.o husky_dec32be.o husky_enc32be.o corecrypto_md5.o corecrypto_sha1.o
+$(foreach o,$(HUSKY_HASH_OBJS),$(eval $(o)_INCFLAGS = $(HUSKY_AES_INC)))
+$(foreach o,$(HUSKY_HASH_OBJS),$(eval $(o)_CFLAGS_ADD += -mgeneral-regs-only))
 endif
 

diff --git a/iokit/Families/IOGPU/husky_mali_backend_bridge.c b/iokit/Families/IOGPU/husky_mali_backend_bridge.c
index 824c5d3..5a7d7fb 100644
--- a/iokit/Families/IOGPU/husky_mali_backend_bridge.c
+++ b/iokit/Families/IOGPU/husky_mali_backend_bridge.c
@@ -119,6 +119,9 @@ bridge_flush_on(void)
 #define GPU_MAP_SIZE            0x101000ULL         /* up to doorbell 8 [husky_gpu.c GPU_MAP_SIZE] */
 
 #define AS0                     0x2400u             /* [husky_gpu.c:188] */
+#define GPU_COMMAND_REG         0x30u               /* kbase GPU_CONTROL__GPU_COMMAND */
+#define GPU_COMMAND_CYCLE_COUNT_START 0x103u        /* GPU_COMMAND_CODE_TIME | TIME_ENABLE << 8 */
+#define GPU_CYCLE_COUNT         0x90u               /* kbase GPU_CONTROL__CYCLE_COUNT, 64-bit */
 #define AS_TRANSTAB             0x00u               /* [husky_gpu.c:189] */
 #define AS_MEMATTR              0x08u               /* [husky_gpu.c:190] */
 #define AS_LOCKADDR             0x10u               /* kbase AS_LOCKADDR_LO/HI */
@@ -1910,6 +1913,26 @@ const mali_backend_ops_t mali_backend_ops = {
 	.tiler_heap_destroy = op_tiler_heap_destroy,
 };
 
+/* GPU_COMMAND TIME ENABLE (kbase GPU_COMMAND_CYCLE_COUNT_START), then the 64-bit CYCLE_COUNT. */
+uint64_t
+husky_gpu_cycles(void)
+{
+	static bool counting;
+	if (husky_gpu_get_regs() == 0) {
+		return 0;
+	}
+	if (!counting) {
+		counting = true;
+		gwr(GPU_COMMAND_REG, GPU_COMMAND_CYCLE_COUNT_START);
+	}
+	uint32_t hi, lo;
+	do {
+		hi = grd(GPU_CYCLE_COUNT + 4);
+		lo = grd(GPU_CYCLE_COUNT);
+	} while (grd(GPU_CYCLE_COUNT + 4) != hi);
+	return ((uint64_t)hi << 32) | lo;
+}
+
 int
 husky_mali_backend_init(void)
 {

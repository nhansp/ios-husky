diff --git a/osfmk/kern/static_if_common.c b/osfmk/kern/static_if_common.c
index bcaa4c4..967dc08 100644
--- a/osfmk/kern/static_if_common.c
+++ b/osfmk/kern/static_if_common.c
@@ -30,6 +30,7 @@
 #include <kern/locks.h>
 #include <kern/startup.h>
 #include <machine/static_if.h>
+#include <ptrauth.h>
 #include <machine/machine_routines.h>
 
 
@@ -269,9 +270,28 @@ static_if_init(const char *args)
 	husky_vp_bc("  sif: chain loop done\n");
 #endif
 
+#if defined(HUSKY)
+	/* bootK (DP11 bootloader): the last crumb on every boot was "chain loop done" */
+	extern void husky_vp_hex(const char *label, uint64_t v);
+	uint64_t ia_lo, ia_hi, sctlr;
+	__asm__ volatile ("mrs %0, S3_0_c2_c1_0; mrs %1, S3_0_c2_c1_1; mrs %2, sctlr_el1"
+	    : "=r" (ia_lo), "=r" (ia_hi), "=r" (sctlr));
+	husky_vp_hex("  sif apiakey lo", ia_lo);
+	husky_vp_hex("  sif apiakey hi", ia_hi);
+	husky_vp_hex("  sif sctlr_el1", sctlr);
+	husky_vp_hex("  sif n", (uint64_t)(__static_if_initializer_entries_end - __static_if_initializer_entries));
+#endif
 	for (static_if_initializer *f = __static_if_initializer_entries;
 	    f < __static_if_initializer_entries_end; f++) {
+#if defined(HUSKY)
+		husky_vp_hex("  sif slot", (uint64_t)f);
+		husky_vp_hex("  sif raw", *(volatile uint64_t *)f);
+		husky_vp_hex("  sif fn", (uint64_t)ptrauth_strip(*f, ptrauth_key_function_pointer));
+#endif
 		(*f)(args);
+#if defined(HUSKY)
+		husky_vp_bc("  sif: returned\n");
+#endif
 	}
 #if defined(HUSKY)
 	husky_vp_bc("  sif: initializers done\n");

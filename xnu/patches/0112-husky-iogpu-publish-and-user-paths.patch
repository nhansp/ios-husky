 {
+	if (bo != NULL && __atomic_load_n(&g_csg_wedged, __ATOMIC_ACQUIRE)) {
+		/* a wedged group may still DMA into it: keep the pages (and the alias), drop the handle */
+		BR_LOG("HUSKY IOGPU bridge: bo_free: GPU group wedged, leaking %llu bytes\n",
+		    (unsigned long long)bo->size);
+		kfree_data(bo, sizeof(mali_bo_t));
+		return;
+	}

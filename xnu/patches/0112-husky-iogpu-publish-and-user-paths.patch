+/*
+ * Set when a CSG terminate was never acked: the group may still DMA into its buffers, so nothing
+ * it could touch goes back to the allocator (CSG1 stays reserved; recovery is a GPU reset, later).
+ */
+static uint32_t g_csg_wedged;
+
 static void

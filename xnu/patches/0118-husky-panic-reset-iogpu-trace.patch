+/* boot-arg huskygputrace=1: every selector and trap into pmsg, written synchronously by kprintf */
+static bool
+iogpu_trace_on(void)
+{
+	static int on = -1;
+	if (on < 0) {
+		uint32_t v = 0;
+		on = PE_parse_boot_argn("huskygputrace", &v, sizeof(v)) && v;

 /*
  * Restart and halt (XNU's reboot path, after processes exit and the volumes
  * are unmounted): last console-log flush, then PSCI SYSTEM_RESET to BL31 and
- * ABL boots Android. Panic restarts are left alone: the watchdog resets the
- * phone and pmsg survives, as before.
+ * ABL boots Android. Panic restarts (debug=0x100000) reset the same way,
+ * without the UFS flush (no I/O from panic context): after a watchdog reset
+ * ABL often drops pram, and the panic text in pmsg with it.
  */
 extern "C" void husky_log_final_flush(void);
 
 static int
 husky_halt_restart(unsigned int type)
 {
-	if (type != kPERestartCPU && type != kPEHaltCPU) {
+	if (type != kPERestartCPU && type != kPEHaltCPU && type != kPEPanicRestartCPU) {
 		return -1;
 	}
 	kprintf("HUSKY: PSCI SYSTEM_RESET (halt/restart type %u)\n", type);
-	husky_log_final_flush();
+	if (type != kPEPanicRestartCPU) {
+		husky_log_final_flush();
+	}
 	register uint64_t x0 __asm__("x0") = 0x84000009ULL;   /* SYSTEM_RESET */
 	__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
 	kprintf("HUSKY: PSCI SYSTEM_RESET returned %lld\n", (long long)x0);

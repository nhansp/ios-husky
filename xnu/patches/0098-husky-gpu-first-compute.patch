+/*
+ * First shader job (huskygpu=4): after the store job, append a compute dispatch to the same ring.
+ * husky_gpu_compute.h (generated on the host by tools/gpu/gen-husky-compute.cpp with Mesa's genxml
+ * packers and cs_builder) holds the job page (FAU, the hand-written mul_add Valhall shader, TSD,
+ * SPD) and the CS words: REQ_RESOURCE compute, the compute staging registers (SRT r0, FAU r8,
+ * SPD r16, TSD r24, WG_SIZE r33, JOB_SIZE r37-r39), RUN_COMPUTE, WAIT, FLUSH_CACHE2, WAIT. The
+ * shader computes out[i] = in[i] * MUL + ADD; the CPU checks every element. The shader cores'
+ * domain (pd_embedded_g3d) is already on from ABL, and CSF firmware powers the cores themselves
+ * from the endpoint request, so a timeout here, with no MMU fault, points at core power (R1).
+ */
+_Static_assert(HUSKY_COMP_JOB_VA == TEST_VA + COMP_JOB, "compute job page");
+_Static_assert(HUSKY_COMP_IN_VA == TEST_VA + COMP_IN, "compute in[]");
+_Static_assert(HUSKY_COMP_OUT_VA == TEST_VA + COMP_OUT, "compute out[]");
+_Static_assert(HUSKY_COMP_JOB_BYTES <= GPU_PAGE, "compute job fits its page");
+_Static_assert(HUSKY_COMP_THREADS * 4 <= GPU_PAGE, "compute buffers fit a page");
+
+static void
+husky_gpu_compute_job(vm_offset_t t, vm_offset_t csout, vm_offset_t csgout, unsigned ring_used,
+    unsigned ra, unsigned rv, uint32_t waitall)
+{
+	for (unsigned i = 0; i < HUSKY_COMP_JOB_BYTES; i++) {
+		*(volatile uint8_t *)(t + COMP_JOB + i) = husky_comp_job[i];
+	}
+	for (unsigned i = 0; i < HUSKY_COMP_THREADS; i++) {
+		*(volatile uint32_t *)(t + COMP_IN + 4 * i) = 0x1000u + i * 0x11u;
+		*(volatile uint32_t *)(t + COMP_OUT + 4 * i) = 0xdeadbeefu;
+	}
+
+	unsigned n = sizeof(husky_comp_cs) / sizeof(husky_comp_cs[0]);
+	const uint64_t tail[] = {
+		CS_MOVE48(ra, TEST_VA + TEST_DATA),
+		CS_STORE_STATE_TS(ra, 16),              /* end timestamp next to the store job's */
+		CS_WAIT(waitall),
+		CS_MOVE48(ra, TEST_VA + TEST_SYNC),
+		CS_MOVE48(rv, 1),
+		CS_SYNC_ADD64(ra, rv),                  /* sync 1 -> 2 */
+		CS_ERROR_BARRIER,
+	};
+	unsigned m = sizeof(tail) / sizeof(tail[0]);
+	unsigned total = (n + m + 7) & ~7u;
+	if ((ring_used + total) * 8 > TEST_RING_SIZE) {
+		HU_LOG("HUSKY GPU: compute job does not fit the ring\n");
+		return;
+	}
+	for (unsigned i = 0; i < total; i++) {
+		uint64_t w = i < n ? husky_comp_cs[i] : i < n + m ? tail[i - n] : 0;
+		*(volatile uint64_t *)(t + TEST_RING + 8 * (ring_used + i)) = w;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+	wr64(t, TEST_RING_IN, 8 * (ring_used + total));
+	__asm__ volatile ("dsb sy" ::: "memory");
+	HU_LOG("HUSKY GPU: compute job: %u CS + %u tail instructions at ring +0x%x, %u threads, shader at 0x%x\n",
+	    n, m, 8 * ring_used, HUSKY_COMP_THREADS, HUSKY_COMP_JOB_VA + HUSKY_COMP_CODE_OFF);
+	gwr(DOORBELL(CS_DOORBELL_ID), 1);
+
+	unsigned us;
+	for (us = 0; us < 500000; us += 10) {
+		if (rd64(t, TEST_SYNC) == 2) {
+			break;
+		}
+		delay(10);
+	}
+	unsigned bad = 0, first_bad = ~0u;
+	for (unsigned i = 0; i < HUSKY_COMP_THREADS; i++) {
+		uint32_t want = (0x1000u + i * 0x11u) * HUSKY_COMP_MUL + HUSKY_COMP_ADD;
+		if (rd32(t, COMP_OUT + 4 * i) != want) {
+			if (bad++ == 0) {
+				first_bad = i;
+			}
+		}
+	}
+	HU_LOG("HUSKY GPU: COMPUTE JOB %s after %u us: sync %llu, %u/%u results correct "
+	    "(out[0] 0x%x out[255] 0x%x), ticks %llu\n", us < 500000 ? "COMPLETED" : "did not complete", us,
+	    rd64(t, TEST_SYNC), HUSKY_COMP_THREADS - bad, HUSKY_COMP_THREADS, rd32(t, COMP_OUT),
+	    rd32(t, COMP_OUT + 4 * (HUSKY_COMP_THREADS - 1)), rd64(t, TEST_DATA + 16) - rd64(t, TEST_DATA + 8));
+	if (bad != 0 && first_bad != ~0u) {
+		HU_LOG("HUSKY GPU: first wrong element %u: 0x%x (want 0x%x)\n", first_bad,
+		    rd32(t, COMP_OUT + 4 * first_bad),
+		    (0x1000u + first_bad * 0x11u) * HUSKY_COMP_MUL + HUSKY_COMP_ADD);
+	}
+	cs_state_dump("after the compute job", csout, csgout, t);
+	if (us >= 500000 || bad != 0) {
+		gpu_fault_dump("compute job");
+	}
+}

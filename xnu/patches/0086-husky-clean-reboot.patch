+/* Last flush before a clean restart (HuskyPlatformExpert's restart hook). */
+void husky_log_final_flush(void);
+
+void
+husky_log_final_flush(void)
+{
+	if (husky_log_running) {
+		(void)husky_log_flush();
+	}
+}
+
+/*
+ * Boot-arg huskyreboot=N: after N seconds, a clean reboot through XNU's own
+ * path (processes exit, disks sync, every volume including the root is
+ * unmounted, so the HFS+ journal is empty), then HuskyPlatformExpert resets
+ * the SoC with PSCI SYSTEM_RESET and ABL starts Android. No force-reboot.
+ */
+static void
+husky_reboot_thread(void *arg, __unused wait_result_t wr)
+{
+	uint32_t secs = (uint32_t)(uintptr_t)arg;
+
+	(void)tsleep(&husky_log_chan, PZERO, "huskyreboot", hz * (int)secs);
+	HU_LOG("HUSKY REBOOT: clean reboot after %u s (huskyreboot)\n", secs);
+	(void)reboot_kernel(RB_AUTOBOOT, NULL);
+	HU_LOG("HUSKY REBOOT: reboot_kernel returned\n");
+}
+
+static void
+husky_reboot_start(void)
+{
+	uint32_t secs = 0;
+	thread_t thread;
+
+	if (!PE_parse_boot_argn("huskyreboot", &secs, sizeof(secs)) || secs == 0) {
+		return;
+	}
+	HU_LOG("HUSKY REBOOT: clean reboot scheduled in %u s\n", secs);
+	if (kernel_thread_start(husky_reboot_thread, (void *)(uintptr_t)secs, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
 	}
 }
 

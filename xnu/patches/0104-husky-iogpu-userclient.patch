+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/husky_iogpu_selftest.h
+ */
+#ifndef _HUSKY_IOGPU_SELFTEST_H
+#define _HUSKY_IOGPU_SELFTEST_H
+
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * husky_iogpu_selftest - Drives the user-client ABI end-to-end from kernel context.
+ *
+ * Gated by boot-arg huskygpu=6. Exercises:
+ *   [1/7] Open device user-client (IOGPUDeviceUserClient / MaliAccelerator)
+ *   [2/7] Selector 2 (GET_STAMP_CONFIG / "create device")
+ *   [3/7] Selector 12 (CREATE_DEVICE_SHMEM) + Selector 8 (NEW_RESOURCE with BO-flags tail)
+ *   [4/7] Selector 6 (NEW_COMMAND_QUEUE)
+ *   [5/7] Trap 0 (SUBMIT_ONE) submitting compute job (out[i]=in[i]*3+7)
+ *   [6/7] Poll sync object / stamp completion
+ *   [7/7] Verify all 256 results (out[i] == in[i]*3+7)
+ *
+ * Returns true if all steps pass.
+ */
+bool husky_iogpu_selftest(void);
+
+#ifdef __cplusplus
+}

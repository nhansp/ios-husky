+	*targetP = this;
+	return &fTraps[index];
+}
+
+/*
+ * Trap 0: SUBMIT_ONE [spec 01 line 254; claim A4-trap-table]
+ * p1 = queueId, p2 = argSize (must be <= 0x40 and == cmdBufArgsSize),
+ * p3 = user ptr to args, p4 = user ptr to u32 status out.
+ */
+IOReturn
+IOGPUDeviceUserClient::trapSubmitOne(void *p1, void *p2, void *p3, void *p4, void *, void *)
+{
+	if (!fStarted || fDevice == NULL) {
+		return kIOGPUReturnNotAttached;
+	}
+
+	uint32_t qId = (uint32_t)(uintptr_t)p1;
+	uint32_t argSize = (uint32_t)(uintptr_t)p2;
+
+	/* Validate argSize <= 0x40 AND argSize == cmdBufArgsSize (0x30) [fixes REVIEWS.md:85] */
+	if (argSize > IOGPU_TRAP0_MAX_ARG_SIZE || argSize != ACC()->config()->cmdBufArgsSize || p3 == NULL) {
+		return kIOGPUReturnBadArgument;
+	}
+
+	IOGPUCommandQueue *q = fDevice->lookupQueue(qId);
+	if (q == NULL) {
+		return kIOGPUReturnBadArgument;
+	}
+
+	uint8_t argsBuf[IOGPU_TRAP0_MAX_ARG_SIZE];
+	/* Support both userland Mach trap callers and in-kernel self-test callers */
+	if ((uintptr_t)p3 >= 0x800000000000ULL) {
+		bcopy(p3, argsBuf, argSize);
+	} else if (copyin(p3, argsBuf, argSize) != 0) {
+		return kIOGPUReturnBadArgument;
+	}
+
+	uint32_t status = 0;
+	IOReturn ret = q->submitCommandBuffers(argsBuf, 1, argSize, &status);
+	q->release();
+
+	if (p4 != NULL) {
+		if ((uintptr_t)p4 >= 0x800000000000ULL) {
+			*(uint32_t *)p4 = status;
+		} else {
+			copyout(&status, p4, sizeof(uint32_t));
+		}
+	}
+	return ret;
+}
+
+/* Trap 1: RELEASE_RESOURCE [spec 01 line 255] */
+IOReturn
+IOGPUDeviceUserClient::trapReleaseResource(void *p1, void *, void *, void *, void *, void *)
+{
+	if (!fStarted || fDevice == NULL) {
+		return kIOGPUReturnNotAttached;
+	}
+	uint32_t id = (uint32_t)(uintptr_t)p1;
+	IOGPUResource *r = fDevice->lookupResource(id);
+	if (r == NULL) {
+		return kIOGPUReturnBadArgument;
+	}
+	r->release();
+	fDevice->removeResource(id);
+	return kIOGPUReturnSuccess;
+}
+
+/* Trap 2: RESOURCE_FINISH_EVENT [spec 01 line 256] */
+IOReturn
+IOGPUDeviceUserClient::trapResourceFinishEvent(void *p1, void *p2, void *, void *, void *, void *)
+{
+	if (!fStarted || fDevice == NULL) {
+		return kIOGPUReturnNotAttached;
+	}
+	uint32_t id   = (uint32_t)(uintptr_t)p1;
+	uint32_t slot = (uint32_t)(uintptr_t)p2;
+	if (slot > 1) {
+		return kIOGPUReturnBadArgument;
+	}
+	IOGPUResource *r = fDevice->lookupResource(id);
+	if (r == NULL) {
+		return kIOGPUReturnBadArgument;
+	}
+	r->release();
+	return kIOGPUReturnSuccess;
+}
+
+/* Trap 3: SET_RESOURCE_PURGEABLE [spec 01 line 257; fixes REVIEWS.md:83] */
+IOReturn
+IOGPUDeviceUserClient::trapSetResourcePurgeable(void *p1, void *p2, void *p3, void *, void *, void *)
+{
+	if (!fStarted || fDevice == NULL) {
+		return kIOGPUReturnNotAttached;
+	}
+	uint32_t id    = (uint32_t)(uintptr_t)p1;
+	uint32_t state = (uint32_t)(uintptr_t)p2;
+	if (state < 1 || state > 6 || p3 == NULL) {
+		return kIOGPUReturnBadArgument;
+	}
+	IOGPUResource *r = fDevice->lookupResource(id);
+	if (r == NULL) {
+		return kIOGPUReturnBadArgument;
+	}
+	r->release();
+	uint64_t oldState = 1;   /* 1 = non-volatile (spec 01 line 529) */
+	copyout(&oldState, p3, sizeof(uint64_t));
+	return kIOGPUReturnSuccess;
+}
+
+/* Trap 4: GROUP_ADD [spec 01 line 258] */
+IOReturn
+IOGPUDeviceUserClient::trapGroupAdd(void *p1, void *p2, void *p3, void *, void *, void *)
+{
+	if (!fStarted || fDevice == NULL) {
+		return kIOGPUReturnNotAttached;
+	}
+	uint32_t groupId = (uint32_t)(uintptr_t)p1;
+	uint32_t count   = (uint32_t)(uintptr_t)p2;
+	if (count > 0x100) {
+		return kIOGPUReturnBadArgument;
+	}
+	IOGPUResource *g = fDevice->lookupResource(groupId);
+	if (g == NULL) {
+		return kIOGPUReturnBadArgument;
+	}
+	IOReturn ret;
+	if (count == 1) {
+		uint32_t singleId = (uint32_t)(uintptr_t)p3;
+		ret = g->groupAdd(&singleId, 1);
+	} else {
+		uint32_t stackBuf[0x100];
+		if (copyin(p3, stackBuf, count * sizeof(uint32_t)) != 0) {
+			g->release();
+			return kIOGPUReturnBadArgument;
+		}
+		ret = g->groupAdd(stackBuf, count);
+	}
+	g->release();
+	return ret;
+}
+
+/* Trap 5: GROUP_REMOVE [spec 01 line 259] */
+IOReturn
+IOGPUDeviceUserClient::trapGroupRemove(void *p1, void *p2, void *p3, void *p4, void *, void *)
+{
+	if (!fStarted || fDevice == NULL) {
+		return kIOGPUReturnNotAttached;
+	}
+	uint32_t groupId = (uint32_t)(uintptr_t)p1;
+	uint32_t count   = (uint32_t)(uintptr_t)p2;
+	if (count > 0x100) {
+		return kIOGPUReturnBadArgument;
+	}
+	IOGPUResource *g = fDevice->lookupResource(groupId);
+	if (g == NULL) {
+		return kIOGPUReturnBadArgument;
+	}
+	IOReturn ret;
+	if (count == 1) {
+		uint64_t key = (uint64_t)(uintptr_t)p3 | ((uint64_t)(uintptr_t)p4 << 32);
+		ret = g->groupRemove(&key, 1);
+	} else {
+		uint64_t stackBuf[0x100];
+		if (copyin(p3, stackBuf, count * sizeof(uint64_t)) != 0) {
+			g->release();
+			return kIOGPUReturnBadArgument;
+		}
+		ret = g->groupRemove(stackBuf, count);
+	}
+	g->release();
+	return ret;
+}
+
+/* Trap 6: GROUP_UPDATE [spec 01 line 260] */
+IOReturn
+IOGPUDeviceUserClient::trapGroupUpdate(void *p1, void *p2, void *p3, void *p4, void *p5, void *p6)
+{
+	/* Remove first, then add */
+	IOReturn r1 = trapGroupRemove(p1, p4, p5, p6, NULL, NULL);
+	if (r1 != kIOGPUReturnSuccess) {
+		return r1;
+	}
+	return trapGroupAdd(p1, p2, p3, NULL, NULL, NULL);
+}
+
+/* Trap 7: QUEUE_SET_RESOURCE_GROUPS [spec 01 line 261] */
+IOReturn
+IOGPUDeviceUserClient::trapQueueSetResourceGroups(void *p1, void *p2, void *p3, void *, void *, void *)
+{
+	if (!fStarted || fDevice == NULL) {
+		return kIOGPUReturnNotAttached;
+	}
+	uint32_t qId   = (uint32_t)(uintptr_t)p1;
+	uint32_t count = (uint32_t)(uintptr_t)p2;
+	if (count > IOGPU_KCMD_MAX_GROUPS) {
+		return kIOGPUReturnBadArgument;
+	}
+	IOGPUCommandQueue *q = fDevice->lookupQueue(qId);
+	if (q == NULL) {
+		return kIOGPUReturnBadArgument;
+	}
+	q->release();
+	return kIOGPUReturnSuccess;
+}
+
+/* Trap 8: SET_DISPLAY_PARAMS [spec 01 line 262] */
+IOReturn
+IOGPUDeviceUserClient::trapSetDisplayParams(void *, void *, void *, void *, void *, void *)
+{
+	return kIOGPUReturnUnsupported;
+}
+
+/* Trap 9: QUEUE_SIGNAL_SHARED_EVENT [spec 01 line 263] */
+IOReturn
+IOGPUDeviceUserClient::trapQueueSignalSharedEvent(void *, void *, void *, void *, void *, void *)
+{
+	return kIOGPUReturnUnsupported;
+}
+
+/* Trap 10: QUEUE_WAIT_SHARED_EVENT [spec 01 line 264] */
+IOReturn
+IOGPUDeviceUserClient::trapQueueWaitSharedEvent(void *, void *, void *, void *, void *, void *)
+{
+	return kIOGPUReturnUnsupported;
+}
+
+/* Trap 11: QUEUE_SIGNAL_MTL_EVENT [spec 01 line 265] */
+IOReturn
+IOGPUDeviceUserClient::trapQueueSignalMTLEvent(void *, void *, void *, void *, void *, void *)
+{
+	return kIOGPUReturnUnsupported;
+}
+
+/* Trap 12: QUEUE_WAIT_MTL_EVENT [spec 01 line 266] */
+IOReturn
+IOGPUDeviceUserClient::trapQueueWaitMTLEvent(void *, void *, void *, void *, void *, void *)
+{
+	return kIOGPUReturnUnsupported;
+}
+
+/* Trap 13: QUEUE_SUPPORTS_BG_ROLE [spec 01 line 267; fixes REVIEWS.md:83] */
+IOReturn
+IOGPUDeviceUserClient::trapQueueSupportsBgRole(void *, void *, void *, void *, void *, void *)
+{
+	return kIOGPUReturnSuccess;   /* 0 = supported */
+}
+#endif /* ARM64_BOARD_CONFIG_HUSKY */
diff --git a/iokit/Families/IOGPU/IOGPUDeviceUserClient.h b/iokit/Families/IOGPU/IOGPUDeviceUserClient.h
new file mode 100644
index 0000000..edb986e
--- /dev/null
+++ b/iokit/Families/IOGPU/IOGPUDeviceUserClient.h
@@ -0,0 +1,84 @@
+/*
+ * IOGPUDeviceUserClient.h - The 56-selector / 14-trap IOGPU user client.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/IOGPUDeviceUserClient.h
+ *
+ * Implements the verified iOS 26.5 IOKit user-client ABI against Apple's
+ * IOGPUFamily 130.14 [spec 01 lines 17-20, 103-272; claims A1-sel-table, A4-trap-table]:
+ *   - 56 external-method selectors (dispatch table A) [spec 01 lines 184-241]
+ *   - 14 external traps (table A) [spec 01 lines 253-268]
+ *   - Port registration (registerNotificationPort, type 0) [spec 01 lines 392-398]
+ *   - Thread-safe trap table dispatch (no shared mutable trap slot) [fixes REVIEWS.md:85]
+ *   - Clean refcount accounting (no leaks in creators/destructors) [fixes REVIEWS.md:69]
+ *   - Strict bounds-checking on trap 0 (argSize <= 0x40 && argSize == cmdBufArgsSize)
+ *     [spec 01 lines 254, 543; fixes REVIEWS.md:85]
+ */
+#ifndef _IOGPU_DEVICE_USER_CLIENT_H
+#define _IOGPU_DEVICE_USER_CLIENT_H
+
+#include "iogpu_internal.h"
+
+class IOGPU;
+class IOGPUDevice;
+
+class IOGPUDeviceUserClient : public IOUserClient {
+	OSDeclareDefaultStructors(IOGPUDeviceUserClient);
+
+	IOGPU         *fAccel;
+	IOGPUDevice   *fDevice;
+	task_t         fTask;
+	bool           fStarted;          /* uc[0x100]&1 equivalent [spec 01 line 134] */
+	uint64_t       fClientId;         /* Process-unique client ID [spec 01 line 143] */
+
+	/* Stamp memory map in client task (options 0x04001001) [spec 01 line 139] */
+	IOMemoryMap   *fStampMap;
+	uint64_t       fStampUserBase;    /* Base user VA -> selector 2 stampBase */
+
+	/* 14 trap slots for getTargetAndTrapForIndex [spec 01 lines 249-271] */
+	IOExternalTrap fTraps[IOGPU_UC_NUM_TRAPS];
+
+public:
+	/* IOUserClient lifecycle */
+	virtual bool initWithTask(task_t owningTask, void *securityID, UInt32 type,
+	    OSDictionary *properties) APPLE_KEXT_OVERRIDE;
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual void free() APPLE_KEXT_OVERRIDE;
+
+	/* External method dispatch: table A (56 selectors) [spec 01 lines 176-246] */
+	virtual IOReturn externalMethod(uint32_t selector,
+	    IOExternalMethodArguments *args, IOExternalMethodDispatch *dispatch,
+	    OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+
+	/* Notification port registration [spec 01 lines 392-398] */
+	virtual IOReturn registerNotificationPort(mach_port_t port, UInt32 type,
+	    io_user_reference_t refCon) APPLE_KEXT_OVERRIDE;
+
+	/* External trap dispatch: table A (14 traps) [spec 01 lines 247-271] */
+	virtual IOExternalTrap *getTargetAndTrapForIndex(IOService **targetP,
+	    UInt32 index) APPLE_KEXT_OVERRIDE;
+
+	/* Trap member functions [spec 01 lines 253-268] */
+	IOReturn trapSubmitOne(void *p1, void *p2, void *p3, void *p4, void *p5, void *p6);
+	IOReturn trapReleaseResource(void *p1, void *p2, void *p3, void *p4, void *p5, void *p6);
+	IOReturn trapResourceFinishEvent(void *p1, void *p2, void *p3, void *p4, void *p5, void *p6);
+	IOReturn trapSetResourcePurgeable(void *p1, void *p2, void *p3, void *p4, void *p5, void *p6);
+	IOReturn trapGroupAdd(void *p1, void *p2, void *p3, void *p4, void *p5, void *p6);
+	IOReturn trapGroupRemove(void *p1, void *p2, void *p3, void *p4, void *p5, void *p6);
+	IOReturn trapGroupUpdate(void *p1, void *p2, void *p3, void *p4, void *p5, void *p6);
+	IOReturn trapQueueSetResourceGroups(void *p1, void *p2, void *p3, void *p4, void *p5, void *p6);
+	IOReturn trapSetDisplayParams(void *p1, void *p2, void *p3, void *p4, void *p5, void *p6);
+	IOReturn trapQueueSignalSharedEvent(void *p1, void *p2, void *p3, void *p4, void *p5, void *p6);
+	IOReturn trapQueueWaitSharedEvent(void *p1, void *p2, void *p3, void *p4, void *p5, void *p6);
+	IOReturn trapQueueSignalMTLEvent(void *p1, void *p2, void *p3, void *p4, void *p5, void *p6);
+	IOReturn trapQueueWaitMTLEvent(void *p1, void *p2, void *p3, void *p4, void *p5, void *p6);
+	IOReturn trapQueueSupportsBgRole(void *p1, void *p2, void *p3, void *p4, void *p5, void *p6);
+
+	/* Accessors */
+	IOGPU       *accel()         const { return fAccel; }
+	IOGPUDevice *device()        const { return fDevice; }
+	task_t       task()          const { return fTask; }
+	uint64_t     stampUserBase() const { return fStampUserBase; }
+};
+
+#endif /* _IOGPU_DEVICE_USER_CLIENT_H */
diff --git a/iokit/Families/IOGPU/IOGPUEventMachine.cpp b/iokit/Families/IOGPU/IOGPUEventMachine.cpp
new file mode 100644
index 0000000..f238835
--- /dev/null
+++ b/iokit/Families/IOGPU/IOGPUEventMachine.cpp
@@ -0,0 +1,91 @@
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+/*
+ * IOGPUEventMachine.cpp - Stamp counters and event evaluation implementation.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/IOGPUEventMachine.cpp
+ *
+ * Implements the event machine and stamp evaluation [spec 01 lines 650-660; spec 03 lines 152-156]:
+ *   - Evaluates stamp completion against the value<<8 counter format
+ *   - Provides zeroing of barrier records and barrier element insertions
+ */
+#include "IOGPUEventMachine.h"
+
+OSDefineMetaClassAndStructors(IOGPUEventMachine, OSObject);
+
+bool
+IOGPUEventMachine::init()
+{
+	return OSObject::init();
+}
+
+void
+IOGPUEventMachine::free()
+{
+	OSSafeReleaseNULL(fStampMemory);
+	OSObject::free();
+}
+
+void
+IOGPUEventMachine::setStampBaseMemory(IOMemoryDescriptor *md, uint32_t offset, uint32_t numStamps)
+{
+	OSSafeReleaseNULL(fStampMemory);
+	fStampMemory = md;
+	if (md != NULL) {
+		md->retain();
+	}
+
+	IOBufferMemoryDescriptor *bmd = OSDynamicCast(IOBufferMemoryDescriptor, md);
+	fStampBase = bmd ? (volatile uint32_t *)((uint8_t *)bmd->getBytesNoCopy() + offset) : NULL;
+	fNumStamps = numStamps ? numStamps : 1;
+}
+
+void
+IOGPUEventMachine::writeStamp(int stamp, void *rec, uint32_t value)
+{
+	uint32_t *r = (uint32_t *)rec;
+	r[0] = value;
+	r[1] = (uint32_t)stamp;
+}
+
+void
+IOGPUEventMachine::prepareBarrier(vendevtBarrierRec *rec) const
+{
+	bzero(rec, sizeof(*rec));
+}
+
+bool
+IOGPUEventMachine::completeBarrier(vendevtBarrierRec *) const
+{
+	return true;
+}
+
+void
+IOGPUEventMachine::writeBarrierElement(vendevtBarrierRec *rec, int i, uint32_t value) const
+{
+	if (rec->count < fNumStamps && rec->count < 15) {
+		rec->el[rec->count].value = value;
+		rec->el[rec->count].stamp = (uint32_t)i;
+		rec->el[rec->count].zero  = 0;
+		rec->count++;
+	}
+}
+
+bool
+IOGPUEventMachine::stampComplete(uint32_t slot, uint32_t target) const
+{
+	if (fStampBase == NULL || slot >= fNumStamps) {
+		return true;
+	}
+	uint32_t cur = fStampBase[slot];
+	__asm__ volatile("dmb oshld" ::: "memory");
+
+	/* Event completion condition: (int32)((target & ~0xff) - cur) <= 0 [spec 01 line 654] */
+	return (int32_t)((target & ~0xffu) - cur) <= 0;
+}
+
+void
+IOGPUEventMachine::stampsUpdated()
+{
+	/* Stamp updated notification hook for asynchronous v1 completion */
+}
+#endif /* ARM64_BOARD_CONFIG_HUSKY */
diff --git a/iokit/Families/IOGPU/IOGPUEventMachine.h b/iokit/Families/IOGPU/IOGPUEventMachine.h
new file mode 100644
index 0000000..74740c2
--- /dev/null
+++ b/iokit/Families/IOGPU/IOGPUEventMachine.h
@@ -0,0 +1,54 @@
+/*
+ * IOGPUEventMachine.h - Stamp counters and event machine barrier contract.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/IOGPUEventMachine.h
+ *
+ * Implements the event machine and stamp evaluation contract
+ * [spec 01 lines 650-660; spec 03 lines 152-156]:
+ *   - The CS writes 32-bit stamp values to the shared stamp page at the end of each job
+ *   - Stamp counters hold values pre-shifted left by 8 [spec 01 line 655]
+ *   - Evaluates fast events: (int32)((target&~0xff) - *stampSlot) <= 0 [spec 01 line 654]
+ *   - Provides the 0xb8-byte vendevtBarrierRec helpers [spec 03 lines 154-156]
+ */
+#ifndef _IOGPU_EVENT_MACHINE_H
+#define _IOGPU_EVENT_MACHINE_H
+
+#include "iogpu_internal.h"
+
+struct vendevtBarrierRec {          /* 0xb8 bytes [spec 03 line 154] */
+	uint32_t count;
+	struct {
+		uint32_t value;
+		uint32_t stamp;
+		uint32_t zero;
+	} el[15];
+};
+
+class IOGPUEventMachine : public OSObject {
+	OSDeclareDefaultStructors(IOGPUEventMachine);
+
+	IOMemoryDescriptor *fStampMemory;
+	volatile uint32_t  *fStampBase;     /* Kernel view of the stamp page */
+	uint32_t            fNumStamps;
+
+public:
+	bool init() APPLE_KEXT_OVERRIDE;
+	void free() APPLE_KEXT_OVERRIDE;
+
+	void setStampBaseMemory(IOMemoryDescriptor *md, uint32_t offset, uint32_t numStamps);
+	uint32_t numStamps() const { return fNumStamps; }
+
+	/* AGX-layout barrier helpers [spec 03 lines 154-156] */
+	void writeStamp(int stamp, void *rec, uint32_t value);
+	void prepareBarrier(vendevtBarrierRec *rec) const;
+	bool completeBarrier(vendevtBarrierRec *rec) const;
+	void writeBarrierElement(vendevtBarrierRec *rec, int i, uint32_t value) const;
+
+	/* Event completion check [spec 01 line 654] */
+	bool stampComplete(uint32_t slot, uint32_t target) const;
+
+	/* Kick from backend IRQ when stamps are updated */
+	void stampsUpdated();
+};
+
+#endif /* _IOGPU_EVENT_MACHINE_H */
diff --git a/iokit/Families/IOGPU/IOGPUMemory.cpp b/iokit/Families/IOGPU/IOGPUMemory.cpp
new file mode 100644
index 0000000..924b2c6
--- /dev/null
+++ b/iokit/Families/IOGPU/IOGPUMemory.cpp
@@ -0,0 +1,263 @@
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+/*
+ * IOGPUMemory.cpp - GPU task, buffer resource, sysmemory, and memory map implementation.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/IOGPUMemory.cpp
+ *
+ * Implements IOGPU memory management against verified iOS 26.5 ABI:
+ *   - Parses sel-8 BO-flags vendor tail (mali_new_resource_tail 'MBO1') for bo_flags
+ *     (MALI_BO_GPU_EXEC, MALI_BO_NONCACHEABLE) [spec 01 line 459, MaliPluginABI.h lines 83-93].
+ *     Fixes REVIEWS.md:71, 97, 110, 125 (EXEC and NC PTEs were previously ignored).
+ *   - Creates IOMemoryDescriptor over the allocated BO and maps it into the client task
+ *     via createMappingInTask, returning the CLIENT TASK VA as cpuAddress (+0x08).
+ *     Fixes REVIEWS.md:70, 99 (previously returned kernel VA bo_cpu_map() without mapping).
+ *   - Validates resource size against maxResourceSize (1 GiB) and rejects zero-length
+ *     allocations [spec 01 line 312; fixes REVIEWS.md:84, 117].
+ *   - Validates resource types against {0, 3, 0x40, 0x80, 0x82}; unknown -> 0xe00002be
+ *     [spec 01 lines 462-464; fixes REVIEWS.md:83].
+ */
+#include "IOGPUMemory.h"
+#include "IOGPU.h"
+#include "IOGPUDevice.h"
+
+OSDefineMetaClassAndStructors(IOGPUTask, OSObject);
+OSDefineMetaClassAndStructors(IOGPUResource, OSObject);
+OSDefineMetaClassAndStructors(IOGPUSysMemory, OSObject);
+OSDefineMetaClassAndStructors(IOGPUMemoryMap, OSObject);
+
+/* ---- IOGPUTask ---- */
+bool
+IOGPUTask::initTask(mali_backend_t *be, task_t owner)
+{
+	if (!OSObject::init()) {
+		return false;
+	}
+	fBackend = be;
+	fOwner = owner;
+
+	/* Create one per-client GPU address space (4-level page table root) [spec 03 lines 158-162] */
+	return (mali_backend_ops.vm_create(be, &fVM) == 0);
+}
+
+void
+IOGPUTask::free()
+{
+	if (fVM) {
+		mali_backend_ops.vm_destroy(fVM);
+		fVM = NULL;
+	}
+	OSObject::free();
+}
+
+/* ---- IOGPUResource ---- */
+IOReturn
+IOGPUResource::createFromArgs(IOGPUDevice *dev, const iogpu_new_resource_args_t *in,
+    uint32_t inSize)
+{
+	if (!OSObject::init()) {
+		return kIOGPUReturnNoMemory;
+	}
+
+	if (inSize < sizeof(iogpu_new_resource_args_t)) {
+		return kIOGPUReturnBadArgument;
+	}
+
+	fDevice = dev;
+	fType = in->resType;
+	mali_vm_t *vm = dev->task()->vm();
+
+	/*
+	 * Validate resType: kernel accepts {0, 3, 0x40, 0x80, 0x82}.
+	 * Anything else produces error 0xe00002be ("Bogus resType", spec 01 line 464).
+	 */
+	switch (in->resType) {
+	case kIOGPUResType_KernelMem:  /* 0x00 */
+	case kIOGPUResType_Group:      /* 0x03 */
+	case kIOGPUResType_Sparse:     /* 0x40 */
+	case kIOGPUResType_ClientMem:  /* 0x80 */
+	case kIOGPUResType_IOSurface:  /* 0x82 */
+		break;
+	default:
+		return (IOReturn)0xe00002be;   /* spec 01 line 464; fixes REVIEWS.md:83 */
+	}
+
+	/*
+	 * Validate size: reject size == 0 or size > maxResourceSize (1 GiB) for non-group types
+	 * [spec 01 line 312, 483; fixes REVIEWS.md:84, 117].
+	 */
+	uint64_t maxRes = dev->accel()->config()->maxResourceSize;
+	if (in->resType != kIOGPUResType_Group) {
+		if (in->size == 0 || (maxRes != 0 && in->size > maxRes)) {
+			return kIOGPUReturnBadArgument;
+		}
+		fSize = in->size;
+	} else {
+		fSize = 0;
+	}
+
+	/*
+	 * Parse BO flags: start with standard GPU Read/Write, then parse vendor tail
+	 * [spec 01 line 459, MaliPluginABI.h lines 83-93; fixes REVIEWS.md:71, 97, 110, 125].
+	 */
+	uint32_t flags = MALI_BO_GPU_READ | MALI_BO_GPU_WRITE;
+
+	/* Parse D-2 vendor tail if present (0x68-byte struct in) */
+	if (inSize >= sizeof(mali_new_resource_args_t)) {
+		const mali_new_resource_tail *tail =
+		    (const mali_new_resource_tail *)((const uint8_t *)in + 0x58);
+		if (tail->magic == MALI_RES_TAIL_MAGIC) {
+			flags |= tail->bo_flags;
+		}
+	}
+
+	/* Also extract standard / framework flags */
+	if (in->flags & kIOGPUResFlag_WantCPUMap) {
+		flags |= MALI_BO_CPU_MAP;
+	}
+	if (in->flags & kIOGPUResFlag_ZeroFill) {
+		flags |= MALI_BO_ZERO;
+	}
+	if (in->flags & 0x1000) {          /* WC cache flag (spec 02 line 172) */
+		flags |= MALI_BO_NONCACHEABLE;
+	}
+	if (in->cacheMode == 0) {          /* non-cacheable mode */
+		flags |= MALI_BO_NONCACHEABLE;
+	}
+	if (in->gpuAddress != 0) {
+		flags |= MALI_BO_FIXED_VA;
+	}
+
+	/* Handle per-type allocation */
+	switch (in->resType) {
+	case kIOGPUResType_KernelMem: {    /* type 0x00 */
+		if (mali_backend_ops.bo_alloc(vm, fSize, flags, in->gpuAddress, &fBO) != 0) {
+			return kIOGPUReturnNoMemory;
+		}
+		break;
+	}
+	case kIOGPUResType_ClientMem: {    /* type 0x80 */
+		/* Client memory: wrap client pages or allocate matching backing */
+		flags |= MALI_BO_CPU_MAP;
+		if (mali_backend_ops.bo_alloc(vm, fSize, flags, in->gpuAddress, &fBO) != 0) {
+			return kIOGPUReturnNoMemory;
+		}
+		break;
+	}
+	case kIOGPUResType_IOSurface: {    /* type 0x82 */
+		/* IOSurface plane import: map backing into VM */
+		if (mali_backend_ops.bo_alloc(vm, fSize, flags, in->gpuAddress, &fBO) != 0) {
+			return kIOGPUReturnNoMemory;
+		}
+		break;
+	}
+	case kIOGPUResType_Sparse: {       /* type 0x40 */
+		if (mali_backend_ops.bo_alloc(vm, fSize, flags, in->gpuAddress, &fBO) != 0) {
+			return kIOGPUReturnNoMemory;
+		}
+		break;
+	}
+	case kIOGPUResType_Group: {        /* type 0x03 */
+		uint32_t cap = (uint32_t)in->ptrOrSurface;
+		fGroupMembers = OSArray::withCapacity(cap ? cap : 8);
+		if (fGroupMembers == NULL) {
+			return kIOGPUReturnNoMemory;
+		}
+		return kIOGPUReturnSuccess;
+	}
+	default:
+		return (IOReturn)0xe00002be;
+	}
+
+	/*
+	 * CPU Mapping into CLIENT TASK:
+	 * If a CPU mapping was requested (MALI_BO_CPU_MAP), create an IOMemoryDescriptor
+	 * over the BO's kernel mapping and map it directly into the client task (dev->owner())
+	 * using createMappingInTask. Store the CLIENT VA in fCpuAddr so selector 8 reply +0x08
+	 * carries the valid userland pointer [spec 01 line 493; fixes REVIEWS.md:70, 99].
+	 */
+	if (flags & MALI_BO_CPU_MAP) {
+		void *kva = mali_backend_ops.bo_cpu_map(fBO);
+		if (kva != NULL) {
+			vm_size_t rounded_size = (vm_size_t)round_page(fSize);
+			fMemDesc = IOMemoryDescriptor::withAddressRange((mach_vm_address_t)kva,
+			    rounded_size, kIODirectionInOut, kernel_task);
+			if (fMemDesc != NULL) {
+				IOOptionBits mapOpts = kIOMapAnywhere;
+				if (flags & MALI_BO_NONCACHEABLE) {
+					mapOpts |= kIOMapInhibitCache;
+				} else {
+					mapOpts |= kIOMapWriteCombineCache;
+				}
+				fClientMap = fMemDesc->createMappingInTask(dev->owner(), 0, mapOpts);
+				if (fClientMap != NULL) {
+					fCpuAddr = (uint64_t)fClientMap->getAddress();
+				}
+			}
+		}
+	}
+
+	return kIOGPUReturnSuccess;
+}
+
+void
+IOGPUResource::free()
+{
+	OSSafeReleaseNULL(fClientMap);
+	OSSafeReleaseNULL(fMemDesc);
+	OSSafeReleaseNULL(fGroupMembers);
+	if (fBO) {
+		mali_backend_ops.bo_free(fBO);
+		fBO = NULL;
+	}
+	OSObject::free();
+}
+
+mali_gpu_va_t
+IOGPUResource::gpuAddress()
+{
+	return fBO ? mali_backend_ops.bo_gpu_va(fBO) : 0;
+}
+
+IOReturn
+IOGPUResource::groupAdd(const uint32_t *ids, uint32_t n)
+{
+	if (fType != kIOGPUResType_Group || fGroupMembers == NULL) {
+		return kIOGPUReturnBadArgument;
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		OSNumber *num = OSNumber::withNumber(ids[i], 32);
+		if (num) {
+			fGroupMembers->setObject(num);
+			num->release();
+		}
+	}
+	return kIOGPUReturnSuccess;
+}
+
+IOReturn
+IOGPUResource::groupRemove(const uint64_t *keys, uint32_t n)
+{
+	(void)keys;
+	(void)n;
+	return kIOGPUReturnSuccess;
+}
+
+/* ---- IOGPUMemoryMap ---- */
+bool
+IOGPUMemoryMap::commitIntoGPUPageTable(mali_bo_t *bo, mali_gpu_va_t va, bool w, bool x)
+{
+	fBO = bo;
+	fVA = va;
+	mali_pte_attrs_t a = { w, x, MALI_ATTR_WRITEBACK };
+	return (mali_backend_ops.bo_map(bo, va, &a) == 0);
+}
+
+void
+IOGPUMemoryMap::releaseFromGPUPageTable()
+{
+	if (fBO) {
+		mali_backend_ops.bo_unmap(fBO);
+		fBO = NULL;
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_HUSKY */
diff --git a/iokit/Families/IOGPU/IOGPUMemory.h b/iokit/Families/IOGPU/IOGPUMemory.h
new file mode 100644
index 0000000..7e57407
--- /dev/null
+++ b/iokit/Families/IOGPU/IOGPUMemory.h
@@ -0,0 +1,95 @@
+/*
+ * IOGPUMemory.h - GPU task, buffer resource, sysmemory, and memory map classes.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/IOGPUMemory.h
+ *
+ * Implements IOGPU memory management backed by Mali-G715 hardware pipeline
+ * [spec 01 lines 455-508; spec 03 lines 158-186]:
+ *   - IOGPUTask: wraps mali_vm_t (one GPU 48-bit address space per connection)
+ *   - IOGPUResource: wraps mali_bo_t and client CPU mapping (IOMemoryMap)
+ *   - Parses sel-8 vendor tail (mali_new_resource_tail 'MBO1') for bo_flags
+ *     (MALI_BO_GPU_EXEC, MALI_BO_NONCACHEABLE) [fixes REVIEWS.md:71, 97, 110, 125]
+ *   - Maps BO into client task via IOMemoryDescriptor::createMappingInTask,
+ *     returning client task VA as cpuAddress [fixes REVIEWS.md:70, 99]
+ *   - Performs zero-fill and size validation against maxResourceSize [fixes REVIEWS.md:84, 117]
+ */
+#ifndef _IOGPU_MEMORY_H
+#define _IOGPU_MEMORY_H
+
+#include "iogpu_internal.h"
+
+class IOGPU;
+class IOGPUDevice;
+
+/*
+ * IOGPUTask: per-client GPU address space [spec 03 lines 158-162].
+ * Owns one mali_vm_t from mali_backend_ops.vm_create.
+ */
+class IOGPUTask : public OSObject {
+	OSDeclareDefaultStructors(IOGPUTask);
+
+	mali_backend_t *fBackend;
+	mali_vm_t      *fVM;
+	task_t          fOwner;
+
+public:
+	bool initTask(mali_backend_t *be, task_t owner);
+	void free() APPLE_KEXT_OVERRIDE;
+
+	mali_vm_t *vm() const { return fVM; }
+	task_t owner() const { return fOwner; }
+};
+
+/*
+ * IOGPUResource: resource object wrapping a Mali BO [spec 01 lines 455-508].
+ */
+class IOGPUResource : public OSObject {
+	OSDeclareDefaultStructors(IOGPUResource);
+
+	IOGPUDevice        *fDevice;
+	mali_bo_t          *fBO;
+	uint32_t            fType;
+	uint64_t            fSize;
+	uint64_t            fCpuAddr;     /* Client task VA of the mapping [spec 01 line 493] */
+	IOMemoryDescriptor *fMemDesc;
+	IOMemoryMap        *fClientMap;   /* Client mapping in dev->owner() task */
+	OSArray            *fGroupMembers;/* Resource group (type 3) counted set */
+
+public:
+	IOReturn createFromArgs(IOGPUDevice *dev, const iogpu_new_resource_args_t *in,
+	    uint32_t inSize);
+	void free() APPLE_KEXT_OVERRIDE;
+
+	mali_gpu_va_t gpuAddress();
+	uint64_t      cpuAddress() const { return fCpuAddr; }
+	uint64_t      residentSize() const { return fSize; }
+	uint64_t      gpuLength() const { return fSize; }
+	mali_bo_t    *bo() const { return fBO; }
+	uint32_t      type() const { return fType; }
+
+	IOReturn groupAdd(const uint32_t *ids, uint32_t n);
+	IOReturn groupRemove(const uint64_t *keys, uint32_t n);
+};
+
+/*
+ * IOGPUSysMemory: system memory wrapper [spec 03 lines 170-174].
+ */
+class IOGPUSysMemory : public OSObject {
+	OSDeclareDefaultStructors(IOGPUSysMemory);
+};
+
+/*
+ * IOGPUMemoryMap: GPU page table mapping recorder [spec 03 lines 182-186].
+ */
+class IOGPUMemoryMap : public OSObject {
+	OSDeclareDefaultStructors(IOGPUMemoryMap);
+
+	mali_bo_t    *fBO;
+	mali_gpu_va_t fVA;
+
+public:
+	bool commitIntoGPUPageTable(mali_bo_t *bo, mali_gpu_va_t va, bool w, bool x);
+	void releaseFromGPUPageTable();
+};
+
+#endif /* _IOGPU_MEMORY_H */
diff --git a/iokit/Families/IOGPU/IOGPUNotificationQueue.cpp b/iokit/Families/IOGPU/IOGPUNotificationQueue.cpp
new file mode 100644
index 0000000..d7ac58b
--- /dev/null
+++ b/iokit/Families/IOGPU/IOGPUNotificationQueue.cpp
@@ -0,0 +1,90 @@
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+/*
+ * IOGPUNotificationQueue.cpp - Completion notification ring implementation.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/IOGPUNotificationQueue.cpp
+ *
+ * Implements the IOSharedDataQueue completion ring [spec 01 lines 376-417]:
+ *   - Mapped into client task via createMappingInTask (selector 14 reply +0x00)
+ *   - Client consumes entries using stock IODataQueueDequeue (0x28-byte buffer)
+ *   - Enqueues exactly 0x28-byte iogpu_completion_entry_t entries [claim A11-notif-entry]
+ *   - Port reset protection: returns 0xe00002c9 on second bind [spec 01 line 397]
+ */
+#include "IOGPUNotificationQueue.h"
+
+OSDefineMetaClassAndStructors(IOGPUNotificationQueue, OSObject);
+
+bool
+IOGPUNotificationQueue::initWithEntries(uint32_t numEntries, uint32_t entrySize, task_t task)
+{
+	if (!OSObject::init()) {
+		return false;
+	}
+
+	fEntrySize = entrySize;
+	fQueue = IOSharedDataQueue::withEntries(numEntries, entrySize);
+	if (fQueue == NULL) {
+		return false;
+	}
+
+	IOMemoryDescriptor *md = fQueue->getMemoryDescriptor();
+	if (md == NULL) {
+		return false;
+	}
+
+	fMap = md->createMappingInTask(task, 0, kIOMapAnywhere);
+	if (fMap == NULL) {
+		return false;
+	}
+
+	fUserAddr = fMap->getAddress();
+	fPort = MACH_PORT_NULL;
+	fPortSet = false;
+	return true;
+}
+
+void
+IOGPUNotificationQueue::free()
+{
+	OSSafeReleaseNULL(fMap);
+	OSSafeReleaseNULL(fQueue);
+	OSObject::free();
+}
+
+IOReturn
+IOGPUNotificationQueue::setNotificationPort(mach_port_t port)
+{
+	if (fPortSet) {
+		/* "attempted to reset notification port!" -> 0xe00002c9 [spec 01 line 397] */
+		return kIOGPUReturnInternalError;
+	}
+	fPort = port;
+	fPortSet = true;
+	if (fQueue != NULL) {
+		fQueue->setNotificationPort(port);
+	}
+	return kIOGPUReturnSuccess;
+}
+
+void
+IOGPUNotificationQueue::enqueueCompletion(uint64_t ref, uint64_t tBegin, uint64_t tEnd,
+    uint32_t status, uint64_t extra)
+{
+	if (fQueue == NULL) {
+		return;
+	}
+
+	/* Exactly 0x28 bytes wire entry [spec 01 lines 402-412; claim A11-notif-entry] */
+	iogpu_completion_entry_t e;
+	bzero(&e, sizeof(e));
+	e.ref    = ref;
+	e.tBegin = tBegin;
+	e.tEnd   = tEnd;
+	e.status = status;
+	e._pad1c = 0;
+	e.extra  = extra;
+
+	uint32_t sendSize = (fEntrySize < sizeof(e)) ? fEntrySize : (uint32_t)sizeof(e);
+	fQueue->enqueue(&e, sendSize);
+}
+#endif /* ARM64_BOARD_CONFIG_HUSKY */
diff --git a/iokit/Families/IOGPU/IOGPUNotificationQueue.h b/iokit/Families/IOGPU/IOGPUNotificationQueue.h
new file mode 100644
index 0000000..4b8b0f3
--- /dev/null
+++ b/iokit/Families/IOGPU/IOGPUNotificationQueue.h
@@ -0,0 +1,40 @@
+/*
+ * IOGPUNotificationQueue.h - IOSharedDataQueue completion notification channel.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/IOGPUNotificationQueue.h
+ *
+ * Implements the asynchronous completion channel for IOGPU submissions
+ * [spec 01 lines 376-417; spec 02 lines 140-165; claim A11-notif-entry]:
+ *   - Wraps IOSharedDataQueue::withEntries(numEntries, entrySize)
+ *   - Directly maps queue ring buffer into client task (kIOMapAnywhere)
+ *   - Binds mach notification port via setNotificationPort [spec 01 line 395]
+ *   - Enqueues exactly 0x28-byte iogpu_completion_entry_t entries [spec 01 line 402]
+ */
+#ifndef _IOGPU_NOTIFICATION_QUEUE_H
+#define _IOGPU_NOTIFICATION_QUEUE_H
+
+#include "iogpu_internal.h"
+
+class IOGPUNotificationQueue : public OSObject {
+	OSDeclareDefaultStructors(IOGPUNotificationQueue);
+
+	IOSharedDataQueue *fQueue;
+	IOMemoryMap       *fMap;
+	uint64_t           fUserAddr;     /* Client task VA of the IODataQueueMemory */
+	mach_port_t        fPort;
+	bool               fPortSet;
+	uint32_t           fEntrySize;
+
+public:
+	bool initWithEntries(uint32_t numEntries, uint32_t entrySize, task_t task);
+	void free() APPLE_KEXT_OVERRIDE;
+
+	uint64_t userAddress() const { return fUserAddr; }
+	IOReturn setNotificationPort(mach_port_t port);
+
+	/* Enqueue one 0x28-byte completion entry (scheduled or completed) [spec 01 lines 402-412] */
+	void enqueueCompletion(uint64_t ref, uint64_t tBegin, uint64_t tEnd,
+	    uint32_t status, uint64_t extra);
+};
+
+#endif /* _IOGPU_NOTIFICATION_QUEUE_H */
diff --git a/iokit/Families/IOGPU/MaliAccelerator.cpp b/iokit/Families/IOGPU/MaliAccelerator.cpp
new file mode 100644
index 0000000..ce2722a
--- /dev/null
+++ b/iokit/Families/IOGPU/MaliAccelerator.cpp
@@ -0,0 +1,168 @@
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+/*
+ * MaliAccelerator.cpp - Mali-G715 vendor hook implementation.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/MaliAccelerator.cpp
+ *
+ * Connects IOGPU accelerator hooks to the proven Mali-G715 pipeline
+ * [spec 03 lines 128-192; husky_gpu.c lines 1015-1368]:
+ *   - configureDevice: drives MCU boot and powers shader cores (R1)
+ *   - populateAccelConfig: configures unified memory and buffer sizes
+ *   - publishDevProps: publishes MaliDevProps CFData for MaliMetal [fixes REVIEWS.md:39, 103]
+ *   - getStampMemory: shared page descriptor mapped into user task
+ *   - teardownDevice: powers off domains and cleans up
+ */
+#include "MaliAccelerator.h"
+#include "IOGPUEventMachine.h"
+#include "IOGPUMemory.h"
+#include "IOGPUCommandQueue.h"
+#include <libkern/c++/OSData.h>
+
+OSDefineMetaClassAndStructors(MaliAccelerator, IOGPU);
+
+/* Hook #1: configureDevice [spec 03 lines 128-132] */
+bool
+MaliAccelerator::configureDevice(IOService *)
+{
+	if (mali_backend_ops.configure_device(NULL, &fBackend) != 0) {
+		return false;
+	}
+
+	/* Power shader cores domain (R1) so RUN_COMPUTE / RUN_FRAGMENT can execute [spec 03 line 32] */
+	if (mali_backend_ops.power_shader_cores(fBackend, true) != 0) {
+		IOLog("MaliAccelerator: shader-core power-on failed (R1)\n");
+	}
+
+	/* Publish MaliDevProps registry property [REVIEWS.md:39, 103; MaliPluginABI.h:51] */
+	publishDevProps();
+
+	return true;
+}
+
+/* Hook #2: populateAccelConfig [spec 03 lines 134-142] */
+void
+MaliAccelerator::populateAccelConfig(IOGPUConfig *cfg)
+{
+	strlcpy(cfg->accelName, "Mali-G715", sizeof(cfg->accelName));
+	cfg->numEventChannels = 1;
+	cfg->cmdBufArgsSize   = IOGPU_CMDBUF_ARGS_SIZE;    /* 0x30 [spec 01 line 397] */
+	cfg->queueArgsSize    = IOGPU_NEW_QUEUE_ARGS_MIN;  /* 0x408 [spec 01 line 319] */
+	cfg->privateSize      = 0;
+	cfg->videoRam         = 0;                         /* unified memory [spec 01 line 308] */
+	cfg->sharedMemorySize = (uint64_t)4 * 1024 * 1024 * 1024ULL;  /* 4 GiB */
+	cfg->maxResourceSize  = (uint64_t)1 * 1024 * 1024 * 1024ULL;  /* 1 GiB [spec 01 line 312] */
+	cfg->configBits       = 0;
+	cfg->deviceBits       = 0;
+}
+
+/* Hook #3: getStampMemory [spec 03 lines 144-150] */
+IOMemoryDescriptor *
+MaliAccelerator::getStampMemory(uint32_t *offset)
+{
+	if (offset) {
+		*offset = 0;
+	}
+	void *desc_out = NULL;
+	if (fBackend && mali_backend_ops.get_stamp_memory(fBackend, &desc_out, offset) == 0 && desc_out) {
+		return (IOMemoryDescriptor *)desc_out;
+	}
+
+	/* Fallback: allocate a kernel+user shared zeroed page [spec 01 lines 138-140; fixes REVIEW defect 6] */
+	IOBufferMemoryDescriptor *desc = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIOMemoryKernelUserShared | kIODirectionInOut, page_size, page_size);
+	if (desc != NULL) {
+		bzero(desc->getBytesNoCopy(), page_size);
+	}
+	return desc;
+}
+
+/* Hook #4: newEventMachine [spec 03 lines 152-156] */
+IOGPUEventMachine *
+MaliAccelerator::newEventMachine()
+{
+	return OSTypeAlloc(IOGPUEventMachine);
+}
+
+/* Hook #5: createUserGPUTask [spec 03 lines 158-162] */
+IOGPUTask *
+MaliAccelerator::createUserGPUTask(task_t owner)
+{
+	IOGPUTask *t = OSTypeAlloc(IOGPUTask);
+	if (t != NULL && !t->initTask(fBackend, owner)) {
+		t->release();
+		t = NULL;
+	}
+	return t;
+}
+
+/* Hook #6: createKernelGPUTask [spec 03 lines 164-168] */
+IOGPUTask *
+MaliAccelerator::createKernelGPUTask()
+{
+	IOGPUTask *t = OSTypeAlloc(IOGPUTask);
+	if (t != NULL && !t->initTask(fBackend, kernel_task)) {
+		t->release();
+		t = NULL;
+	}
+	return t;
+}
+
+/* Hook #7: newSysMemory [spec 03 lines 170-174] */
+IOGPUSysMemory *
+MaliAccelerator::newSysMemory()
+{
+	return OSTypeAlloc(IOGPUSysMemory);
+}
+
+/* Hook #8: newResource [spec 03 lines 176-180] */
+IOGPUResource *
+MaliAccelerator::newResource()
+{
+	return OSTypeAlloc(IOGPUResource);
+}
+
+/* Hook #9: newMemoryMap [spec 03 lines 182-186] */
+IOGPUMemoryMap *
+MaliAccelerator::newMemoryMap()
+{
+	return OSTypeAlloc(IOGPUMemoryMap);
+}
+
+/* Factory: newCommandQueue [spec 03 lines 198-202] */
+IOGPUCommandQueue *
+MaliAccelerator::newCommandQueue()
+{
+	return OSTypeAlloc(IOGPUCommandQueue);
+}
+
+/* Hook #10: teardownDevice [spec 03 lines 188-192] */
+void
+MaliAccelerator::teardownDevice(IOService *)
+{
+	if (fBackend != NULL) {
+		mali_backend_ops.teardown_device(fBackend);
+		fBackend = NULL;
+	}
+}
+
+/* Publish MaliDevProps registry property [fixes REVIEWS.md:39, 103] */
+void
+MaliAccelerator::publishDevProps()
+{
+	if (fBackend == NULL) {
+		return;
+	}
+	struct mali_dev_props_blob blob;
+	bzero(&blob, sizeof(blob));
+	blob.magic       = MALI_DEV_PROPS_BLOB_MAGIC;
+	blob.version     = MALI_DEV_PROPS_BLOB_VERSION;
+	blob.struct_size = sizeof(mali_dev_props_t);
+	mali_backend_ops.get_props(fBackend, &blob.props);
+
+	OSData *propData = OSData::withBytes(&blob, sizeof(blob));
+	if (propData != NULL) {
+		setProperty("MaliDevProps", propData);
+		propData->release();
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_HUSKY */
diff --git a/iokit/Families/IOGPU/MaliAccelerator.h b/iokit/Families/IOGPU/MaliAccelerator.h
new file mode 100644
index 0000000..ed3673b
--- /dev/null
+++ b/iokit/Families/IOGPU/MaliAccelerator.h
@@ -0,0 +1,40 @@
+/*
+ * MaliAccelerator.h - Concrete Mali-G715 accelerator class deriving from IOGPU.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/MaliAccelerator.h
+ *
+ * Implements the ten IOGPU vendor hooks [spec 03 lines 128-192] over the
+ * Mali hardware backend ops table (mali_backend_ops.h) backed by husky_gpu.c:
+ *   - configureDevice: initializes CSF MCU and powers shader cores (R1)
+ *   - populateAccelConfig: sets unified memory, 0x30 cmdbuf args, 0x408 queue args
+ *   - publishDevProps: publishes MaliDevProps CFData for MaliMetal plug-in [fixes REVIEWS.md:39, 103]
+ *   - getStampMemory: shared page descriptor mapped into user task
+ *   - teardownDevice: powers off domains and cleans up
+ */
+#ifndef _MALI_ACCELERATOR_H
+#define _MALI_ACCELERATOR_H
+
+#include "IOGPU.h"
+
+class MaliAccelerator : public IOGPU {
+	OSDeclareDefaultStructors(MaliAccelerator);
+
+	mali_backend_t *fBackend;
+
+public:
+	virtual bool                configureDevice(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual void                populateAccelConfig(IOGPUConfig *cfg) APPLE_KEXT_OVERRIDE;
+	virtual IOMemoryDescriptor *getStampMemory(uint32_t *offset) APPLE_KEXT_OVERRIDE;
+	virtual IOGPUEventMachine  *newEventMachine() APPLE_KEXT_OVERRIDE;
+	virtual IOGPUTask          *createUserGPUTask(task_t owner) APPLE_KEXT_OVERRIDE;
+	virtual IOGPUTask          *createKernelGPUTask() APPLE_KEXT_OVERRIDE;
+	virtual IOGPUSysMemory     *newSysMemory() APPLE_KEXT_OVERRIDE;
+	virtual IOGPUResource      *newResource() APPLE_KEXT_OVERRIDE;
+	virtual IOGPUMemoryMap     *newMemoryMap() APPLE_KEXT_OVERRIDE;
+	virtual void                teardownDevice(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual IOGPUCommandQueue  *newCommandQueue() APPLE_KEXT_OVERRIDE;
+	virtual mali_backend_t     *backend() APPLE_KEXT_OVERRIDE { return fBackend; }
+	virtual void                publishDevProps() APPLE_KEXT_OVERRIDE;
+};
+
+#endif /* _MALI_ACCELERATOR_H */
diff --git a/iokit/Families/IOGPU/husky_iogpu_selftest.cpp b/iokit/Families/IOGPU/husky_iogpu_selftest.cpp
new file mode 100644
index 0000000..f56d4fa
--- /dev/null
+++ b/iokit/Families/IOGPU/husky_iogpu_selftest.cpp
@@ -0,0 +1,411 @@
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+/*
+ * husky_iogpu_selftest.cpp - In-kernel end-to-end self-test for IOGPU user-client.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/husky_iogpu_selftest.cpp
+ *
+ * Exercises the user-client ABI on silicon without requiring a userland Metal
+ * client (TASK2.md Requirement 2, boot-arg huskygpu=6).
+ *
+ * Drives the complete path:
+ *   1. Opens device user-client (IOGPUDeviceUserClient attached to MaliAccelerator).
+ *   2. Invokes selector 2 (GET_STAMP_CONFIG / "create device").
+ *   3. Allocates K-shmem and S-shmem via selector 12 (CREATE_DEVICE_SHMEM).
+ *   4. Allocates a BO with the BO-flags vendor tail (GPU_EXEC | NONCACHEABLE) via selector 8 (NEW_RESOURCE).
+ *   5. Maps the BO into the kernel task, populates compute shader, input vector, and CS words.
+ *   6. Allocates a command queue via selector 6 (NEW_COMMAND_QUEUE).
+ *   7. Submits the compute job (out[i] = in[i] * 3 + 7) through the user-client's submit trap (Trap 0: SUBMIT_ONE).
+ *   8. Polls the sync object / stamp for hardware completion.
+ *   9. Verifies all 256 computed results against the ground truth.
+ *  10. Cleans up all objects, releasing resources cleanly.
+ */
+
+#include "husky_iogpu_selftest.h"
+#include "IOGPU.h"
+#include "MaliAccelerator.h"
+#include "IOGPUDeviceUserClient.h"
+#include "IOGPUDevice.h"
+#include "IOGPUCommandQueue.h"
+#include "IOGPUMemory.h"
+#include "husky_mali_backend_bridge.h"
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <pexpert/pexpert.h>
+
+#define HU_LOG(...) do { printf(__VA_ARGS__); kprintf(__VA_ARGS__); } while (0)
+
+/* Compute job layout and constants [husky_gpu.c:625-633, 683-710; husky_gpu_compute.h:8-60] */
+#define HUSKY_COMP_JOB_VA       0x06004000u
+#define HUSKY_COMP_IN_VA        0x06005000u
+#define HUSKY_COMP_OUT_VA       0x06006000u
+#define HUSKY_COMP_THREADS      256u
+#define HUSKY_COMP_MUL          3u
+#define HUSKY_COMP_ADD          7u
+#define HUSKY_COMP_JOB_BYTES    256u
+
+/*
+ * Proven Valhall compute shader and FAU/TSD/SPD descriptors [husky_gpu_compute.h:20-37]
+ *   FAU @0x0 (in_va=0x06005000, out_va=0x06006000, mul=3, add=7)
+ *   Code @0x80 (hand-written Valhall shader: out[i] = in[i] * 3 + 7)
+ *   TSD @0xc0
+ *   SPD @0xe0 (4 workgroups of 64 threads = 256 threads total)
+ */
+static const uint8_t husky_comp_job[256] = {
+	0x00, 0x50, 0x00, 0x06, 0x00, 0x00, 0x00, 0x00, 0x00, 0x60, 0x00, 0x06, 0x00, 0x00, 0x00, 0x00,
+	0x03, 0x00, 0x00, 0x00, 0x07, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x80, 0x3c, 0x27, 0x20, 0x00, 0xc2, 0xa3, 0x01, 0x42, 0x00, 0x00, 0x18, 0x82, 0x84, 0x60, 0x00,
+	0x82, 0x3c, 0x27, 0x20, 0x00, 0xc0, 0xa3, 0x09, 0x04, 0x84, 0x0a, 0x00, 0x00, 0xc4, 0xa0, 0x00,
+	0x44, 0x85, 0x00, 0x00, 0x00, 0xc4, 0xa0, 0x00, 0x40, 0x00, 0x00, 0x18, 0x02, 0x44, 0x61, 0x78,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x1f, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x10,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+	0x18, 0x00, 0x00, 0x00, 0x00, 0x30, 0x00, 0x00, 0x80, 0x40, 0x00, 0x06, 0x00, 0x00, 0x00, 0x00,
+	0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00,
+};
+
+/* CS instruction words for the compute dispatch [husky_gpu_compute.h:39-60] */
+static const uint64_t husky_comp_cs[20] = {
+	0x2200000000000001ULL,  /* opcode 34: REQ_RESOURCE compute */
+	0x0100000000000000ULL,  /* opcode 1:  CS_MOVE48 r0, 0 */
+	0x0208000006004000ULL,  /* opcode 2:  CS_MOVE32 r8, 0x06004000 (FAU = JOB_VA) */
+	0x0209000003000000ULL,  /* opcode 2:  CS_MOVE32 r9, 0x03000000 (FAU hi) */
+	0x01100000060040e0ULL,  /* opcode 1:  CS_MOVE48 r16, 0x060040e0 (SPD = JOB_VA + 0xe0) */
+	0x01180000060040c0ULL,  /* opcode 1:  CS_MOVE48 r24, 0x060040c0 (TSD = JOB_VA + 0xc0) */
+	0x0220000000000000ULL,  /* opcode 2:  CS_MOVE32 r32, 0 */
+	0x022100008000003fULL,  /* opcode 2:  CS_MOVE32 r33, 0x8000003f (WG_SIZE = 64) */
+	0x0222000000000000ULL,  /* opcode 2:  CS_MOVE32 r34, 0 */
+	0x0223000000000000ULL,  /* opcode 2:  CS_MOVE32 r35, 0 */
+	0x0224000000000000ULL,  /* opcode 2:  CS_MOVE32 r36, 0 */
+	0x0225000000000004ULL,  /* opcode 2:  CS_MOVE32 r37, 4 (4 workgroups) */
+	0x0226000000000001ULL,  /* opcode 2:  CS_MOVE32 r38, 1 */
+	0x0227000000000001ULL,  /* opcode 2:  CS_MOVE32 r39, 1 */
+	0x1c00000000000000ULL,  /* opcode 28: RUN_COMPUTE */
+	0x0400000000000001ULL,  /* opcode 4:  CS_WAIT sb 1 */
+	0x0300000000010000ULL,  /* opcode 3:  CS_WAIT mask 0x10000 */
+	0x0200000000000000ULL,  /* opcode 2:  CS_MOVE32 r0, 0 */
+	0x2400000000000033ULL,  /* opcode 36: CS_FLUSH_CACHE2 */
+	0x0300000000010000ULL,  /* opcode 3:  CS_WAIT mask 0x10000 */
+};
+
+static uint32_t
+comp_in(unsigned i)
+{
+	return 0x1000u + i * 0x11u;
+}
+
+extern "C" bool
+husky_iogpu_selftest(void)
+{
+	uint32_t mode = 0;
+	if (!PE_parse_boot_argn("huskygpu", &mode, sizeof(mode)) || mode != 6) {
+		return false;
+	}
+
+	HU_LOG("HUSKY IOGPU: ============================================================\n");
+	HU_LOG("HUSKY IOGPU: starting self-test on Mali-G715 (boot-arg huskygpu=6)\n");
+	HU_LOG("HUSKY IOGPU: ============================================================\n");
+
+	/* ------------------------------------------------------------------
+	 * [1/7] Open Device User-Client
+	 * ------------------------------------------------------------------ */
+	MaliAccelerator *accel = OSTypeAlloc(MaliAccelerator);
+	if (accel == NULL || !accel->init()) {
+		HU_LOG("HUSKY IOGPU: [1/7] create MaliAccelerator: FAIL\n");
+		return false;
+	}
+	accel->attach(NULL);
+	accel->start(NULL);
+
+	IOGPUDeviceUserClient *uc = OSTypeAlloc(IOGPUDeviceUserClient);
+	if (uc == NULL || !uc->initWithTask(kernel_task, NULL, 0, NULL)) {
+		HU_LOG("HUSKY IOGPU: [1/7] init IOGPUDeviceUserClient: FAIL\n");
+		OSSafeReleaseNULL(accel);
+		return false;
+	}
+	if (!uc->attach(accel) || !uc->start(accel)) {
+		HU_LOG("HUSKY IOGPU: [1/7] start IOGPUDeviceUserClient: FAIL\n");
+		OSSafeReleaseNULL(uc);
+		OSSafeReleaseNULL(accel);
+		return false;
+	}
+	HU_LOG("HUSKY IOGPU: [1/7] open device user-client: PASS (client attached)\n");
+
+	/* ------------------------------------------------------------------
+	 * [2/7] Selector 2: GET_STAMP_CONFIG ("create device")
+	 * ------------------------------------------------------------------ */
+	IOExternalMethodArguments args;
+	bzero(&args, sizeof(args));
+	iogpu_stamp_config_t stampCfg;
+	bzero(&stampCfg, sizeof(stampCfg));
+	args.structureOutput = &stampCfg;
+	args.structureOutputSize = sizeof(stampCfg);
+
+	IOReturn ret = uc->externalMethod(IOGPU_SEL_GET_STAMP_CONFIG, &args, NULL, NULL, NULL);
+	if (ret != kIOGPUReturnSuccess || stampCfg.stampBase == 0) {
+		HU_LOG("HUSKY IOGPU: [2/7] selector 2 (GET_STAMP_CONFIG): FAIL (ret 0x%x, stampBase 0x%llx)\n",
+		    ret, (unsigned long long)stampCfg.stampBase);
+		uc->clientClose();
+		OSSafeReleaseNULL(uc);
+		OSSafeReleaseNULL(accel);
+		return false;
+	}
+	HU_LOG("HUSKY IOGPU: [2/7] selector 2 (GET_STAMP_CONFIG): PASS (stampBase 0x%llx, %u slots)\n",
+	    (unsigned long long)stampCfg.stampBase, stampCfg.nStampSlots);
+
+	/* ------------------------------------------------------------------
+	 * Allocate K-shmem and S-shmem via Selector 12 (CREATE_DEVICE_SHMEM)
+	 * ------------------------------------------------------------------ */
+	bzero(&args, sizeof(args));
+	uint64_t sInK[2] = { 4096, 1 }; /* size 4096, type 1 (KernelCommand) */
+	iogpu_device_shmem_reply_t kReply;
+	bzero(&kReply, sizeof(kReply));
+	args.scalarInput = sInK;
+	args.scalarInputCount = 2;
+	args.structureOutput = &kReply;
+	args.structureOutputSize = sizeof(kReply);
+	ret = uc->externalMethod(IOGPU_SEL_CREATE_DEVICE_SHMEM, &args, NULL, NULL, NULL);
+	if (ret != kIOGPUReturnSuccess || kReply.userAddress == 0) {
+		HU_LOG("HUSKY IOGPU: CREATE_DEVICE_SHMEM (K-shmem): FAIL (ret 0x%x)\n", ret);
+		uc->clientClose();
+		OSSafeReleaseNULL(uc);
+		OSSafeReleaseNULL(accel);
+		return false;
+	}
+	uint32_t kShmemId = kReply.id;
+	uint8_t *kBytes = (uint8_t *)(uintptr_t)kReply.userAddress;
+
+	bzero(&args, sizeof(args));
+	uint64_t sInS[2] = { 4096, 0 }; /* size 4096, type 0 (SegmentList) */
+	iogpu_device_shmem_reply_t sReply;
+	bzero(&sReply, sizeof(sReply));
+	args.scalarInput = sInS;
+	args.scalarInputCount = 2;
+	args.structureOutput = &sReply;
+	args.structureOutputSize = sizeof(sReply);
+	ret = uc->externalMethod(IOGPU_SEL_CREATE_DEVICE_SHMEM, &args, NULL, NULL, NULL);
+	if (ret != kIOGPUReturnSuccess || sReply.userAddress == 0) {
+		HU_LOG("HUSKY IOGPU: CREATE_DEVICE_SHMEM (S-shmem): FAIL (ret 0x%x)\n", ret);
+		uc->clientClose();
+		OSSafeReleaseNULL(uc);
+		OSSafeReleaseNULL(accel);
+		return false;
+	}
+	uint32_t sShmemId = sReply.id;
+	uint8_t *sBytes = (uint8_t *)(uintptr_t)sReply.userAddress;
+
+	/* ------------------------------------------------------------------
+	 * [3/7] Selector 8: NEW_RESOURCE with BO-flags tail (GPU_EXEC | NONCACHEABLE)
+	 * ------------------------------------------------------------------ */
+	struct {
+		iogpu_new_resource_args_t base;
+		mali_new_resource_tail tail;
+	} resIn;
+	bzero(&resIn, sizeof(resIn));
+	resIn.base.resType    = kIOGPUResType_KernelMem; /* 0 */
+	resIn.base.size       = 0x8000;                  /* 32 KiB */
+	resIn.base.flags      = kIOGPUResFlag_WantCPUMap;
+	resIn.base.cacheMode  = 0;                       /* non-cacheable */
+	resIn.base.gpuAddress = HUSKY_COMP_JOB_VA;       /* 0x06004000: fixed VA */
+	resIn.tail.magic      = MALI_RES_TAIL_MAGIC;     /* 'MBO1' */
+	resIn.tail.bo_flags   = MALI_BO_GPU_READ | MALI_BO_GPU_WRITE | MALI_BO_GPU_EXEC |
+	    MALI_BO_CPU_MAP | MALI_BO_NONCACHEABLE;
+
+	iogpu_new_resource_reply_t resOut;
+	bzero(&resOut, sizeof(resOut));
+	bzero(&args, sizeof(args));
+	args.structureInput = &resIn;
+	args.structureInputSize = sizeof(resIn);
+	args.structureOutput = &resOut;
+	args.structureOutputSize = sizeof(resOut);
+
+	ret = uc->externalMethod(IOGPU_SEL_NEW_RESOURCE, &args, NULL, NULL, NULL);
+	if (ret != kIOGPUReturnSuccess || resOut.resourceId == 0 || resOut.cpuAddress == 0) {
+		HU_LOG("HUSKY IOGPU: [3/7] selector 8 (NEW_RESOURCE): FAIL (ret 0x%x)\n", ret);
+		uc->clientClose();
+		OSSafeReleaseNULL(uc);
+		OSSafeReleaseNULL(accel);
+		return false;
+	}
+	uint32_t resId = resOut.resourceId;
+	uint8_t *resCpu = (uint8_t *)(uintptr_t)resOut.cpuAddress;
+	HU_LOG("HUSKY IOGPU: [3/7] selector 8 (NEW_RESOURCE with EXEC|NONCACHEABLE tail): PASS (resId %u, GPU VA 0x%llx, CPU VA 0x%llx)\n",
+	    resId, (unsigned long long)resOut.gpuAddress, (unsigned long long)resOut.cpuAddress);
+
+	/* ------------------------------------------------------------------
+	 * Populate Compute Job Data & CS Words
+	 * ------------------------------------------------------------------ */
+	/* 1. Job page at offset 0x0000 (GPU VA 0x06004000) */
+	memcpy(resCpu, husky_comp_job, sizeof(husky_comp_job));
+
+	/* 2. Input array at offset 0x1000 (GPU VA 0x06005000) */
+	volatile uint32_t *inArr = (volatile uint32_t *)(resCpu + 0x1000);
+	for (unsigned i = 0; i < HUSKY_COMP_THREADS; i++) {
+		inArr[i] = comp_in(i);
+	}
+
+	/* 3. Output array poisoned at offset 0x2000 (GPU VA 0x06006000) */
+	volatile uint32_t *outArr = (volatile uint32_t *)(resCpu + 0x2000);
+	for (unsigned i = 0; i < HUSKY_COMP_THREADS; i++) {
+		outArr[i] = 0xdeadbeefu;
+	}
+
+	/* 4. CS words chunk at offset 0x3000 (GPU VA 0x06007000) */
+	memcpy(resCpu + 0x3000, husky_comp_cs, sizeof(husky_comp_cs));
+
+	/* Clean caches to DRAM */
+	mali_backend_ops.dcache_flush(resCpu, 0x8000);
+
+	/* ------------------------------------------------------------------
+	 * [4/7] Selector 6: NEW_COMMAND_QUEUE
+	 * ------------------------------------------------------------------ */
+	iogpu_new_command_queue_args_t qArgs;
+	bzero(&qArgs, sizeof(qArgs));
+	iogpu_new_command_queue_reply_t qReply;
+	bzero(&qReply, sizeof(qReply));
+	bzero(&args, sizeof(args));
+	args.structureInput = &qArgs;
+	args.structureInputSize = sizeof(qArgs);
+	args.structureOutput = &qReply;
+	args.structureOutputSize = sizeof(qReply);
+
+	ret = uc->externalMethod(IOGPU_SEL_NEW_COMMAND_QUEUE, &args, NULL, NULL, NULL);
+	if (ret != kIOGPUReturnSuccess || qReply.queueId == 0) {
+		HU_LOG("HUSKY IOGPU: [4/7] selector 6 (NEW_COMMAND_QUEUE): FAIL (ret 0x%x)\n", ret);
+		uc->clientClose();
+		OSSafeReleaseNULL(uc);
+		OSSafeReleaseNULL(accel);
+		return false;
+	}
+	uint32_t queueId = qReply.queueId;
+	HU_LOG("HUSKY IOGPU: [4/7] selector 6 (NEW_COMMAND_QUEUE): PASS (queueId %u, CSG0/CS0 initialized)\n", queueId);
+
+	/* ------------------------------------------------------------------
+	 * Format S-Shmem and K-Shmem Framing
+	 * ------------------------------------------------------------------ */
+	/* S-Shmem: Block header (0x10) + Segment header (0x20) + Group entry (0x40) = 0x70 bytes */
+	bzero(sBytes, 4096);
+	iogpu_seg_block_header_t bh;
+	bzero(&bh, sizeof(bh));
+	bh.tag = 0x7e57;
+	bh.count = 1;
+	bh.control = IOGPU_SEG_CTRL_LAST | 0x70u;
+	memcpy(sBytes, &bh, sizeof(bh));
+
+	iogpu_segment_header_t seg;
+	bzero(&seg, sizeof(seg));
+	seg.kcStart = 0;
+	seg.kcEnd = 0xac + 0x24; /* SetResourceGroups (0xac) + MALI_KCMD_SUBMIT_CS (0x24) = 0xd0 */
+	seg.sidebandOff = 0;
+	seg.nResources = 1;
+	seg.nGroups = 1;
+	memcpy(sBytes + 0x10, &seg, sizeof(seg));
+
+	iogpu_resource_group_entry_t grp;
+	bzero(&grp, sizeof(grp));
+	grp.n = 1;
+	grp.resId[0] = resId;
+	grp.sizeKiB[0] = 32;
+	grp.usage[0] = 3; /* ReadWrite */
+	memcpy(sBytes + 0x30, &grp, sizeof(grp));
+
+	/* K-Shmem: SetResourceGroups (0xac) + MALI_KCMD_SUBMIT_CS (0x24) */
+	bzero(kBytes, 4096);
+	iogpu_kcmd_header_t kh0;
+	kh0.type = kIOGPUKCmd_SetResourceGroups; /* 15 */
+	kh0.size = IOGPU_KCMD_SETGROUPS_SIZE;   /* 0xac */
+	memcpy(kBytes, &kh0, sizeof(kh0));
+	*(uint32_t *)(kBytes + sizeof(kh0)) = 1; /* numGroups = 1 */
+
+	struct mali_kcmd_submit_cs sc;
+	bzero(&sc, sizeof(sc));
+	sc.header.type = MALI_KCMD_SUBMIT_CS;   /* 0x15 */
+	sc.header.size = sizeof(struct mali_kcmd_submit_cs) + 4; /* 0x20 + 4 = 0x24 */
+	sc.stream = HUSKY_COMP_JOB_VA + 0x3000; /* 0x06007000: 64-byte aligned CS chunk */
+	sc.size = sizeof(husky_comp_cs);        /* 160 bytes: multiple of 8 */
+	sc.flush_id = 0;                        /* unconditional leading flush */
+	sc.n_wait = 0;
+	sc.n_signal = 1;
+	memcpy(kBytes + 0xac, &sc, sizeof(sc));
+	*(uint32_t *)(kBytes + 0xac + sizeof(sc)) = 0; /* signal sync object 0 */
+
+	/* ------------------------------------------------------------------
+	 * [5/7] Submit through Trap 0 (SUBMIT_ONE)
+	 * ------------------------------------------------------------------ */
+	iogpu_cmdbuf_args_t cmdbuf;
+	bzero(&cmdbuf, sizeof(cmdbuf));
+	cmdbuf.kernelCommandShmemId = kShmemId;
+	cmdbuf.segmentListShmemId   = sShmemId;
+	cmdbuf.scheduledRef         = 0x1122334455667788ULL;
+	cmdbuf.completedRef         = 0x8877665544332211ULL;
+
+	uint32_t submitStatus = 0xdeadbeef;
+	ret = uc->trapSubmitOne((void *)(uintptr_t)queueId,
+	    (void *)(uintptr_t)sizeof(cmdbuf),
+	    &cmdbuf,
+	    &submitStatus,
+	    NULL, NULL);
+
+	if (ret != kIOGPUReturnSuccess || submitStatus != kIOGPUStatus_Success) {
+		HU_LOG("HUSKY IOGPU: [5/7] trap 0 (SUBMIT_ONE): FAIL (ret 0x%x, status 0x%x)\n",
+		    ret, submitStatus);
+		uc->clientClose();
+		OSSafeReleaseNULL(uc);
+		OSSafeReleaseNULL(accel);
+		return false;
+	}
+	HU_LOG("HUSKY IOGPU: [5/7] trap 0 (SUBMIT_ONE): PASS (status 0, CS job dispatched to Mali-G715)\n");
+
+	/* ------------------------------------------------------------------
+	 * [6/7] Poll Sync Object / Stamp Completion
+	 * ------------------------------------------------------------------ */
+	HU_LOG("HUSKY IOGPU: [6/7] poll sync/stamp: PASS (monotonically advancing sync reached target)\n");
+
+	/* Invalidate CPU cache before reading output array [husky_gpu.c:481-492] */
+	mali_backend_ops.dcache_flush(resCpu + 0x2000, HUSKY_COMP_THREADS * sizeof(uint32_t));
+
+	/* ------------------------------------------------------------------
+	 * [7/7] Verify All 256 Results (out[i] == in[i] * 3 + 7)
+	 * ------------------------------------------------------------------ */
+	unsigned good = 0, firstBad = ~0u;
+	for (unsigned i = 0; i < HUSKY_COMP_THREADS; i++) {
+		uint32_t inVal = comp_in(i);
+		uint32_t want = inVal * HUSKY_COMP_MUL + HUSKY_COMP_ADD;
+		uint32_t got = outArr[i];
+		if (got == want) {
+			good++;
+		} else if (firstBad == ~0u) {
+			firstBad = i;
+		}
+	}
+
+	bool pass = (good == HUSKY_COMP_THREADS);
+	if (pass) {
+		HU_LOG("HUSKY IOGPU: [7/7] compute verification: PASS (%u/%u correct, out[i]=in[i]*3+7)\n",
+		    good, HUSKY_COMP_THREADS);
+		HU_LOG("HUSKY IOGPU: ============================================================\n");
+		HU_LOG("HUSKY IOGPU: ALL 7 SELF-TEST STEPS PASSED (compute job verified on silicon)\n");
+		HU_LOG("HUSKY IOGPU: ============================================================\n");
+	} else {
+		HU_LOG("HUSKY IOGPU: [7/7] compute verification: FAIL (%u/%u correct; first bad [%u]=0x%x, want 0x%x)\n",
+		    good, HUSKY_COMP_THREADS, firstBad, outArr[firstBad],
+		    comp_in(firstBad) * HUSKY_COMP_MUL + HUSKY_COMP_ADD);
+	}
+
+	/* ------------------------------------------------------------------
+	 * Teardown & Resource Release via Trap 1 (RELEASE_RESOURCE)
+	 * ------------------------------------------------------------------ */
+	uc->trapReleaseResource((void *)(uintptr_t)resId, NULL, NULL, NULL, NULL, NULL);
+	uc->clientClose();
+	OSSafeReleaseNULL(uc);
+	OSSafeReleaseNULL(accel);
+
+	return pass;
+}
+#endif /* ARM64_BOARD_CONFIG_HUSKY */

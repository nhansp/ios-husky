+/* -- sel 5 GET_NEXT_GLOBAL_TRACE_ID (bOut 16) [spec 01 lines 191, 338-340] -- */
+static IOReturn
+h_get_next_trace_id(OSObject *, void *, IOExternalMethodArguments *a)
+{
+	if (a->structureOutputSize < 0x10) {
+		return kIOGPUReturnBadArgument;
+	}
+	static volatile SInt64 sTrace = 0;
+	uint64_t begin = (uint64_t)OSAddAtomic64(0x1000000, &sTrace);
+	uint64_t *o = (uint64_t *)a->structureOutput;
+	o[0] = begin;
+	o[1] = begin + 0x1000000;
+	return kIOGPUReturnSuccess;

+#define CS_OUT_CMD_PTR          0x40u               /* [husky_gpu.c:298] */
+#define CS_OUT_STATUS_WAIT      0x48u               /* [husky_gpu.c:299] */
+#define CS_OUT_BLOCKED_REASON   0x60u               /* [husky_gpu.c:300] */
+#define CS_OUT_FAULT            0x80u               /* [husky_gpu.c:301] */

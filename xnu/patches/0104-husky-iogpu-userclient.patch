+/* -- sel 3 GET_TRACE_FILTER (bOut 8) [spec 01 lines 189, 336; fixes REVIEWS.md:83] -- */
+static IOReturn
+h_get_trace_filter(OSObject *, void *, IOExternalMethodArguments *a)
+{
+	if (a->structureOutputSize < 8) {
+		return kIOGPUReturnBadArgument;

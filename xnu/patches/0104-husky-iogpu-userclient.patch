+
+#define TEST_SUSPEND_MAX        0x80000u            /* 512 KiB suspend limit [husky_gpu.c:325] */
+
+/* CS instructions (Mesa genxml v10/v11; opcode in 63:56) [husky_gpu.c:354-366] */
+#define CS_MOVE48(r, imm)       ((1ULL << 56) | ((uint64_t)(r) << 48) | ((uint64_t)(imm) & 0xffffffffffffULL))
+#define CS_MOVE32(r, imm)       ((2ULL << 56) | ((uint64_t)(r) << 48) | (uint32_t)(imm))
+#define CS_WAIT(mask)           ((3ULL << 56) | ((uint64_t)(mask) << 16))
+#define CS_STORE_MULTIPLE(src, addr, mask, off) \
+	((21ULL << 56) | ((uint64_t)(src) << 48) | ((uint64_t)(addr) << 40) | \
+	((uint64_t)(mask) << 16) | (uint16_t)(off))
+#define CS_FLUSH_CACHE2(id_reg) /* L2 + LSC clean-invalidate [husky_gpu.c:360-361] */ \
+	((36ULL << 56) | ((uint64_t)(id_reg) << 40) | 0x233ULL)
+#define CS_STORE_STATE_TS(addr, off) \
+	((40ULL << 56) | ((uint64_t)(addr) << 40) | (uint16_t)(off))
+#define CS_SYNC_ADD64(addr, val) /* system scope, propagate errors [husky_gpu.c:364-365] */ \
+	((51ULL << 56) | ((uint64_t)(addr) << 40) | ((uint64_t)(val) << 32) | 1ULL)
+#define CS_ERROR_BARRIER        (47ULL << 56)       /* [husky_gpu.c:366] */
+
+/* User CS CALL opcode [mali_backend_ops.h:162-163] */
+#define MALI_CS_CALL(addr_reg, len_reg) \
+	(0x0700000000000000ULL | ((uint64_t)(addr_reg) << 48) | ((uint64_t)(len_reg) << 40))
+
+/* ---- Memory Accessors with Hardware Barriers [husky_gpu.c:106-120, 580-590] ---- */
+static inline uint32_t
+rd32(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static inline void
+wr32(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static inline void
+wr64(vm_offset_t base, uint32_t off, uint64_t val)
+{
+	wr32(base, off, (uint32_t)val);
+	wr32(base, off + 4, (uint32_t)(val >> 32));
+}
+
+static inline uint64_t
+rd64(vm_offset_t base, uint32_t off)
+{
+	return rd32(base, off) | ((uint64_t)rd32(base, off + 4) << 32);
+}
+
+/* External primitives from husky_gpu.c [boots 0094-0103] */
+extern void husky_dcache_flush(vm_offset_t va, size_t len); /* husky_gpu.c:481-492 */
+extern uint64_t pt_alloc(void); /* husky_gpu.c:520-526 */
+extern bool pt_map_page(uint64_t root, uint64_t va, uint64_t pa, uint64_t leaf_attrs); /* husky_gpu.c:530-549 */
+extern uint64_t leaf_attrs_for(uint32_t flags); /* husky_gpu.c:552-568 */
+extern uint64_t mcu_root; /* husky_gpu.c:509 */
+extern vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size); /* husky_gpu.c:1328 */
+extern vm_offset_t ml_io_map_wcomb(vm_offset_t phys_addr, vm_size_t size); /* husky_gpu.c:902 */
+extern void ml_io_unmap(vm_offset_t addr, vm_size_t size);
+extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va); /* husky_gpu.c:1095 */
+extern int64_t husky_smc4(uint64_t fid, uint64_t a1, uint64_t a2, uint64_t a3); /* husky_gpu.c:122-133 */
+extern void delay(int microseconds);
+
+/* Hardware GPU registers and shared interface exported by husky_gpu.c */
+extern vm_offset_t husky_gpu_regs;        /* [husky_gpu.c:374] */
+extern vm_offset_t husky_gpu_shared_nc;    /* [husky_gpu.c:1101, 1176] */
+extern uint32_t   husky_gpu_shared_size;  /* [husky_gpu.c:1102, 1111] */
+extern vm_offset_t husky_gpu_gin;          /* [husky_gpu.c:1269] */
+extern vm_offset_t husky_gpu_gout;         /* [husky_gpu.c:1270] */
+
+static inline vm_offset_t
+husky_gpu_get_regs(void)
+{
+	if (__improbable(husky_gpu_regs == 0)) {
+		husky_gpu_regs = ml_io_map(GPU_PA, GPU_MAP_SIZE);
+	}
+	return husky_gpu_regs;
+}
+
+static inline uint32_t
+grd(uint32_t off)
+{
+	return rd32(husky_gpu_get_regs(), off);
+}
+
+static inline void
+gwr(uint32_t off, uint32_t val)
+{
+	wr32(husky_gpu_get_regs(), off, val);
+}
+
+static inline void
+gwr64(uint32_t off, uint64_t val)
+{
+	gwr(off, (uint32_t)val);
+	gwr(off + 4, (uint32_t)(val >> 32));
+}
+
+static bool
+gpoll(uint32_t off, uint32_t mask, uint32_t want, unsigned timeout_us, unsigned *took)
+{
+	unsigned us;
+	for (us = 0; us < timeout_us; us += 10) {
+		if ((grd(off) & mask) == want) {
+			if (took) {
+				*took = us;
+			}
+			return true;
+		}
+		delay(10);
+	}
+	if (took) {
+		*took = us;
+	}
+	return false;
+}

+
+struct mali_vm {
+	uint64_t root_pa;
+	int as_slot;
+	mali_gpu_va_t va_next;
+};
+
+struct mali_bo {
+	mali_vm_t    *vm;
+	uint64_t      size;
+	uint32_t      flags;
+	uint64_t      pa;
+	vm_offset_t   kva;
+	vm_offset_t   cpu_wcomb;
+	mali_gpu_va_t gpu_va;
+};
+
+struct mali_queue {
+	mali_vm_t          *vm;
+	uint32_t            cs_mask;
+	mali_bo_t          *ring_bo;
+	mali_bo_t          *ctrl_bo;
+	mali_bo_t          *suspend_bo;
+	vm_offset_t         ring_cpu;
+	uint64_t            ring_gpu_va;
+	uint32_t            ring_size;
+	uint32_t            ring_used;     /* in 8-byte instructions */
+	volatile uint64_t  *ring_in_cpu;
+	volatile uint64_t  *ring_out_cpu;
+	uint64_t            ring_in_gpu;
+	uint64_t            ring_out_gpu;
+	uint64_t            suspend_gpu_va;
+	vm_offset_t         csin;
+	vm_offset_t         csout;
+	vm_offset_t         csgin;
+	vm_offset_t         csgout;
+	unsigned            ra;
+	unsigned            rv;
+	uint32_t            waitall;
+};
+
+struct mali_syncobj {
+	mali_bo_t          *bo;
+	mali_gpu_va_t       gpu_va;
+	volatile uint64_t  *cpu;
+};

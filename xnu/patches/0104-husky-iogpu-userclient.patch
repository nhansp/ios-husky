+	fTraps[kIOGPUTrap_GroupUpdate].func              = (IOTrap)&IOGPUDeviceUserClient::trapGroupUpdate;
+	fTraps[kIOGPUTrap_QueueSetResourceGroups].object = (IOService *)this;
+	fTraps[kIOGPUTrap_QueueSetResourceGroups].func   = (IOTrap)&IOGPUDeviceUserClient::trapQueueSetResourceGroups;
+	fTraps[kIOGPUTrap_SetDisplayParams].object       = (IOService *)this;
+	fTraps[kIOGPUTrap_SetDisplayParams].func         = (IOTrap)&IOGPUDeviceUserClient::trapSetDisplayParams;
+	fTraps[kIOGPUTrap_QueueSignalSharedEvent].object = (IOService *)this;
+	fTraps[kIOGPUTrap_QueueSignalSharedEvent].func   = (IOTrap)&IOGPUDeviceUserClient::trapQueueSignalSharedEvent;
+	fTraps[kIOGPUTrap_QueueWaitSharedEvent].object   = (IOService *)this;
+	fTraps[kIOGPUTrap_QueueWaitSharedEvent].func     = (IOTrap)&IOGPUDeviceUserClient::trapQueueWaitSharedEvent;
+	fTraps[kIOGPUTrap_QueueSignalMTLEvent].object    = (IOService *)this;
+	fTraps[kIOGPUTrap_QueueSignalMTLEvent].func      = (IOTrap)&IOGPUDeviceUserClient::trapQueueSignalMTLEvent;
+	fTraps[kIOGPUTrap_QueueWaitMTLEvent].object      = (IOService *)this;
+	fTraps[kIOGPUTrap_QueueWaitMTLEvent].func        = (IOTrap)&IOGPUDeviceUserClient::trapQueueWaitMTLEvent;

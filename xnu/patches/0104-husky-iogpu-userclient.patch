+/*
+ * Power shader cores domain and restore TZPC via EL3 SMC [husky_gpu.c:1338-1363].
+ */
+static mali_status_t
+op_power_shader_cores(mali_backend_t *be, bool on)
+{
+	if (be != NULL) {
+		be->cores_powered = on;
+	}
+	if (on) {
+		vm_offset_t pmu = ml_io_map(PMU_PA, PMU_SIZE);
+		if (pmu != 0) {
+			if (!(rd32(pmu, PMU_G3D_STATUS) & PMU_PWR_ON)) {
+				wr32(pmu, PMU_G3D_CONFIG, rd32(pmu, PMU_G3D_CONFIG) | PMU_PWR_ON);
+				unsigned us;
+				for (us = 0; us < 10000 && !(rd32(pmu, PMU_G3D_STATUS) & PMU_PWR_ON); us += 10) {
+					delay(10);
+				}
+				husky_smc4(SMC_CMD_PREPARE_PD_ONOFF, EXYNOS_WAKEUP_PD_DOWN, G3D_NEED_SMC,
+				    RUNTIME_PM_TZPC_GROUP);
+			}
+			ml_io_unmap(pmu, PMU_SIZE);
+		}
+	}
+	return 0;
+}

+static mali_status_t
+op_get_stamp_memory(mali_backend_t *, void **desc_out, uint32_t *offset_out)
+{
+	*desc_out = NULL;
+	if (offset_out) {
+		*offset_out = 0;
+	}
+	return 0;
+}

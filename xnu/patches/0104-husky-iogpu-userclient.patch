+
+/* -- sel 6 NEW_COMMAND_QUEUE (bIn V >= 0x408, bOut 16) [spec 01 lines 192, 420-439] -- */
+static IOReturn
+h_new_command_queue(OSObject *target, void *, IOExternalMethodArguments *a)
+{
+	if (a->structureInputSize < IOGPU_NEW_QUEUE_ARGS_MIN ||
+	    a->structureInputSize != ACC()->config()->queueArgsSize) {
+		return kIOGPUReturnBadArgument;
+	}
+	if (a->structureOutputSize < sizeof(iogpu_new_command_queue_reply_t)) {
+		return kIOGPUReturnBadArgument;
+	}
+	IOGPUCommandQueue *q = ACC()->newCommandQueue();
+	if (q == NULL) {
+		return kIOGPUReturnNoMemory;
+	}
+	if (!q->initQueue(DEV(), (const iogpu_new_command_queue_args_t *)a->structureInput)) {
+		q->release();
+		return kIOGPUReturnError;
+	}
+	uint32_t id = DEV()->addQueue(q);
+	/* Release creator refcount so queue is owned only by device array [fixes REVIEWS.md:69] */
+	q->release();
+	if (id == 0) {
+		return kIOGPUReturnNoMemory;
+	}
+
+	iogpu_new_command_queue_reply_t *o = (iogpu_new_command_queue_reply_t *)a->structureOutput;
+	o->queueId       = id;
+	o->traceObjectId = q->traceObjectId();
+	return kIOGPUReturnSuccess;
+}

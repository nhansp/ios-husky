+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+/*
+ * husky_mali_backend_bridge.c - Implementation of mali_backend_ops wrapping husky_gpu.c primitives.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/husky_mali_backend_bridge.c
+ *
+ * Implements the mali_backend_ops table required by IOGPUFamily by replicating
+ * the verified hardware register offsets, values, ordering, and poll loops from
+ * bsd/dev/husky_gpu.c (boots 0094-0103, Mali-G715 Valhall arch 11, CSF).
+ *
+ * =========================================================================
+ * PROVEN PRIMITIVES MIRRORED FROM husky_gpu.c (CITED LINE-FOR-LINE):
+ * =========================================================================
+ * 1. PMU & Power-on SMC:
+ *    - PMU registers at 0x15460000, pd_g3d CONFIG 0x1a80, STATUS 0x1a84, bit 0 [husky_gpu.c:90-96]
+ *    - TZPC SMC restore: SMC_CMD_PREPARE_PD_ONOFF (0x82000410), need_smc 0x1EE10204 [husky_gpu.c:98-101, 1355-1363]
+ * 2. Memory Barriers & Accessors:
+ *    - rd32: volatile read + "dmb oshld" [husky_gpu.c:107-112]
+ *    - wr32: "dmb oshst" + volatile write + "dsb osh" [husky_gpu.c:114-120]
+ *    - rd64 / wr64: 64-bit split read/write [husky_gpu.c:580-590]
+ *    - grd / gwr / gwr64 / gpoll: GPU register access & polling loops [husky_gpu.c:426-461]
+ * 3. MMU 4-Level Page Tables:
+ *    - Translation table root allocation pt_alloc [husky_gpu.c:520-526]
+ *    - 4-level 4 KiB VA->PA map pt_map_page [husky_gpu.c:530-549]
+ *    - Leaf PTE attributes leaf_attrs_for (RW/RO, XN clear for EXEC, AttrIndx 0 vs 1) [husky_gpu.c:552-568]
+ *    - Non-coherent cache clean+invalidate (DC CIVAC) husky_dcache_flush [husky_gpu.c:481-492]
+ * 4. Address Space Binding:
+ *    - AS0 at 0x2400, stride 0x40 (AS1 = 0x2440) [husky_gpu.c:188, 196, 909]
+ *    - Register offsets: TRANSTAB 0x00, MEMATTR 0x08, COMMAND 0x18, STATUS 0x28, TRANSCFG 0x30 [husky_gpu.c:189-195]
+ *    - Proven values: AS_MEMATTR_VALUE = 0x4c4c4c4c8c4c8f4c, AS_TRANSCFG_VALUE = 0x420001c6 [husky_gpu.c:208-209]
+ *    - Command update handshake: AS_COMMAND = 1, gpoll status & 3 == 0 [husky_gpu.c:910-921]
+ * 5. CSF Group (CSG) and Stream (CS) Interfaces:
+ *    - Shared memory interface layout: CSF_GROUP_CONTROL 0x1000, CSF_STREAM_CONTROL 0x40 [husky_gpu.c:262-263]
+ *    - GLB interface at shared+0: doorbell kick through GLB_IN_DB_REQ / GLB_OUT_DB_ACK + DOORBELL0 (0x80000) [husky_gpu.c:254-255, 972-975]
+ *    - CS stream configuration: CS_IN_RING_BASE 0x10, CS_IN_RING_SIZE 0x18, CS_IN_RING_INPUT 0x30, CS_IN_RING_OUTPUT 0x38,
+ *      CS_IN_CONFIG 0x04 (priority 1, doorbell 1: 1u | (1u << 8)), CS_STATE_START [husky_gpu.c:290-310, 947-955]
+ *    - CSG configuration: compute & fragment mask (0x01110055ULL), endpoint request, suspend buffer,
+ *      CSG_STATE_START | CSG_ENDPOINT_CONFIG [husky_gpu.c:273-289, 956-982]
+ * 6. Job Submission & Sync Object Completion:
+ *    - CS Instructions: CS_MOVE32 (2), CS_MOVE48 (1), CS_WAIT (3), CS_FLUSH_CACHE2 (36), CS_SYNC_ADD64 (51), CS_ERROR_BARRIER (47) [husky_gpu.c:354-366]
+ *    - User command stream chunk dispatch via MALI_CS_CALL (opcode 7) [mali_backend_ops.h:162-163]
+ *    - Instruction padding to 64-byte lines ((n + 7) & ~7u) [husky_gpu.c:658, 938]
+ *    - Ring write barrier "dsb sy" + update RING_INPUT + "dsb sy" + kick DOORBELL(CS_DOORBELL_ID) (0x90000) [husky_gpu.c:667-670, 942-943]
+ *    - Polling sync object for hardware completion (500 ms timeout) [husky_gpu.c:672-678]
+ *
+ * =========================================================================
+ * LIST OF DIFFERENCES FROM husky_gpu.c AND RATIONALE (TASK2.md Requirement 1):
+ * =========================================================================
+ * 1. Dynamic vs Static Allocations:
+ *    husky_gpu.c used hardcoded static virtual/physical addresses (TEST_VA 0x06000000, test_pa, TEST_RING).
+ *    The bridge dynamically allocates per-client ring buffers, control pages, and suspend buffers via
+ *    op_bo_alloc and maps them into the client VM's page tables.
+ * 2. MALI_CS_CALL vs Direct Ring Emission:
+ *    husky_gpu.c appended pre-baked compute/render instruction arrays directly to the ring. The bridge
+ *    formats a standard Layer-B submission wrapper that executes a cache flush, invokes the client's
+ *    user-constructed command stream chunk using MALI_CS_CALL(stream_addr, stream_size), and executes
+ *    the standard completion tail.
+ * 3. Dynamic Address Space Binding:
+ *    husky_gpu.c statically bound AS1 once at boot to mcu_root. The bridge parameterizes AS binding
+ *    per client VM (op_vm_bind_as_slot) using the allocated page table root (vm->root_pa).
+ * 4. Contiguous Kernel Memory Deallocation:
+ *    husky_gpu.c allocated memory once at boot with KMA_PERMANENT. The bridge allocates BO backing with
+ *    KMA_DATA | KMA_ZERO and frees it on op_bo_free via kmem_free and ml_io_unmap to prevent kernel memory leaks.
+ * 5. Discrete Sync Objects:
+ *    husky_gpu.c used a hardcoded offset TEST_SYNC inside the monolithic test area. The bridge manages
+ *    independent 4 KiB sync objects (mali_syncobj_t) for each client and queue.
+ */
+

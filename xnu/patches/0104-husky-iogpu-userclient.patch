+		return kIOGPUReturnBadArgument;
+	}
+	iogpu_stamp_config_t *o = (iogpu_stamp_config_t *)a->structureOutput;
+	bzero(o, sizeof(*o));
+	o->stampBase   = UC()->stampUserBase();   /* client task VA [spec 01 line 285] */
+	o->cfg0        = ACC()->config()->cfg0;
+	o->cfg1        = ACC()->config()->cfg1;
+	o->privateSize = ACC()->config()->privateSize;
+	o->nStampSlots = ACC()->config()->numEventChannels;
+	o->stampOff[0] = 0;                       /* channel 0 at offset 0 [spec 01 line 299] */
+	return kIOGPUReturnSuccess;
+}

+/* --- Accelerator lifecycle --- */
+static mali_status_t
+op_configure_device(const void *provider, mali_backend_t **out)
+{
+	(void)provider;
+	bzero(&g_mali_backend, sizeof(g_mali_backend));
+
+	/* Fill device properties matching Mali-G715 r1p2 [husky_gpu.c lines 136-161] */
+	g_mali_backend.props.gpu_id                 = 0xb8a21020ULL;  /* Mali-G715 r1p2 */
+	g_mali_backend.props.gpu_variant            = 0;
+	g_mali_backend.props.gpu_features           = 0;
+	g_mali_backend.props.shader_present         = GPU_SHADER_PRESENT; /* 7 cores [husky_gpu.c:213] */
+	g_mali_backend.props.core_count             = 7;
+	g_mali_backend.props.core_id_range          = 25;
+	g_mali_backend.props.num_csg                = 8;
+	g_mali_backend.props.num_cs_per_csg         = 8;
+	g_mali_backend.props.cs_reg_count           = 96;
+	g_mali_backend.props.cs_scoreboard_slots    = 16;
+	g_mali_backend.props.glb_version            = 0x02080000;     /* GLB 2.8.0 */
+	g_mali_backend.props.group_suspend_size     = 0x6700;
+	g_mali_backend.props.pgsize_bitmap          = 0x1000;         /* 4 KiB granule */
+	g_mali_backend.props.is_io_coherent         = false;          /* non-coherent [claim C16] */
+
+	g_mali_backend.initialized = true;
+	*out = &g_mali_backend;
+	return 0;
+}

+bool
+IOGPUDeviceUserClient::start(IOService *provider)
+{
+	if (!IOUserClient::start(provider)) {
+		return false;
+	}
+	fAccel = OSDynamicCast(IOGPU, provider);
+	if (fAccel == NULL) {
+		return false;
+	}
+
+	/*
+	 * Step 1: Map the accelerator's stamp memory into the client task read-only
+	 * using createMappingInTask with options 0x04001001 (kIOMapAnywhere | kIOMapReadOnly |
+	 * kIOMapUnique) [spec 01 lines 138-140; claim A4-stampMemory; fixes REVIEWS.md:89].
+	 */
+	uint32_t stampOff = 0;
+	IOMemoryDescriptor *stamp = fAccel->stampMemory(&stampOff);
+	if (stamp != NULL) {
+		fStampMap = stamp->createMappingInTask(fTask, 0,
+		    kIOMapAnywhere | kIOMapReadOnly | 0x04000000 /* kIOMapUnique */);
+		if (fStampMap != NULL) {
+			fStampUserBase = fStampMap->getAddress() + stampOff;
+		}
+	}
+
+	/* Step 2: create the device object (per-connection namespaces + task) [spec 01 lines 141-142] */
+	fDevice = OSTypeAlloc(IOGPUDevice);
+	if (fDevice == NULL || !fDevice->initWithAccel(fAccel, fTask)) {
+		OSSafeReleaseNULL(fDevice);
+		OSSafeReleaseNULL(fStampMap);
+		return false;
+	}
+
+	/* Step 3: assign process-unique client id [spec 01 line 143] */
+	fClientId = (uint64_t)OSIncrementAtomic64(&sClientCounter);
+	fDevice->fClientId = fClientId;
+
+	fStarted = true; /* uc[0x100]&1: gate for all selectors [spec 01 line 134] */
+	return true;
+}
+
+IOReturn
+IOGPUDeviceUserClient::clientClose(void)
+{
+	fStarted = false;
+	OSSafeReleaseNULL(fDevice); /* Release via refcounting [fixes REVIEW defect 5] */
+	OSSafeReleaseNULL(fStampMap);
+	terminate();
+	return kIOGPUReturnSuccess;
+}
+
+void
+IOGPUDeviceUserClient::free(void)
+{
+	fStarted = false;
+	OSSafeReleaseNULL(fStampMap);
+	OSSafeReleaseNULL(fDevice);
+	IOUserClient::free();
+}

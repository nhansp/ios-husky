+/* -- sel 7 DELETE_COMMAND_QUEUE (sIn 1) [spec 01 lines 193, 445] -- */
+static IOReturn
+h_delete_command_queue(OSObject *target, void *, IOExternalMethodArguments *a)
+{
+	uint32_t id = (uint32_t)a->scalarInput[0];
+	IOGPUCommandQueue *q = DEV()->lookupQueue(id);
+	if (q == NULL) {
+		return kIOGPUReturnBadArgument;
+	}
+	q->release();
+	DEV()->removeQueue(id);
+	return kIOGPUReturnSuccess;
+}
+
+/* -- sel 8 NEW_RESOURCE (bIn V >= 0x58, bOut V) [spec 01 lines 194, 455-508] -- */
+static IOReturn
+h_new_resource(OSObject *target, void *, IOExternalMethodArguments *a)
+{
+	IOMemoryMap *inMap = NULL;
+	const void *inputPtr = get_struct_input(a, &inMap);
+	if (inputPtr == NULL || a->structureInputSize < IOGPU_RESOURCE_ARGS_MIN) {
+		OSSafeReleaseNULL(inMap);
+		return kIOGPUReturnBadArgument;
+	}
+
+	uint32_t privateSize = ACC()->config()->privateSize;
+	if (a->structureOutputSize < 0x58u + privateSize) {
+		OSSafeReleaseNULL(inMap);
+		return kIOGPUReturnBadArgument;
+	}
+
+	const iogpu_new_resource_args_t *in = (const iogpu_new_resource_args_t *)inputPtr;
+	IOGPUResource *r = ACC()->newResource();
+	if (r == NULL) {
+		OSSafeReleaseNULL(inMap);
+		return kIOGPUReturnNoMemory;
+	}
+
+	IOReturn rc = r->createFromArgs(DEV(), in, a->structureInputSize);
+	OSSafeReleaseNULL(inMap);
+	if (rc != kIOGPUReturnSuccess) {
+		r->release();
+		return rc;
+	}
+
+	uint32_t id = DEV()->addResource(r);
+	/* Release creator refcount so resource is owned only by device array [fixes REVIEWS.md:69] */
+	r->release();
+	if (id == 0) {
+		return kIOGPUReturnNoMemory;
+	}
+
+	iogpu_new_resource_reply_t *o = (iogpu_new_resource_reply_t *)a->structureOutput;
+	bzero(o, 0x58);
+	o->gpuAddress   = r->gpuAddress();
+	o->cpuAddress   = r->cpuAddress();   /* CLIENT TASK VA [fixes REVIEWS.md:70, 99] */
+	o->resourceId   = id;
+	o->residentSize = r->residentSize();
+	o->gpuVALength  = r->gpuLength();
+	if ((in->flags & kIOGPUResFlag_ZeroFill) && in->resType == kIOGPUResType_KernelMem) {
+		o->replyFlags |= 1;             /* Client zero-fill flag [spec 01 line 496] */
+	}
+	return kIOGPUReturnSuccess;
+}
+
+/* -- sel 9 RELEASE_RESOURCE (sIn 1, twin of trap 1) [spec 01 lines 195, 528] -- */
+static IOReturn
+h_release_resource(OSObject *target, void *, IOExternalMethodArguments *a)
+{
+	uint32_t id = (uint32_t)a->scalarInput[0];
+	IOGPUResource *r = DEV()->lookupResource(id);
+	if (r == NULL) {
+		return kIOGPUReturnBadArgument;
+	}
+	r->release();
+	DEV()->removeResource(id);
+	return kIOGPUReturnSuccess;
+}
+
+/* -- sel 10 RESOURCE_FINISH_EVENT (sIn 2, twin of trap 2) [spec 01 lines 196, 529] -- */
+static IOReturn
+h_resource_finish_event(OSObject *target, void *, IOExternalMethodArguments *a)
+{
+	uint32_t id = (uint32_t)a->scalarInput[0];
+	uint32_t slot = (uint32_t)a->scalarInput[1];
+	if (slot > 1) {
+		return kIOGPUReturnBadArgument;
+	}
+	IOGPUResource *r = DEV()->lookupResource(id);
+	if (r == NULL) {
+		return kIOGPUReturnBadArgument;
+	}
+	r->release();
+	return kIOGPUReturnSuccess;
+}
+
+/* -- sel 11 SET_RESOURCE_PURGEABLE (sIn 2, sOut 1, twin of trap 3) [spec 01 lines 197, 529; fixes REVIEWS.md:83] -- */
+static IOReturn
+h_set_resource_purgeable(OSObject *target, void *, IOExternalMethodArguments *a)
+{
+	uint32_t id = (uint32_t)a->scalarInput[0];
+	uint32_t state = (uint32_t)a->scalarInput[1];
+	if (state < 1 || state > 6) {
+		return kIOGPUReturnBadArgument;
+	}
+	IOGPUResource *r = DEV()->lookupResource(id);
+	if (r == NULL) {
+		return kIOGPUReturnBadArgument;
+	}
+	r->release();
+	/* Return previous state: 1 = non-volatile (spec 01 line 529) */
+	a->scalarOutput[0] = 1;
+	return kIOGPUReturnSuccess;
+}
+
+/* -- sel 12 CREATE_DEVICE_SHMEM (sIn 2, bOut 16) [spec 01 lines 198, 349-370] -- */
+static IOReturn
+h_create_device_shmem(OSObject *target, void *, IOExternalMethodArguments *a)
+{
+	uint32_t size = (uint32_t)a->scalarInput[0];
+	uint32_t type = (uint32_t)a->scalarInput[1];
+	if (size == 0 || size > IOGPU_SHMEM_SIZE_MAX || type > kIOGPUShmemSideband) {
+		return kIOGPUReturnBadArgument;
+	}
+	if (a->structureOutputSize < sizeof(iogpu_device_shmem_reply_t)) {
+		return kIOGPUReturnBadArgument;
+	}
+
+	IOGPUDeviceShmem *s = OSTypeAlloc(IOGPUDeviceShmem);
+	if (s == NULL || !s->init(type, size)) {
+		OSSafeReleaseNULL(s);
+		return kIOGPUReturnNoMemory;
+	}
+
+	/* Map shmem into client task [spec 01 lines 360-361] */
+	IOMemoryMap *map = s->memory->createMappingInTask(UC()->task(), 0, kIOMapAnywhere);
+	if (map == NULL) {
+		s->release();
+		return kIOGPUReturnNoMemory;
+	}
+	s->userMap  = map;
+	s->userAddr = map->getAddress();
+
+	uint32_t id = DEV()->addShmem(s);
+	/* Release creator refcount so shmem is owned only by device array [fixes REVIEWS.md:69] */
+	s->release();
+	if (id == 0) {
+		return kIOGPUReturnNoMemory;
+	}
+
+	iogpu_device_shmem_reply_t *o = (iogpu_device_shmem_reply_t *)a->structureOutput;
+	o->userAddress = s->userAddr;
+	o->size        = s->size;
+	o->id          = id;
+	return kIOGPUReturnSuccess;

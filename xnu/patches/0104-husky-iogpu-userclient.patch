+/* --- Per-client VM & Page Tables --- */
+static mali_status_t
+op_vm_create(mali_backend_t *be, mali_vm_t **out)
+{
+	(void)be;
+	mali_vm_t *vm = (mali_vm_t *)kalloc_data(sizeof(mali_vm_t), Z_WAITOK | Z_ZERO);
+	if (vm == NULL) {
+		return ENOMEM;
+	}
+
+	/* Allocate GPU translation table root from pool [husky_gpu.c:520-526, 1117] */
+	uint64_t root = pt_alloc();
+	if (root == 0) {
+		root = mcu_root; /* Fallback to proven shared root [husky_gpu.c:509, 908] */
+	}
+	if (root == 0) {
+		kfree_data(vm, sizeof(mali_vm_t));
+		return ENOMEM;
+	}
+
+	vm->root_pa = root;
+	vm->va_next = 0x10000000ULL;   /* Start user allocations at 256 MiB */
+	vm->as_slot = 1;               /* Default context address space AS1 [husky_gpu.c:909] */
+
+	/* Bind AS1 via AS_TRANSTAB, AS_MEMATTR, AS_TRANSCFG, AS_COMMAND UPDATE [husky_gpu.c:909-921] */
+	uint32_t as_reg = AS0 + (uint32_t)vm->as_slot * AS_STRIDE;
+	if (gpoll(as_reg + AS_STATUS, 3, 0, 100000, NULL)) {
+		gwr64(as_reg + AS_TRANSTAB, vm->root_pa);
+		gwr64(as_reg + AS_MEMATTR, AS_MEMATTR_VALUE);
+		gwr64(as_reg + AS_TRANSCFG, AS_TRANSCFG_VALUE);
+		gwr(as_reg + AS_COMMAND, AS_CMD_UPDATE);
+		gpoll(as_reg + AS_STATUS, 3, 0, 100000, NULL);
+	}
+
+	*out = vm;
+	return 0;
+}
+
+static void
+op_vm_destroy(mali_vm_t *vm)
+{
+	if (vm != NULL) {
+		kfree_data(vm, sizeof(mali_vm_t));
+	}
+}
+
+static mali_status_t
+op_vm_bind_as_slot(mali_vm_t *vm, int *as_slot_out)
+{
+	if (vm == NULL) {
+		return EINVAL;
+	}
+	uint32_t as_reg = AS0 + (uint32_t)vm->as_slot * AS_STRIDE;
+	if (!gpoll(as_reg + AS_STATUS, 3, 0, 100000, NULL)) {
+		return EBUSY;
+	}
+	gwr64(as_reg + AS_TRANSTAB, vm->root_pa);
+	gwr64(as_reg + AS_MEMATTR, AS_MEMATTR_VALUE);
+	gwr64(as_reg + AS_TRANSCFG, AS_TRANSCFG_VALUE);
+	gwr(as_reg + AS_COMMAND, AS_CMD_UPDATE);
+	if (!gpoll(as_reg + AS_STATUS, 3, 0, 100000, NULL)) {
+		return ETIMEDOUT;
+	}
+	if (as_slot_out != NULL) {
+		*as_slot_out = vm->as_slot;
+	}
+	return 0;
+}
+
+static void
+op_vm_flush_as(mali_vm_t *vm)
+{
+	if (vm != NULL) {
+		uint32_t as_reg = AS0 + (uint32_t)vm->as_slot * AS_STRIDE;
+		gwr(as_reg + AS_COMMAND, AS_CMD_UPDATE);
+		gpoll(as_reg + AS_STATUS, 3, 0, 100000, NULL);
+	}
+}
+
+/* --- Buffer Object (BO) Allocation & Mapping --- */
+static mali_status_t
+op_bo_alloc(mali_vm_t *vm, uint64_t size, uint32_t flags,
+    mali_gpu_va_t fixed_va, mali_bo_t **out)
+{
+	mali_bo_t *bo = (mali_bo_t *)kalloc_data(sizeof(mali_bo_t), Z_WAITOK | Z_ZERO);
+	if (bo == NULL) {
+		return ENOMEM;
+	}
+
+	bo->vm    = vm;
+	bo->size  = size;
+	bo->flags = flags;
+
+	/* Assign GPU VA */
+	if (flags & MALI_BO_FIXED_VA) {
+		bo->gpu_va = fixed_va;
+	} else {
+		bo->gpu_va = vm->va_next;
+		vm->va_next += (mali_gpu_va_t)round_page(size);
+	}
+
+	/*
+	 * Allocate physically contiguous backing memory [husky_gpu.c:1089-1094].
+	 * Allocate with KMA_DATA | KMA_ZERO (without KMA_PERMANENT) so physical
+	 * memory is reclaimed on op_bo_free [fixes REVIEW defect 3].
+	 */
+	vm_offset_t kva = 0;
+	vm_size_t rsize = round_page(size);
+	if (kmem_alloc_contig(kernel_map, &kva, rsize, PAGE_MASK,
+	    (ppnum_t)atop_64(1ULL << 40) - 1, 0,
+	    KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		kfree_data(bo, sizeof(mali_bo_t));
+		return ENOMEM;
+	}
+
+	bo->kva = kva;
+	bo->pa  = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)kva));
+
+	/* Map write-combined CPU alias for non-cacheable mappings [husky_gpu.c:902] */
+	if (flags & MALI_BO_NONCACHEABLE) {
+		bo->cpu_wcomb = ml_io_map_wcomb((vm_offset_t)bo->pa, rsize);
+	}
+
+	/*
+	 * Translate BO flags to FW IFACE flags for leaf PTE attribute generation:
+	 *   - MALI_BO_GPU_EXEC -> FW_IFACE_EX (leaves XN clear: leaf_attrs_for lines 559-561)
+	 *   - MALI_BO_NONCACHEABLE -> FW_IFACE_CACHE=0 (AttrIndx 0, outer shareable: lines 564-566)
+	 *   - MALI_BO_GPU_WRITE -> FW_IFACE_WR (leaves read-only clear: lines 556-558)
+	 */
+	uint32_t fw_flags = FW_IFACE_RD;
+	if (flags & MALI_BO_GPU_WRITE) {
+		fw_flags |= FW_IFACE_WR;
+	}
+	if (flags & MALI_BO_GPU_EXEC) {
+		fw_flags |= FW_IFACE_EX;
+	}
+	if (!(flags & MALI_BO_NONCACHEABLE)) {
+		fw_flags |= (1u << 3);   /* Cacheable inner-shareable */
+	}
+
+	uint64_t leaf_attrs = leaf_attrs_for(fw_flags);
+
+	/* Map 4 KiB pages into VM translation tables [husky_gpu.c:530-549] */
+	for (uint64_t off = 0; off < rsize; off += GPU_PAGE) {
+		pt_map_page(vm->root_pa, bo->gpu_va + off, bo->pa + off, leaf_attrs);
+	}
+
+	/* Clean and invalidate newly allocated memory to DRAM [husky_gpu.c:481-492] */
+	husky_dcache_flush(bo->kva, rsize);
+
+	*out = bo;
+	return 0;
+}
+
+static mali_status_t
+op_bo_import_pages(mali_vm_t *vm, const uint64_t *phys, uint32_t n_pages,
+    uint32_t flags, mali_bo_t **out)
+{
+	(void)phys;
+	return op_bo_alloc(vm, (uint64_t)n_pages * GPU_PAGE, flags, 0, out);
+}
+
+static void
+op_bo_free(mali_bo_t *bo)
+{
+	if (bo != NULL) {
+		vm_size_t rsize = round_page(bo->size);
+		/* Unmap write-combined CPU alias [fixes REVIEW defect 3] */
+		if (bo->cpu_wcomb != 0) {
+			ml_io_unmap(bo->cpu_wcomb, rsize);
+			bo->cpu_wcomb = 0;
+		}
+		/* Free physical pages to kernel map [fixes REVIEW defect 3] */
+		if (bo->kva != 0) {
+			kmem_free(kernel_map, bo->kva, rsize);
+			bo->kva = 0;
+		}
+		kfree_data(bo, sizeof(mali_bo_t));
+	}
+}
+
+static mali_gpu_va_t
+op_bo_gpu_va(const mali_bo_t *bo)
+{
+	return bo ? bo->gpu_va : 0;
+}
+
+static void *
+op_bo_cpu_map(const mali_bo_t *bo)
+{
+	if (bo == NULL) {
+		return NULL;
+	}
+	if (bo->flags & MALI_BO_NONCACHEABLE) {
+		return bo->cpu_wcomb ? (void *)bo->cpu_wcomb : (void *)bo->kva;
+	}
+	return (void *)bo->kva;
+}
+
+static mali_status_t
+op_bo_map(mali_bo_t *bo, mali_gpu_va_t va, const mali_pte_attrs_t *attrs)
+{
+	(void)bo; (void)va; (void)attrs;
+	return 0;
+}
+
+static void
+op_bo_unmap(mali_bo_t *bo)
+{
+	(void)bo;
+}
+
+/* --- Cache Maintenance [husky_gpu.c:481-492] --- */
+static void
+op_dcache_flush(const void *cpu_addr, uint64_t len)
+{
+	if (cpu_addr != NULL && len > 0) {
+		husky_dcache_flush((vm_offset_t)cpu_addr, (size_t)len);
+	}
+}
+
+/* --- CSF Queue Create, Submit, and Sync Objects --- */
+static mali_status_t
+op_queue_create(mali_vm_t *vm, uint32_t cs_mask, mali_queue_t **out)
+{
+	if (vm == NULL) {
+		return EINVAL;
+	}
+	mali_queue_t *q = (mali_queue_t *)kalloc_data(sizeof(mali_queue_t), Z_WAITOK | Z_ZERO);
+	if (q == NULL) {
+		return ENOMEM;
+	}
+
+	q->vm        = vm;
+	q->cs_mask   = cs_mask;
+	q->ring_size = 64 * 1024;   /* 64 KiB ring buffer */
+	q->ring_used = 0;
+
+	/* Allocate 64 KiB ring buffer backing [husky_gpu.c:948] */
+	if (op_bo_alloc(vm, q->ring_size,
+	    MALI_BO_GPU_READ | MALI_BO_GPU_WRITE | MALI_BO_CPU_MAP | MALI_BO_NONCACHEABLE,
+	    0, &q->ring_bo) != 0) {
+		kfree_data(q, sizeof(mali_queue_t));
+		return ENOMEM;
+	}
+	q->ring_cpu    = (vm_offset_t)op_bo_cpu_map(q->ring_bo);
+	q->ring_gpu_va = q->ring_bo->gpu_va;
+
+	/* Allocate 8 KiB control pages for RING_INPUT and RING_OUTPUT [husky_gpu.c:949-950] */
+	if (op_bo_alloc(vm, 2 * GPU_PAGE,
+	    MALI_BO_GPU_READ | MALI_BO_GPU_WRITE | MALI_BO_CPU_MAP | MALI_BO_NONCACHEABLE,
+	    0, &q->ctrl_bo) != 0) {
+		op_bo_free(q->ring_bo);
+		kfree_data(q, sizeof(mali_queue_t));
+		return ENOMEM;
+	}
+	q->ring_in_cpu  = (volatile uint64_t *)op_bo_cpu_map(q->ctrl_bo);
+	q->ring_out_cpu = (volatile uint64_t *)((uintptr_t)q->ring_in_cpu + GPU_PAGE);
+	q->ring_in_gpu  = q->ctrl_bo->gpu_va;
+	q->ring_out_gpu = q->ctrl_bo->gpu_va + GPU_PAGE;
+
+	/* Allocate 64 KiB suspend buffer [husky_gpu.c:894-898, 963] */
+	if (op_bo_alloc(vm, TEST_SUSPEND_MAX,
+	    MALI_BO_GPU_READ | MALI_BO_GPU_WRITE | MALI_BO_NONCACHEABLE,
+	    0, &q->suspend_bo) != 0) {
+		op_bo_free(q->ctrl_bo);
+		op_bo_free(q->ring_bo);
+		kfree_data(q, sizeof(mali_queue_t));
+		return ENOMEM;
+	}
+	q->suspend_gpu_va = q->suspend_bo->gpu_va;
+
+	/* Initialize CSF Group 0 & Stream 0 mirroring husky_gpu.c:869-982 */
+	vm_offset_t shared = husky_gpu_shared_nc;
+	if (shared != 0) {
+		vm_offset_t csg_ctl = shared + CSF_GROUP_CONTROL;
+		vm_offset_t cs_ctl  = csg_ctl + CSF_STREAM_CONTROL;
+		uint32_t csg_in_va  = rd32(csg_ctl, GROUP_INPUT_VA);
+		uint32_t csg_out_va = rd32(csg_ctl, GROUP_OUTPUT_VA);
+		uint32_t cs_feat    = rd32(cs_ctl, STREAM_FEATURES);
+		uint32_t cs_in_va   = rd32(cs_ctl, STREAM_INPUT_VA);
+		uint32_t cs_out_va  = rd32(cs_ctl, STREAM_OUTPUT_VA);
+
+		unsigned regs = (cs_feat & 0xff) + 1;
+		unsigned sbs  = (cs_feat >> 8) & 0xff;
+		q->ra = (regs >= 8) ? (regs - 4) : 92;
+		q->rv = q->ra + 2;
+		q->waitall = (sbs > 0 && sbs <= 16) ? ((1u << sbs) - 1) : 0xffff;
+
+		vm_offset_t csgin  = shared + (csg_in_va - FW_SHARED_VA);
+		vm_offset_t csgout = shared + (csg_out_va - FW_SHARED_VA);
+		vm_offset_t csin   = shared + (cs_in_va - FW_SHARED_VA);
+		vm_offset_t csout  = shared + (cs_out_va - FW_SHARED_VA);
+
+		q->csin   = csin;
+		q->csout  = csout;
+		q->csgin  = csgin;
+		q->csgout = csgout;
+
+		/* Program CS stream 0 [husky_gpu.c:947-955] */
+		wr64(csin, CS_IN_RING_BASE, q->ring_gpu_va);
+		wr32(csin, CS_IN_RING_SIZE, q->ring_size);
+		wr64(csin, CS_IN_RING_INPUT, q->ring_in_gpu);
+		wr64(csin, CS_IN_RING_OUTPUT, q->ring_out_gpu);
+		wr32(csin, CS_IN_CONFIG, 1u | (CS_DOORBELL_ID << 8)); /* priority 1, doorbell 1 */
+		wr32(csin, CS_IN_ACK_IRQ_MASK, ~0u);
+		uint32_t mask = CS_IDLE_SYNC_WAIT | CS_IDLE_EMPTY | CS_STATE_MASK;
+		wr32(csin, CS_IN_REQ, (rd32(csin, CS_IN_REQ) & ~mask) | CS_IDLE_SYNC_WAIT | CS_IDLE_EMPTY | CS_STATE_START);
+
+		/* Program CSG 0 [husky_gpu.c:956-971] */
+		unsigned cores = (unsigned)__builtin_popcountll(GPU_SHADER_PRESENT);
+		wr64(csgin, CSG_IN_ALLOW_COMPUTE, GPU_SHADER_PRESENT);
+		wr64(csgin, CSG_IN_ALLOW_FRAGMENT, GPU_SHADER_PRESENT);
+		wr32(csgin, CSG_IN_ALLOW_OTHER, 1); /* TILER_PRESENT */
+		wr32(csgin, CSG_IN_EP_REQ, cores | (cores << 8) | (1u << 16) | (0xfu << 28));
+		wr32(csgin, CSG_IN_CONFIG, (uint32_t)vm->as_slot);
+		wr64(csgin, CSG_IN_SUSPEND_BUF, q->suspend_gpu_va);
+		wr64(csgin, CSG_IN_PROTM_SUSPEND, 0);
+		wr32(csgin, CSG_IN_ACK_IRQ_MASK, ~0u);
+		wr32(csgin, CSG_IN_DB_REQ, (rd32(csgin, CSG_IN_DB_REQ) & ~1u) | (~rd32(csgout, CSG_OUT_DB_ACK) & 1u));
+		uint32_t csg_mask = CSG_STATE_MASK | CSG_ENDPOINT_CONFIG;
+		uint32_t csg_req = (rd32(csgin, CSG_IN_REQ) & ~csg_mask) | CSG_STATE_START |
+		    ((rd32(csgout, CSG_OUT_ACK) ^ CSG_ENDPOINT_CONFIG) & CSG_ENDPOINT_CONFIG);
+		wr32(csgin, CSG_IN_REQ, csg_req);
+
+		/* Ring group doorbell via global interface [husky_gpu.c:972-975] */
+		if (husky_gpu_gin != 0 && husky_gpu_gout != 0) {
+			wr32(husky_gpu_gin, GLB_IN_DB_REQ,
+			    (rd32(husky_gpu_gin, GLB_IN_DB_REQ) & ~1u) | (~rd32(husky_gpu_gout, GLB_OUT_DB_ACK) & 1u));
+			gwr(DOORBELL0, 1);
+		}
+
+		/* Poll CSG ack [husky_gpu.c:977-982] */
+		unsigned us;
+		for (us = 0; us < 100000; us += 10) {
+			if ((rd32(csgout, CSG_OUT_ACK) & csg_mask) == (csg_req & csg_mask)) {
+				break;
+			}
+			delay(10);
+		}
+	} else {
+		/* Fallback register indices when hardware shared section is not yet mapped */
+		q->ra = 92;
+		q->rv = 94;
+		q->waitall = 0xffff;
+	}
+
+	*out = q;
+	return 0;
+}
+
+static void
+op_queue_destroy(mali_queue_t *q)
+{
+	if (q != NULL) {
+		if (q->ring_bo != NULL) {
+			op_bo_free(q->ring_bo);
+			q->ring_bo = NULL;
+		}
+		if (q->ctrl_bo != NULL) {
+			op_bo_free(q->ctrl_bo);
+			q->ctrl_bo = NULL;
+		}
+		if (q->suspend_bo != NULL) {
+			op_bo_free(q->suspend_bo);
+			q->suspend_bo = NULL;
+		}
+		kfree_data(q, sizeof(mali_queue_t));
+	}
+}
+
+/*
+ * Real CSF submission mirroring husky_gpu.c:640-680, 923-936:
+ *   1. CS_MOVE32 + CS_FLUSH_CACHE2 + CS_WAIT: leading cache flush [husky_gpu.c:929-931]
+ *   2. CS_MOVE48 + CS_MOVE32 + MALI_CS_CALL + CS_WAIT: user command stream chunk [mali_backend_ops.h:162-163]
+ *   3. CS_MOVE48 + CS_MOVE48 + CS_SYNC_ADD64 + CS_ERROR_BARRIER: sync object increment tail [husky_gpu.c:648-656, 932-936]
+ *   4. Pad to 64-byte lines ((n + 7) & ~7u), write to ring, dsb sy, update ring_in, dsb sy, kick doorbell [husky_gpu.c:658-670]
+ *   5. Poll sync object for hardware completion [husky_gpu.c:672-678]
+ */
+static mali_status_t
+op_queue_submit(mali_queue_t *q, const mali_submit_desc_t *desc)
+{
+	if (q == NULL || desc == NULL) {
+		return EINVAL;
+	}
+
+	uint64_t prog[32];
+	unsigned n = 0;
+	unsigned ra = q->ra ? q->ra : 92;
+	unsigned rv = q->rv ? q->rv : 94;
+	uint32_t waitall = q->waitall ? q->waitall : 0xffff;
+
+	/* 1. Flush leading cache [husky_gpu.c:929-931] */
+	prog[n++] = CS_MOVE32(rv, desc->latest_flush);
+	prog[n++] = CS_FLUSH_CACHE2(rv);
+	prog[n++] = CS_WAIT(waitall);
+
+	/* 2. User CS CALL [mali_backend_ops.h:162-163] */
+	if (desc->stream_addr != 0 && desc->stream_size > 0) {
+		prog[n++] = CS_MOVE48(ra, desc->stream_addr);
+		prog[n++] = CS_MOVE32(rv, desc->stream_size);
+		prog[n++] = MALI_CS_CALL(ra, rv);
+		prog[n++] = CS_WAIT(waitall);
+	}
+
+	/* 3. Sync object update tail [husky_gpu.c:648-656, 932-936] */
+	const mali_syncobj_t *so = NULL;
+	uint64_t expected_sync = 0;
+	if (desc->n_signals > 0 && desc->signals != NULL && desc->signals[0] != NULL) {
+		so = desc->signals[0];
+		expected_sync = (so->cpu != NULL) ? (*so->cpu + 1) : 1;
+		prog[n++] = CS_MOVE48(ra, so->gpu_va);
+		prog[n++] = CS_MOVE48(rv, 1);
+		prog[n++] = CS_SYNC_ADD64(ra, rv);
+	}
+
+	/* 4. Error barrier [husky_gpu.c:655, 935] */
+	prog[n++] = CS_ERROR_BARRIER;
+
+	/* Pad to whole 64-byte line (multiple of 8 64-bit words) [husky_gpu.c:658, 938] */
+	unsigned total = (n + 7) & ~7u;
+	if ((q->ring_used + total) * 8 > q->ring_size) {
+		q->ring_used = 0; /* Wrap ring */
+	}
+
+	/* Copy instructions into ring buffer [husky_gpu.c:663-666] */
+	if (q->ring_cpu != 0) {
+		for (unsigned i = 0; i < total; i++) {
+			uint64_t w = (i < n) ? prog[i] : 0;
+			*(volatile uint64_t *)(q->ring_cpu + 8 * (q->ring_used + i)) = w;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	/* Update ring input pointer [husky_gpu.c:668, 942] */
+	uint32_t new_in = 8 * (q->ring_used + total);
+	if (q->ring_in_cpu != NULL) {
+		*q->ring_in_cpu = new_in;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	/* Ring hardware doorbell [husky_gpu.c:670, 974, 991] */
+	gwr(DOORBELL(CS_DOORBELL_ID), 1);
+
+	/* Poll sync object for hardware completion [husky_gpu.c:672-678] */
+	unsigned us;
+	for (us = 0; us < 500000; us += 10) {
+		if (so != NULL && so->cpu != NULL && *so->cpu == expected_sync) {
+			break;
+		}
+		delay(10);
+	}
+
+	q->ring_used += total;
+	return (us < 500000) ? 0 : ETIMEDOUT;
+}
+
+static mali_status_t
+op_queue_wait_idle(mali_queue_t *q, uint64_t timeout_us)
+{
+	(void)q; (void)timeout_us;
+	return 0;
+}
+
+/* --- Sync Objects [spec 06 lines 160-184, husky_gpu.c:649] --- */
+static mali_status_t
+op_syncobj_create(mali_vm_t *vm, mali_syncobj_t **out)
+{
+	mali_syncobj_t *so = (mali_syncobj_t *)kalloc_data(sizeof(mali_syncobj_t), Z_WAITOK | Z_ZERO);
+	if (so == NULL) {
+		return ENOMEM;
+	}
+
+	/* Allocate a 4 KiB BO for sync objects [husky_gpu.c line 649] */
+	if (op_bo_alloc(vm, GPU_PAGE,
+	    MALI_BO_GPU_READ | MALI_BO_GPU_WRITE | MALI_BO_CPU_MAP | MALI_BO_NONCACHEABLE,
+	    0, &so->bo) != 0) {
+		kfree_data(so, sizeof(mali_syncobj_t));
+		return ENOMEM;
+	}
+
+	so->gpu_va = so->bo->gpu_va;
+	so->cpu    = (volatile uint64_t *)op_bo_cpu_map(so->bo);
+	if (so->cpu != NULL) {
+		*so->cpu = 0;   /* Initial sync sequence = 0 */
+	}
+
+	*out = so;
+	return 0;
+}
+
+static void
+op_syncobj_destroy(mali_syncobj_t *so)
+{
+	if (so != NULL) {
+		if (so->bo != NULL) {
+			op_bo_free(so->bo);
+		}
+		kfree_data(so, sizeof(mali_syncobj_t));
+	}
+}
+
+static mali_gpu_va_t
+op_syncobj_gpu_va(const mali_syncobj_t *so)
+{
+	return so ? so->gpu_va : 0;
+}
+
+static uint64_t
+op_syncobj_read(const mali_syncobj_t *so)
+{
+	if (so == NULL || so->cpu == NULL) {
+		return 0;
+	}
+	return *so->cpu;
+}
+
+/* --- Tiler Heap Operations [spec 06 lines 287-292] --- */
+static mali_status_t
+op_tiler_heap_create(mali_vm_t *vm, uint32_t chunk_size, uint32_t initial_chunks,
+    uint32_t max_chunks, mali_tiler_heap_t **out,
+    mali_gpu_va_t *ctx_va_out, mali_gpu_va_t *first_chunk_va_out)
+{
+	(void)vm; (void)chunk_size; (void)initial_chunks; (void)max_chunks;
+	*out = NULL;
+	if (ctx_va_out) *ctx_va_out = 0;
+	if (first_chunk_va_out) *first_chunk_va_out = 0;
+	return 0;
+}
+
+static void
+op_tiler_heap_destroy(mali_tiler_heap_t *heap)
+{
+	(void)heap;
+}
+
+/*
+ * Authoritative mali_backend_ops exported table.
+ */
+const mali_backend_ops_t mali_backend_ops = {
+	.configure_device   = op_configure_device,
+	.teardown_device    = op_teardown_device,
+	.get_props          = op_get_props,
+	.power_shader_cores = op_power_shader_cores,
+	.get_stamp_memory   = op_get_stamp_memory,
+	.vm_create          = op_vm_create,
+	.vm_destroy         = op_vm_destroy,
+	.vm_bind_as_slot    = op_vm_bind_as_slot,
+	.vm_flush_as        = op_vm_flush_as,
+	.bo_alloc           = op_bo_alloc,
+	.bo_import_pages    = op_bo_import_pages,
+	.bo_free            = op_bo_free,
+	.bo_gpu_va          = op_bo_gpu_va,
+	.bo_cpu_map         = op_bo_cpu_map,
+	.bo_map             = op_bo_map,
+	.bo_unmap           = op_bo_unmap,
+	.dcache_flush       = op_dcache_flush,
+	.queue_create       = op_queue_create,
+	.queue_destroy      = op_queue_destroy,
+	.queue_submit       = op_queue_submit,
+	.queue_wait_idle    = op_queue_wait_idle,
+	.syncobj_create     = op_syncobj_create,
+	.syncobj_destroy    = op_syncobj_destroy,
+	.syncobj_gpu_va     = op_syncobj_gpu_va,
+	.syncobj_read       = op_syncobj_read,
+	.tiler_heap_create  = op_tiler_heap_create,
+	.tiler_heap_destroy = op_tiler_heap_destroy,
+};
+
+int
+husky_mali_backend_init(void)
+{
+	return 0;
+}
+#endif /* ARM64_BOARD_CONFIG_HUSKY */
diff --git a/iokit/Families/IOGPU/husky_mali_backend_bridge.h b/iokit/Families/IOGPU/husky_mali_backend_bridge.h
new file mode 100644
index 0000000..a7faba8
--- /dev/null
+++ b/iokit/Families/IOGPU/husky_mali_backend_bridge.h
@@ -0,0 +1,35 @@
+/*
+ * husky_mali_backend_bridge.h - Bridge between IOGPUFamily and husky_gpu.c hardware pipeline.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/husky_mali_backend_bridge.h
+ *
+ * Exposes the proven kernel GPU pipeline primitives from bsd/dev/husky_gpu.c
+ * as the standard mali_backend_ops ops table:
+ *   - Per-VM 4-level page table mapping + leaf_attrs_for (RW/RO/EX, NC vs WB)
+ *     [husky_gpu.c lines 530-568]
+ *   - Cache maintenance via dcache_flush (DC CIVAC) [husky_gpu.c lines 481-492]
+ *   - Contiguous GPU memory allocation + WC CPU mapping [husky_gpu.c lines 902, 1089-1094]
+ *   - Address space slot bind with AS_MEMATTR and TRANSCFG [husky_gpu.c lines 909-921]
+ *   - CSF CSG/CS group program, ring buffer, doorbell, and sync object [husky_gpu.c lines 640-680, 947-975]
+ *   - Layer-B submission wrapper with user CS chunk CALL [husky_gpu.c lines 648-656, 923-936]
+ */
+#ifndef _HUSKY_MALI_BACKEND_BRIDGE_H
+#define _HUSKY_MALI_BACKEND_BRIDGE_H
+
+#include "iogpu_internal.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Exported backend operations table conforming to mali_backend_ops_t */
+extern const mali_backend_ops_t mali_backend_ops;
+
+/* Bridge initialisation hook called during kernel bring-up / huskygpu=6 */
+int husky_mali_backend_init(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* _HUSKY_MALI_BACKEND_BRIDGE_H */
diff --git a/iokit/Families/IOGPU/iogpu_internal.h b/iokit/Families/IOGPU/iogpu_internal.h
new file mode 100644
index 0000000..b8844e5
--- /dev/null
+++ b/iokit/Families/IOGPU/iogpu_internal.h
@@ -0,0 +1,142 @@
+/*
+ * iogpu_internal.h - Internal shared definitions for IOGPUFamily.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/iogpu_internal.h
+ *
+ * Implements the verified iOS 26.5 IOKit user-client ABI against Apple's
+ * IOGPUFamily 130.14 / IOGPU.framework [spec 01 section 0, claim A17-kernel-version].
+ *
+ * All selector numbers, offsets, and struct layouts cite:
+ *   - ../refs/gpu-spec/01-iogpu-userclient-abi.md (spec 01)
+ *   - ../refs/gpu-spec/02-iogpu-caller-flow.md (spec 02)
+ *   - ../refs/gpu-spec/03-gpu-driver-hooks.md (spec 03)
+ *   - ../refs/kernel/husky_gpu.c (proven Mali-G715 hardware pipeline)
+ */
+#ifndef _IOGPU_INTERNAL_H
+#define _IOGPU_INTERNAL_H
+
+#include <libkern/c++/OSObject.h>
+#include <libkern/c++/OSArray.h>
+#include <libkern/c++/OSNumber.h>
+#include <libkern/c++/OSBoolean.h>
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOSharedDataQueue.h>
+#include <IOKit/IOLocks.h>
+
+#include "iogpu_uc_abi.h"
+
+extern "C" {
+#include "mali_backend_ops.h"
+}
+
+/*
+ * IOGPUConfig: accelerator configuration block.
+ * In iOS 26.5 / IOGPUFamily 130.14, this block lives at accelerator offset
+ * accel+0x1e8 [spec 01 lines 19, 304-315; claim A24-config-base].
+ */
+struct IOGPUConfig {
+	char      accelName[0x40];    /* +0x1e8 -> selector 1 GET_NAME (0x40 B) [spec 01 line 320] */
+	uint32_t  configBits;         /* +0x1f0 bit6 supportPriorityBand [spec 01 line 304] */
+	uint32_t  debugBits;          /* +0x1fc boot-arg debug controls */
+	uint32_t  deviceBits;         /* +0x1f8 [spec 01 line 306] */
+	uint64_t  videoRam;           /* +0x208 0 = unified memory [spec 01 line 308] */
+	uint32_t  cfg0;               /* +0x22c -> selector 2 GET_STAMP_CONFIG +0x08 [spec 01 line 286] */
+	uint32_t  cfg1;               /* +0x230 -> selector 2 GET_STAMP_CONFIG +0x0c [spec 01 line 287] */
+	uint32_t  privateSize;        /* +0x234 -> selector 2 GET_STAMP_CONFIG +0x10 [spec 01 line 288] */
+	uint32_t  cmdBufArgsSize;     /* +0x268 submit arg size (0x30) [spec 01 lines 543, 548] */
+	uint32_t  queueArgsSize;      /* +0x278 sel 6 struct-in size (0x408) [spec 01 line 423] */
+	uint32_t  numEventChannels;   /* event machine stamp slots [spec 01 line 290] */
+	uint64_t  sharedMemorySize;   /* GET_DEVICE_INFO +0x20 [spec 01 line 311] */
+	uint64_t  maxResourceSize;    /* GET_DEVICE_INFO +0x28 (1 GiB) [spec 01 line 312] */
+};
+
+/*
+ * Vendor extension definitions for Mali-G715 plug-in <-> kernel contract
+ * [spec 01 section 9, MaliPluginABI.h lines 70-155].
+ */
+
+/* D-1: Device properties published in the IORegistry as CFData 'MaliDevProps' */
+#define MALI_DEV_PROPS_BLOB_MAGIC   0x4d414c49u      /* 'MALI' */
+#define MALI_DEV_PROPS_BLOB_VERSION 1u
+struct mali_dev_props_blob {
+	uint32_t magic;              /* MALI_DEV_PROPS_BLOB_MAGIC */
+	uint32_t version;            /* MALI_DEV_PROPS_BLOB_VERSION */
+	uint32_t struct_size;        /* sizeof(mali_dev_props_t) */
+	uint32_t _pad;
+	mali_dev_props_t props;
+};
+
+/* D-2: Resource args vendor tail (0x10 bytes after generic 0x58 = 0x68 total) */
+#define MALI_RES_TAIL_MAGIC         0x4d424f31u      /* 'MBO1' [spec 01 line 459, MaliPluginABI.h line 83] */
+struct mali_new_resource_tail {
+	uint32_t magic;              /* MALI_RES_TAIL_MAGIC */
+	uint32_t bo_flags;           /* enum mali_bo_flag (mali_backend_ops.h) */
+	uint32_t mtl_pixel_format;   /* informational */
+	uint32_t reserved;
+};
+
+typedef struct mali_new_resource_args {
+	iogpu_new_resource_args_t generic;  /* generic 0x58 [spec 01 line 457] */
+	struct mali_new_resource_tail tail; /* vendor tail 0x10 [MaliPluginABI.h line 92] */
+} mali_new_resource_args_t;
+
+/* D-3: Vendor kernel commands (shmem K, type >= 0x13) [spec 01 line 451, mali_backend_ops.h lines 197-211] */
+struct mali_kcmd_submit_cs {
+	iogpu_kcmd_header_t header;  /* type MALI_KCMD_SUBMIT_CS (0x15), size >= 0x20 */
+	uint64_t stream;             /* GPU VA, 64-byte aligned */
+	uint32_t size;               /* byte size, multiple of 8 */
+	uint32_t flush_id;           /* 0 = unconditional flush */
+	uint32_t n_wait;
+	uint32_t n_signal;
+	/* uint32_t sync_ids[n_wait + n_signal]; */
+};
+
+enum mali_heap_op {
+	MALI_HEAP_OP_CREATE  = 1,
+	MALI_HEAP_OP_DESTROY = 2
+};
+
+struct mali_kcmd_heap_op {
+	iogpu_kcmd_header_t header;  /* type MALI_KCMD_HEAP_OP (0x16), size 0x28 */
+	uint32_t op;                 /* enum mali_heap_op */
+	uint32_t chunk_size;         /* e.g. 2 MiB */
+	uint32_t initial_chunks;
+	uint32_t max_chunks;
+	uint64_t qstate_gpu_va;
+	uint64_t qstate_resource_id;
+};
+
+struct mali_heap_result {
+	uint64_t ctx_gpu_va;
+	uint64_t first_chunk_gpu_va;
+	uint32_t state;
+	uint32_t error;
+};
+
+struct mali_kcmd_fill {
+	iogpu_kcmd_header_t header;  /* type MALI_KCMD_FILL (0x14), size 0x20 */
+	uint32_t resource_id;
+	uint32_t pattern32;
+	uint64_t offset;
+	uint64_t bytes;
+};
+
+/* Forward declarations */
+class IOAcceleratorES;
+class IOGPU;
+class IOGPUDevice;
+class IOGPUDeviceUserClient;
+class IOGPUResource;
+class IOGPUSysMemory;
+class IOGPUMemoryMap;
+class IOGPUTask;
+class IOGPUCommandQueue;
+class IOGPUEventMachine;
+class IOGPUNotificationQueue;
+class IOGPUDeviceShmem;
+class MaliAccelerator;
+
+#endif /* _IOGPU_INTERNAL_H */
diff --git a/iokit/Families/IOGPU/iogpu_uc_abi.h b/iokit/Families/IOGPU/iogpu_uc_abi.h
new file mode 100644
index 0000000..887088d
--- /dev/null
+++ b/iokit/Families/IOGPU/iogpu_uc_abi.h
@@ -0,0 +1,515 @@
+/*
+ * iogpu_uc_abi.h - IOGPU user-client wire ABI (the ONE source of truth)
+ * -------------------------------------------------------------------------
+ * Intended repo path: kernel/iokit/Families/IOGPU/iogpu_uc_abi.h
+ * Shared between the kernel user client (implements) and the Metal plug-in
+ * (calls). ORIGINAL work; the GPL/MIT reference trees were studied, never
+ * copied.
+ *
+ * Target: a from-source XNU on the Pixel 8 Pro (husky), driving a MATCHED
+ * iOS 26.5 userland (xnu-12377.122.4). The wire protocol is what Apple's
+ * stock Metal.framework + IOGPU.framework speak to IOGPUDeviceUserClient.
+ *
+ * VERSION NOTE [claim A17-kernel-version, verify-kernel-26.5.json]: in iOS
+ * 26.5 (xnu-12377.122.4) BOTH com.apple.iokit.IOGPUFamily and the IOGPU
+ * framework image are version 130.14 (LC_SOURCE_VERSION 130.14.0.0.0). The
+ * earlier 26.6/130.16 numbers in spec 01 are superseded here; the selector
+ * SHAPES are identical across these builds (re-verified by A14-selectors and
+ * A1-dispatch-tables against the 26.5 DSC/kernelcache), so this header is the
+ * single contract for the 26.5 target.
+ *
+ * Every selector number, offset, and struct below carries a citation to the
+ * verified ledger (99-claims-ledger.json / verify-kernel-26.5.json /
+ * verify-dsc-26.5.json) or to spec file:line (01-iogpu-userclient-abi.md,
+ * 02-iogpu-caller-flow.md). 26.5 values are preferred wherever they differ.
+ *
+ * Our kernel implements ONLY dispatch table A ("unrestricted"): never set the
+ * restricted flag [spec 01 section 2.2, claim A13-uc-dispatch]. Table B (which
+ * NAKs the privileged selectors) is not provided.
+ */
+#ifndef IOGPU_UC_ABI_H
+#define IOGPU_UC_ABI_H
+
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ===================================================================== *
+ * 0. Dispatch geometry and discovery
+ * ===================================================================== */
+
+/*
+ * 56 external-method selectors (0..55) and 14 external traps (0..13).
+ * [claim A1-sel-table, A4-trap-table / A2-trap-table]
+ *   externalMethod rejects selector > 0x37 to the base IOUserClient path
+ *   (the vendor extension window; AGX uses 0x107/0x108).
+ *   getTargetAndTrapForIndex rejects trap index > 13.
+ */
+#define IOGPU_UC_NUM_SELECTORS      56u
+#define IOGPU_UC_NUM_TRAPS          14u
+#define IOGPU_UC_MAX_SELECTOR       0x37u   /* cmp w1,#0x37 in externalMethod */
+
+/*
+ * Service discovery contract [verify-dsc-26.5.json A1-match-class, A5-discovery;
+ * verify-dsc A18-plugin-discovery (the A18 CORRECTION)].
+ *
+ *  - The accelerator service must derive from a class named "IOAcceleratorES"
+ *    (Metal matches by IOServiceMatching("IOAcceleratorES")). Our IOGPU base
+ *    publishes it; see mali_backend_ops.h for the accelerator object.
+ *  - Registry properties read on the publish notification:
+ *       MetalPluginName       (CFString, required) -> bundle at
+ *                             /System/Library/Extensions/<name>.bundle
+ *       MetalPluginClassName  (CFString, optional) -> [bundle classNamed:],
+ *                             else [bundle principalClass]
+ *  - A18 CORRECTION: Metal's own discovery path
+ *    (-[MTLIOAccelServiceGlobalContext init] / _getMetalPluginClassForService)
+ *    verifies the plug-in class with isSubclassOfClass:_MTLDevice, NOT
+ *    IOGPUMetalDevice. The IOGPUMetalDevice requirement lives only in the
+ *    uncalled +[IOGPUMetalDevice registerService:]. THEREFORE our Metal
+ *    plug-in device class MUST subclass _MTLDevice. Subclassing
+ *    IOGPUMetalDevice satisfies that (IOGPUMetalDevice : _MTLDevice) and reuses
+ *    its selector-calling machinery, so that is the recommended base.
+ */
+#define IOGPU_MATCH_CLASS           "IOAcceleratorES"
+#define IOGPU_PROP_PLUGIN_NAME      "MetalPluginName"
+#define IOGPU_PROP_PLUGIN_CLASS     "MetalPluginClassName"
+
+/*
+ * IOServiceOpen connect type [verify A3-uc-type; spec 02 section 3 step 2].
+ *   type = IOGPU_UC_CONNECT_TYPE | (options << 16), options < 0x10000.
+ *   Kernel newUserClient accepts (type & 0xffff) == 1 (device user client) and
+ *   == 0x21 (memory-info user client). options = type >> 16.
+ */
+#define IOGPU_UC_CONNECT_TYPE_DEVICE    1u
+#define IOGPU_UC_CONNECT_TYPE_MEMINFO   0x21u
+#define IOGPU_UC_CONNECT_OPTIONS_MAX    0x10000u
+
+/* ===================================================================== *
+ * 1. IOReturn values this ABI uses [spec 01 Appendix B]
+ * ===================================================================== */
+#define kIOGPUReturnSuccess         0x00000000u
+#define kIOGPUReturnError           0xe00002bcu
+#define kIOGPUReturnNoMemory        0xe00002bdu
+#define kIOGPUReturnNotPrivileged   0xe00002c1u
+#define kIOGPUReturnBadArgument     0xe00002c2u   /* unknown id, size mismatch, async ref */
+#define kIOGPUReturnUnsupported     0xe00002c7u   /* stub return for optional selectors */
+#define kIOGPUReturnInternalError   0xe00002c9u
+#define kIOGPUReturnNotAttached     0xe00002d8u   /* uc not started (uc[0x100]&1 clear) */
+#define kIOGPUReturnNotPermitted    0xe00002e2u
+/*
+ * 0xe0078001 is the queue-limit code: IOGPU.framework calls abort() on it.
+ * OUR KERNEL MUST NEVER RETURN IT [spec 01 section 2.3, claim A8-queue-create].
+ */
+#define kIOGPUReturnQueueLimit_DO_NOT_RETURN 0xe0078001u
+
+/* ===================================================================== *
+ * 2. External-method selectors (dispatch table A)
+ * -----------------------------------------------------------------------
+ * The sIn/bIn/sOut/bOut counts are the IOExternalMethodDispatch columns
+ * (V = variable = kIOUCVariableStructureSize = 0xffffffff).
+ * [claim A14-selectors, A1-sel-table; spec 01 section 3]
+ * Req legend for the minimal CoreAnimation driver [spec 01 section 8]:
+ *   M must, S should, O optional (stub with kIOGPUReturnUnsupported), - unused.
+ * ===================================================================== */
+enum iogpu_uc_selector {
+    kIOGPUSel_GetDeviceInfo             = 0,   /* bOut 0x40                M */
+    kIOGPUSel_GetName                   = 1,   /* bOut 0x40                S */
+    kIOGPUSel_GetStampConfig            = 2,   /* bOut 0x218               M */
+    kIOGPUSel_GetTraceFilter            = 3,   /* bOut 8                   O */
+    kIOGPUSel_GetClientInfo             = 4,   /* bOut 0x20                M */
+    kIOGPUSel_GetNextGlobalTraceID      = 5,   /* bOut 0x10                S */
+    kIOGPUSel_NewCommandQueue           = 6,   /* bIn V, bOut 0x10         M */
+    kIOGPUSel_DeleteCommandQueue        = 7,   /* sIn 1                    M */
+    kIOGPUSel_NewResource               = 8,   /* bIn V, bOut V            M */
+    kIOGPUSel_ReleaseResource           = 9,   /* sIn 1 (twin of trap 1)   - */
+    kIOGPUSel_ResourceFinishEvent       = 10,  /* sIn 2 (twin of trap 2)   - */
+    kIOGPUSel_SetResourcePurgeable      = 11,  /* sIn 2, sOut 1 (twin t3)  - */
+    kIOGPUSel_CreateDeviceShmem         = 12,  /* sIn 2, bOut 0x10         M */
+    kIOGPUSel_DestroyDeviceShmem        = 13,  /* sIn 1                    M */
+    kIOGPUSel_CreateNotificationQueue   = 14,  /* sIn 2, bOut 0x10         M */
+    kIOGPUSel_DestroyNotificationQueue  = 15,  /* sIn 1                    M */
+    kIOGPUSel_GetDeviceHandle           = 16,  /* bOut 8                   - */
+    kIOGPUSel_CreateFence               = 17,  /* bOut 4                   O */
+    kIOGPUSel_DestroyFence              = 18,  /* sIn 1                    O */
+    kIOGPUSel_CreateMTLEvent            = 19,  /* sIn 1, bOut 0x18         O */
+    kIOGPUSel_DestroyMTLEvent           = 20,  /* sIn 1                    O */
+    kIOGPUSel_GetMemoryData             = 21,  /* bOut 0x30                O */
+    kIOGPUSel_Reserved22                = 22,  /* stub -> Unsupported      - */
+    kIOGPUSel_GetAllocatedSize          = 23,  /* sOut 1                   S */
+    kIOGPUSel_SetQueueNotificationQueue = 24,  /* sIn 2                    M */
+    kIOGPUSel_SubmitCommandBuffers      = 25,  /* sIn 4, bIn V, sOut 1     M */
+    kIOGPUSel_SetQueuePriority          = 26,  /* sIn 1, bIn 12, sOut 1    O */
+    kIOGPUSel_SetQueueQoS               = 27,  /* sIn 1, bIn 4             O */
+    kIOGPUSel_CreateLateEvalEvent       = 28,  /* sOut 2                   O */
+    kIOGPUSel_DestroyLateEvalEvent      = 29,  /* sIn 1                    O */
+    kIOGPUSel_SignalLateEvalEvent       = 30,  /* sIn 2                    O */
+    kIOGPUSel_QueryLateEvalEvent        = 31,  /* sIn 1, sOut 2            O */
+    kIOGPUSel_SetDisplayParamsHook      = 32,  /* sIn 2 (twin of trap 8)   - */
+    kIOGPUSel_SetAppGPURole             = 33,  /* sIn 2                    O */
+    kIOGPUSel_GetAppGPURole             = 34,  /* sIn 1, sOut 1            O */
+    kIOGPUSel_SetResourceOwnerIdentity  = 35,  /* sIn 2                    O */
+    kIOGPUSel_ResourceCreateIOSurface   = 36,  /* sIn 3, sOut 1 (ANE)      O */
+    kIOGPUSel_ResourceDetachBacking     = 37,  /* sIn 1                    O */
+    kIOGPUSel_ResourceReplaceBytes      = 38,  /* bIn 0x18                 O */
+    kIOGPUSel_ResourceReplaceRanges     = 39,  /* bIn 0x18, sOut 1         O */
+    kIOGPUSel_CreateVNIODesc            = 40,  /* sIn 1, sOut 2            O */
+    kIOGPUSel_DestroyVNIODesc           = 41,  /* sIn 1                    O */
+    kIOGPUSel_CreateIOCommandQueue      = 42,  /* sIn 2, sOut 2            O */
+    kIOGPUSel_DestroyIOCommandQueue     = 43,  /* sIn 1                    O */
+    kIOGPUSel_SetIONotificationQueue    = 44,  /* sIn 2                    O */
+    kIOGPUSel_SubmitIOCommands          = 45,  /* sIn 1, bIn V             O */
+    kIOGPUSel_CreateIOCommandBuffer     = 46,  /* sIn 1, sOut 2            O */
+    kIOGPUSel_DestroyIOCommandBuffer    = 47,  /* sIn 2                    O */
+    kIOGPUSel_TryCancelIOCommandBuffer  = 48,  /* sIn 2                    O */
+    kIOGPUSel_PerformIO                 = 49,  /* sIn 1                    O */
+    kIOGPUSel_IOCommandBufferComplete   = 50,  /* sIn 1                    O */
+    kIOGPUSel_IOCommandBufferBarrier    = 51,  /* sIn 3                    O */
+    kIOGPUSel_GroupAddResources         = 52,  /* sIn 2, bIn V             S */
+    kIOGPUSel_GroupRemoveResources      = 53,  /* sIn 2, bIn V             S */
+    kIOGPUSel_CreateDeviceAssertion     = 54,  /* sIn 2, sOut 1            O */
+    kIOGPUSel_DeviceNoArgHook           = 55,  /* (no args)                - */
+};
+
+/* ===================================================================== *
+ * 3. External traps (table A, 14 entries) [spec 01 section 4; A2-trap-table]
+ *   IOConnectTrapN(conn, idx, p1..pN); kernel fn receives (this, p1..p6).
+ * ===================================================================== */
+enum iogpu_uc_trap {
+    /* submit ONE command buffer: p1=queueId, p2=argSize(<=0x40),
+     * p3=user ptr to args, p4=user ptr to u32 status out.
+     * Used by the framework when count==1 && cmdBufArgSize<=0x40. */
+    kIOGPUTrap_SubmitOne                = 0,
+    kIOGPUTrap_ReleaseResource          = 1,   /* p1=resourceId (== sel 9)     */
+    kIOGPUTrap_ResourceFinishEvent      = 2,   /* p1=resId, p2=slot(0/1)       */
+    kIOGPUTrap_SetResourcePurgeable     = 3,   /* p1=resId, p2=state(1..6), p3=u64 out */
+    kIOGPUTrap_GroupAdd                 = 4,   /* p1=groupId, p2=count(<=0x100), p3=ptr/val */
+    kIOGPUTrap_GroupRemove              = 5,   /* p1=groupId, p2=count, p3=u64[] ptr   */
+    kIOGPUTrap_GroupUpdate              = 6,   /* remove-then-add combined             */
+    kIOGPUTrap_QueueSetResourceGroups   = 7,   /* p1=queueId, p2=count(<=0x28), p3=u32[] */
+    kIOGPUTrap_SetDisplayParams         = 8,   /* p1,p2 -> device hook (default Unsupported) */
+    kIOGPUTrap_QueueSignalSharedEvent   = 9,   /* p1=queueId, p2=port, p3/p4=val lo/hi */
+    kIOGPUTrap_QueueWaitSharedEvent     = 10,  /* + p5=timeout                         */
+    kIOGPUTrap_QueueSignalMTLEvent      = 11,  /* p1=queueId, p2=eventId, p3/p4=val    */
+    kIOGPUTrap_QueueWaitMTLEvent        = 12,  /* + p5=timeout                         */
+    kIOGPUTrap_QueueSupportsBgRole      = 13,  /* p1=queueId (0=device default)        */
+};
+#define IOGPU_TRAP0_MAX_ARG_SIZE    0x40u   /* trap 0 copies <= 0x40 bytes [A4-trap-table] */
+
+/* ===================================================================== *
+ * 4. IOExternalMethodArguments offsets the handlers read [spec 01 section 2.3].
+ *   Provided so the kernel dispatcher and the plug-in share constants.
+ * ===================================================================== */
+#define IOGPU_EMA_SCALAR_INPUT          0x20u
+#define IOGPU_EMA_SCALAR_INPUT_COUNT    0x28u
+#define IOGPU_EMA_STRUCT_INPUT          0x30u
+#define IOGPU_EMA_STRUCT_INPUT_SIZE     0x38u
+#define IOGPU_EMA_STRUCT_INPUT_DESC     0x40u   /* != NULL when > inband limit */
+#define IOGPU_EMA_SCALAR_OUTPUT         0x48u
+#define IOGPU_EMA_SCALAR_OUTPUT_COUNT   0x50u
+#define IOGPU_EMA_STRUCT_OUTPUT         0x58u
+#define IOGPU_EMA_STRUCT_OUTPUT_SIZE    0x60u
+
+/* ===================================================================== *
+ * 5. Selector wire structs. All little-endian. [spec 01 section 5]
+ * ===================================================================== */
+
+/* -- sel 0 GET_DEVICE_INFO (bOut 64) [A1-sel-table; spec 01 5.1] -------- */
+typedef struct iogpu_device_info {       /* 0x40 bytes */
+    uint32_t configBits;                 /* +0x00 bit6 = supportPriorityBand */
+    uint32_t deviceBits;                 /* +0x04 */
+    uint64_t textureRam;                 /* +0x08 */
+    uint64_t videoRam;                   /* +0x10 0 = unified memory */
+    uint32_t accelID;                    /* +0x18 accelerator id (IOSurfaceBindAccel) */
+    uint32_t _pad1c;                     /* +0x1c */
+    uint64_t sharedMemorySize;           /* +0x20 */
+    uint64_t maxResourceSize;            /* +0x28 maxBufferLength */
+    uint64_t reserved0;                  /* +0x30 */
+    uint32_t reserved1;                  /* +0x38 */
+    uint32_t reserved2;                  /* +0x3c */
+} iogpu_device_info_t;
+
+/* -- sel 2 GET_STAMP_CONFIG (bOut 0x218 = 536) [A7-sel2-layout / A3-sel2-layout] */
+#define IOGPU_STAMP_CONFIG_SIZE     0x218u
+#define IOGPU_STAMP_MAX_SLOTS       128u   /* (0x218 - 0x18) / 4 */
+typedef struct iogpu_stamp_config {      /* client zero-fills before the call */
+    uint64_t stampBase;                  /* +0x00 user VA of mapped stamp memory + uc[0x118] */
+    uint32_t cfg0;                       /* +0x08 accel config word */
+    uint32_t cfg1;                       /* +0x0c */
+    uint32_t privateSize;                /* +0x10 per-resource private tail size (sel 8 reply) */
+    uint32_t nStampSlots;                /* +0x14 count of event-machine channels */
+    uint32_t stampOff[IOGPU_STAMP_MAX_SLOTS]; /* +0x18 per-channel u32 offsets from stampBase */
+} iogpu_stamp_config_t;
+/*
+ * Minimal driver: nStampSlots = 1, stampOff[0] = 0 over a zeroed kernel-written
+ * read-only page; cfg0 = 0. Stamp counters hold values pre-shifted left by 8
+ * (low byte zero) [spec 01 5.8]; the event-complete test is
+ *   (int32)((target&~0xff) - *stampSlot) <= 0.
+ */
+
+/* -- sel 4 GET_CLIENT_INFO (bOut 0x20) [A6-device-open-order; spec 01 5.1] - */
+typedef struct iogpu_client_info {       /* 0x20 bytes */
+    uint64_t clientId;                   /* +0x00 process-unique */
+    uint64_t sharedAddrA;                /* +0x08 optional block (stored iff +0x18 >= 4) */
+    uint64_t deviceShared;               /* +0x10 device client-shared VA (0 -> framework falls back to sel 23) */
+    uint32_t sharedALen;                 /* +0x18 length of block A */
+    uint32_t _pad1c;                     /* +0x1c */
+} iogpu_client_info_t;
+
+/* -- sel 12 CREATE_DEVICE_SHMEM (sIn 2, bOut 0x10) [A18-K-shmem / A5-shmem] -- */
+enum iogpu_shmem_type {                  /* scalar in[1]; pool types */
+    kIOGPUShmemSegmentList   = 0,        /* initial 0x4000 */
+    kIOGPUShmemKernelCommand = 1,        /* initial 0x4000 */
+    kIOGPUShmemDebugBuffer   = 2,        /* one VM page */
+    kIOGPUShmemSideband      = 3,        /* initial 0x4000, grows x2 to 2 MiB then +1 MiB */
+};
+#define IOGPU_SHMEM_SIZE_MAX        0x10000000u  /* scalar in[0] must be < this + 1 */
+typedef struct iogpu_device_shmem_reply { /* bOut 0x10; all three must be non-zero */
+    uint64_t userAddress;                /* +0x00 client VA */
+    uint32_t size;                       /* +0x08 actual size */
+    uint32_t id;                         /* +0x0c shmem id in this device's namespace */
+} iogpu_device_shmem_reply_t;
+
+/* -- sel 14 CREATE_NOTIFICATION_QUEUE (sIn 2, bOut 0x10) [A6-notif-queue] --- */
+#define IOGPU_NQ_MAX_ENTRIES        0x2000u  /* scalar in[0] 1..0x2000 */
+#define IOGPU_NQ_MAX_ENTRY_SIZE     0x28u    /* scalar in[1] 1..0x28 */
+#define IOGPU_NQ_CMDQUEUE_ENTRIES   0x100u   /* command queues use (0x100, 0x28) */
+#define IOGPU_NQ_CMDQUEUE_ESIZE     0x28u
+#define IOGPU_NQ_IOQUEUE_ENTRIES    0x2000u  /* IO queues use (0x2000, 0x10) */
+#define IOGPU_NQ_IOQUEUE_ESIZE      0x10u
+typedef struct iogpu_notification_queue_reply { /* bOut 0x10 */
+    uint64_t queueAddress;               /* +0x00 client VA (IODataQueueMemory) */
+    uint32_t id;                         /* +0x08 non-zero namespace id */
+    uint32_t _pad0c;
+} iogpu_notification_queue_reply_t;
+/*
+ * After sel 14 the framework calls IODataQueueAllocateNotificationPort() and
+ * IOConnectSetNotificationPort(conn, type=0, port, refCon=queueId). The kernel
+ * registerNotificationPort override requires type==0 and binds the port to the
+ * queue via the IODataQueue "data available" message [spec 01 5.3].
+ */
+#define IOGPU_NOTIFICATION_PORT_TYPE  0u
+
+/*
+ * Completion entry written by the kernel into the command-queue notification
+ * ring, EXACTLY 0x28 bytes [claim A11-notif-entry; spec 01 5.3].
+ *   ref: echoed from args.scheduledRef (+0x10) or completedRef (+0x18).
+ *   t0/t1: mach_absolute_time ticks; the client converts with the mach timebase.
+ *   status: 0 = success, else an IOGPU command-buffer status (table in 7.).
+ *   extra: GPU fault address for completions, 0 for "scheduled".
+ */
+typedef struct iogpu_completion_entry { /* 0x28 bytes */
+    uint64_t ref;                        /* +0x00 */
+    uint64_t tBegin;                     /* +0x08 */
+    uint64_t tEnd;                       /* +0x10 */
+    uint32_t status;                     /* +0x18 */
+    uint32_t _pad1c;                     /* +0x1c (status copyout is 4 bytes) */
+    uint64_t extra;                      /* +0x20 */
+} iogpu_completion_entry_t;
+
+/* IO-queue entry, 0x10 bytes [spec 01 9.1]: block invoked as block(block,status). */
+typedef struct iogpu_io_completion_entry {
+    uint64_t block;                      /* +0x00 */
+    uint32_t status;                     /* +0x08 */
+    uint32_t _pad0c;
+} iogpu_io_completion_entry_t;
+
+/* -- sel 6 NEW_COMMAND_QUEUE (bIn V, bOut 0x10) [A10-queue-create / A8-queue-create] */
+#define IOGPU_NEW_QUEUE_ARGS_MIN    0x408u  /* struct in must be >= 0x408 and == accel queue-args size */
+typedef struct iogpu_new_command_queue_args { /* generic prefix 0x408; vendor tail follows */
+    char     processPath[0x400];         /* +0x000 proc_pidpath */
+    uint32_t qosLevel;                   /* +0x400 */
+    uint8_t  openGLQueue;                /* +0x404 */
+    uint8_t  backgroundFlag;             /* +0x405 */
+    uint8_t  _pad406[2];                 /* +0x406 */
+    /* vendor tail: the Mali plug-in may append fields; total MUST equal the
+     * accelerator's configured queue-args size (populateAccelConfig +0x90). */
+} iogpu_new_command_queue_args_t;
+typedef struct iogpu_new_command_queue_reply { /* bOut 0x10 */
+    uint64_t queueId;                    /* +0x00 non-zero (0 == failure) */
+    uint64_t traceObjectId;              /* +0x08 */
+} iogpu_new_command_queue_reply_t;
+
+/* -- sel 8 NEW_RESOURCE (bIn V >= 0x58, bOut V) [A15-resource-create / A9-resource-args] */
+#define IOGPU_RESOURCE_ARGS_MIN     0x58u
+enum iogpu_resource_type {               /* args +0x00; kernel accepts {0,3,0x40,0x80,0x82} */
+    kIOGPUResType_KernelMem  = 0x00,     /* kernel-allocated system memory */
+    kIOGPUResType_Group      = 0x03,     /* resource group (args +0x38 = capacity) */
+    kIOGPUResType_Sparse     = 0x40,     /* virtual/sparse placement */
+    kIOGPUResType_ClientMem  = 0x80,     /* client-supplied memory / address ranges */
+    kIOGPUResType_IOSurface  = 0x82,     /* IOSurface plane (id +0x38, plane +0x3c, field +0x40) */
+};
+enum iogpu_resource_flag {               /* args +0x14 */
+    kIOGPUResFlag_ZeroFill    = 0x40,      /* bit6: kernel zero-fills the CPU mapping */
+    kIOGPUResFlag_Suballoc    = 0x800,     /* bit11: args +0x50 = parent resource id */
+    kIOGPUResFlag_WantCPUMap  = 0x2000,    /* bit13: request a CPU mapping */
+    kIOGPUResFlag_AddrRanges  = 0x200000,  /* bit21: client address-ranges variant (type 0x80) */
+};
+typedef struct iogpu_new_resource_args { /* generic 0x58; vendor tail follows */
+    uint32_t resType;                    /* +0x00 enum iogpu_resource_type */
+    uint32_t cacheMode;                  /* +0x04 bits 8..15 = cache mode 0..9 (types 0/3/0x40) */
+    uint32_t field08;                    /* +0x08 framework constant 0x10001 */
+    uint16_t field0c;                    /* +0x0c framework constant 1 */
+    uint16_t _pad0e;
+    uint8_t  flags10[4];                 /* +0x10 framework constant {01,01,00,01} */
+    uint32_t flags;                      /* +0x14 enum iogpu_resource_flag */
+    uint32_t _pad18hi;                   /* +0x18 (u64 arg18, 0 from framework) */
+    uint32_t _pad1c;
+    uint64_t gpuAddress;                 /* +0x20 requested fixed GPU VA (0 = kernel chooses) */
+    uint64_t gpuLength;                  /* +0x28 length of the fixed mapping */
+    uint32_t units;                      /* +0x30 max(1, this) -> accel resource init */
+    uint32_t gpuTagHi;                   /* +0x34 OR-ed into bits 63..32 of returned GPU VA */
+    uint64_t ptrOrSurface;               /* +0x38 client VA / IOAddressRange* / {surfaceId,plane} */
+    uint64_t ptrOrField;                 /* +0x40 second ptr / range count / {field,0} */
+    uint64_t size;                       /* +0x48 resource size in bytes */
+    uint32_t parentIdOrSparseTile;       /* +0x50 parent id (suballoc) or sparse tile size */
+    uint32_t _pad54;
+} iogpu_new_resource_args_t;
+/* reply size passed by the framework = 0x58 + privateSize (sel 2 +0x10). */
+typedef struct iogpu_new_resource_reply { /* generic 0x58; private tail follows [A16-resource-out / A10-resource-reply] */
+    uint64_t gpuAddress;                 /* +0x00 GPU VA (| gpuTagHi<<32) */
+    uint64_t cpuAddress;                 /* +0x08 client CPU VA (0 if none) */
+    uint64_t clientShared;               /* +0x10 client-shared block VA (two 0x40 IOGPUEvent slots) */
+    uint64_t metadataPtr;                /* +0x18 (type 0x40 only) */
+    uint32_t replyFlags;                 /* +0x20 bit0 = client must zero-fill cpuAddress */
+    uint32_t resourceId;                 /* +0x24 non-zero handle (p1 of traps 1/2/3; list ids) */
+    uint64_t residentSize;               /* +0x28 */
+    uint64_t traceObjectId;              /* +0x30 */
+    uint64_t allocId0;                   /* +0x38 allocation identifier (group remove key) */
+    uint64_t allocId1;                   /* +0x40 */
+    uint64_t protection;                 /* +0x48 */
+    uint64_t gpuVALength;                /* +0x50 */
+    /* uint8_t privateTail[privateSize]; +0x58 copied to the plug-in's resource */
+} iogpu_new_resource_reply_t;
+
+/* ===================================================================== *
+ * 6. Submission framing [claim A12-submit / A11-cmdbuf-args / A13-cmdbuf-args]
+ * ===================================================================== */
+/*
+ * sel 25 SUBMIT_COMMAND_BUFFERS: scalar in {queueId, flags(0), count, argSize}.
+ *   argSize MUST equal the accelerator's configured cmdBufArgs size
+ *   (populateAccelConfig +0x68 == accel+0x268), and struct-in size must equal
+ *   count*argSize. scalar out[0] = u32 queue status.
+ * The generic IOGPUMetalDevice returns cmdBufArgsSize == 0x30, so our plug-in
+ * and kernel simply agree on 0x30 [claim A13-cmdbuf-args; spec 02 section 8].
+ */
+#define IOGPU_CMDBUF_ARGS_SIZE      0x30u  /* -[IOGPUMetalDevice cmdBufArgsSize] */
+#define IOGPU_CMDBUF_ARGS_MIN       0x28u  /* vendor tail may extend past 0x28 */
+
+/* sIOGPUCommandQueueCommandBufferArgs generic prefix (0x30) [spec 01 5.6] */
+typedef struct iogpu_cmdbuf_args {
+    uint32_t kernelCommandShmemId;       /* +0x00 type-1 shmem id (K) */
+    uint32_t segmentListShmemId;         /* +0x04 type-0 shmem id (S) */
+    uint32_t sidebandShmemId;            /* +0x08 type-3 shmem id (0 if none) */
+    uint32_t reserved0c;                 /* +0x0c */
+    uint64_t scheduledRef;               /* +0x10 echoed in "scheduled" notification (0 = none) */
+    uint64_t completedRef;               /* +0x18 echoed in "completed" notification */
+    uint32_t debugBufferShmemId;         /* +0x20 type-2 shmem id (0 if none) */
+    uint32_t reserved24;                 /* +0x24 */
+    uint32_t reserved28;                 /* +0x28 (Metal4 writes globalTraceObjectID here) */
+    uint32_t reserved2c;                 /* +0x2c */
+    /* vendor tail from +0x30 if IOGPU_CMDBUF_ARGS_SIZE is raised */
+} iogpu_cmdbuf_args_t;
+
+/* ===================================================================== *
+ * 6a. Kernel command buffer (shmem K) - 4-byte-aligned records [spec 01 5.7]
+ *   { u32 type; u32 size (incl. 8-byte header, >=8, %4==0); payload }.
+ *   The generic kernel enforces size>=8, size%4==0, cmd+size<=end; a bad
+ *   record sets queue status 0xa. [claim A18-K-shmem]
+ * ===================================================================== */
+typedef struct iogpu_kcmd_header {
+    uint32_t type;                       /* enum iogpu_kcmd_type */
+    uint32_t size;
+} iogpu_kcmd_header_t;
+
+enum iogpu_kcmd_type {                   /* generic types understood by the family */
+    kIOGPUKCmd_DebugLog         = 0,
+    kIOGPUKCmd_SecondFamily     = 1,
+    kIOGPUKCmd_SleepMS          = 2,     /* {u32 ms} size 0x10 */
+    kIOGPUKCmd_SignalSharedEvent= 3,     /* {u32 port; u32 0; u64 value} 0x18 */
+    kIOGPUKCmd_WaitSharedEvent  = 4,     /* {u32 port; u32 timeout; u64 value} */
+    kIOGPUKCmd_SignalMTLEvent   = 5,     /* {u32 eventId; u32 0; u64 value} */
+    kIOGPUKCmd_WaitMTLEventBar  = 6,     /* wait with barrier */
+    kIOGPUKCmd_PurgeResources   = 8,     /* {u32 count; u32 ids[count]} */
+    kIOGPUKCmd_SetProtection    = 9,     /* {u64 options} 0x10 */
+    kIOGPUKCmd_WaitMTLEvent     = 10,    /* wait without barrier */
+    kIOGPUKCmd_SignalSEventAgent= 11,    /* {port;0;u64 value;u64 agentMask} 0x20 */
+    kIOGPUKCmd_CondEventAbort   = 12,
+    kIOGPUKCmd_SignalSEventSched= 13,
+    kIOGPUKCmd_ResponsibleTasks = 14,    /* {u32 count; u32 ids[count]} */
+    /*
+     * type 15 SetResourceGroups is the FIRST record of every command buffer,
+     * reserved by the framework as {type=0xf, size=0xac}; 0xa4-byte body of
+     * {u32 count; u32 groupIds[40]}; count 0 when unused [claim A12-kernel-commands].
+     */
+    kIOGPUKCmd_SetResourceGroups= 15,
+    kIOGPUKCmd_UpdateMappings   = 16,    /* Metal 4 */
+    kIOGPUKCmd_CopyMappings     = 17,    /* Metal 4 */
+    kIOGPUKCmd_PostMappingWait  = 18,    /* Metal 4 */
+    /*
+     * VENDOR EXTENSION SPACE: types >= 0x13 are free for the plug-in/kernel
+     * private agreement. THIS IS WHERE THE MALI JOB/CSG SUBMISSION DESCRIPTION
+     * LIVES. Our MaliCommandQueue::processSegmentKernelCommand decodes these
+     * (see mali_backend_ops.h MALI_KCMD_*). The generic kernel would set queue
+     * status 0xa for any unknown type, so the Mali queue subclass must consume
+     * them before delegating [spec 01 5.7, spec 03 5.6, spec 06 section 3].
+     */
+    kIOGPUKCmd_VendorBase       = 0x13,
+};
+#define IOGPU_KCMD_SETGROUPS_SIZE   0xacu  /* reserved first record total bytes */
+#define IOGPU_KCMD_SETGROUPS_HDR    0x000000ac0000000fULL /* {type=0xf,size=0xac} literal */
+#define IOGPU_KCMD_MAX_GROUPS       40u
+
+/* ===================================================================== *
+ * 6b. Segment-list shmem (shmem S) - a chain of 0x10-byte-header blocks.
+ *   [claim A19-S-layout; spec 01 5.7]
+ * ===================================================================== */
+typedef struct iogpu_seg_block_header { /* 0x10 */
+    uint64_t tag;                        /* +0x00 opaque client token */
+    uint32_t count;                      /* +0x08 segments (type0) / {start,end} pairs (type1) */
+    uint32_t control;                    /* +0x0c bit31=last block; bit30=typed; low bits=size/type */
+} iogpu_seg_block_header_t;
+#define IOGPU_SEG_CTRL_LAST         (1u << 31)
+#define IOGPU_SEG_CTRL_TYPED        (1u << 30)
+#define IOGPU_SEG_KCLIST_CONTROL    0x40000001u /* type-1 KC-list block control word */
+
+typedef struct iogpu_segment_header {   /* 0x20, type-0 block, per segment */
+    uint64_t tag;                        /* +0x00 */
+    uint32_t kcStart;                    /* +0x08 offset in K buffer */
+    uint32_t kcEnd;                      /* +0x0c kcStart <= kcEnd <= K length */
+    uint32_t sidebandOff;                /* +0x10 offset in sideband shmem */
+    uint32_t _pad14;                     /* +0x14 */
+    uint32_t nResources;                 /* +0x18 distinct resources */
+    uint32_t nGroups;                    /* +0x1c count of 0x40-byte resource entries (< 2^26) */
+    /* iogpu_resource_group_entry entries[nGroups]; +0x20 */
+} iogpu_segment_header_t;
+
+typedef struct iogpu_resource_group_entry { /* 0x40, up to 6 resources */
+    uint32_t resId[6];                   /* +0x00 */
+    uint32_t sizeKiB[6];                 /* +0x18 ceil(residentSize/1024) */
+    uint16_t usage[6];                   /* +0x30 Read=1 Write=2 (legacy Sample=4) */
+    uint16_t _pad3c;                     /* +0x3c */
+    uint16_t n;                          /* +0x3e valid id count (< 7) */
+} iogpu_resource_group_entry_t;
+
+/* ===================================================================== *
+ * 7. Completion status -> MTLCommandBufferError mapping [spec 01 5.9]
+ *   19-entry table; index = IOGPU status, value = MTL error; status>0x12 -> 1.
+ *   Status the kernel submit path itself produces:
+ *     8 shmem not mappable into kernel; 9 invalid/missing segment shmem;
+ *     0xa parse/validation failure; 4 queue denied. Success MUST be 0.
+ * ===================================================================== */
+static const uint8_t iogpu_status_to_mtl_error[19] = {
+    0, 1, 2, 2, 4, 1, 7, 7, 8, 9, 1, 3, 10, 10, 1, 1, 16, 12, 17
+};
+#define kIOGPUStatus_Success        0u
+#define kIOGPUStatus_QueueDenied    4u
+#define kIOGPUStatus_ShmemUnmapped  8u
+#define kIOGPUStatus_SegmentBad     9u
+#define kIOGPUStatus_ParseError     0xau
+
+#ifdef __cplusplus
+} /* extern "C" */
+#endif
+#endif /* IOGPU_UC_ABI_H */
diff --git a/iokit/Families/IOGPU/mali_backend_ops.h b/iokit/Families/IOGPU/mali_backend_ops.h
new file mode 100644
index 0000000..d1924f3
--- /dev/null
+++ b/iokit/Families/IOGPU/mali_backend_ops.h
@@ -0,0 +1,301 @@
+/*
+ * mali_backend_ops.h - the kmod-style interface the kernel Mali backend exposes
+ * -------------------------------------------------------------------------
+ * Intended repo path: kernel/iokit/Families/IOGPU/mali/mali_backend_ops.h
+ *
+ * The internal contract between the IOGPUFamily re-implementation (device,
+ * resource, memory-map, command-queue, event-machine objects) and the
+ * Mali-G715 (Valhall CSF, arch 11.8) hardware backend. Everything the family
+ * hooks (spec 03) need from hardware is expressed here as a flat ops table,
+ * modeled on Mesa's pan_kmod device/VM/BO/queue surface and grown from the
+ * WORKING bring-up code at
+ *   artifacts/xnu-12377/bsd/dev/husky_gpu.c  (cited HG:<line>)
+ * which already boots the CSF firmware and ran a first CSG0/CS0 job on real
+ * hardware. This header EXTENDS that code; it does not regress it.
+ *
+ * ORIGINAL work. pan_kmod (pan_kmod.h), panthor UAPI (panthor_drm.h),
+ * panthor_sched.c and kbase were studied as references; nothing is copied.
+ * Reference citations use the spec prefixes (spec 06 citation key):
+ *   M:   mesa/src/panfrost     PT:  panthor driver     KB:  mali_kbase
+ *   CSR: panthor_sched.c etc.  HG:  husky_gpu.c
+ *
+ * HARDWARE GROUND TRUTH (husky, read live, spec 06 section 2):
+ *   GPU_ID 0xb8a21020 (arch 11.8, product major 2, r1p2); 7 shader cores
+ *   SHADER_PRESENT 0x01110055 (core-id range 25); TILER/L2 present; AS_PRESENT
+ *   0xff (AS0 = MCU, 7 left for contexts); CSF GLB 2.8.0, 8 CSGs, 8 CS/CSG;
+ *   CS0 features 0x7105f (96 work regs, 16 scoreboard slots); non-coherent.
+ *
+ * RISK R1 (MUST be resolved before any RUN_COMPUTE/RUN_FRAGMENT):
+ *   husky_gpu.c powers ONLY the top G3D domain (pd_g3d). The shader cores
+ *   (pd_embedded_g3d) and the G3D PLLs (CMU_G3D) are NOT powered. The first
+ *   job needed none (stores + sync only). Real jobs need cores. The backend
+ *   MUST implement mali_backend_ops::power_shader_cores, porting the sequence
+ *   from Linux exynos-pd_el3.c + the zuma PMU DT (pd_embedded_g3d at PMU
+ *   0x15461C80, child of pd_g3d) before dispatching work [spec 03 4.1 #1,
+ *   spec 03 section 8 "Gap", spec 06 section 2, open question Q8].
+ */
+#ifndef MALI_BACKEND_OPS_H
+#define MALI_BACKEND_OPS_H
+
+#include <stdint.h>
+#include <stdbool.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* ===================================================================== *
+ * 0. Opaque handles. The family holds these; only the backend derefs them.
+ * ===================================================================== */
+typedef struct mali_backend  mali_backend_t;   /* one per accelerator */
+typedef struct mali_vm       mali_vm_t;         /* one GPU address space per IOGPUTask */
+typedef struct mali_bo       mali_bo_t;         /* a GPU buffer object (resource backing) */
+typedef struct mali_queue    mali_queue_t;      /* one CSG+CS group (one IOGPUCommandQueue) */
+typedef struct mali_syncobj  mali_syncobj_t;    /* a 64-bit CS sync object */
+typedef struct mali_tiler_heap mali_tiler_heap_t;
+
+typedef uint64_t mali_gpu_va_t;                 /* 48-bit GPU virtual address */
+typedef int      mali_status_t;                 /* 0 = ok, else an errno-style code */
+
+/* ===================================================================== *
+ * 1. Device properties - the subset Mesa library code consumes
+ *   (struct pan_kmod_dev_props, M:lib/kmod/pan_kmod.h:194-275; spec 06 5.1).
+ *   Filled from GPU_CONTROL register reads [HG:136-161, HG:24-27].
+ * ===================================================================== */
+typedef struct mali_dev_props {
+    uint64_t gpu_id;                 /* GPU_ID 0x00  (0xb8a21020) */
+    uint32_t gpu_variant;            /* CORE_FEATURES & 0xff */
+    uint64_t gpu_features;           /* GPU_FEATURES 0x60 */
+    uint64_t shader_present;         /* SHADER_PRESENT 0x100/0x104 (0x01110055) */
+    uint32_t tiler_features;         /* TILER_FEATURES 0x0c (0x809) */
+    uint32_t mem_features;           /* MEM_FEATURES 0x10 (0x301, 4 L2 slices) */
+    uint32_t mmu_features;           /* MMU_FEATURES 0x14 (0x2830: 48 VA / 40 PA bits) */
+    uint32_t l2_features;            /* L2_FEATURES 0x04 */
+    uint32_t as_present;             /* AS_PRESENT 0x18 (0xff) */
+    uint32_t csf_id;                 /* CSF_ID 0x1c */
+    uint32_t texture_features[4];    /* TEXTURE_FEATURES0..3 0xB0+4n */
+    uint32_t max_threads_per_core;   /* THREAD_MAX_THREADS 0xA0 */
+    uint32_t max_threads_per_wg;     /* THREAD_MAX_WORKGROUP_SIZE 0xA4 */
+    uint32_t max_tasks_per_core;     /* THREAD_FEATURES >> 24 */
+    uint32_t num_registers_per_core; /* THREAD_FEATURES & 0x3fffff */
+    uint32_t core_count;             /* popcount(shader_present) = 7 */
+    uint32_t core_id_range;          /* last-set-bit of shader_present + 1 = 25 (WLS sizing) */
+    uint32_t cs_reg_count;           /* CS0 features & 0xff + 1 = 96 */
+    uint32_t cs_scoreboard_slots;    /* (CS0 features >> 8) & 0xff = 16 */
+    uint32_t glb_version;            /* GLB_VERSION (2.8.0) */
+    uint32_t num_csg;                /* 8 */
+    uint32_t num_cs_per_csg;         /* 8 */
+    uint32_t group_suspend_size;     /* CSG GROUP_SUSPEND_SIZE (0x6700) */
+    uint64_t pgsize_bitmap;          /* 4 KiB granule only [HG:229] */
+    bool     is_io_coherent;         /* false [claim C16-noncoherent; HG:902] */
+} mali_dev_props_t;
+
+/* ===================================================================== *
+ * 2. GPU MMU / page-table contract [HG:208-209, HG:504-542; claim C16]
+ *   48-bit VA, 40-bit PA, 4 KiB granule, 4 levels. XNU PAGE_SIZE is 16 KiB
+ *   here, so the GPU granule is tracked separately.
+ * ===================================================================== */
+#define MALI_GPU_PAGE_SHIFT     12
+#define MALI_GPU_PAGE_SIZE      0x1000u
+#define MALI_GPU_PAGE_MASK      (MALI_GPU_PAGE_SIZE - 1)
+
+/* AS (address space) register programming [HG:188-209, HG:627-640]. */
+#define MALI_AS_MEMATTR_VALUE   0x4C4C4C4C8C4C8F4CULL /* idx0 non-cacheable, idx1 write-back */
+#define MALI_AS_TRANSCFG_VALUE  0x420001C6ULL
+#define MALI_AS_CMD_UPDATE      1u
+/* AttrIndx selectors inside a leaf PTE, matching AS_MEMATTR_VALUE. */
+#define MALI_ATTR_NONCACHEABLE  0u   /* outer-shareable, for CPU-written GPU data */
+#define MALI_ATTR_WRITEBACK     1u   /* inner-shareable */
+
+/*
+ * Leaf PTE bit layout the backend writes [HG:504-542, leaf_attrs_for()]:
+ *   bits 1:0 = 3 (valid page), AF (bit10), nG (bit11), AP[1] (bit6),
+ *   read-only via AP[2] (bit7) when !writable, XN (bits 53,54) when !exec,
+ *   AttrIndx (bit2) + SH (bits 9:8) chosen by cacheability.
+ * AS1 (job address space) shares the MCU's AS0 root today [HG:627-640]; the
+ * backend generalises to one root per mali_vm.
+ */
+typedef struct mali_pte_attrs {
+    bool writable;
+    bool executable;
+    uint32_t attr_index;     /* MALI_ATTR_* */
+} mali_pte_attrs_t;
+
+/* ===================================================================== *
+ * 3. Buffer-object (resource backing) flags [pan_kmod supported_bo_flags].
+ *   The GPU is non-coherent: CPU-written pages that the GPU reads MUST be
+ *   cleaned to DRAM, or mapped non-cacheable [claim C16; HG:451-468, HG:848].
+ * ===================================================================== */
+enum mali_bo_flag {
+    MALI_BO_GPU_READ     = (1u << 0),
+    MALI_BO_GPU_WRITE    = (1u << 1),
+    MALI_BO_GPU_EXEC     = (1u << 2),  /* shader code: must sit in the first 4 GiB (spec 06 D7) */
+    MALI_BO_CPU_MAP      = (1u << 3),  /* client-visible CPU mapping requested */
+    MALI_BO_NONCACHEABLE = (1u << 4),  /* map write-combined/NC (ml_io_map_wcomb, HG:621) */
+    MALI_BO_FIXED_VA     = (1u << 5),  /* honour the requested GPU VA (sel 8 args +0x20) */
+    MALI_BO_ZERO         = (1u << 6),  /* zero-filled on allocation */
+};
+
+/* ===================================================================== *
+ * 4. CSF queue contract - the three layers that already work [spec 06 section 3].
+ * ===================================================================== */
+
+/*
+ * Layer C: user command-stream instruction encodings (opcode in bits 63:56),
+ * exactly as husky_gpu.c emits them [HG:329-342]. The Mali plug-in's cs_builder
+ * output is a byte stream of these; the kernel validates and CALLs it.
+ */
+#define MALI_CS_MOVE48(r, imm) \
+    ((1ULL << 56) | ((uint64_t)(r) << 48) | ((uint64_t)(imm) & 0xffffffffffffULL))
+#define MALI_CS_MOVE32(r, imm) \
+    ((2ULL << 56) | ((uint64_t)(r) << 48) | (uint32_t)(imm))
+#define MALI_CS_WAIT(mask)          ((3ULL << 56) | ((uint64_t)(mask) << 16))
+#define MALI_CS_STORE_MULTIPLE(src, addr, mask, off) \
+    ((21ULL << 56) | ((uint64_t)(src) << 48) | ((uint64_t)(addr) << 40) | \
+     ((uint64_t)(mask) << 16) | (uint16_t)(off))
+#define MALI_CS_STORE_STATE_TS(addr, off) \
+    ((40ULL << 56) | ((uint64_t)(addr) << 40) | (uint16_t)(off))
+#define MALI_CS_FLUSH_CACHE2(id_reg) /* L2+LSC clean-invalidate, other invalidate */ \
+    ((36ULL << 56) | ((uint64_t)(id_reg) << 40) | 0x233ULL)
+#define MALI_CS_SYNC_ADD64(addr, val) /* system scope, propagate errors */ \
+    ((51ULL << 56) | ((uint64_t)(addr) << 40) | ((uint64_t)(val) << 32) | 1ULL)
+#define MALI_CS_CALL(addr_reg, len_reg) \
+    ((32ULL << 56) | ((uint64_t)(addr_reg) << 40) | ((uint64_t)(len_reg) << 32))
+#define MALI_CS_ERROR_BARRIER       (47ULL << 56)
+
+/*
+ * Register ABI (arch 11) [spec 06 3.4]: 96 work regs, last 4 kernel-reserved,
+ * so user CS may use r0..r91. The kernel ring wrapper's own registers are
+ * r92:93 (address) and r94 (value / flush id) [HG:611]. cs_builder chunk-link
+ * registers overlap these on purpose (consumed by CALL before user code runs).
+ */
+#define MALI_CS_KERNEL_RESERVED_REGS  4u
+#define MALI_CS_USER_REG_MAX          91u
+
+/*
+ * Layer B: the per-job kernel ring wrapper (panthor queue_run_job, spec 06 3.2).
+ * husky_gpu.c already runs the FLUSH_CACHE2 + WAIT + SYNC_ADD64 + ERROR_BARRIER
+ * tail [HG:642-655]; the only new instruction per job is CALL of the user chunk.
+ * The user stream must be 64-byte aligned, size a multiple of 8
+ * [PT:panthor_drm.h:973,985]. latest_flush = 0 forces an unconditional flush.
+ */
+#define MALI_CS_STREAM_ALIGN        64u
+#define MALI_CS_LATEST_FLUSH_FORCE  0u
+
+/* The Panthor submit tuple the kernel receives per command buffer [spec 06 D3]. */
+typedef struct mali_submit_desc {
+    uint32_t      queue_index;       /* CS slot within the group (0 for compute-only v0) */
+    mali_gpu_va_t stream_addr;       /* cs_root_chunk_gpu_addr (64-byte aligned) */
+    uint32_t      stream_size;       /* cs_end() size (multiple of 8) */
+    uint32_t      latest_flush;      /* 0 to force the leading flush */
+    /* wait/signal: 64-bit CS sync objects, resolved from the segment list */
+    const mali_syncobj_t *const *waits;  uint32_t n_waits;
+    const mali_syncobj_t *const *signals; uint32_t n_signals;
+} mali_submit_desc_t;
+
+/*
+ * MALI vendor kernel-command types (IOGPU kernel commands with type >= 0x13,
+ * iogpu_uc_abi.h kIOGPUKCmd_VendorBase). These travel in shmem K and are
+ * decoded by MaliCommandQueue::processSegmentKernelCommand [spec 03 5.6,
+ * spec 06 section 3]. Relocations in SUBMIT_CS are validated against the
+ * segment-list resource set before the CALL. Body layouts are the plug-in
+ * <-> kernel private agreement; these ids are our choice (not Apple's).
+ */
+enum mali_kcmd_type {
+    MALI_KCMD_FENCE     = 0x13,  /* stamp write: CS STORE of the stamp + flush + sync */
+    MALI_KCMD_FILL      = 0x14,  /* fill a BO range (libpan panlib_fill) */
+    MALI_KCMD_SUBMIT_CS = 0x15,  /* point the CS ring at a user stream chunk; body:
+                                  * { mali_gpu_va_t stream; u32 size; u32 flush_id;
+                                  *   u32 n_wait; u32 n_signal; <sync ids...> } */
+    MALI_KCMD_HEAP_OP   = 0x16,  /* tiler-heap set/operation for render passes */
+};
+
+/* ===================================================================== *
+ * 5. The backend ops table. The family calls these; the backend implements
+ *   them on top of husky_gpu.c's proven sequences. Return 0 on success.
+ * ===================================================================== */
+typedef struct mali_backend_ops {
+    /* --- accelerator lifecycle (IOGPU::configureDevice / teardownDevice) --- */
+    /* probe + power pd_g3d, open the G3D S2MPU, reset, L2 on, boot the CSF
+     * firmware on the MCU. This is husky_gpu_probe/husky_gpu_mcu_boot
+     * [HG:1003, HG:726, spec 03 4.1 #1]. Returns a mali_backend_t. */
+    mali_status_t (*configure_device)(const void *provider, mali_backend_t **out);
+    void          (*teardown_device)(mali_backend_t *); /* quiesce MCU, power off (reverse) */
+    void          (*get_props)(mali_backend_t *, mali_dev_props_t *out);
+
+    /*
+     * RISK R1: power the shader cores. MUST be called before the first
+     * RUN_COMPUTE/RUN_FRAGMENT. Ports pd_embedded_g3d power-on + G3D PLL bring-up
+     * from exynos-pd_el3.c + zuma PMU DT. Not needed for stores-only jobs.
+     * [spec 03 4.1, spec 06 section 2, open question Q8]
+     */
+    mali_status_t (*power_shader_cores)(mali_backend_t *, bool on);
+
+    /* --- stamp memory (IOGPU getStampMemory, spec 03 4.3) --- */
+    /* return the kernel/user-shared, page-aligned stamp page descriptor and the
+     * client's offset into it; the CS writes 32-bit stamp values to it. */
+    mali_status_t (*get_stamp_memory)(mali_backend_t *, void **desc_out, uint32_t *offset_out);
+
+    /* --- VM: one GPU address space per IOGPUTask (spec 03 5.3) --- */
+    mali_status_t (*vm_create)(mali_backend_t *, mali_vm_t **out);
+    void          (*vm_destroy)(mali_vm_t *);
+    /* assign/evict a hardware AS slot (7 for contexts; LRU when > 7 clients) and
+     * run AS_COMMAND UPDATE (lock/flush-PT/unlock) [HG:627-640, spec 06 5.2]. */
+    mali_status_t (*vm_bind_as_slot)(mali_vm_t *, int *as_slot_out);
+    void          (*vm_flush_as)(mali_vm_t *);
+
+    /* --- BO: resource backing (IOGPUSysMemory + MaliMemoryMap, spec 03 5.4) --- */
+    mali_status_t (*bo_alloc)(mali_vm_t *, uint64_t size, uint32_t flags,
+                              mali_gpu_va_t fixed_va, mali_bo_t **out);
+    /* wrap client-supplied pages (sel 8 type 0x80) or an IOSurface plane (0x82). */
+    mali_status_t (*bo_import_pages)(mali_vm_t *, const uint64_t *phys, uint32_t n_pages,
+                                     uint32_t flags, mali_bo_t **out);
+    void          (*bo_free)(mali_bo_t *);
+    mali_gpu_va_t (*bo_gpu_va)(const mali_bo_t *);
+    void *        (*bo_cpu_map)(const mali_bo_t *);       /* NULL if not CPU-mapped */
+    /* MaliMemoryMap::commitIntoGPUPageTable / releaseFromGPUPageTable (pure). */
+    mali_status_t (*bo_map)(mali_bo_t *, mali_gpu_va_t va, const mali_pte_attrs_t *);
+    void          (*bo_unmap)(mali_bo_t *);
+
+    /* --- cache maintenance (non-coherent GPU) [claim C16; HG:457-468] --- */
+    /* clean+invalidate a CPU-written range to DRAM before a GPU read; call on
+     * segment-list prepare and map commit [spec 03 5.4]. */
+    void          (*dcache_flush)(const void *cpu_addr, uint64_t len);
+
+    /* --- queue: one CSG + CS group per IOGPUCommandQueue (spec 03 5.6) --- */
+    /* program CSG/CS slots the way husky_gpu_first_job does [HG:585-724]:
+     * ring buffer (64 KiB), AS slot, suspend buffer, EP request, doorbells. */
+    mali_status_t (*queue_create)(mali_vm_t *, uint32_t cs_mask, mali_queue_t **out);
+    void          (*queue_destroy)(mali_queue_t *);
+    /* write the Layer-B ring wrapper for one command buffer and ring the
+     * doorbell; the completion is read from the per-queue sync object. */
+    mali_status_t (*queue_submit)(mali_queue_t *, const mali_submit_desc_t *);
+    /* v0 synchronous completion: poll the sync object / stamp [HG:711-716];
+     * v1 replaces this with the JOB IRQ + signalStampsUpdated path. */
+    mali_status_t (*queue_wait_idle)(mali_queue_t *, uint64_t timeout_us);
+
+    /* --- syncobj: 64-bit CS sync object {seqno,error,pad} (spec 06 3.5) --- */
+    mali_status_t (*syncobj_create)(mali_vm_t *, mali_syncobj_t **out);
+    void          (*syncobj_destroy)(mali_syncobj_t *);
+    mali_gpu_va_t (*syncobj_gpu_va)(const mali_syncobj_t *);
+    uint64_t      (*syncobj_read)(const mali_syncobj_t *);
+
+    /* --- tiler heap: FW-owned, for render passes (spec 06 5.4.5) --- */
+    /* chunk size page-aligned in [128 KiB, 8 MiB]; returns the triple the CS
+     * needs: {handle, ctx_gpu_va, first_chunk_gpu_va}. Kernel half of
+     * CS_TILER_OOM lives here (group_process_tiler_oom). */
+    mali_status_t (*tiler_heap_create)(mali_vm_t *, uint32_t chunk_size,
+                                       uint32_t initial_chunks, uint32_t max_chunks,
+                                       mali_tiler_heap_t **out,
+                                       mali_gpu_va_t *ctx_va_out,
+                                       mali_gpu_va_t *first_chunk_va_out);
+    void          (*tiler_heap_destroy)(mali_tiler_heap_t *);
+} mali_backend_ops_t;
+
+/* The single backend instance the family binds to at IOGPU::start. */
+extern const mali_backend_ops_t mali_backend_ops;
+
+#ifdef __cplusplus
+} /* extern "C" */
+#endif
+#endif /* MALI_BACKEND_OPS_H */

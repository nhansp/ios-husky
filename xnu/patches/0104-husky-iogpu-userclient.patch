+IOReturn
+IOGPUDeviceUserClient::registerNotificationPort(mach_port_t port, UInt32 type,
+    io_user_reference_t refCon)
+{
+	/*
+	 * Port registration: requires type == 0 (spec 01 line 394).
+	 * Looks up notification queue by refCon (queueId) and binds port [spec 01 lines 392-398].
+	 */
+	if (!fStarted || fDevice == NULL) {
+		return kIOGPUReturnNotAttached;
+	}
+	if (type != IOGPU_NOTIFICATION_PORT_TYPE) {
+		return kIOGPUReturnUnsupported;
+	}
+	IOGPUNotificationQueue *nq = fDevice->lookupNotifQueue((uint32_t)refCon);
+	if (nq == NULL) {
+		return kIOGPUReturnBadArgument;
+	}
+	IOReturn rc = nq->setNotificationPort(port);
+	nq->release();
+	return rc;
+}

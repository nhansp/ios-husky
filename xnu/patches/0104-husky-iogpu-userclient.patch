diff --git a/iokit/Families/IOGPU/IOGPU.cpp b/iokit/Families/IOGPU/IOGPU.cpp
new file mode 100644
index 0000000..608346e
--- /dev/null
+++ b/iokit/Families/IOGPU/IOGPU.cpp
@@ -0,0 +1,176 @@
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+/*
+ * IOGPU.cpp - Accelerator service lifecycle, configuration, and user client factory.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/IOGPU.cpp
+ *
+ * Implements IOGPU lifecycle against iOS 26.5 IOKit conventions:
+ *   - Service matching as IOAcceleratorES [spec 01 lines 108-112; spec 02 line 72]
+ *   - Registry properties: MetalPluginName="MaliMetal", MetalPluginClassName="MaliMTLDevice"
+ *     [spec 01 lines 113-118; claim A5-discovery]
+ *   - Config block setup [spec 01 lines 19, 304-315]
+ *   - Publishes MaliDevProps in IORegistry [spec 03 lines 288-292; fixes REVIEWS.md:39, 103]
+ *   - Correct failure unwind without double stop/teardown [fixes REVIEWS.md:86]
+ *   - Includes IOGPUMemory.h so OSSafeReleaseNULL(fKernelTask) compiles [fixes REVIEWS.md:68]
+ */
+#include "IOGPU.h"
+#include "IOGPUDeviceUserClient.h"
+#include "IOGPUEventMachine.h"
+#include "IOGPUMemory.h"     /* needed for IOGPUTask definition; fixes REVIEWS.md:68 */
+#include <pexpert/pexpert.h>
+
+OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
+OSDefineMetaClassAndAbstractStructors(IOGPU, IOAcceleratorES);
+
+bool
+IOGPU::start(IOService *provider)
+{
+	if (!IOAcceleratorES::start(provider)) {
+		return false;
+	}
+	fProvider = provider;
+
+	/* Kill switch: boot-arg huskygpu_hide=1 suppresses publishing */
+	uint32_t hide = 0;
+	if (PE_parse_boot_argn("huskygpu_hide", &hide, sizeof(hide)) && hide) {
+		fHidden = true;
+		IOLog("IOGPU: huskygpu_hide set; not publishing IOAcceleratorES\n");
+		return true;
+	}
+
+	/* Step 1: configureDevice (power, reset, firmware boot) [spec 03 lines 128-132] */
+	if (!configureDevice(provider)) {
+		IOLog("IOGPU: configureDevice failed\n");
+		return false;
+	}
+	fConfigured = true;
+
+	/* Step 2: default config then vendor population [spec 01 lines 19, 304-315] */
+	bzero(&fConfig, sizeof(fConfig));
+	strlcpy(fConfig.accelName, "Mali-G715", sizeof(fConfig.accelName));
+	fConfig.cmdBufArgsSize   = IOGPU_CMDBUF_ARGS_SIZE;    /* 0x30 [spec 01 line 397] */
+	fConfig.queueArgsSize    = IOGPU_NEW_QUEUE_ARGS_MIN;  /* 0x408 [spec 01 line 319] */
+	fConfig.privateSize      = 0;                         /* generic tail [spec 01 line 240] */
+	fConfig.numEventChannels = 1;                         /* 1 stamp slot [spec 01 line 290] */
+	fConfig.sharedMemorySize = 0;                         /* populated by hook */
+	populateAccelConfig(&fConfig);
+
+	/* Step 3: event machine [spec 03 lines 152-156] */
+	fEventMachine = newEventMachine();
+	if (fEventMachine == NULL || !fEventMachine->init()) {
+		IOLog("IOGPU: failed to create event machine\n");
+		teardownDevice(provider);
+		fConfigured = false;
+		return false;
+	}
+
+	/* Step 4: stamp page [spec 01 lines 138-140, 285-298; spec 03 lines 144-150] */
+	fStampMemory = getStampMemory(&fStampOffset);
+	if (fStampMemory == NULL) {
+		IOLog("IOGPU: getStampMemory failed\n");
+		OSSafeReleaseNULL(fEventMachine);
+		teardownDevice(provider);
+		fConfigured = false;
+		return false;
+	}
+	fEventMachine->setStampBaseMemory(fStampMemory, fStampOffset, fConfig.numEventChannels);
+
+	/* Step 5: kernel GPU task [spec 03 lines 164-168] */
+	fKernelTask = createKernelGPUTask();
+	if (fKernelTask == NULL) {
+		IOLog("IOGPU: createKernelGPUTask failed\n");
+		OSSafeReleaseNULL(fStampMemory);
+		OSSafeReleaseNULL(fEventMachine);
+		teardownDevice(provider);
+		fConfigured = false;
+		return false;
+	}
+
+	fAccelID = 1;   /* accelerator id returned in GET_DEVICE_INFO +0x18 [spec 01 line 310] */
+	fStarted = true;
+
+	/*
+	 * Step 6: Publish for Metal discovery:
+	 *   - MetalPluginName="MaliMetal" [spec 01 line 113; claim A5-discovery]
+	 *   - MetalPluginClassName="MaliMTLDevice" [spec 01 line 114]
+	 *   - IOUserClientClass="IOGPUDeviceUserClient" [spec 01 line 127]
+	 *   - MaliDevProps CFData blob [spec 03 line 288; fixes REVIEWS.md:39, 103]
+	 */
+	setProperty(IOGPU_PROP_PLUGIN_NAME, "MaliMetal");
+	setProperty(IOGPU_PROP_PLUGIN_CLASS, "MaliMTLDevice");
+	setProperty("IOGPUName", fConfig.accelName);
+	setProperty(kIOUserClientClassKey, "IOGPUDeviceUserClient");
+	publishDevProps();
+
+	registerService();
+	IOLog("IOGPU: %s published as IOAcceleratorES (accelID %u)\n", fConfig.accelName, fAccelID);
+	return true;
+}
+
+void
+IOGPU::stop(IOService *provider)
+{
+	if (fStarted || fConfigured) {
+		teardownDevice(provider);
+		fStarted = false;
+		fConfigured = false;
+	}
+	IOAcceleratorES::stop(provider);
+}
+
+void
+IOGPU::free()
+{
+	OSSafeReleaseNULL(fEventMachine);
+	OSSafeReleaseNULL(fStampMemory);
+	OSSafeReleaseNULL(fKernelTask);
+	IOAcceleratorES::free();
+}
+
+IOMemoryDescriptor *
+IOGPU::stampMemory(uint32_t *offset)
+{
+	if (offset) { *offset = fStampOffset; }
+	return fStampMemory;
+}
+
+void
+IOGPU::signalStampsUpdated()
+{
+	if (fEventMachine) {
+		fEventMachine->stampsUpdated();
+	}
+}
+
+IOReturn
+IOGPU::newUserClient(task_t owningTask, void *securityID, UInt32 type,
+    OSDictionary *properties, IOUserClient **handler)
+{
+	/*
+	 * Connect type low 16 bits:
+	 *   1    = device user client (IOGPUDeviceUserClient)
+	 *   0x21 = memory-info user client
+	 * [spec 01 lines 82-86, 124-131; spec 02 lines 105-110; claim A3-uc-type].
+	 */
+	uint32_t kind = type & 0xffff;
+	if (kind != IOGPU_UC_CONNECT_TYPE_DEVICE &&
+	    kind != IOGPU_UC_CONNECT_TYPE_MEMINFO) {
+		return kIOReturnUnsupported;
+	}
+
+	IOGPUDeviceUserClient *uc = OSTypeAlloc(IOGPUDeviceUserClient);
+	if (uc == NULL) {
+		return kIOReturnNoMemory;
+	}
+
+	if (!uc->initWithTask(owningTask, securityID, type, properties) ||
+	    !uc->attach(this) || !uc->start(this)) {
+		uc->detach(this);
+		uc->release();
+		return kIOReturnError;
+	}
+
+	*handler = uc;
+	return kIOReturnSuccess;
+}
+#endif /* ARM64_BOARD_CONFIG_HUSKY */
diff --git a/iokit/Families/IOGPU/IOGPU.h b/iokit/Families/IOGPU/IOGPU.h
new file mode 100644
index 0000000..a3cc1e1
--- /dev/null
+++ b/iokit/Families/IOGPU/IOGPU.h
@@ -0,0 +1,90 @@
+/*
+ * IOGPU.h - IOAcceleratorES base and IOGPU accelerator service.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/IOGPU.h
+ *
+ * Metal matches the accelerator service by class inheritance:
+ *   IOServiceMatching("IOAcceleratorES") [spec 01 lines 108-112; spec 02 line 72].
+ * IOGPU derives from IOAcceleratorES and owns:
+ *   - Accelerator lifecycle (start, stop, configureDevice, teardownDevice)
+ *   - The 0x40-byte IOGPUConfig block at accel+0x1e8 [spec 01 lines 19, 304-315]
+ *   - The shared stamp page and event machine [spec 01 lines 138-140, 285-298]
+ *   - The kernel GPU task [spec 03 lines 164-168]
+ *   - Dispatch of newUserClient (connect types 1 and 0x21) [spec 01 lines 82, 129]
+ */
+#ifndef _IOGPU_H
+#define _IOGPU_H
+
+#include "iogpu_internal.h"
+
+/*
+ * IOAcceleratorES: the base class Metal searches for in the IORegistry.
+ * Minimal base: inheritance provides the class identity string [spec 01 lines 108-112].
+ */
+class IOAcceleratorES : public IOService {
+	OSDeclareDefaultStructors(IOAcceleratorES);
+};
+
+/*
+ * IOGPU: the abstract IOGPUFamily accelerator driver.
+ * Concrete subclasses (such as MaliAccelerator) implement the vendor hooks.
+ */
+class IOGPU : public IOAcceleratorES {
+	OSDeclareAbstractStructors(IOGPU);
+
+protected:
+	IOService          *fProvider;
+	IOGPUConfig         fConfig;
+	IOGPUEventMachine  *fEventMachine;
+	IOGPUTask          *fKernelTask;
+	IOMemoryDescriptor *fStampMemory;
+	uint32_t            fStampOffset;
+	uint32_t            fAccelID;
+	bool                fHidden;        /* huskygpu_hide kill switch */
+	bool                fStarted;
+	bool                fConfigured;
+
+public:
+	/* IOService lifecycle */
+	virtual bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual void stop(IOService *provider) APPLE_KEXT_OVERRIDE;
+	virtual void free() APPLE_KEXT_OVERRIDE;
+
+	/* User client factory [spec 01 lines 124-131; claim A3-uc-type] */
+	virtual IOReturn newUserClient(task_t owningTask, void *securityID,
+	    UInt32 type, OSDictionary *properties,
+	    IOUserClient **handler) APPLE_KEXT_OVERRIDE;
+
+	/* Accessors for family objects */
+	IOGPUConfig        *config()        { return &fConfig; }
+	IOGPUEventMachine  *eventMachine()  { return fEventMachine; }
+	IOGPUTask          *kernelTask()    { return fKernelTask; }
+	uint32_t            accelID() const { return fAccelID; }
+	IOMemoryDescriptor *stampMemory(uint32_t *offset);
+
+	/* ---- Ten vendor hooks (spec 03 lines 128-192) ---- */
+	virtual bool                configureDevice(IOService *provider) = 0;   /* #1 */
+	virtual void                populateAccelConfig(IOGPUConfig *cfg) = 0;   /* #2 */
+	virtual IOMemoryDescriptor *getStampMemory(uint32_t *offset) = 0;        /* #3 */
+	virtual IOGPUEventMachine  *newEventMachine() = 0;                       /* #4 */
+	virtual IOGPUTask          *createUserGPUTask(task_t owner) = 0;         /* #5 */
+	virtual IOGPUTask          *createKernelGPUTask() = 0;                   /* #6 */
+	virtual IOGPUSysMemory     *newSysMemory() = 0;                          /* #7 */
+	virtual IOGPUResource      *newResource() = 0;                           /* #8 */
+	virtual IOGPUMemoryMap     *newMemoryMap() = 0;                          /* #9 */
+	virtual void                teardownDevice(IOService *provider) = 0;     /* #10 */
+
+	/* Factory for command queue subclasses [spec 03 lines 198-202] */
+	virtual IOGPUCommandQueue  *newCommandQueue() = 0;
+
+	/* Hardware backend pointer */
+	virtual mali_backend_t     *backend() = 0;
+
+	/* Publish vendor device properties in IORegistry [spec 03 lines 288-292] */
+	virtual void                publishDevProps() = 0;
+
+	/* Completion notification kick from backend IRQ [spec 03 lines 148-150] */
+	void signalStampsUpdated();
+};
+
+#endif /* _IOGPU_H */
diff --git a/iokit/Families/IOGPU/IOGPUCommandQueue.cpp b/iokit/Families/IOGPU/IOGPUCommandQueue.cpp
new file mode 100644
index 0000000..35be632
--- /dev/null
+++ b/iokit/Families/IOGPU/IOGPUCommandQueue.cpp
@@ -0,0 +1,442 @@
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+/*
+ * IOGPUCommandQueue.cpp - Command queue submission and CSF dispatch implementation.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/IOGPUCommandQueue.cpp
+ *
+ * Implements IOGPU command queue submission against Mali-G715 CSF hardware
+ * [spec 01 lines 535-649; spec 03 lines 198-202; spec 06 lines 140-212]:
+ *   - Parses untrusted shared memory K and S safely, snapshotting headers first
+ *     to prevent double-fetch vulnerabilities [fixes REVIEWS.md:77].
+ *   - Validates integer overflow on block lengths and bounds on segment lists
+ *     [spec 01 lines 636-640; fixes REVIEWS.md:77].
+ *   - Enforces group n < 7 and validates every resource ID [spec 01 line 632].
+ *   - Performs cache maintenance (mali_backend_ops.dcache_flush) on all referenced
+ *     resources before submitting to the GPU [spec 03 line 260; fixes REVIEWS.md:71, 98].
+ *   - Counts SUBMIT_CS records for sync object completion accounting (not per command buffer),
+ *     eliminating sync object desync [spec 06 lines 160-184; fixes REVIEWS.md:76].
+ *   - Guarantees notification delivery on error paths so userland callbacks always fire
+ *     [spec 01 lines 565-569; fixes REVIEWS.md:120].
+ */
+#include "IOGPUCommandQueue.h"
+#include "IOGPUDevice.h"
+#include "IOGPU.h"
+#include "IOGPUMemory.h"
+#include "IOGPUNotificationQueue.h"
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+
+OSDefineMetaClassAndStructors(IOGPUCommandQueue, OSObject);
+
+bool
+IOGPUCommandQueue::initQueue(IOGPUDevice *dev, const iogpu_new_command_queue_args_t *args)
+{
+	if (!OSObject::init()) {
+		return false;
+	}
+	fDevice = dev;
+	(void)args;
+
+	static volatile SInt64 sTrace = 0x2000;
+	fTraceId = (uint64_t)OSIncrementAtomic64(&sTrace);
+	fSubmitSeq = 0;
+	fStatus = kIOGPUStatus_Success;
+
+	mali_vm_t *vm = dev->task()->vm();
+
+	/* Allocate hardware queue on CSG0 / CS0 (compute-only v0) [spec 06 lines 170-174] */
+	if (mali_backend_ops.queue_create(vm, 0x1 /* CS0 */, &fMaliQueue) != 0) {
+		return false;
+	}
+
+	/* Allocate 64-bit CS sync object {seqno, error, pad} [spec 06 lines 160, 278] */
+	if (mali_backend_ops.syncobj_create(vm, &fSync) != 0) {
+		mali_backend_ops.queue_destroy(fMaliQueue);
+		fMaliQueue = NULL;
+		return false;
+	}
+
+	return true;
+}
+
+void
+IOGPUCommandQueue::free()
+{
+	if (fSync != NULL) {
+		mali_backend_ops.syncobj_destroy(fSync);
+		fSync = NULL;
+	}
+	if (fMaliQueue != NULL) {
+		mali_backend_ops.queue_destroy(fMaliQueue);
+		fMaliQueue = NULL;
+	}
+	OSObject::free();
+}
+
+IOReturn
+IOGPUCommandQueue::submitCommandBuffers(const void *structIn, uint32_t count,
+    uint32_t argSize, uint32_t *statusOut)
+{
+	const uint8_t *base = (const uint8_t *)structIn;
+	uint32_t status = kIOGPUStatus_Success;
+
+	for (uint32_t i = 0; i < count; i++) {
+		const iogpu_cmdbuf_args_t *cb =
+		    (const iogpu_cmdbuf_args_t *)(base + (uint64_t)i * argSize);
+		uint32_t s = processOneCommandBuffer(cb);
+		if (s != kIOGPUStatus_Success) {
+			status = s;   /* Last error reported to client */
+		}
+	}
+
+	fStatus = status;
+	if (statusOut != NULL) {
+		*statusOut = status;
+	}
+	return kIOGPUReturnSuccess;
+}
+
+uint32_t
+IOGPUCommandQueue::processOneCommandBuffer(const iogpu_cmdbuf_args_t *cb)
+{
+	uint64_t t0 = mach_absolute_time();
+
+	/* Resolve shared memory buffers [spec 01 lines 555-557] */
+	IOGPUDeviceShmem *kS = fDevice->lookupShmem(cb->kernelCommandShmemId);
+	IOGPUDeviceShmem *sS = fDevice->lookupShmem(cb->segmentListShmemId);
+
+	/* Missing segment shmem -> status 9 (kIOGPUStatus_SegmentBad) [spec 01 line 671] */
+	if (sS == NULL) {
+		OSSafeReleaseNULL(kS);
+		if (cb->completedRef && fNotifQueue) {
+			fNotifQueue->enqueueCompletion(cb->completedRef, t0, mach_absolute_time(),
+			    kIOGPUStatus_SegmentBad, 0);
+		}
+		return kIOGPUStatus_SegmentBad;
+	}
+
+	uint8_t *kbytes = kS ? (uint8_t *)kS->kernelBytes() : NULL;
+	uint8_t *sbytes = (uint8_t *)sS->kernelBytes();
+
+	/* Unmapped shmem -> status 8 (kIOGPUStatus_ShmemUnmapped) [spec 01 line 671] */
+	if (sbytes == NULL || (kS && kbytes == NULL)) {
+		OSSafeReleaseNULL(kS);
+		OSSafeReleaseNULL(sS);
+		if (cb->completedRef && fNotifQueue) {
+			fNotifQueue->enqueueCompletion(cb->completedRef, t0, mach_absolute_time(),
+			    kIOGPUStatus_ShmemUnmapped, 0);
+		}
+		return kIOGPUStatus_ShmemUnmapped;
+	}
+
+	uint32_t klen = kS ? kS->size : 0;
+	uint32_t slen = sS->size;
+
+	/* Deliver scheduled notification if requested [spec 01 lines 565-566] */
+	if (cb->scheduledRef && fNotifQueue) {
+		fNotifQueue->enqueueCompletion(cb->scheduledRef, t0, mach_absolute_time(),
+		    kIOGPUStatus_Success, 0);
+	}
+
+	uint32_t off = 0;
+	uint32_t status = kIOGPUStatus_Success;
+	uint32_t submits_dispatched = 0;
+
+	/*
+	 * Walk segment-list blocks safely with header snapshots to prevent
+	 * double-fetch hazards [spec 01 lines 609-640; fixes REVIEWS.md:77].
+	 */
+	while (off + sizeof(iogpu_seg_block_header_t) <= slen) {
+		iogpu_seg_block_header_t bh;
+		memcpy(&bh, sbytes + off, sizeof(bh));
+
+		uint32_t control = bh.control;
+		bool last = (control & IOGPU_SEG_CTRL_LAST) != 0;
+
+		if (control & IOGPU_SEG_CTRL_TYPED) {
+			/* Type-1 KC-list: {start, end} pairs [spec 01 lines 633-635] */
+			uint32_t type = control & 0x3fffffffu;
+			if (type != 1 && type != 2) {
+				status = kIOGPUStatus_ParseError;   /* Types other than 1 and 2 fail [spec 01 line 640] */
+				break;
+			}
+
+			/* Integer overflow check on blen */
+			if (bh.count > (slen - sizeof(iogpu_seg_block_header_t)) / 8u) {
+				status = kIOGPUStatus_ParseError;
+				break;
+			}
+			uint32_t blen = (uint32_t)sizeof(iogpu_seg_block_header_t) + 8u * bh.count;
+			if (off + blen > slen) {
+				status = kIOGPUStatus_ParseError;
+				break;
+			}
+
+			if (type == 1 && kbytes != NULL) {
+				const uint32_t *pairs = (const uint32_t *)(sbytes + off + 0x10);
+				for (uint32_t p = 0; p < bh.count; p++) {
+					uint32_t ks = pairs[2 * p];
+					uint32_t ke = pairs[2 * p + 1];
+					if (ks > ke || ke > klen) {
+						status = kIOGPUStatus_ParseError;
+						break;
+					}
+					status = processSegmentKernelCommands(kbytes, ks, ke, &submits_dispatched);
+					if (status != kIOGPUStatus_Success) {
+						break;
+					}
+				}
+			}
+			off += blen;
+		} else {
+			/* Type-0 segment-list block [spec 01 lines 618-632] */
+			uint32_t bsize = control & 0x3fffffffu;
+			if (bsize < 0x10 || off + bsize > slen) {
+				if (bsize == 0 && off == 0 && last) {
+					break;   /* Empty buffer accepted [spec 01 line 640] */
+				}
+				status = kIOGPUStatus_ParseError;
+				break;
+			}
+
+			uint32_t soff = off + 0x10;
+			for (uint32_t sseg = 0; sseg < bh.count; sseg++) {
+				if (soff + sizeof(iogpu_segment_header_t) > off + bsize) {
+					status = kIOGPUStatus_ParseError;
+					break;
+				}
+
+				iogpu_segment_header_t seg;
+				memcpy(&seg, sbytes + soff, sizeof(seg));
+
+				if (seg.kcStart > seg.kcEnd || seg.kcEnd > klen || kbytes == NULL) {
+					status = kIOGPUStatus_ParseError;
+					break;
+				}
+				if (seg.nGroups >= (1u << 26)) {
+					status = kIOGPUStatus_ParseError;
+					break;
+				}
+
+				uint64_t groupBytes = (uint64_t)seg.nGroups * sizeof(iogpu_resource_group_entry_t);
+				if (soff + sizeof(iogpu_segment_header_t) + groupBytes > off + bsize) {
+					status = kIOGPUStatus_ParseError;
+					break;
+				}
+
+				/*
+				 * Validate resource entries and perform cache maintenance
+				 * [spec 01 line 632; spec 03 lines 260-264; fixes REVIEWS.md:71, 77, 98].
+				 */
+				for (uint32_t g = 0; g < seg.nGroups; g++) {
+					iogpu_resource_group_entry_t entry;
+					memcpy(&entry, sbytes + soff + sizeof(iogpu_segment_header_t) +
+					    g * sizeof(iogpu_resource_group_entry_t), sizeof(entry));
+
+					if (entry.n >= 7) {
+						status = kIOGPUStatus_ParseError;   /* n must be < 7 [spec 01 line 632] */
+						break;
+					}
+
+					for (uint32_t r = 0; r < entry.n; r++) {
+						uint32_t resId = entry.resId[r];
+						if (resId == 0) {
+							status = kIOGPUStatus_ParseError;
+							break;
+						}
+
+						IOGPUResource *res = fDevice->lookupResource(resId);
+						if (res == NULL) {
+							status = kIOGPUStatus_ParseError;   /* Unknown ID fails buffer [spec 01 line 644] */
+							break;
+						}
+
+						/*
+						 * Non-coherent GPU cache maintenance: clean CPU-written
+						 * resources to DRAM before the GPU reads them
+						 * [claim C16; spec 03 lines 260-264; fixes REVIEWS.md:71, 98].
+						 * Flush using kernel mapping bo_cpu_map(res->bo()) rather than
+						 * client task userland VA to ensure valid EL1 translation and
+						 * flush resources without CPU mapping [fixes REVIEW defect 4].
+						 */
+						void *kernel_va = (res->bo() != NULL) ? mali_backend_ops.bo_cpu_map(res->bo()) : NULL;
+						if (kernel_va != NULL && res->residentSize() > 0) {
+							mali_backend_ops.dcache_flush(kernel_va, res->residentSize());
+						}
+						res->release(); /* Balance retain from lookupResource [fixes REVIEW defect 8] */
+					}
+					if (status != kIOGPUStatus_Success) {
+						break;
+					}
+				}
+				if (status != kIOGPUStatus_Success) {
+					break;
+				}
+
+				/* Process the segment's kernel commands */
+				status = processSegmentKernelCommands(kbytes, seg.kcStart, seg.kcEnd,
+				    &submits_dispatched);
+				if (status != kIOGPUStatus_Success) {
+					break;
+				}
+
+				soff += sizeof(iogpu_segment_header_t) + (uint32_t)groupBytes;
+			}
+			off += bsize;
+		}
+
+		if (status != kIOGPUStatus_Success || last) {
+			break;
+		}
+	}
+
+	/*
+	 * Sync accounting tied strictly to SUBMIT_CS dispatches:
+	 * Each SUBMIT_CS bumps the sync object by +1 via MALI_CS_SYNC_ADD64.
+	 * If no SUBMIT_CS jobs were dispatched (e.g. empty buffer or fences only),
+	 * we do NOT wait (fixes REVIEWS.md:36, 76).
+	 */
+	if (status == kIOGPUStatus_Success && submits_dispatched > 0) {
+		uint64_t target = fSubmitSeq + submits_dispatched;
+
+		/* Poll sync object for GPU completion [spec 06 lines 160, 275] */
+		uint64_t us;
+		for (us = 0; us < 500000; us += 10) {
+			if (mali_backend_ops.syncobj_read(fSync) >= target) {
+				break;
+			}
+			IODelay(10);
+		}
+
+		if (mali_backend_ops.syncobj_read(fSync) >= target) {
+			fSubmitSeq = target;
+		} else {
+			status = kIOGPUStatus_ParseError;   /* GPU timeout / hang treated as error */
+		}
+	}
+
+	uint64_t t1 = mach_absolute_time();
+
+	/*
+	 * Post completed notification with accurate status and timestamps
+	 * [spec 01 lines 565-569; fixes REVIEWS.md:120].
+	 */
+	if (cb->completedRef && fNotifQueue) {
+		fNotifQueue->enqueueCompletion(cb->completedRef, t0, t1, status, 0);
+	}
+
+	OSSafeReleaseNULL(kS);
+	OSSafeReleaseNULL(sS);
+	return status;
+}
+
+/*
+ * Decode kernel commands inside one segment [spec 01 lines 576-607].
+ */
+uint32_t
+IOGPUCommandQueue::processSegmentKernelCommands(const uint8_t *k, uint32_t start,
+    uint32_t end, uint32_t *submits_dispatched)
+{
+	uint32_t off = start;
+
+	while (off + sizeof(iogpu_kcmd_header_t) <= end) {
+		iogpu_kcmd_header_t h;
+		memcpy(&h, k + off, sizeof(h));
+
+		uint32_t type = h.type;
+		uint32_t size = h.size;
+
+		/* Validation: size >= 8, multiple of 4, cmd + size <= end [spec 01 line 580] */
+		if (size < sizeof(iogpu_kcmd_header_t) || (size & 3) || off + size > end) {
+			return kIOGPUStatus_ParseError;
+		}
+
+		const uint8_t *body = k + off + sizeof(iogpu_kcmd_header_t);
+
+		switch (type) {
+		case kIOGPUKCmd_SetResourceGroups: {      /* Type 15: first record, 0xac [spec 01 line 600] */
+			if (size != IOGPU_KCMD_SETGROUPS_SIZE) {
+				return kIOGPUStatus_ParseError;
+			}
+			uint32_t numGroups = *(const uint32_t *)body;
+			if (numGroups > IOGPU_KCMD_MAX_GROUPS) {
+				return kIOGPUStatus_ParseError;
+			}
+			break;
+		}
+		case kIOGPUKCmd_DebugLog:                 /* 0 */
+		case kIOGPUKCmd_SecondFamily:             /* 1 */
+		case kIOGPUKCmd_SleepMS:                  /* 2 */
+		case kIOGPUKCmd_SignalSharedEvent:        /* 3 */
+		case kIOGPUKCmd_WaitSharedEvent:          /* 4 */
+		case kIOGPUKCmd_SignalMTLEvent:           /* 5 */
+		case kIOGPUKCmd_WaitMTLEventBar:          /* 6 */
+		case kIOGPUKCmd_PurgeResources:           /* 8 */
+		case kIOGPUKCmd_SetProtection:            /* 9 */
+		case kIOGPUKCmd_WaitMTLEvent:             /* 10 */
+		case kIOGPUKCmd_SignalSEventAgent:        /* 11 */
+		case kIOGPUKCmd_CondEventAbort:           /* 12 */
+		case kIOGPUKCmd_SignalSEventSched:        /* 13 */
+		case kIOGPUKCmd_ResponsibleTasks:         /* 14 */
+		case kIOGPUKCmd_UpdateMappings:           /* 16 */
+		case kIOGPUKCmd_CopyMappings:             /* 17 */
+		case kIOGPUKCmd_PostMappingWait:          /* 18 */
+			/* Generic framework types accepted [spec 01 lines 587-604] */
+			break;
+
+		case MALI_KCMD_SUBMIT_CS: {               /* Vendor 0x15: run user CS chunk [mali_backend_ops.h] */
+			if (size < sizeof(iogpu_kcmd_header_t) + sizeof(struct mali_kcmd_submit_cs) - sizeof(iogpu_kcmd_header_t)) {
+				return kIOGPUStatus_ParseError;
+			}
+
+			const struct mali_kcmd_submit_cs *cmd =
+			    (const struct mali_kcmd_submit_cs *)(k + off);
+
+			/* Stream address must be 64-byte aligned, size multiple of 8 [mali_backend_ops.h line 180] */
+			if ((cmd->stream & (MALI_CS_STREAM_ALIGN - 1)) || (cmd->size & 7)) {
+				return kIOGPUStatus_ParseError;
+			}
+
+			/* Validate total record size matches sync count [submit_framing.h line 195] */
+			uint32_t expectedSize = (uint32_t)sizeof(struct mali_kcmd_submit_cs) +
+			    4u * (cmd->n_wait + cmd->n_signal);
+			if (size != expectedSize) {
+				return kIOGPUStatus_ParseError;
+			}
+
+			mali_submit_desc_t desc;
+			bzero(&desc, sizeof(desc));
+			desc.queue_index  = 0;
+			desc.stream_addr  = cmd->stream;
+			desc.stream_size  = cmd->size;
+			desc.latest_flush = cmd->flush_id;
+
+			const mali_syncobj_t *sig = fSync;
+			desc.signals   = &sig;
+			desc.n_signals = 1;
+
+			if (mali_backend_ops.queue_submit(fMaliQueue, &desc) != 0) {
+				return kIOGPUStatus_ParseError;
+			}
+
+			(*submits_dispatched)++;
+			break;
+		}
+
+		case MALI_KCMD_FENCE:                     /* Vendor 0x13: stamp write completion marker */
+		case MALI_KCMD_FILL:                      /* Vendor 0x14: buffer fill */
+		case MALI_KCMD_HEAP_OP:                   /* Vendor 0x16: tiler heap management */
+			/* Decoded and accepted */
+			break;
+
+		default:
+			/* Unknown command -> status 0xa [spec 01 line 605] */
+			return kIOGPUStatus_ParseError;
+		}
+
+		off += size;
+	}
+
+	return kIOGPUStatus_Success;
+}
+#endif /* ARM64_BOARD_CONFIG_HUSKY */
diff --git a/iokit/Families/IOGPU/IOGPUCommandQueue.h b/iokit/Families/IOGPU/IOGPUCommandQueue.h
new file mode 100644
index 0000000..9b5d156
--- /dev/null
+++ b/iokit/Families/IOGPU/IOGPUCommandQueue.h
@@ -0,0 +1,58 @@
+/*
+ * IOGPUCommandQueue.h - Command queue submission, CSF group program, and validation.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/IOGPUCommandQueue.h
+ *
+ * Implements IOGPU submission framing against Mali-G715 CSF hardware
+ * [spec 01 lines 535-649; spec 03 lines 198-202; spec 06 lines 140-212]:
+ *   - Parses and validates untrusted shared memory K and S without double-fetches
+ *     [spec 01 lines 576-640; fixes REVIEWS.md:77]
+ *   - Cache maintenance on all referenced resources before submission
+ *     [spec 03 lines 260-264; fixes REVIEWS.md:71, 98]
+ *   - Accurate sync accounting tied to SUBMIT_CS count [fixes REVIEWS.md:76]
+ *   - Real queue program via the husky CSF path [husky_gpu.c lines 640-680, 947-975]
+ *   - Notification delivery on error and success [spec 01 lines 565-569; fixes REVIEWS.md:120]
+ */
+#ifndef _IOGPU_COMMAND_QUEUE_H
+#define _IOGPU_COMMAND_QUEUE_H
+
+#include "iogpu_internal.h"
+
+class IOGPUDevice;
+class IOGPUNotificationQueue;
+
+class IOGPUCommandQueue : public OSObject {
+	OSDeclareDefaultStructors(IOGPUCommandQueue);
+
+	IOGPUDevice            *fDevice;
+	IOGPUNotificationQueue *fNotifQueue;
+	mali_queue_t           *fMaliQueue;
+	mali_syncobj_t         *fSync;
+	uint64_t                fTraceId;
+	uint64_t                fSubmitSeq;     /* Monotonic sync count [spec 06 line 180] */
+	uint32_t                fStatus;        /* Last submission status */
+
+public:
+	bool initQueue(IOGPUDevice *dev, const iogpu_new_command_queue_args_t *args);
+	void free() APPLE_KEXT_OVERRIDE;
+
+	uint64_t traceObjectId() const { return fTraceId; }
+	void setNotificationQueue(IOGPUNotificationQueue *nq) { fNotifQueue = nq; }
+
+	/*
+	 * Submission entry (selector 25 / trap 0) [spec 01 lines 211, 254, 537-551].
+	 * Writes queue status to *statusOut (0 = success).
+	 */
+	IOReturn submitCommandBuffers(const void *structIn, uint32_t count,
+	    uint32_t argSize, uint32_t *statusOut);
+
+private:
+	/* Process one command buffer and manage notifications */
+	uint32_t processOneCommandBuffer(const iogpu_cmdbuf_args_t *cb);
+
+	/* Decode kernel commands inside one segment [spec 01 lines 576-607] */
+	uint32_t processSegmentKernelCommands(const uint8_t *k, uint32_t start,
+	    uint32_t end, uint32_t *submits_dispatched);
+};
+
+#endif /* _IOGPU_COMMAND_QUEUE_H */
diff --git a/iokit/Families/IOGPU/IOGPUDevice.cpp b/iokit/Families/IOGPU/IOGPUDevice.cpp
new file mode 100644
index 0000000..53bb4f4
--- /dev/null
+++ b/iokit/Families/IOGPU/IOGPUDevice.cpp
@@ -0,0 +1,248 @@
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+/*
+ * IOGPUDevice.cpp - Per-connection namespace and shared memory implementation.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/IOGPUDevice.cpp
+ *
+ * Implements namespace management with strict ID checks [spec 01 line 707]:
+ *   - All handles are 1-based non-zero integers; 0 is an invalid handle.
+ *   - Looking up an unknown handle returns NULL -> maps to kIOGPUReturnBadArgument.
+ *   - Concurrent access is guarded with IOLock [fixes REVIEWS.md:78].
+ *   - ID drift bug is fixed: nextId is only advanced when setObject succeeds [fixes REVIEWS.md:93].
+ *   - Leaks are avoided: caller drops allocation refcount after adding [fixes REVIEWS.md:69].
+ */
+#include "IOGPUDevice.h"
+#include "IOGPU.h"
+#include "IOGPUMemory.h"
+#include "IOGPUCommandQueue.h"
+#include "IOGPUNotificationQueue.h"
+
+OSDefineMetaClassAndStructors(IOGPUDeviceShmem, OSObject);
+OSDefineMetaClassAndStructors(IOGPUDevice, OSObject);
+
+/* ---- IOGPUDeviceShmem ---- */
+bool
+IOGPUDeviceShmem::init(uint32_t t, uint32_t sz)
+{
+	if (!OSObject::init()) {
+		return false;
+	}
+	type = t;
+	size = (uint32_t)round_page(sz);
+	windowOff = 0;
+	windowLen = size;
+
+	/*
+	 * Allocate kernel+user shared memory, zero-initialized and page-aligned
+	 * [spec 01 lines 359-360, 367].
+	 */
+	memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIOMemoryKernelUserShared | kIODirectionInOut, size, page_size);
+	if (memory == NULL) {
+		return false;
+	}
+	bzero(memory->getBytesNoCopy(), size);
+	return true;
+}
+
+void
+IOGPUDeviceShmem::free()
+{
+	OSSafeReleaseNULL(userMap);
+	OSSafeReleaseNULL(memory);
+	OSObject::free();
+}
+
+void *
+IOGPUDeviceShmem::kernelBytes()
+{
+	return memory ? memory->getBytesNoCopy() : NULL;
+}
+
+/* ---- IOGPUDevice ---- */
+bool
+IOGPUDevice::initWithAccel(IOGPU *accel, task_t owner)
+{
+	if (!OSObject::init()) {
+		return false;
+	}
+	fAccel = accel;
+	fOwner = owner;
+
+	fLock = IOLockAlloc();
+	if (fLock == NULL) {
+		return false;
+	}
+
+	fResources   = OSArray::withCapacity(16);
+	fShmems      = OSArray::withCapacity(8);
+	fNotifQueues = OSArray::withCapacity(4);
+	fQueues      = OSArray::withCapacity(4);
+
+	fNextResId   = 1;
+	fNextShmemId = 1;
+	fNextNqId    = 1;
+	fNextQueueId = 1;
+
+	if (!fResources || !fShmems || !fNotifQueues || !fQueues) {
+		return false;
+	}
+
+	/* Step 2: create the per-connection GPU task / VM [spec 01 line 141; spec 03 line 158] */
+	fTask = accel->createUserGPUTask(owner);
+	return (fTask != NULL);
+}
+
+void
+IOGPUDevice::free()
+{
+	OSSafeReleaseNULL(fResources);
+	OSSafeReleaseNULL(fShmems);
+	OSSafeReleaseNULL(fNotifQueues);
+	OSSafeReleaseNULL(fQueues);
+	OSSafeReleaseNULL(fTask);
+
+	if (fLock) {
+		IOLockFree(fLock);
+		fLock = NULL;
+	}
+	OSObject::free();
+}
+
+/*
+ * Namespace helper macros:
+ *   - NS_ADD: atomically sets object at index = (id - 1). If successful, increments
+ *             nextId and returns id. If setObject fails, does NOT increment nextId
+ *             (fixing ID drift: REVIEWS.md:93).
+ *   - NS_LOOKUP: returns pointer under lock if index is in range and valid.
+ *   - NS_REMOVE: replaces entry with kOSBooleanFalse under lock, dropping retain count.
+ */
+static uint32_t
+ns_add_internal(IOLock *lock, OSArray *arr, uint32_t *pNextId, OSObject *obj)
+{
+	IOLockLock(lock);
+	uint32_t id = *pNextId;
+	unsigned int idx = id - 1;
+	bool ok = false;
+	if (idx < arr->getCount()) {
+		ok = arr->replaceObject(idx, obj);
+	} else if (idx == arr->getCount()) {
+		ok = arr->setObject(obj);
+	} else {
+		/* Pad with false values up to idx */
+		while (arr->getCount() < idx) {
+			arr->setObject(kOSBooleanFalse);
+		}
+		ok = arr->setObject(obj);
+	}
+	if (ok) {
+		(*pNextId)++;
+	} else {
+		id = 0;
+	}
+	IOLockUnlock(lock);
+	return id;
+}
+
+static OSObject *
+ns_lookup_internal(IOLock *lock, OSArray *arr, uint32_t id)
+{
+	OSObject *ret = NULL;
+	IOLockLock(lock);
+	if (id >= 1 && (id - 1) < arr->getCount()) {
+		OSObject *obj = arr->getObject(id - 1);
+		if (obj != (OSObject *)kOSBooleanFalse) {
+			ret = obj;
+			ret->retain(); /* Retain under lock to prevent concurrent UAF [fixes REVIEW defect 8] */
+		}
+	}
+	IOLockUnlock(lock);
+	return ret;
+}
+
+static void
+ns_remove_internal(IOLock *lock, OSArray *arr, uint32_t id)
+{
+	IOLockLock(lock);
+	if (id >= 1 && (id - 1) < arr->getCount()) {
+		arr->replaceObject(id - 1, kOSBooleanFalse);
+	}
+	IOLockUnlock(lock);
+}
+
+/* Resource namespace */
+uint32_t
+IOGPUDevice::addResource(IOGPUResource *r)
+{
+	return ns_add_internal(fLock, fResources, &fNextResId, (OSObject *)r);
+}
+
+IOGPUResource *
+IOGPUDevice::lookupResource(uint32_t id)
+{
+	return OSDynamicCast(IOGPUResource, ns_lookup_internal(fLock, fResources, id));
+}
+
+void
+IOGPUDevice::removeResource(uint32_t id)
+{
+	ns_remove_internal(fLock, fResources, id);
+}
+
+/* Shmem namespace */
+uint32_t
+IOGPUDevice::addShmem(IOGPUDeviceShmem *s)
+{
+	return ns_add_internal(fLock, fShmems, &fNextShmemId, (OSObject *)s);
+}
+
+IOGPUDeviceShmem *
+IOGPUDevice::lookupShmem(uint32_t id)
+{
+	return OSDynamicCast(IOGPUDeviceShmem, ns_lookup_internal(fLock, fShmems, id));
+}
+
+void
+IOGPUDevice::removeShmem(uint32_t id)
+{
+	ns_remove_internal(fLock, fShmems, id);
+}
+
+/* Notification queue namespace */
+uint32_t
+IOGPUDevice::addNotifQueue(IOGPUNotificationQueue *q)
+{
+	return ns_add_internal(fLock, fNotifQueues, &fNextNqId, (OSObject *)q);
+}
+
+IOGPUNotificationQueue *
+IOGPUDevice::lookupNotifQueue(uint32_t id)
+{
+	return OSDynamicCast(IOGPUNotificationQueue, ns_lookup_internal(fLock, fNotifQueues, id));
+}
+
+void
+IOGPUDevice::removeNotifQueue(uint32_t id)
+{
+	ns_remove_internal(fLock, fNotifQueues, id);
+}
+
+/* Command queue namespace */
+uint32_t
+IOGPUDevice::addQueue(IOGPUCommandQueue *q)
+{
+	return ns_add_internal(fLock, fQueues, &fNextQueueId, (OSObject *)q);
+}
+
+IOGPUCommandQueue *
+IOGPUDevice::lookupQueue(uint32_t id)
+{
+	return OSDynamicCast(IOGPUCommandQueue, ns_lookup_internal(fLock, fQueues, id));
+}
+
+void
+IOGPUDevice::removeQueue(uint32_t id)
+{
+	ns_remove_internal(fLock, fQueues, id);
+}
+#endif /* ARM64_BOARD_CONFIG_HUSKY */
diff --git a/iokit/Families/IOGPU/IOGPUDevice.h b/iokit/Families/IOGPU/IOGPUDevice.h
new file mode 100644
index 0000000..df4ac66
--- /dev/null
+++ b/iokit/Families/IOGPU/IOGPUDevice.h
@@ -0,0 +1,104 @@
+/*
+ * IOGPUDevice.h - Per-connection device object, namespace management, and shared memory.
+ * -------------------------------------------------------------------------
+ * Target repo path: kernel/iokit/Families/IOGPU/IOGPUDevice.h
+ *
+ * Each IOGPUDeviceUserClient connection instantiates one IOGPUDevice object
+ * [spec 01 lines 141-143; spec 02 lines 105-115].
+ * Owns:
+ *   - The client's GPU task and address space (IOGPUTask / mali_vm_t)
+ *   - 1-based per-connection handle namespaces:
+ *       * Resources (sel 8 / trap 1 / sel 9) [spec 01 lines 498, 528]
+ *       * Device shmems (sels 12 / 13) [spec 01 lines 357, 371]
+ *       * Notification queues (sels 14 / 15) [spec 01 lines 383, 400]
+ *       * Command queues (sels 6 / 7) [spec 01 lines 431, 445]
+ *   - Thread-safe handle lookup and lifecycle management with IOLock [fixes REVIEWS.md:78]
+ *   - ID drift prevention and leak-free lifecycle [fixes REVIEWS.md:69, 93]
+ */
+#ifndef _IOGPU_DEVICE_H
+#define _IOGPU_DEVICE_H
+
+#include "iogpu_internal.h"
+
+class IOGPU;
+class IOGPUTask;
+class IOGPUResource;
+class IOGPUCommandQueue;
+class IOGPUNotificationQueue;
+
+/*
+ * IOGPUDeviceShmem: client-kernel shared memory region (selector 12/13).

+
+/* Helper to get struct input pointer handling inband vs IOMemoryDescriptor [spec 01 line 163] */
+static const void *
+get_struct_input(IOExternalMethodArguments *a, IOMemoryMap **outMap)
+{
+	*outMap = NULL;
+	if (a->structureInputDescriptor != NULL) {
+		*outMap = a->structureInputDescriptor->createMappingInTask(kernel_task, 0, kIOMapAnywhere);
+		return *outMap ? (const void *)(*outMap)->getAddress() : NULL;
+	}
+	return a->structureInput;
+}

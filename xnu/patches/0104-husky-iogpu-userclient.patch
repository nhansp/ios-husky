+/* -- sel 0 GET_DEVICE_INFO (bOut 64) [spec 01 lines 186, 301-316] -- */
+static IOReturn
+h_get_device_info(OSObject *target, void *, IOExternalMethodArguments *a)
+{
+	if (a->structureOutputSize < sizeof(iogpu_device_info_t)) {
+		return kIOGPUReturnBadArgument;
+	}
+	iogpu_device_info_t *o = (iogpu_device_info_t *)a->structureOutput;
+	bzero(o, sizeof(*o));
+	o->configBits       = ACC()->config()->configBits;
+	o->deviceBits       = ACC()->config()->deviceBits;
+	o->textureRam       = 0;
+	o->videoRam         = 0;   /* 0 = unified memory [spec 01 line 308] */
+	o->accelID          = ACC()->accelID();
+	o->sharedMemorySize = ACC()->config()->sharedMemorySize;
+	o->maxResourceSize  = ACC()->config()->maxResourceSize;
+	return kIOGPUReturnSuccess;
+}
+
+/* -- sel 1 GET_NAME (bOut 64) [spec 01 lines 187, 320-322] -- */
+static IOReturn
+h_get_name(OSObject *target, void *, IOExternalMethodArguments *a)
+{
+	if (a->structureOutputSize < 0x40) {
+		return kIOGPUReturnBadArgument;
+	}
+	strlcpy((char *)a->structureOutput, ACC()->config()->accelName, 0x40);
+	return kIOGPUReturnSuccess;
+}
+
+/* -- sel 2 GET_STAMP_CONFIG (bOut 0x218) [spec 01 lines 188, 281-299] -- */
+static IOReturn
+h_get_stamp_config(OSObject *target, void *, IOExternalMethodArguments *a)
+{

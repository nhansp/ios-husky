+#define CS_OUT_FAULT_INFO       0x88u               /* [husky_gpu.c:303] */
+#define CS_OUT_FATAL_INFO       0x90u               /* [husky_gpu.c:304] */
+#define CS_STATE_MASK           7u                  /* [husky_gpu.c:305] */
+#define CS_STATE_START          1u                  /* [husky_gpu.c:306] */

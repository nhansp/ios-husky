+bool
+IOGPUDeviceUserClient::initWithTask(task_t owningTask, void *securityID,
+    UInt32 type, OSDictionary *properties)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) {
+		return false;
+	}
+	fTask = owningTask;
+
+	/* Initialize the 14 trap descriptors [spec 01 lines 247-271] */
+	bzero(fTraps, sizeof(fTraps));
+	fTraps[kIOGPUTrap_SubmitOne].object              = (IOService *)this;
+	fTraps[kIOGPUTrap_SubmitOne].func                = (IOTrap)&IOGPUDeviceUserClient::trapSubmitOne;
+	fTraps[kIOGPUTrap_ReleaseResource].object        = (IOService *)this;
+	fTraps[kIOGPUTrap_ReleaseResource].func          = (IOTrap)&IOGPUDeviceUserClient::trapReleaseResource;
+	fTraps[kIOGPUTrap_ResourceFinishEvent].object    = (IOService *)this;
+	fTraps[kIOGPUTrap_ResourceFinishEvent].func      = (IOTrap)&IOGPUDeviceUserClient::trapResourceFinishEvent;
+	fTraps[kIOGPUTrap_SetResourcePurgeable].object   = (IOService *)this;
+	fTraps[kIOGPUTrap_SetResourcePurgeable].func     = (IOTrap)&IOGPUDeviceUserClient::trapSetResourcePurgeable;
+	fTraps[kIOGPUTrap_GroupAdd].object               = (IOService *)this;

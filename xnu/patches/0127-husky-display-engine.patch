+	gicd_write32(cfg_off, gicd_read32(cfg_off) & ~(3U << cfg_shift));
+	*(volatile uint8_t *)(gicd_base + HUSKY_GICD_IPRIORITYR + intid) = prio;
+	*(volatile uint64_t *)(gicd_base + HUSKY_GICD_IROUTER + (vm_offset_t)intid * 8) = husky_boot_affinity;
+	__builtin_arm_dsb(DSB_SY);
+	gicd_write32(HUSKY_GICD_ISENABLER + (intid / 32) * 4, 1U << (intid % 32));
+	while (gicd_read32(GICD_CTLR) & HUSKY_GICD_CTLR_RWP) {

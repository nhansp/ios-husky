+void husky_dcache_flush(vm_offset_t va, size_t len);
+void husky_dcache_clean(vm_offset_t va, size_t len);
+
 /*
  * Clean+invalidate to PoC by VA. XNU's flush_dcache64 is a bare dsb here:
  * the HUSKY config inherits Apple's __ARM_COHERENT_IO__ (all DMA coherent),
@@ -522,6 +525,21 @@ husky_dcache_flush(vm_offset_t va, size_t len)
 	__asm__ volatile ("dsb sy" ::: "memory");
 }
 
+/* Clean to PoC by VA, lines stay valid: CPU-written scanout pixels for the DPU. */
+void
+husky_dcache_clean(vm_offset_t va, size_t len)
+{
+	uint64_t ctr;
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r"(ctr));
+	size_t line = 4u << ((ctr >> 16) & 0xf);
+	vm_offset_t p = va & ~(vm_offset_t)(line - 1);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (; p < va + len; p += line) {
+		__asm__ volatile ("dc cvac, %0" : : "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}

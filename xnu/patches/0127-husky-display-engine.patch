+/*
+ * Display engine for HUSKY.
+ *
+ * The ABL leaves DECON0 idle with the DPP0 RDMA pointing at its splash
+ * buffer; the DSI command-mode panel keeps its last frame and DECON0 sends
+ * one frame per shadow-update request, started by the panel's TE through the
+ * hardware trigger. This engine keeps that arrangement and changes only what
+ * a frame reads: the RDMA base address register is pointed at the physical
+ * pages of the IOSurface CoreAnimation just finished, so GPU-rendered frames
+ * reach the panel without a CPU copy. Surfaces CoreAnimation creates for the
+ * panel come from a physically contiguous pool below 4 GiB (the DPU SysMMU is
+ * left in bypass); anything else still takes the CPU copy into the splash.
+ *
+ * Everything runs only when boot-arg huskydisp=N is set; the steps are
+ * cumulative:
+ *   1  read-only register probe and TE measurement
+ *   2  scanout pool, swap statistics, SwapWait argument logging
+ *   3  direct flips, polled
+ *   4  GIC interrupts, vsync from the panel's TE
+ *   5  panel to 120 Hz (huskydisp_hz=60 skips it)
+ *   6  failure injection (huskydisp_inject=1|2)
+ * huskydisp_slots=2..6 sizes the pool (default 4 x 16 MiB).
+ */
+#include "HuskyDisplay.h"
+
+#if defined(HUSKY)
+#include <IOKit/system.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOMemoryDescriptor.h>
+#include <kern/clock.h>
+#include <mach/mach_time.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <machine/atomic.h>
+#include <libkern/OSAtomic.h>
+#include <pexpert/pexpert.h>
+
+extern "C" vm_offset_t ml_io_map(vm_offset_t phys_addr, vm_size_t size);
+extern "C" int husky_irq_register(uint32_t intid, void (*fn)(void *arg, uint32_t intid), void *arg);
+extern "C" void husky_gic_spi_enable(uint32_t intid, uint8_t prio);
+extern "C" int husky_gic_spi_probe(uint32_t intid, uint32_t *grp, uint32_t *cfg, uint32_t *en, uint64_t *route);
+extern unsigned long gPhysBase, gPhysSize;
+
+#define HD_DECON_PHYS           0x19470000ULL
+#define HD_WIN_PHYS             0x19480000ULL
+#define HD_WINCON_PHYS          0x194A0000ULL
+#define HD_DSIM_PHYS            0x19440000ULL
+#define HD_RDMA_PHYS            0x19900000ULL
+#define HD_SYSMMU_PHYS          0x19840000ULL
+#define HD_WINDOWS              14
+#define HD_WIN_STRIDE           0x1000
+
+/* DECON0 main */
+#define DECON_GLOBAL_CON        0x20
+#define DECON_TRIG_CON          0x30
+#define DECON_HW_TE_CNT         0x38
+#define DECON_SHD_REG_UP_REQ    0x50
+#define DECON_INT_EN            0x60
+#define DECON_INT_EN_EXTRA      0x64
+#define DECON_INT_PEND          0x70
+#define DECON_INT_PEND_EXTRA    0x74
+#define GCON_CMD                (1u << 8)
+#define TRIG_HW_EN              (1u << 0)
+#define TRIG_MASK_DECON         (1u << 4)
+#define TRIG_SEL_MASK           (3u << 24)
+#define INT_EN_MASTER           (1u << 0)
+#define INT_EXTRA               (1u << 4)
+#define INT_FRAME_START         (1u << 12)
+#define INT_FRAME_DONE          (1u << 13)
+#define EXTRA_TIME_OUT          (1u << 0)
+#define EXTRA_RES_CONFLICT      (1u << 4)
+#define EXTRA_TE_RISE           (1u << 16)
+#define EXTRA_ALL               (EXTRA_TIME_OUT | EXTRA_RES_CONFLICT | EXTRA_TE_RISE)
+#define SHD_REQUEST             0x80003FFFu
+
+/* DPP0 RDMA */
+#define RDMA_IRQ                0x04
+#define RDMA_IN_CTRL_0          0x08
+#define RDMA_SRC_SIZE           0x10
+#define RDMA_SRC_OFFSET         0x14
+#define RDMA_IMG_SIZE           0x18

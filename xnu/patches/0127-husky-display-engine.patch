+/* ---- scanout pool ---- */
+
+static struct {
+	IOSimpleLock             *lock;
+	bool                      ready;
+	uint32_t                  n, used;
+	uint32_t                  width, height, stride;
+	uint64_t                  pa[HD_MAX_SLOTS];
+	void                     *kva[HD_MAX_SLOTS];
+	IOBufferMemoryDescriptor *md[HD_MAX_SLOTS];
+	IOBufferMemoryDescriptor *whole;
+} husky_pool;
+
+bool
+husky_scanout_geometry(uint32_t *width, uint32_t *height, uint32_t *bytesPerRow)
+{
+	if (!husky_pool.ready) {
+		return false;
+	}
+	*width = husky_pool.width;
+	*height = husky_pool.height;
+	*bytesPerRow = husky_pool.stride;
+	return true;
+}
+
+bool
+husky_scanout_slot_get(uint64_t size, uint64_t *pa, void **kva, int *slot)
+{
+	bool found = false;
+
+	if (!husky_pool.ready || size > HD_SLOT_SIZE) {
+		return false;
+	}
+	IOInterruptState st = IOSimpleLockLockDisableInterrupt(husky_pool.lock);
+	for (uint32_t i = 0; i < husky_pool.n; i++) {
+		if (!(husky_pool.used & (1u << i))) {
+			husky_pool.used |= 1u << i;
+			*pa = husky_pool.pa[i];
+			*kva = husky_pool.kva[i];
+			*slot = (int)i;
+			found = true;
+			break;
+		}
+	}
+	IOSimpleLockUnlockEnableInterrupt(husky_pool.lock, st);
+	return found;
+}
+
+void
+husky_scanout_slot_put(int slot)
+{
+	if (!husky_pool.ready || slot < 0 || (uint32_t)slot >= husky_pool.n) {
+		return;
+	}
+	IOInterruptState st = IOSimpleLockLockDisableInterrupt(husky_pool.lock);
+	husky_pool.used &= ~(1u << slot);
+	IOSimpleLockUnlockEnableInterrupt(husky_pool.lock, st);
+}
+
+/* ---- panel DCS batches, bytes on the DSI link ---- */
+
+struct husky_dcs {
+	uint8_t len;
+	uint8_t b[13];
+};
+
+/*
+ * 60 -> 120 Hz and back: the byte sequences hk3_set_panel_feat
+ * (panel-google-hk3.c) emits for HS op mode, manual frame mode, early exit on
+ * and fixed TE at 120 Hz, and for early exit off, changeable TE at 60 Hz. Each
+ * batch must go out whole (the driver warns of a black screen otherwise). The
+ * IRC and TE2 blocks are deliberately not sent: this code never changes them.
+ */

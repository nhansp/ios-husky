+	bool     fPoolOK, fProbeOK;
+	bool     fIrqOK, fIrqOn;
+	bool     fTeRise, fHwCnt;               /* TE_RISE latches; HW_TE_CNT counts */
+	uint32_t fPeriodUS;
+	uint32_t fTeHz;
+	uint32_t fDsimUrun, fDsimTe1;           /* ABL's values, probed */
+	uint32_t fWatchTick;
+	uint32_t fHwCntLast;
+	uint32_t fHwShift;                      /* HW_TE_CNT field that counts TE: 0 = CNT_A, 16 = CNT_B */
+	bool     fVsyncDirty, fWantTimer;
+	uint32_t fWantPeriodUS;
+	char     fFallbackMsg[64];
+	bool     fFallbackPending;
+
+	uint32_t fSwapStats, fSwapPool, fSwapNonPool, fDistinctN;
+	uint32_t fDistinct[16];
+	uint32_t fSwapWaitLogged;
+
+	static void watchFired(OSObject *owner, IOTimerEventSource *sender);
+	static void pollFired(OSObject *owner, IOTimerEventSource *sender);
+	static void bringupEntry(void *arg, wait_result_t wr);
+
+	bool setup(void);
+	void probe(void);
+	bool allocPool(void);
+	void bringup(void);
+	bool teMeasure(uint32_t ms, uint32_t *edges, uint32_t *hw0, uint32_t *hw1);
+	uint32_t teWait(uint32_t ms, uint32_t *periodUS);
+	uint32_t hwTe(void);
+	uint32_t teDelta(uint32_t cur, uint32_t last);
+	uint32_t teSample(void);
+	void teSkip(uint32_t n);
+	void enableDecon(void);
+	bool irqOn(void);
+	void pickVsync(bool measure);
+	void panelTo120(void);
+	void panelTo60(void);
+	bool panelQuiesce(void);
+	bool dsimSend(const void *packets, uint32_t count, uint32_t *drainedUS);
+	void dsimTimers(uint32_t urun, uint32_t te1);
+	void requestFrame(uint64_t pa);
+
+	void programFlip(uint64_t pa);
+	void arm(HuskySurface *s, uint64_t pa, uint32_t swapID);
+	bool armWait(HuskySurface *s, uint64_t pa, uint32_t swapID);
+	void startPoll(void);
+	void retire(struct husky_flip *f);
+	void onFrameStart(void);
+	void onFrameDone(void);
+	void onExtra(void);
+	void onRdma(void);
+	void servicePoll(void);
+	void pollNow(void);
+	void fallback(const char *reason);
+	void markRetired(uint32_t swapID);
+	bool doWork(void);
+	void watch(void);
+	void stats(void);
+};
+
+#endif /* HUSKY */
+#endif /* _HUSKY_DISPLAY_H */

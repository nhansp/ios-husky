+static uint64_t
+hd_us_to_abs(uint64_t us)
+{
+	uint64_t a;
+	nanoseconds_to_absolutetime(us * 1000, &a);
+	return a;
+}
+
+static uint32_t
+hd_abs_to_us(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return (uint32_t)(ns / 1000);
+}

+static void
+husky_disp_irq(void *arg, uint32_t intid)
+{
+	((HuskyDisplay *)arg)->irq(intid);
+}
+
+uint32_t
+HuskyDisplay::level(void)
+{
+	static uint32_t v = ~0u;
+	if (v == ~0u) {
+		v = hd_boot_arg("huskydisp", 0);
+	}
+	return v;
+}
+
+HuskyDisplay *
+HuskyDisplay::create(IOWorkLoop *loop, uint64_t splashPA, uint32_t width, uint32_t height,
+    uint32_t rowBytes, HuskySurface *splash, const HuskyDisplayOps *ops, void *ctx)
+{
+	uint32_t lvl = level();
+	if (lvl == 0) {
+		return NULL;
+	}
+	HuskyDisplay *d = OSTypeAlloc(HuskyDisplay);
+	if (d == NULL || !d->init()) {
+		OSSafeReleaseNULL(d);
+		return NULL;
+	}
+	d->fLoop = loop;
+	d->fOps = *ops;
+	d->fCtx = ctx;
+	d->fSplash = splash;
+	d->fSplashPA = splashPA;
+	d->fWidth = width;
+	d->fHeight = height;
+	d->fRowBytes = rowBytes;
+	d->fFrameBytes = rowBytes * height;
+	d->fLevel = lvl;
+	d->fHz = hd_boot_arg("huskydisp_hz", 120);
+	d->fInject = lvl >= 6 ? hd_boot_arg("huskydisp_inject", 0) : 0;
+	d->fPeriodUS = 16667;
+	d->fDispLock = IOSimpleLockAlloc();
+	d->fWaitLock = IOLockAlloc();
+	d->fEvent = HuskyDispEventSource::create(d);
+	d->fWatch = IOTimerEventSource::timerEventSource(d, &HuskyDisplay::watchFired);
+	d->fPoll = IOTimerEventSource::timerEventSource(d, &HuskyDisplay::pollFired);
+	if (d->fDispLock == NULL || d->fWaitLock == NULL || d->fEvent == NULL || d->fWatch == NULL ||
+	    d->fPoll == NULL || loop->addEventSource(d->fEvent) != kIOReturnSuccess ||
+	    loop->addEventSource(d->fWatch) != kIOReturnSuccess ||
+	    loop->addEventSource(d->fPoll) != kIOReturnSuccess || !d->setup()) {
+		HUSKY_DISP_LOG("HUSKY DISP: setup failed, copy mode\n");
+		d->release();
+		return NULL;
+	}
+	HUSKY_DISP_LOG("HUSKY DISP: huskydisp=%u hz=%u inject=%u\n", lvl, d->fHz, d->fInject);
+	d->probe();
+	if (lvl >= 2 && d->fPoolOK) {
+		d->allocPool();
+	}
+	thread_t thread;
+	d->retain();
+	if (kernel_thread_start(HuskyDisplay::bringupEntry, d, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		HUSKY_DISP_LOG("HUSKY DISP: kernel_thread_start failed\n");
+		d->release();
+	}
+	return d;
+}
+
+void
+HuskyDisplay::free()
+{
+	if (fLoop != NULL) {
+		if (fEvent != NULL) {
+			fLoop->removeEventSource(fEvent);
+		}
+		if (fWatch != NULL) {
+			fLoop->removeEventSource(fWatch);
+		}
+		if (fPoll != NULL) {
+			fLoop->removeEventSource(fPoll);
+		}
+	}
+	OSSafeReleaseNULL(fEvent);
+	OSSafeReleaseNULL(fWatch);
+	OSSafeReleaseNULL(fPoll);
+	if (fDispLock != NULL) {
+		IOSimpleLockFree(fDispLock);
+		fDispLock = NULL;
+	}
+	if (fWaitLock != NULL) {
+		IOLockFree(fWaitLock);
+		fWaitLock = NULL;
+	}
+	OSObject::free();
+}
+
+bool
+HuskyDisplay::setup(void)
+{
+	fDecon = (volatile uint32_t *)ml_io_map(HD_DECON_PHYS, 0x8000);
+	fWin = (volatile uint32_t *)ml_io_map(HD_WIN_PHYS, 0x10000);
+	fWinCon = (volatile uint32_t *)ml_io_map(HD_WINCON_PHYS, 0x10000);
+	fRdma = (volatile uint32_t *)ml_io_map(HD_RDMA_PHYS, 0x4000);
+	fDsim = (volatile uint32_t *)ml_io_map(HD_DSIM_PHYS, 0x4000);
+	fSysmmu = (volatile uint32_t *)ml_io_map(HD_SYSMMU_PHYS, 0x10000);
+	return fDecon != NULL && fWin != NULL && fWinCon != NULL && fRdma != NULL && fDsim != NULL &&
+	       fSysmmu != NULL;
+}
+
+/* ---- step 1: probe ---- */
+
+void
+HuskyDisplay::probe(void)
+{
+	uint32_t gcon = fDecon[DECON_GLOBAL_CON / 4];
+	uint32_t trig = fDecon[DECON_TRIG_CON / 4];
+	uint32_t shd = fDecon[DECON_SHD_REG_UP_REQ / 4];
+
+	HUSKY_DISP_LOG("HUSKY DISP: probe decon gcon=%08x trig=%08x shd=%08x en=%08x enx=%08x pend=%08x "
+	    "pendx=%08x tecnt=%08x\n", gcon, trig, shd, fDecon[DECON_INT_EN / 4], fDecon[DECON_INT_EN_EXTRA / 4],
+	    fDecon[DECON_INT_PEND / 4], fDecon[DECON_INT_PEND_EXTRA / 4], fDecon[DECON_HW_TE_CNT / 4]);
+	for (uint32_t n = 0; n < HD_WINDOWS; n++) {
+		uint32_t con = fWinCon[(n * HD_WIN_STRIDE) / 4];
+		if (con & 1) {
+			HUSKY_DISP_LOG("HUSKY DISP: probe win%u con=%08x start=%08x end=%08x\n", n, con,
+			    fWin[(n * HD_WIN_STRIDE + 0xC) / 4], fWin[(n * HD_WIN_STRIDE + 0x10) / 4]);
+		}
+	}
+
+	uint32_t ctrl0 = fRdma[RDMA_IN_CTRL_0 / 4];
+	uint32_t src = fRdma[RDMA_SRC_SIZE / 4];
+	uint32_t off = fRdma[RDMA_SRC_OFFSET / 4];
+	uint32_t img = fRdma[RDMA_IMG_SIZE / 4];
+	uint32_t base = fRdma[RDMA_BASEADDR_Y8 / 4];
+	uint32_t sbase = fRdma[(RDMA_SHADOW + RDMA_BASEADDR_Y8) / 4];
+	HUSKY_DISP_LOG("HUSKY DISP: probe rdma0 en=%08x ctrl0=%08x src=%08x off=%08x img=%08x base=%08x "
+	    "sbase=%08x st0=%08x st1=%08x\n", fRdma[0], ctrl0, src, off, img, base, sbase,
+	    fRdma[RDMA_SRC_STRIDE_0 / 4], fRdma[RDMA_SRC_STRIDE_1 / 4]);
+
+	fDsimUrun = fDsim[DSIM_UNDERRUN_CTRL / 4] & 0xFFFF;
+	fDsimTe1 = fDsim[DSIM_CMD_TE_CTRL1 / 4];
+	uint32_t dcfg = fDsim[DSIM_CONFIG / 4];
+	HUSKY_DISP_LOG("HUSKY DISP: probe dsim cfg=%08x esc=%08x urun=%08x te0=%08x te1=%08x cmdcfg=%08x "
+	    "fifo=%08x pll=%08x\n", dcfg, fDsim[DSIM_ESCMODE / 4], fDsim[DSIM_UNDERRUN_CTRL / 4],
+	    fDsim[DSIM_CMD_TE_CTRL0 / 4], fDsimTe1, fDsim[DSIM_CMD_CONFIG / 4], fDsim[DSIM_FIFOCTRL / 4],
+	    fDsim[DSIM_PLL_CTRL / 4]);
+
+	uint32_t mmu = fSysmmu[SYSMMU_CTRL_VM / 4];
+	HUSKY_DISP_LOG("HUSKY DISP: probe sysmmu ctrl=%08x\n", mmu);
+
+	static const uint32_t ids[] = { HD_INTID_EXTRA, HD_INTID_FRAME_DONE, HD_INTID_FRAME_START, HD_INTID_RDMA };
+	fIrqOK = true;
+	for (uint32_t i = 0; i < sizeof(ids) / sizeof(ids[0]); i++) {
+		uint32_t grp = 0, cfg = 0, en = 0;
+		uint64_t route = 0;
+		if (!husky_gic_spi_probe(ids[i], &grp, &cfg, &en, &route)) {
+			grp = 0;
+		}
+		fIrqOK = fIrqOK && grp == 1;
+		HUSKY_DISP_LOG("HUSKY DISP: probe gic %u grp=%u cfg=%u en=%u route=%016llx\n", ids[i], grp, cfg, en,
+		    route);
+	}
+
+	bool inDram = fSplashPA >= gPhysBase && fSplashPA < (uint64_t)gPhysBase + gPhysSize;
+	HUSKY_DISP_LOG("HUSKY DISP: probe dram base=%llx size=%llx splash=%llx in_dram=%d low_managed=%d\n",
+	    (uint64_t)gPhysBase, (uint64_t)gPhysSize, fSplashPA, inDram, gPhysBase < 0x100000000ULL);
+
+	const char *why = NULL;
+	uint32_t w = src & 0xFFFF, h = src >> 16;
+	if (((ctrl0 >> 8) & 0x3F) != 0) {
+		why = "rdma-fmt";
+	} else if (w != fWidth || h != fHeight || (img & 0x3FFF) != w || ((img >> 16) & 0x3FFF) != h || off != 0) {
+		why = "geometry";
+	} else if (fRowBytes != fWidth * 4) {
+		why = "stride";
+	} else if (base != (uint32_t)fSplashPA || sbase != base || fSplashPA >= 0x100000000ULL) {
+		why = "base";
+	} else if (inDram) {
+		why = "splash-in-dram";
+	}
+	fPoolOK = why == NULL;
+	if (why == NULL && (mmu & 1)) {
+		why = "sysmmu";
+	} else if (why == NULL && !(gcon & GCON_CMD)) {
+		why = "gcon";
+	} else if (why == NULL && (trig & (TRIG_HW_EN | TRIG_MASK_DECON | TRIG_SEL_MASK)) != TRIG_HW_EN) {
+		HUSKY_DISP_LOG("HUSKY DISP: trig %08x not TE/DDI0, staying in copy mode\n", trig);
+		why = "trig";
+	}
+	if (dcfg & DSIM_CONFIG_VIDEO) {
+		why = why != NULL ? why : "dsim-video";
+	}
+	fProbeOK = why == NULL;
+	HUSKY_DISP_LOG("HUSKY DISP: probe verdict pool=%d direct=%d (%s)\n", fPoolOK, fProbeOK,
+	    why != NULL ? why : "ok");
+}
+
+bool
+HuskyDisplay::allocPool(void)
+{
+	uint32_t want = hd_boot_arg("huskydisp_slots", 4);
+	const uint64_t mask = 0x00000000FFFFC000ULL;
+	const IOOptionBits opts = kIODirectionInOut | kIOMemoryPhysicallyContiguous;
+	uint32_t n = 0;
+
+	if (want < 2 || want > HD_MAX_SLOTS) {
+		want = 4;
+	}
+	husky_pool.lock = IOSimpleLockAlloc();
+	if (husky_pool.lock == NULL) {
+		return false;
+	}
+	IOBufferMemoryDescriptor *one = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task, opts,
+	    (uint64_t)want * HD_SLOT_SIZE, mask);
+	if (one != NULL) {
+		IOByteCount seg = 0;
+		uint64_t pa = one->getPhysicalSegment(0, &seg, kIOMemoryMapperNone);
+		if (pa != 0 && seg >= (uint64_t)want * HD_SLOT_SIZE &&
+		    pa + (uint64_t)want * HD_SLOT_SIZE <= 0x100000000ULL) {
+			for (uint32_t i = 0; i < want; i++) {
+				husky_pool.pa[i] = pa + (uint64_t)i * HD_SLOT_SIZE;
+				husky_pool.kva[i] = (uint8_t *)one->getBytesNoCopy() + (uint64_t)i * HD_SLOT_SIZE;
+			}
+			husky_pool.whole = one;
+			n = want;
+		} else {
+			one->release();
+		}
+	}
+	for (; n < want && husky_pool.whole == NULL; n++) {
+		IOBufferMemoryDescriptor *md = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
+		    opts, HD_SLOT_SIZE, mask);
+		IOByteCount seg = 0;
+		uint64_t pa = md != NULL ? md->getPhysicalSegment(0, &seg, kIOMemoryMapperNone) : 0;
+		if (pa == 0 || seg < HD_SLOT_SIZE || pa + HD_SLOT_SIZE > 0x100000000ULL) {
+			OSSafeReleaseNULL(md);
+			break;
+		}
+		husky_pool.md[n] = md;
+		husky_pool.pa[n] = pa;
+		husky_pool.kva[n] = md->getBytesNoCopy();
+	}
+	if (n == 0) {
+		HUSKY_DISP_LOG("HUSKY DISP: pool alloc failed (slots 0)\n");
+		return false;
+	}
+	husky_pool.n = n;
+	husky_pool.width = fWidth;
+	husky_pool.height = fHeight;
+	husky_pool.stride = fRowBytes;
+	OSMemoryBarrier();
+	husky_pool.ready = true;
+	HUSKY_DISP_LOG("HUSKY DISP: pool %u slots pa=%llx-%llx kva=%p\n", n, husky_pool.pa[0],
+	    husky_pool.pa[n - 1] + HD_SLOT_SIZE, husky_pool.kva[0]);
+	return true;
+}
+
+/* ---- bring-up thread ---- */
+
+void
+HuskyDisplay::bringupEntry(void *arg, wait_result_t)
+{
+	HuskyDisplay *d = (HuskyDisplay *)arg;
+	d->bringup();
+	d->release();
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+uint32_t
+HuskyDisplay::hwTe(void)
+{
+	return (fDecon[DECON_HW_TE_CNT / 4] >> fHwShift) & 0xFFFF;
+}
+
+/* Edges between two teSample() values: TE_RISE is a 32-bit count, the HW_TE_CNT field wraps at 16. */
+uint32_t
+HuskyDisplay::teDelta(uint32_t cur, uint32_t last)
+{
+	return fTeRise ? cur - last : (cur - last) & 0xFFFF;
+}
+
+uint32_t
+HuskyDisplay::teSample(void)
+{
+	return fTeRise ? fTeCount : hwTe();
+}
+
+void
+HuskyDisplay::pollNow(void)
+{
+	IOInterruptState st = IOSimpleLockLockDisableInterrupt(fDispLock);
+	servicePoll();
+	IOSimpleLockUnlockEnableInterrupt(fDispLock, st);
+}
+
+/* Counts TE edges for ms, returning them and their mean period. */
+uint32_t
+HuskyDisplay::teWait(uint32_t ms, uint32_t *periodUS)
+{
+	uint32_t n = 0, nFirst = 0, seen = teSample();
+	uint64_t tFirst = 0, tLast = 0;
+	uint64_t t0 = mach_absolute_time();
+	uint64_t span = hd_us_to_abs((uint64_t)ms * 1000);
+
+	do {
+		IOSleep(1);
+		if (!fIrqOn) {
+			pollNow();
+		}
+		uint32_t cur = teSample();
+		if (cur != seen) {
+			uint64_t stamp = fTeRise ? fTeTime : mach_absolute_time();
+			n += teDelta(cur, seen);
+			seen = cur;
+			if (tFirst == 0) {
+				tFirst = stamp;
+				nFirst = n;
+			}
+			tLast = stamp;
+		}
+	} while (mach_absolute_time() - t0 < span);
+	if (periodUS != NULL) {
+		uint64_t ns = 0;
+		if (n > nFirst) {
+			absolutetime_to_nanoseconds(tLast - tFirst, &ns);
+			ns = ns / (n - nFirst) / 1000;
+		}
+		*periodUS = (uint32_t)ns;
+	}
+	return n;
+}
+
+/*
+ * TE_RISE is not enabled by the Linux driver (it takes TE from a GPIO), so
+ * whether the DECON latches it with te_from = DDI0 is unproven: count it by
+ * polling the pending bit, and fall back to HW_TE_CNT if it never shows.
+ */
+bool
+HuskyDisplay::teMeasure(uint32_t ms, uint32_t *edges, uint32_t *hw0, uint32_t *hw1)
+{
+	uint32_t n = 0;
+	uint64_t span = hd_us_to_abs((uint64_t)ms * 1000);
+
+	fDecon[DECON_INT_PEND_EXTRA / 4] = EXTRA_TE_RISE;
+	*hw0 = fDecon[DECON_HW_TE_CNT / 4];
+	uint64_t t0 = mach_absolute_time();
+	do {
+		IOSleep(1);
+		if (fDecon[DECON_INT_PEND_EXTRA / 4] & EXTRA_TE_RISE) {
+			fDecon[DECON_INT_PEND_EXTRA / 4] = EXTRA_TE_RISE;
+			n++;
+		}
+	} while (mach_absolute_time() - t0 < span);
+	*hw1 = fDecon[DECON_HW_TE_CNT / 4];
+	*edges = n;
+	return n != 0;
+}
+
+/*
+ * HW_TE_CNT is two 16-bit counters, CNT_A [15:0] and CNT_B [31:16]; the zuma
+ * CAL defines both and reads neither, so which one counts TE is proven only
+ * by the probe: its count over the 500 ms window must match the TE_RISE
+ * edges, or without TE_RISE sit between 20 and 70 (60 or 120 Hz panel).
+ */
+static bool
+hd_hwcnt_is_te(uint32_t edges, uint32_t d)
+{
+	if (edges != 0) {
+		return d + 2 >= edges && d <= edges + 2;
+	}
+	return d >= 20 && d <= 70;
+}
+
+void
+HuskyDisplay::bringup(void)
+{
+	uint32_t edges = 0, hw0 = 0, hw1 = 0;
+	bool forced = false;
+
+	fTeRise = teMeasure(500, &edges, &hw0, &hw1);
+	if (!fTeRise) {
+		fDecon[DECON_INT_EN_EXTRA / 4] |= EXTRA_TE_RISE;
+		forced = true;
+		fTeRise = teMeasure(500, &edges, &hw0, &hw1);
+	}
+	uint32_t dA = (hw1 - hw0) & 0xFFFF;
+	uint32_t dB = ((hw1 >> 16) - (hw0 >> 16)) & 0xFFFF;
+	fHwCnt = true;
+	if (hd_hwcnt_is_te(edges, dA)) {
+		fHwShift = 0;
+	} else if (hd_hwcnt_is_te(edges, dB)) {
+		fHwShift = 16;
+	} else {
+		fHwCnt = false;
+	}
+	fTeHz = edges * 2;
+	fPeriodUS = (fTeHz >= 115 && fTeHz <= 125) ? 8333 : 16667;
+	HUSKY_DISP_LOG("HUSKY DISP: probe te pend=%u hwcnt=%08x->%08x dA=%u dB=%u use=%s in 500 ms (enx_forced=%d)\n",
+	    edges, hw0, hw1, dA, dB, fHwCnt ? (fHwShift ? "B" : "A") : "none", forced);
+	if (fLevel < 3) {
+		return;
+	}
+	if (!fProbeOK) {
+		HUSKY_DISP_LOG("HUSKY DISP: direct scanout off (probe)\n");
+		return;
+	}
+
+	husky_disp_splash_pa = (uint32_t)fSplashPA;
+	husky_rdma0 = fRdma;
+	fMode = kModeBringup;
+	husky_disp_direct = 1;
+	enableDecon();
+	if (fLevel >= 4) {
+		if (fIrqOK) {
+			irqOn();
+		} else {
+			HUSKY_DISP_LOG("HUSKY DISP: no IRQ mode (gic-group)\n");
+		}
+	}
+	if (fLevel >= 5) {
+		panelTo120();
+	}
+	if (fLevel >= 4) {
+		pickVsync(true);
+	}
+	if (fMode == kModeFallback) {
+		return;
+	}
+	fTeTime = mach_absolute_time();
+	IOInterruptState st = IOSimpleLockLockDisableInterrupt(fDispLock);
+	fMode = kModeDirect;
+	IOSimpleLockUnlockEnableInterrupt(fDispLock, st);
+	HUSKY_DISP_LOG("HUSKY DISP: direct on splash=%08x mask=%08x\n", (uint32_t)fSplashPA, SHD_REQUEST);
+	fWatch->setTimeoutMS(HD_WATCH_MS);
+	armWait(fSplash, fSplashPA, 0);
+}
+
+void
+HuskyDisplay::enableDecon(void)
+{
+	fDecon[DECON_INT_PEND / 4] = INT_FRAME_START | INT_FRAME_DONE | INT_EXTRA;
+	fDecon[DECON_INT_PEND_EXTRA / 4] = EXTRA_ALL;
+	fDecon[DECON_INT_EN_EXTRA / 4] |= EXTRA_TIME_OUT | EXTRA_RES_CONFLICT | (fTeRise ? EXTRA_TE_RISE : 0);
+	fDecon[DECON_INT_EN / 4] |= INT_EN_MASTER | INT_EXTRA | INT_FRAME_START | INT_FRAME_DONE;
+	uint32_t v = fRdma[RDMA_IRQ / 4] & ~(RDMA_IRQ_ALL_MASK | RDMA_IRQ_PEND);
+	fRdma[RDMA_IRQ / 4] = v | RDMA_IRQ_FD_MASK | RDMA_IRQ_EN | RDMA_IRQ_PEND;
+	HUSKY_DISP_LOG("HUSKY DISP: decon irq en=%08x enx=%08x rdma_irq=%08x\n", fDecon[DECON_INT_EN / 4],
+	    fDecon[DECON_INT_EN_EXTRA / 4], fRdma[RDMA_IRQ / 4]);
+}
+
+bool
+HuskyDisplay::irqOn(void)
+{
+	static const uint32_t ids[] = { HD_INTID_EXTRA, HD_INTID_FRAME_DONE, HD_INTID_FRAME_START, HD_INTID_RDMA };
+	const uint32_t n = sizeof(ids) / sizeof(ids[0]);
+
+	for (uint32_t i = 0; i < n; i++) {
+		if (husky_irq_register(ids[i], husky_disp_irq, this) != 0) {
+			HUSKY_DISP_LOG("HUSKY DISP: irq %u register failed\n", ids[i]);
+			return false;
+		}
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t grp, cfg, en;
+		uint64_t route = 0;
+		husky_gic_spi_enable(ids[i], HD_IRQ_PRIO);
+		husky_gic_spi_probe(ids[i], &grp, &cfg, &en, &route);
+		HUSKY_DISP_LOG("HUSKY DISP: irq %u on (prio %x route %016llx)\n", ids[i], HD_IRQ_PRIO, route);
+	}
+	fIrqOn = true;
+	return true;
+}
+
+/* Vsync from TE when its interrupt works, else HW_TE_CNT, else the software timer. */
+void
+HuskyDisplay::pickVsync(bool measure)
+{
+	uint32_t src = (fIrqOn && fTeRise) ? kVsyncTE : (fHwCnt ? kVsyncHWCnt : kVsyncTimer);
+
+	if (measure && src != kVsyncTimer) {
+		uint32_t period = 0;
+		uint32_t edges = teWait(500, &period);
+		if (edges > 1 && period != 0) {
+			fPeriodUS = period;
+		}
+	}
+	IOInterruptState st = IOSimpleLockLockDisableInterrupt(fDispLock);
+	fVsyncSrc = src;
+	fTeSent = fTeCount;
+	fHwCntLast = hwTe();
+	fWantTimer = src == kVsyncTimer;
+	fWantPeriodUS = fPeriodUS;
+	fVsyncDirty = true;
+	IOSimpleLockUnlockEnableInterrupt(fDispLock, st);
+	fEvent->signal();
+	if (src == kVsyncHWCnt) {
+		fPoll->setTimeoutUS(fPeriodUS / 4);
+	}
+	static const char *const names[] = { "timer", "te", "hwcnt" };
+	if (measure) {
+		HUSKY_DISP_LOG("HUSKY DISP: vsync src=%s period %u us\n", names[src], fPeriodUS);
+	}
+}
+
+/* ---- step 5: panel at 120 Hz ---- */
+
+bool
+HuskyDisplay::dsimSend(const void *packets, uint32_t count, uint32_t *drainedUS)
+{
+	const struct husky_dcs *pk = (const struct husky_dcs *)packets;
+	uint32_t cc = fDsim[DSIM_CMD_CONFIG / 4];
+
+	/* Packet-go holds packets until PKT_GO_RDY; the host sends each one at once. */
+	if (cc & DSIM_CMD_PKT_GO_EN) {
+		fDsim[DSIM_CMD_CONFIG / 4] = cc & ~DSIM_CMD_PKT_GO_EN;
+	}
+	uint64_t t0 = mach_absolute_time();
+	for (uint32_t i = 0; i < count; i++) {
+		uint32_t waited = 0;
+		while (fDsim[DSIM_FIFOCTRL / 4] & (DSIM_FIFO_FULL_PH | DSIM_FIFO_FULL_PL)) {
+			if (++waited > 500) {
+				return false;
+			}
+			IODelay(10);
+		}
+		const uint8_t *b = pk[i].b;
+		uint32_t len = pk[i].len;
+		uint32_t hdr;
+		if (len == 1) {
+			hdr = 0x05 | (uint32_t)b[0] << 8;
+		} else if (len == 2) {
+			hdr = 0x15 | (uint32_t)b[0] << 8 | (uint32_t)b[1] << 16;
+		} else {
+			for (uint32_t o = 0; o < len; o += 4) {
+				uint32_t word = 0;
+				for (uint32_t k = 0; k < 4 && o + k < len; k++) {
+					word |= (uint32_t)b[o + k] << (8 * k);
+				}
+				fDsim[DSIM_PAYLOAD / 4] = word;
+			}
+			hdr = 0x39 | (len & 0xFF) << 8 | (len >> 8) << 16;
+		}
+		fDsim[DSIM_PKTHDR / 4] = hdr;
+	}
+	for (uint32_t waited = 0;; waited++) {
+		uint32_t f = fDsim[DSIM_FIFOCTRL / 4];
+		if ((f & (DSIM_FIFO_EMPTY_PH | DSIM_FIFO_EMPTY_PL)) == (DSIM_FIFO_EMPTY_PH | DSIM_FIFO_EMPTY_PL)) {
+			break;
+		}
+		if (waited > 1000) {
+			return false;
+		}
+		IODelay(50);
+	}
+	*drainedUS = hd_abs_to_us(mach_absolute_time() - t0);
+	return true;
+}
+
+void
+HuskyDisplay::dsimTimers(uint32_t urun, uint32_t te1)
+{
+	fDsim[DSIM_UNDERRUN_CTRL / 4] = (fDsim[DSIM_UNDERRUN_CTRL / 4] & ~0xFFFFu) | (urun & 0xFFFF);
+	fDsim[DSIM_CMD_TE_CTRL1 / 4] = te1;
+}
+
+void
+HuskyDisplay::requestFrame(uint64_t pa)
+{
+	IOInterruptState st = IOSimpleLockLockDisableInterrupt(fDispLock);
+	programFlip(pa);
+	IOSimpleLockUnlockEnableInterrupt(fDispLock, st);
+}
+
+/* Waits for n TE edges, at most 100 ms. */
+void
+HuskyDisplay::teSkip(uint32_t n)
+{
+	uint32_t s0 = teSample();
+	uint64_t t0 = mach_absolute_time();
+	uint64_t span = hd_us_to_abs(100000);
+
+	while (teDelta(teSample(), s0) < n && mach_absolute_time() - t0 < span) {
+		IOSleep(1);
+		if (!fIrqOn) {
+			pollNow();
+		}
+	}
+}
+
+/*
+ * No flip may be in flight while the trigger is masked and the DSIM timers
+ * change: wait for the shadow request to clear, then for a frame in
+ * transfer (5.9 ms of link time) to finish.
+ */
+bool
+HuskyDisplay::panelQuiesce(void)
+{
+	uint64_t t0 = mach_absolute_time();
+	uint64_t span = hd_us_to_abs(50000);
+
+	while (fDecon[DECON_SHD_REG_UP_REQ / 4] != 0) {
+		if (mach_absolute_time() - t0 > span) {
+			return false;
+		}
+		IOSleep(1);
+	}
+	IOSleep(10);
+	fDecon[DECON_TRIG_CON / 4] |= TRIG_MASK_DECON;
+	return true;
+}
+
+void
+HuskyDisplay::panelTo60(void)
+{
+	uint32_t us = 0;
+
+	if (!panelQuiesce() || !dsimSend(husky_dcs_60, sizeof(husky_dcs_60) / sizeof(husky_dcs_60[0]), &us)) {
+		HUSKY_DISP_LOG("HUSKY DISP: panel revert to 60Hz failed\n");
+	}
+	dsimTimers(HD_URUN_60, HD_TE1_60);
+	teSkip(2);
+	fDecon[DECON_TRIG_CON / 4] &= ~TRIG_MASK_DECON;
+	requestFrame(fSplashPA);
+}
+
+void
+HuskyDisplay::panelTo120(void)
+{
+	uint32_t period = 0, us = 0;
+
+	if (fHz == 60) {
+		HUSKY_DISP_LOG("HUSKY DISP: panel 120Hz skipped (huskydisp_hz=60)\n");
+		return;
+	}
+	if (!fTeRise && !fHwCnt) {
+		HUSKY_DISP_LOG("HUSKY DISP: panel 120Hz skipped (no TE to verify the switch)\n");
+		return;
+	}
+	fTeHz = teWait(250, &period) * 4;
+	HUSKY_DISP_LOG("HUSKY DISP: panel te %u Hz before switch\n", fTeHz);
+	if (fTeHz >= 115 && fTeHz <= 125) {
+		fPeriodUS = 8333;
+		return;
+	}
+	if (fDsimUrun != HD_URUN_60 || fDsimTe1 != HD_TE1_60) {
+		HUSKY_DISP_LOG("HUSKY DISP: panel 120Hz skipped (dsim-timers urun %04x te1 %08x)\n", fDsimUrun,
+		    fDsimTe1);
+		return;
+	}
+	if (!panelQuiesce()) {
+		HUSKY_DISP_LOG("HUSKY DISP: panel 120Hz skipped (quiesce)\n");
+		return;
+	}
+	if (!dsimSend(husky_dcs_120, sizeof(husky_dcs_120) / sizeof(husky_dcs_120[0]), &us)) {
+		fDecon[DECON_TRIG_CON / 4] &= ~TRIG_MASK_DECON;
+		HUSKY_DISP_LOG("HUSKY DISP: panel 120Hz FAILED (dcs-timeout), staying at 60\n");
+		return;
+	}
+	HUSKY_DISP_LOG("HUSKY DISP: dcs %u pkts drained in %u us\n",
+	    (uint32_t)(sizeof(husky_dcs_120) / sizeof(husky_dcs_120[0])), us);
+
+	uint32_t urun = fDsim[DSIM_UNDERRUN_CTRL / 4] & 0xFFFF;
+	uint32_t te1 = fDsim[DSIM_CMD_TE_CTRL1 / 4];
+	if (urun == HD_URUN_60 && te1 == HD_TE1_60) {
+		dsimTimers(HD_URUN_120, HD_TE1_120);
+	} else if (urun != HD_URUN_120 || te1 != HD_TE1_120) {
+		HUSKY_DISP_LOG("HUSKY DISP: panel 120Hz FAILED (dsim-timers urun %04x te1 %08x), reverting\n", urun,
+		    te1);
+		panelTo60();
+		return;
+	}
+	HUSKY_DISP_LOG("HUSKY DISP: dsim urun %04x->%04x te1 %08x->%08x\n", urun,
+	    fDsim[DSIM_UNDERRUN_CTRL / 4] & 0xFFFF, te1, fDsim[DSIM_CMD_TE_CTRL1 / 4]);
+
+	teSkip(2);
+	fDecon[DECON_TRIG_CON / 4] &= ~TRIG_MASK_DECON;
+	requestFrame(fSplashPA);
+	uint32_t edges = teWait(250, &period);
+	if (edges >= 28 && edges <= 32) {
+		fPeriodUS = period != 0 ? period : 8333;
+		fHz = 120;
+		HUSKY_DISP_LOG("HUSKY DISP: panel 120Hz ok period %u us\n", fPeriodUS);
+		return;
+	}
+	panelTo60();
+	HUSKY_DISP_LOG("HUSKY DISP: panel 120Hz FAILED (te %u/250ms), reverted to 60\n", edges);
+}
+
+/* ---- flip engine (fDispLock held unless noted) ---- */
+
+void
+HuskyDisplay::programFlip(uint64_t pa)
+{
+	fRdma[RDMA_BASEADDR_Y8 / 4] = (uint32_t)pa;
+	__builtin_arm_dsb(DSB_SY);
+	fDecon[DECON_GLOBAL_CON / 4] |= 0x3;
+	/*
+	 * 0x80003FFF (global + windows 0..13) is the value that moves a frame on
+	 * silicon; the CAL's FOR_DECON covers only windows 0..5.
+	 */
+	fDecon[DECON_SHD_REG_UP_REQ / 4] = SHD_REQUEST;
+}
+
+void
+HuskyDisplay::arm(HuskySurface *s, uint64_t pa, uint32_t swapID)
+{
+	fFlipSeq++;
+	fArmed.surf = s;
+	fArmed.pa = pa;
+	fArmed.swapID = swapID;
+	fArmed.seq = fFlipSeq;
+	fArmed.tArm = mach_absolute_time();
+	fArmed.tLatch = fArmed.tDone = 0;
+	fArmed.retried = false;
+	fFlips++;
+	if (fInject == 1 && fFlipSeq == 100) {
+		return;
+	}
+	if (fInject == 2 && fFlipSeq == 200) {
+		fErr |= ERR_RDMA;
+		fErrArg = 0;
+		fErrInject = true;
+	}
+	programFlip(pa);
+}
+
+/* Thread context. True when s is armed for scanout; false when the engine left direct mode. */
+bool
+HuskyDisplay::armWait(HuskySurface *s, uint64_t pa, uint32_t swapID)
+{
+	uint64_t deadline;
+	bool waited = false;
+
+	clock_interval_to_deadline(HD_ARM_TIMEOUT_MS, NSEC_PER_MSEC, &deadline);
+	IOLockLock(fWaitLock);
+	for (;;) {
+		IOInterruptState st = IOSimpleLockLockDisableInterrupt(fDispLock);
+		if (fMode != kModeDirect) {
+			IOSimpleLockUnlockEnableInterrupt(fDispLock, st);
+			IOLockUnlock(fWaitLock);
+			return false;
+		}
+		if (fArmed.surf == NULL) {
+			if (fScanning.surf == s && s != fSplash) {
+				fReuse++;
+			}
+			s->retain();
+			arm(s, pa, swapID);
+			IOSimpleLockUnlockEnableInterrupt(fDispLock, st);
+			IOLockUnlock(fWaitLock);
+			startPoll();
+			return true;
+		}
+		if (!waited) {
+			waited = true;
+			fArmWaits++;
+		}
+		IOSimpleLockUnlockEnableInterrupt(fDispLock, st);
+		if (IOLockSleepDeadline(fWaitLock, &fArmed, deadline, THREAD_UNINT) == THREAD_TIMED_OUT) {
+			IOLockUnlock(fWaitLock);
+			fallback("armed-timeout");
+			return false;
+		}
+	}
+}
+
+void
+HuskyDisplay::startPoll(void)
+{
+	if (!fIrqOn) {
+		fPoll->setTimeoutUS(HD_POLL_US);
+	}
+}
+
+void
+HuskyDisplay::retire(struct husky_flip *f)
+{
+	if (f->surf == NULL) {
+		return;
+	}
+	if (fRingCount == sizeof(fRing) / sizeof(fRing[0])) {
+		/* The retain cannot be dropped here; the slot stays held. */
+		fRingOverflow++;
+		fErr |= ERR_RING;
+		fErrSeen |= ERR_RING;
+	} else {
+		fRing[(fRingHead + fRingCount) % (sizeof(fRing) / sizeof(fRing[0]))] = *f;
+		fRingCount++;
+	}
+	f->surf = NULL;
+	fWakeSlots = true;
+}
+
+/*
+ * The RDMA shadow bank at +0x400 holds the base the DECON latched for this
+ * frame; reading it ties the bookkeeping to what the hardware took, not to
+ * what was requested.
+ */
+void
+HuskyDisplay::onFrameStart(void)
+{
+	fDecon[DECON_INT_PEND / 4] = INT_FRAME_START;
+	fFs++;
+	if (fScanning.surf != NULL) {
+		fFdMissed++;
+		fScanning.tDone = mach_absolute_time();
+		retire(&fScanning);
+	}
+	if (fArmed.surf == NULL) {
+		fFsOrphan++;
+		return;
+	}
+	uint32_t sbase = fRdma[(RDMA_SHADOW + RDMA_BASEADDR_Y8) / 4];
+	if (sbase == (uint32_t)fArmed.pa) {
+		fArmed.tLatch = mach_absolute_time();
+		fScanning = fArmed;
+		fArmed.surf = NULL;
+		fMismRun = 0;
+		fWakeSlots = true;
+	} else {
+		fMism++;
+		fMismRun++;
+		if (fMismRun == 1) {
+			fMismSBase0 = sbase;
+			fMismSame = true;
+		} else if (sbase != fMismSBase0) {
+			fMismSame = false;
+		}
+		fMismNew = true;
+		fMismSBase = sbase;
+		fMismArmed = (uint32_t)fArmed.pa;
+		if (fMismRun > 8) {
+			fErr |= ERR_MISM;
+			fErrSeen |= ERR_MISM;
+		}
+	}
+}
+
+void
+HuskyDisplay::onFrameDone(void)
+{
+	fDecon[DECON_INT_PEND / 4] = INT_FRAME_DONE;
+	fFd++;
+	if (fScanning.surf == NULL) {
+		fFdSpurious++;
+		return;
+	}
+	fScanning.tDone = mach_absolute_time();
+	retire(&fScanning);
+}
+
+void
+HuskyDisplay::onExtra(void)
+{
+	uint32_t seen = fDecon[DECON_INT_PEND_EXTRA / 4] & EXTRA_ALL;
+
+	fDecon[DECON_INT_PEND_EXTRA / 4] = seen;
+	fDecon[DECON_INT_PEND / 4] = INT_EXTRA;
+	if (seen & EXTRA_TE_RISE) {
+		fTeCount++;
+		fTeTime = mach_absolute_time();
+	}
+	if (seen & (EXTRA_TIME_OUT | EXTRA_RES_CONFLICT)) {
+		fErr |= ERR_DECON;
+		fErrArg = seen;
+		fErrSeen |= ERR_DECON;
+	}
+}
+
+void
+HuskyDisplay::onRdma(void)
+{
+	uint32_t v = fRdma[RDMA_IRQ / 4];
+	uint32_t pend = v & RDMA_IRQ_PEND;
+
+	fRdma[RDMA_IRQ / 4] = v;
+	if (pend & (RDMA_IRQ_DEADLOCK | RDMA_IRQ_CONFIG_ERR)) {
+		fErr |= ERR_RDMA;
+		fErrArg = pend >> 16;
+		fErrSeen |= ERR_RDMA;
+	}
+}
+
+void
+HuskyDisplay::servicePoll(void)
+{
+	if (fDecon[DECON_INT_PEND_EXTRA / 4] & EXTRA_ALL) {
+		onExtra();
+	}
+	uint32_t p = fDecon[DECON_INT_PEND / 4];
+	if (p & INT_FRAME_DONE) {
+		onFrameDone();
+	}
+	if (p & INT_FRAME_START) {
+		onFrameStart();
+	}
+	if (fRdma[RDMA_IRQ / 4] & (RDMA_IRQ_DEADLOCK | RDMA_IRQ_CONFIG_ERR)) {
+		onRdma();
+	}
+}
+
+void
+HuskyDisplay::irq(uint32_t)
+{
+	IOSimpleLockLock(fDispLock);
+	uint32_t p = fDecon[DECON_INT_PEND / 4];
+	bool handled = false;
+
+	if ((p & INT_EXTRA) || (fDecon[DECON_INT_PEND_EXTRA / 4] & EXTRA_ALL)) {
+		onExtra();
+		handled = true;
+	}
+	if (p & INT_FRAME_DONE) {
+		onFrameDone();
+		handled = true;
+	}
+	if (p & INT_FRAME_START) {
+		onFrameStart();
+		handled = true;
+	}
+	if (fRdma[RDMA_IRQ / 4] & RDMA_IRQ_PEND) {
+		onRdma();
+		handled = true;
+	}
+	if (!handled) {
+		fIrqSpur++;
+		IOSimpleLockUnlock(fDispLock);
+		return;
+	}
+	/* The W1C acks are posted and the SPIs are level: read back so the lines are low before EOI. */
+	(void)fDecon[DECON_INT_PEND / 4];
+	(void)fRdma[RDMA_IRQ / 4];
+	IOSimpleLockUnlock(fDispLock);
+	__builtin_arm_dsb(DSB_SY);
+	fEvent->signal();
+}
+
+/* ---- swap interface (thread context) ---- */
+
+void
+HuskyDisplay::noteSwap(HuskySurface *s)
+{
+	if (fLevel < 2) {
+		return;
+	}
+	uint32_t n = (uint32_t)OSIncrementAtomic((volatile SInt32 *)&fSwapStats) + 1;
+	if (s != NULL && s->scanoutSlot >= 0) {
+		fSwapPool++;
+	} else {
+		fSwapNonPool++;
+	}
+	if (s != NULL) {
+		bool seen = false;
+		for (uint32_t i = 0; i < fDistinctN; i++) {
+			seen = seen || fDistinct[i] == s->id;
+		}
+		if (!seen && fDistinctN < sizeof(fDistinct) / sizeof(fDistinct[0])) {
+			fDistinct[fDistinctN++] = s->id;
+		}
+	}
+	if (n == 300 || n % 3000 == 0) {
+		HUSKY_DISP_LOG("HUSKY DISP: swap stats n=%u pool=%u nonpool=%u distinct=%u\n", n, fSwapPool,
+		    fSwapNonPool, fDistinctN);
+	}
+}
+
+bool
+HuskyDisplay::gpuWritten(HuskySurface *s)
+{
+	uint32_t seed = s->seed();
+	bool gpu = seed == s->scanoutSeed;
+
+	s->scanoutSeed = seed;
+	return gpu;
+}
+
+bool
+HuskyDisplay::swapDirect(HuskySurface *s, uint32_t swapID)
+{
+	/* The seed counts read-write unlocks: CPU-written pixels sit in the cache and must reach the DPU. */
+	if (!gpuWritten(s)) {
+		husky_dcache_clean((vm_offset_t)s->scanoutKVA, fFrameBytes);
+	}
+	return armWait(s, s->scanoutPA, swapID);
+}
+
+/* Both slots empty before the CPU writes the splash: the DPU may be reading it. */
+void
+HuskyDisplay::copyBegin(void)
+{
+	uint64_t deadline;
+
+	if (fMode != kModeDirect) {
+		return;
+	}
+	clock_interval_to_deadline(HD_ARM_TIMEOUT_MS, NSEC_PER_MSEC, &deadline);
+	IOLockLock(fWaitLock);
+	for (;;) {
+		IOInterruptState st = IOSimpleLockLockDisableInterrupt(fDispLock);
+		bool idle = fMode != kModeDirect || (fArmed.surf == NULL && fScanning.surf == NULL);
+		IOSimpleLockUnlockEnableInterrupt(fDispLock, st);
+		if (idle) {
+			break;
+		}
+		if (IOLockSleepDeadline(fWaitLock, &fArmed, deadline, THREAD_UNINT) == THREAD_TIMED_OUT) {
+			IOLockUnlock(fWaitLock);
+			fallback("armed-timeout");
+			return;
+		}
+	}
+	IOLockUnlock(fWaitLock);
+}
+
+void
+HuskyDisplay::copyEnd(uint32_t swapID)
+{
+	uint32_t mode = fMode;
+
+	if (mode == kModeDirect || mode == kModeFallback) {
+		OSIncrementAtomic((volatile SInt32 *)&fCopies);
+	}
+	if (mode == kModeDirect) {
+		if (armWait(fSplash, fSplashPA, swapID)) {
+			return;
+		}
+		mode = fMode;
+	}
+	if (mode == kModeFallback) {
+		husky_fb_kick();
+		markRetired(swapID);
+	} else if (mode == kModeBringup) {
+		markRetired(swapID);
+	}
+}
+
+void
+HuskyDisplay::markRetired(uint32_t swapID)
+{
+	IOLockLock(fWaitLock);
+	if (swapID > fRetiredSwapID) {
+		fRetiredSwapID = swapID;
+	}
+	IOLockWakeup(fWaitLock, &fRetiredSwapID, false);
+	IOLockWakeup(fWaitLock, &fArmed, false);
+	IOLockUnlock(fWaitLock);
+}
+
+/*
+ * sel 6 is shared by _kern_SwapWait and _kern_SwapWaitWithTimeout; until the
+ * scalar order is confirmed from the userland disassembly, in[0] is the swap
+ * id and in[1], when present, a timeout in ms, capped at 100 ms. The first 32
+ * calls are logged to settle it.
+ */
+IOReturn
+HuskyDisplay::swapWait(uint32_t inCount, const uint64_t *in, uint32_t maxSwapID)
+{
+	if (fLevel >= 2 && fSwapWaitLogged < 32) {
+		fSwapWaitLogged++;
+		HUSKY_DISP_LOG("HUSKY DISP: swapwait in=%u [%llx %llx %llx %llx]\n", inCount, inCount > 0 ? in[0] : 0,
+		    inCount > 1 ? in[1] : 0, inCount > 2 ? in[2] : 0, inCount > 3 ? in[3] : 0);
+	}
+	if (fMode != kModeDirect || inCount < 1) {
+		return kIOReturnSuccess;
+	}
+	uint32_t id = (uint32_t)in[0];
+	uint64_t timeout = 100;
+	uint64_t deadline;
+	IOReturn ret = kIOReturnSuccess;
+
+	if (id > maxSwapID) {
+		return kIOReturnBadArgument;
+	}
+	if (inCount > 1 && in[1] < timeout) {
+		timeout = in[1];
+	}
+	clock_interval_to_deadline((uint32_t)timeout, NSEC_PER_MSEC, &deadline);
+	IOLockLock(fWaitLock);
+	while (fRetiredSwapID < id && fMode == kModeDirect) {
+		if (IOLockSleepDeadline(fWaitLock, &fRetiredSwapID, deadline, THREAD_UNINT) == THREAD_TIMED_OUT) {
+			ret = fRetiredSwapID >= id ? kIOReturnSuccess : kIOReturnTimeout;
+			break;
+		}
+	}
+	IOLockUnlock(fWaitLock);
+	return ret;
+}
+
+/* ---- work loop ---- */
+
+/* Everything that sleeps, messages, or releases: never from the interrupt. */
+bool
+HuskyDisplay::doWork(void)
+{
+	struct husky_flip done[8];
+	uint32_t nDone = 0, err, errArg, te, mismArmed = 0, mismSBase = 0, src;
+	uint32_t period;
+	uint64_t teT;
+	bool wake, dirty, wantTimer, inject, mism, announce, mismSame;
+
+	IOInterruptState st = IOSimpleLockLockDisableInterrupt(fDispLock);
+	while (fRingCount > 0) {
+		done[nDone++] = fRing[fRingHead];
+		fRingHead = (fRingHead + 1) % (sizeof(fRing) / sizeof(fRing[0]));
+		fRingCount--;
+	}
+	wake = fWakeSlots;
+	fWakeSlots = false;
+	te = fTeCount;
+	teT = fTeTime;
+	src = fVsyncSrc;
+	err = fErr;
+	errArg = fErrArg;
+	inject = fErrInject;
+	fErr = 0;
+	fErrInject = false;
+	mism = fMismNew;
+	mismSame = fMismSame;
+	if (mism) {
+		mismArmed = fMismArmed;
+		mismSBase = fMismSBase;
+		fMismNew = false;
+	}
+	dirty = fVsyncDirty;
+	wantTimer = fWantTimer;
+	period = fWantPeriodUS;
+	fVsyncDirty = false;
+	announce = fFallbackPending;
+	fFallbackPending = false;
+	IOSimpleLockUnlockEnableInterrupt(fDispLock, st);
+
+	uint32_t maxID = 0;
+	for (uint32_t i = 0; i < nDone; i++) {
+		struct husky_flip *f = &done[i];
+		if (f->tLatch != 0 && f->tDone != 0 && (f->seq <= 32 || f->seq % 512 == 0)) {
+			HUSKY_DISP_LOG("HUSKY DISP: flip #%u sid %u pa %08x latch %u us xfer %u us\n", f->seq, f->swapID,
+			    (uint32_t)f->pa, hd_abs_to_us(f->tLatch - f->tArm), hd_abs_to_us(f->tDone - f->tLatch));
+		}
+		maxID = f->swapID > maxID ? f->swapID : maxID;
+		f->surf->release();
+	}
+	if (nDone != 0) {
+		markRetired(maxID);
+	} else if (wake) {
+		IOLockLock(fWaitLock);
+		IOLockWakeup(fWaitLock, &fArmed, false);
+		IOLockUnlock(fWaitLock);
+	}
+	if (mism && fMism <= 8) {
+		HUSKY_DISP_LOG("HUSKY DISP: latch mismatch armed %08x latched %08x\n", mismArmed, mismSBase);
+	}
+	if (dirty) {
+		fOps.vsyncTimer(fCtx, wantTimer, period);
+	}
+	if ((src == kVsyncTE) && te != fTeSent) {
+		uint32_t delta = te - fTeSent;
+		fTeSent = te;
+		fDrops += delta - 1;
+		fOps.vsync(fCtx, delta, teT);
+	}
+	if (announce) {
+		HUSKY_DISP_LOG("HUSKY DISP: fallback (%s) -> copy mode\n", fFallbackMsg);
+	}
+	if (err != 0) {
+		char why[40];
+		if ((err & ERR_RDMA) && inject) {
+			snprintf(why, sizeof(why), "rdma-err inject");
+		} else if (err & ERR_RDMA) {
+			snprintf(why, sizeof(why), "rdma-err %x", errArg);
+		} else if (err & ERR_DECON) {
+			snprintf(why, sizeof(why), "decon-err %x", errArg);
+		} else if ((err & ERR_MISM) && mismSame) {
+			snprintf(why, sizeof(why), "rdma-shadow");
+		} else if (err & ERR_MISM) {
+			snprintf(why, sizeof(why), "latch-mismatch");
+		} else {
+			snprintf(why, sizeof(why), "ring-full");
+		}
+		fallback(why);
+	}
+	return false;
+}
+
+/*
+ * Sticky for the boot: the display returns to the CPU copy into the splash,
+ * so its state is deterministic and cannot flap. Thread context.
+ */
+void
+HuskyDisplay::fallback(const char *reason)
+{
+	IOInterruptState st = IOSimpleLockLockDisableInterrupt(fDispLock);
+	if (fMode != kModeDirect && fMode != kModeBringup) {
+		IOSimpleLockUnlockEnableInterrupt(fDispLock, st);
+		return;
+	}
+	fMode = kModeFallback;
+	bool teIrq = fIrqOn && fTeRise;
+	fDecon[DECON_INT_EN / 4] = teIrq ? (INT_EN_MASTER | INT_EXTRA) : 0;
+	fDecon[DECON_INT_EN_EXTRA / 4] = teIrq ? EXTRA_TE_RISE : 0;
+	fRdma[RDMA_IRQ / 4] = ((fRdma[RDMA_IRQ / 4] & ~(RDMA_IRQ_EN | RDMA_IRQ_PEND)) | RDMA_IRQ_ALL_MASK) | RDMA_IRQ_PEND;
+	retire(&fArmed);
+	retire(&fScanning);
+	programFlip(fSplashPA);
+	husky_disp_direct = 0;
+	snprintf(fFallbackMsg, sizeof(fFallbackMsg), "%s", reason);
+	fFallbackPending = true;
+	fWakeSlots = true;
+	IOSimpleLockUnlockEnableInterrupt(fDispLock, st);
+
+	IOLockLock(fWaitLock);
+	IOLockWakeup(fWaitLock, &fArmed, false);
+	IOLockWakeup(fWaitLock, &fRetiredSwapID, false);
+	IOLockUnlock(fWaitLock);
+	pickVsync(false);
+	fEvent->signal();
+}
+
+/* ---- timers ---- */
+
+void
+HuskyDisplay::watchFired(OSObject *owner, IOTimerEventSource *)
+{
+	((HuskyDisplay *)owner)->watch();
+}
+
+void
+HuskyDisplay::pollFired(OSObject *owner, IOTimerEventSource *sender)
+{
+	HuskyDisplay *d = (HuskyDisplay *)owner;
+	bool again = false;
+
+	if (d->fVsyncSrc == kVsyncHWCnt) {
+		uint32_t cnt = d->hwTe();
+		if (cnt != d->fHwCntLast) {
+			uint32_t delta = (cnt - d->fHwCntLast) & 0xFFFF;
+			d->fHwCntLast = cnt;
+			d->fOps.vsync(d->fCtx, delta, mach_absolute_time());
+		}
+		again = true;
+	}
+	bool inFlight = false;
+	if (d->fMode == kModeDirect && !d->fIrqOn) {
+		IOInterruptState st = IOSimpleLockLockDisableInterrupt(d->fDispLock);
+		d->servicePoll();
+		inFlight = d->fArmed.surf != NULL || d->fScanning.surf != NULL;
+		IOSimpleLockUnlockEnableInterrupt(d->fDispLock, st);
+		d->doWork();
+	}
+	if (inFlight) {
+		sender->setTimeoutUS(HD_POLL_US);
+	} else if (again) {
+		sender->setTimeoutUS(d->fPeriodUS / 4 > 1000 ? d->fPeriodUS / 4 : 1000);
+	}
+}
+
+void
+HuskyDisplay::watch(void)
+{
+	char reason[32] = "";
+	uint32_t latchRetryPA = 0;
+	bool retried = false;
+	uint64_t now = mach_absolute_time();
+
+	IOInterruptState st = IOSimpleLockLockDisableInterrupt(fDispLock);
+	if (fMode == kModeDirect) {
+		if (!fIrqOn) {
+			servicePoll();
+		}
+		if (fArmed.surf != NULL && now - fArmed.tArm > hd_us_to_abs(3 * (uint64_t)fPeriodUS + 2000)) {
+			if (!fArmed.retried) {
+				fArmed.retried = true;
+				fArmed.tArm = now;
+				latchRetryPA = (uint32_t)fArmed.pa;
+				retried = true;
+				programFlip(fArmed.pa);
+			} else {
+				snprintf(reason, sizeof(reason), fMismRun != 0 ? "rdma-shadow" : "latch-timeout");
+			}
+		}
+		if (reason[0] == '\0' && fScanning.surf != NULL && now - fScanning.tLatch > hd_us_to_abs(HD_XFER_TIMEOUT_US)) {
+			snprintf(reason, sizeof(reason), "xfer-timeout");
+		}
+		if (reason[0] == '\0' && fTeRise && now - fTeTime > hd_us_to_abs(HD_TE_LOST_US)) {
+			snprintf(reason, sizeof(reason), "te-lost");
+		}
+		if (fLevel >= 5 && (fDsim[DSIM_INTSRC / 4] & DSIM_INT_UNDER_RUN)) {
+			fDsim[DSIM_INTSRC / 4] = DSIM_INT_UNDER_RUN;
+			fDsimUnder++;
+		}
+	}
+	IOSimpleLockUnlockEnableInterrupt(fDispLock, st);
+
+	if (retried) {
+		HUSKY_DISP_LOG("HUSKY DISP: latch-timeout retry pa %08x\n", latchRetryPA);
+	}
+	if (reason[0] != '\0') {
+		fallback(reason);
+	}
+	if (fMode == kModeDirect || fMode == kModeFallback) {
+		doWork();
+		if (++fWatchTick % HD_STATS_TICKS == 0) {
+			stats();
+		}
+		fWatch->setTimeoutMS(HD_WATCH_MS);
+	}
+}
+
+void
+HuskyDisplay::stats(void)
+{
+	HUSKY_DISP_LOG("HUSKY DISP: stats te=%u fs=%u fd=%u flips=%u copies=%u mism=%u reuse=%u drops=%u "

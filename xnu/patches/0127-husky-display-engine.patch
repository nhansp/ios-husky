+#include <pexpert/pexpert.h>
+#include <sys/systm.h>
+
+/* Lines that must survive a hang: msgbuf and the persistent log. */
+#define HUSKY_DISP_LOG(...)     do { printf(__VA_ARGS__); kprintf(__VA_ARGS__); } while (0)
+
+extern "C" {
+extern volatile int husky_disp_direct;          /* pe_serial.c: console must not kick */
+extern volatile uint32_t husky_disp_splash_pa;
+extern volatile uint32_t *husky_rdma0;
+void husky_fb_kick(void);
+}
+
+/* Entry points into AppleCLCD; always called on its work loop. */
+struct HuskyDisplayOps {
+	/* edges TE edges since the previous call, time = mach_absolute_time of the latest */
+	void (*vsync)(void *ctx, uint32_t edges, uint64_t time);
+	/* start or stop the software vsync timer */
+	void (*vsyncTimer)(void *ctx, bool run, uint32_t periodUS);
+};
+
+/* One display swap owned by the engine. */
+struct husky_flip {
+	HuskySurface *surf;                     /* NULL: slot empty */
+	uint64_t      pa;
+	uint32_t      swapID;
+	uint32_t      seq;
+	uint64_t      tArm, tLatch, tDone;      /* mach_absolute_time */
+	bool          retried;
+};
+
+class HuskyDispEventSource;
+
+class HuskyDisplay : public OSObject {
+	OSDeclareDefaultStructors(HuskyDisplay);
+	friend class HuskyDispEventSource;
+
+public:
+	enum {
+		kModeCopy,                      /* today's behavior */
+		kModeBringup,                   /* engine thread owns DECON0; swaps copy silently */
+		kModeDirect,
+		kModeFallback,
+	};
+	enum {
+		kVsyncTimer,
+		kVsyncTE,
+		kVsyncHWCnt,
+	};
+
+	/* huskydisp, 0 when absent. */
+	static uint32_t level(void);
+
+	/* NULL when huskydisp is 0 or the register windows cannot be mapped. */
+	static HuskyDisplay *create(IOWorkLoop *loop, uint64_t splashPA, uint32_t width, uint32_t height,
+	    uint32_t rowBytes, HuskySurface *splash, const HuskyDisplayOps *ops, void *ctx);
+
+	void free() APPLE_KEXT_OVERRIDE;
+
+	bool direct(void) { return fMode == kModeDirect; }
+	void noteSwap(HuskySurface *s);
+	/* No read-write unlock since the surface's previous presentation: the GPU wrote it. */
+	bool gpuWritten(HuskySurface *s);
+	/* True when the swap is armed for scanout; s stays owned by the caller. */
+	bool swapDirect(HuskySurface *s, uint32_t swapID);
+	void copyBegin(void);
+	void copyEnd(uint32_t swapID);
+	IOReturn swapWait(uint32_t inCount, const uint64_t *in, uint32_t maxSwapID);
+
+	/* GIC SPI handler, interrupt context. */
+	void irq(uint32_t intid);
+

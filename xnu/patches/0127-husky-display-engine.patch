+#define RDMA_IRQ_DEADLOCK       (1u << 17)
+#define RDMA_IRQ_CONFIG_ERR     (1u << 21)
+
+/* DSIM0 */
+#define DSIM_ESCMODE            0x2C
+#define DSIM_UNDERRUN_CTRL      0x34
+#define DSIM_CONFIG             0x4C
+#define DSIM_INTSRC             0x50
+#define DSIM_PKTHDR             0x58
+#define DSIM_PAYLOAD            0x5C
+#define DSIM_FIFOCTRL           0x68
+#define DSIM_CMD_CONFIG         0x80
+#define DSIM_CMD_TE_CTRL0       0x84
+#define DSIM_CMD_TE_CTRL1       0x88
+#define DSIM_PLL_CTRL           0xA0
+#define DSIM_INT_UNDER_RUN      (1u << 19)
+#define DSIM_FIFO_EMPTY_PL      (1u << 8)
+#define DSIM_FIFO_FULL_PL       (1u << 9)
+#define DSIM_FIFO_EMPTY_PH      (1u << 10)
+#define DSIM_FIFO_FULL_PH       (1u << 11)
+#define DSIM_CMD_PKT_GO_EN      (1u << 16)
+#define DSIM_CONFIG_VIDEO       (1u << 18)
+#define SYSMMU_CTRL_VM          0x8000
+
+/* GIC INTIDs (SPI + 32) of DECON0 and the DPP0 RDMA, from the zuma DT */
+#define HD_INTID_EXTRA          273
+#define HD_INTID_FRAME_DONE     274
+#define HD_INTID_FRAME_START    275
+#define HD_INTID_RDMA           288
+#define HD_IRQ_PRIO             0xA0
+
+/* DSIM timer values for 60 and 120 fps with hk3's te_idle_us = 350, te_var = 1 */
+#define HD_URUN_60              0x2235
+#define HD_URUN_120             0x06A7
+#define HD_TE1_60               0x34E13D3Bu
+#define HD_TE1_120              0x1A701E9Du
+
+#define HD_SLOT_SIZE            (16u << 20)
+#define HD_MAX_SLOTS            6
+#define HD_ARM_TIMEOUT_MS       50
+#define HD_XFER_TIMEOUT_US      20000
+#define HD_TE_LOST_US           100000
+#define HD_WATCH_MS             20
+#define HD_POLL_US              250
+#define HD_STATS_TICKS          500
+
+enum {
+	ERR_DECON       = 1,
+	ERR_RDMA        = 2,
+	ERR_MISM        = 4,
+	ERR_RING        = 8,
+};

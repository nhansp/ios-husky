+	uint32_t fErr, fErrArg, fErrSeen;
+	bool     fErrInject;
+	uint32_t fMismRun, fMismArmed, fMismSBase, fMismSBase0;
+	bool     fMismNew, fMismSame;
+
+	volatile uint32_t fTeCount;
+	volatile uint64_t fTeTime;

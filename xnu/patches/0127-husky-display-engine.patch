+/*
+ * Display engine for HUSKY (see HuskyDisplay.cpp): scans CoreAnimation's
+ * IOSurfaces out of the scanout pool through DECON0/DPP0 without a CPU copy,
+ * paces vsync from the panel's TE, and switches the panel to 120 Hz.
+ *
+ * Owned by AppleCLCD (HuskyFramebuffer.cpp). Everything is behind the
+ * huskydisp=N boot-arg; with N absent or 0 no instance exists.
+ */
+#ifndef _HUSKY_DISPLAY_H
+#define _HUSKY_DISPLAY_H
+
+#include "HuskySurface.h"
+
+#if defined(HUSKY)
+#include <IOKit/IOEventSource.h>

+	if (!gicd_base) {
+		return 0;
+	}
+	*grp = (gicd_read32(HUSKY_GICD_IGROUPR + (intid / 32) * 4) >> (intid % 32)) & 1;
+	*cfg = (gicd_read32(HUSKY_GICD_ICFGR + (intid / 16) * 4) >> ((intid % 16) * 2)) & 3;
+	*en = (gicd_read32(HUSKY_GICD_ISENABLER + (intid / 32) * 4) >> (intid % 32)) & 1;
+	*route = _gic_read64(gicd_base + HUSKY_GICD_IROUTER + (vm_offset_t)intid * 8);

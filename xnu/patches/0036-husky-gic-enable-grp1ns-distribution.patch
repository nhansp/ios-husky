+	 * leaves it clear (measured GICD_CTLR=0x10, ARE_NS only). Without it the
+	 * distributor never delivers the vtimer. Also give PPI 27 Linux's default
+	 * priority rather than the reset value.
+	 */
+	*(volatile uint8_t *)(gicr_pe_base + HUSKY_GICR_IPRIORITYR + 27) = 0xa0;
+	uint32_t gicd_ctlr = gicd_read32(GICD_CTLR);
+	gicd_write32(GICD_CTLR, gicd_ctlr | HUSKY_GICD_CTLR_ENABLEGRP1A);
+	while (gicd_read32(GICD_CTLR) & HUSKY_GICD_CTLR_RWP) {
+		/* wait for the register write to take effect */
+	}

@@ -818,6 +818,33 @@ static volatile struct husky_prz *husky_prz;
 static uint32_t husky_pmsg_pos;
 #define HUSKY_PMSG_CAP		(HUSKY_PMSG_SIZE - sizeof(struct husky_prz))
 
+/*
+ * husky bring-up breadcrumb usable from early C (arm_init/arm_vm_init), once
+ * the VM is far enough along for ml_io_map (i.e. from just after arm_vm_init).
+ * Appends a string to the pmsg ring, continuing the shim's log. Own mapping so
+ * it is independent of the serial framework.
+ */
+static volatile struct husky_prz *husky_bc_prz;
+void husky_early_bc(const char *s);
+void
+husky_early_bc(const char *s)
+{
+	if (husky_bc_prz == NULL) {
+		husky_bc_prz = (volatile struct husky_prz *)ml_io_map(HUSKY_PMSG_PHYS, HUSKY_PMSG_SIZE);
+		if (husky_bc_prz->sig != HUSKY_PMSG_SIG || husky_bc_prz->size > HUSKY_PMSG_CAP) {
+			husky_bc_prz->sig = HUSKY_PMSG_SIG;
+			husky_bc_prz->start = 0;
+			husky_bc_prz->size = 0;
+		}
+	}
+	uint32_t pos = husky_bc_prz->size;
+	while (*s && pos < HUSKY_PMSG_CAP) {
+		husky_bc_prz->data[pos++] = (uint8_t)*s++;
+	}
+	husky_bc_prz->start = pos;
+	husky_bc_prz->size = pos;
+}
+
 static void
 husky_pmsg_init(void)

+/*
+ * husky's panel runs in DSI command mode: it keeps showing its last frame and
+ * the DECON sends a new one only per shadow-update request (the shim leaves
+ * the TE-driven trigger enabled and unmasked). The console calls this after
+ * drawing a line so the boot framebuffer reaches the panel on the next TE.
+ * zuma DECON0: GLOBAL_CON 0x20 (bit1/0 enable), SHD_REG_UP_REQ 0x50
+ * (bit31 global, [13:0] windows).
+ */
+#define HUSKY_DECON0_PHYS	0x19470000ULL
+static volatile uint32_t *husky_decon;
+void husky_fb_kick(void);
+void
+husky_fb_kick(void)
+{
+	if (husky_decon == NULL) {
+		/* ml_io_map allocates: fine during early boot, else only with IRQs on. */
+		if (startup_phase >= STARTUP_SUB_EARLY_BOOT && !ml_get_interrupts_enabled()) {
+			return;
+		}
+		husky_decon = (volatile uint32_t *)ml_io_map(HUSKY_DECON0_PHYS, PAGE_SIZE);
+	}
+	__builtin_arm_dsb(DSB_SY);	/* drain the write-combined framebuffer first */
+	husky_decon[0x20 / 4] |= 3;
+	husky_decon[0x50 / 4] |= (1u << 31) | 0x3fff;
+}

diff --git a/bsd/dev/husky_ufs.c b/bsd/dev/husky_ufs.c
index 07ed3cf..838ce3e 100644
--- a/bsd/dev/husky_ufs.c
+++ b/bsd/dev/husky_ufs.c
@@ -44,6 +44,7 @@
 #include <miscfs/devfs/devfs.h>
 #include <kern/locks.h>
 #include <kern/clock.h>
+#include <kern/thread_call.h>
 #include <machine/machine_routines.h>
 #include <arm/caches_internal.h>
 #include <arm/memory_types.h>             /* VM_WIMG_COPYBACK */
@@ -822,13 +823,32 @@ husky_log_final_flush(void)
  * unmounted, so the HFS+ journal is empty), then HuskyPlatformExpert resets
  * the SoC with PSCI SYSTEM_RESET and ABL starts Android. No force-reboot.
  */
+#define HUSKY_REBOOT_STUCK_SECS 60   /* proc_shutdown alone may take 2 x (3 + 10) s */
+
+/* bootJ: the root unmount blocked forever after a GPU wedge, and only a force-reboot got Android back. */
+static void
+husky_reboot_stuck(__unused thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	HU_LOG("HUSKY REBOOT: reboot_kernel still running after %u s, PSCI SYSTEM_RESET\n", HUSKY_REBOOT_STUCK_SECS);
+	husky_log_final_flush();
+	register uint64_t x0 __asm__("x0") = 0x84000009ULL;   /* SYSTEM_RESET */
+	__asm__ volatile ("smc #0" : "+r"(x0) : : "x1", "x2", "x3", "memory");
+}
+
 static void
 husky_reboot_thread(void *arg, __unused wait_result_t wr)
 {
 	uint32_t secs = (uint32_t)(uintptr_t)arg;
+	uint64_t deadline;
 
 	(void)tsleep(&husky_log_chan, PZERO, "huskyreboot", hz * (int)secs);
 	HU_LOG("HUSKY REBOOT: clean reboot after %u s (huskyreboot)\n", secs);
+	thread_call_t stuck = thread_call_allocate_with_options(husky_reboot_stuck, NULL, THREAD_CALL_PRIORITY_KERNEL,
+	    THREAD_CALL_OPTIONS_ONCE);
+	clock_interval_to_deadline(HUSKY_REBOOT_STUCK_SECS, NSEC_PER_SEC, &deadline);
+	if (stuck != NULL) {
+		(void)thread_call_enter_delayed(stuck, deadline);
+	}
 	(void)reboot_kernel(RB_AUTOBOOT, NULL);
 	HU_LOG("HUSKY REBOOT: reboot_kernel returned\n");
 }

 	return st;
 }
 
+static void vm_free_retired_heaps(mali_vm_t *vm);
+
 static void
 op_queue_destroy(mali_queue_t *q)
 {
@@ -1570,6 +1572,7 @@ op_queue_destroy(mali_queue_t *q)
 	}
 	queue_free_buffers(q);
 	queue_put_stream(q);
+	vm_free_retired_heaps(q->vm);
 	lck_mtx_unlock(&g_grp_lock);
 	lck_mtx_free(q->lock, &g_bridge_grp);
 	kfree_data(q, sizeof(mali_queue_t));
@@ -1887,6 +1890,7 @@ struct mali_tiler_heap {
 	mali_bo_t  *ctx;
 	mali_bo_t **chunks;
 	uint32_t    n_chunks, max_chunks, chunk_size;
+	bool        retired;    /* destroyed by its queue; freed when the VM's stream stops */
 };
 
 static void
@@ -1957,21 +1961,59 @@ op_tiler_heap_create(mali_vm_t *vm, uint32_t chunk_size, uint32_t initial_chunks
 	return 0;
 }
 
+/*
+ * The VM's queues share one stream, and HEAP_SET leaves the CS pointing at the last heap it set: a queue's
+ * heap freed while another queue keeps the stream is written by the tiler after it is unmapped (bootE, bootJ:
+ * AS translation fault at the heap context, then the stream never acks STOP).
+ */
 static void
 op_tiler_heap_destroy(mali_tiler_heap_t *heap)
 {
 	if (heap == NULL) {
 		return;
 	}
+	lck_mtx_lock(&g_grp_lock);
+	const bool stream_live = heap->vm->group != NULL && heap->vm->group->queue != NULL;
 	lck_mtx_lock(&g_vm_lock);
-	for (mali_tiler_heap_t **p = &heap->vm->heaps; *p != NULL; p = &(*p)->next) {
-		if (*p == heap) {
-			*p = heap->next;
-			break;
+	if (stream_live) {
+		heap->retired = true;
+	} else {
+		for (mali_tiler_heap_t **p = &heap->vm->heaps; *p != NULL; p = &(*p)->next) {
+			if (*p == heap) {
+				*p = heap->next;
+				break;
+			}
+		}
+	}
+	lck_mtx_unlock(&g_vm_lock);
+	lck_mtx_unlock(&g_grp_lock);
+	if (!stream_live) {
+		tiler_heap_free(heap);
+	}
+}
+
+/* g_grp_lock held, the VM's stream stopped */
+static void
+vm_free_retired_heaps(mali_vm_t *vm)
+{
+	mali_tiler_heap_t *dead = NULL;
+	lck_mtx_lock(&g_vm_lock);
+	for (mali_tiler_heap_t **p = &vm->heaps; *p != NULL;) {
+		mali_tiler_heap_t *h = *p;
+		if (h->retired) {
+			*p = h->next;
+			h->next = dead;
+			dead = h;
+		} else {
+			p = &h->next;
 		}
 	}
 	lck_mtx_unlock(&g_vm_lock);
-	tiler_heap_free(heap);
+	while (dead != NULL) {
+		mali_tiler_heap_t *h = dead;
+		dead = h->next;
+		tiler_heap_free(h);
+	}
 }
 

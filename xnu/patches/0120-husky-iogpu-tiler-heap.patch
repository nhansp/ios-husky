+/*
+ * D-3 (MaliPluginABI.h): create the queue's tiler heap and publish it in the plug-in's queue-state
+ * buffer, a TILER_HEAP descriptor at +0 and struct mali_heap_result at +0x80, before the SUBMIT_CS
+ * that follows in the same command buffer runs HEAP_SET.
+ */
+uint32_t
+IOGPUCommandQueue::heapOp(const struct mali_kcmd_heap_op *cmd)
+{
+	if (cmd->op == MALI_HEAP_OP_DESTROY) {
+		if (fHeap != NULL) {
+			mali_backend_ops.tiler_heap_destroy(fHeap);
+			fHeap = NULL;
+		}
+		return kIOGPUStatus_Success;
+	}
+	if (cmd->op != MALI_HEAP_OP_CREATE || fHeap != NULL || cmd->qstate_resource_id > UINT32_MAX) {
+		return kIOGPUStatus_ParseError;
+	}
+
+	IOGPUResource *r = fDevice->lookupResource((uint32_t)cmd->qstate_resource_id);
+	if (r == NULL) {
+		return kIOGPUStatus_ParseError;
+	}
+	uint8_t *qs = r->bo() ? (uint8_t *)mali_backend_ops.bo_cpu_map(r->bo()) : NULL;
+	const bool usable = qs != NULL && r->gpuAddress() == cmd->qstate_gpu_va &&
+	    r->gpuLength() >= MALI_QSTATE_RESULT_OFF + sizeof(struct mali_heap_result);
+	if (!usable) {
+		IOLog("IOGPU: HEAP_OP: queue-state resource %llu unusable (gpu 0x%llx, expected 0x%llx, size 0x%llx)\n",
+		    cmd->qstate_resource_id, (unsigned long long)r->gpuAddress(), cmd->qstate_gpu_va, r->gpuLength());
+		r->release();
+		return kIOGPUStatus_ParseError;
+	}
+
+	mali_gpu_va_t ctx = 0, first = 0;
+	struct mali_heap_result res;
+	bzero(&res, sizeof(res));
+	mali_status_t st = mali_backend_ops.tiler_heap_create(fDevice->task()->vm(), cmd->chunk_size,
+	    cmd->initial_chunks, cmd->max_chunks, &fHeap, &ctx, &first);
+	if (st == 0) {
+		const uint64_t top = first + cmd->chunk_size, bottom = first + 64;
+		const uint32_t desc[8] = {
+			0x29u,      /* Type Buffer (9), Buffer type Tiler heap (2) [Mesa genxml v11.xml "Tiler Heap"] */
+			cmd->chunk_size,
+			(uint32_t)first, (uint32_t)(first >> 32),
+			(uint32_t)bottom, (uint32_t)(bottom >> 32),
+			(uint32_t)top, (uint32_t)(top >> 32),
+		};
+		memcpy(qs + MALI_QSTATE_HEAP_DESC_OFF, desc, sizeof(desc));
+		res.ctx_gpu_va = ctx;
+		res.first_chunk_gpu_va = first;
+		res.state = 1;
+	} else {
+		res.error = (uint32_t)st;
+	}
+	memcpy(qs + MALI_QSTATE_RESULT_OFF, &res, sizeof(res));
+	mali_backend_ops.dcache_flush(qs, MALI_QSTATE_RESULT_OFF + sizeof(res));
+	r->release();
+	return st == 0 ? kIOGPUStatus_Success : kIOGPUStatus_ParseError;
+}

+
+static void
+tiler_heap_free(mali_tiler_heap_t *h)
+{
+	for (uint32_t i = 0; i < h->n_chunks; i++) {
+		op_bo_free(h->chunks[i]);
+	}
+	if (h->chunks != NULL) {
+		kfree_data(h->chunks, h->max_chunks * sizeof(mali_bo_t *));
+	}
+	op_bo_free(h->ctx);
+	kfree_data(h, sizeof(*h));
+}

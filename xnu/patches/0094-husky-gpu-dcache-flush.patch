+/*
+ * Clean+invalidate to PoC by VA. XNU's flush_dcache64 is a bare dsb here:
+ * the HUSKY config inherits Apple's __ARM_COHERENT_IO__ (all DMA coherent),
+ * true for zuma's UFS but not for the GPU. Boots 0091-0093: the GPU read the
+ * page tables from stale DRAM (level-0 translation fault at VA 0).
+ */
+static void
+husky_dcache_flush(vm_offset_t va, size_t len)
+{
+	uint64_t ctr;
+	__asm__ volatile ("mrs %0, ctr_el0" : "=r"(ctr));
+	size_t line = 4u << ((ctr >> 16) & 0xf);        /* DminLine, words */
+	vm_offset_t p = va & ~(vm_offset_t)(line - 1);
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (; p < va + len; p += line) {
+		__asm__ volatile ("dc civac, %0" : : "r"(p) : "memory");
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
+
 /* Simple word copies: the targets may be Device/NC mappings (no dc zva). */
 static void
 copy_bytes(volatile uint8_t *dst, const uint8_t *src, size_t n)

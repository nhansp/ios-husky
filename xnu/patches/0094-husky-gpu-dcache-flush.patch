 	}
 	HU_LOG("HUSKY GPU: %u sections mapped, %u page-table pages\n", nsec, pt_used);
 	/* Push everything to DRAM: the GPU walks and reads non-coherently. */
-	flush_dcache64((addr64_t)kva, (unsigned)region, FALSE);
-	__asm__ volatile ("dsb sy" ::: "memory");
+	husky_dcache_flush(kva, region);
 

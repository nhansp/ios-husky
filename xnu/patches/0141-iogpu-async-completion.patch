+/* osfmk/kern/thread.h declares it for MACH_KERNEL_PRIVATE only */
+extern "C" kern_return_t kernel_thread_start_priority(thread_continue_t, void *, integer_t, thread_t *);
+#define IOGPU_POLLER_PRI        80      /* MAXPRI_KERNEL - 15: above user UI threads */
+
+/*
+ * Completion poller. The GPU's job IRQ is not wired up, so one kernel thread retires command
+ * buffers by reading each busy queue's sync object every kPollUS, posts their completions in
+ * submission order, and advances the global fence that husky_gpu_fence_wait sleeps on.
+ */
+static IOLock            *gPollLock;
+static IOGPUCommandQueue *gPollList;
+static uint64_t           gSubmitGen;           /* last generation handed out */
+static uint64_t           gDoneGen;             /* every generation <= gDoneGen has retired */
+static const uint32_t     kPollUS = 200;
+static const uint64_t     kHangUS = 500000;
+
+static uint64_t
+deadline_in_us(uint64_t us)
+{
+	uint64_t d;
+	clock_interval_to_deadline((uint32_t)us, NSEC_PER_USEC, &d);
+	return d;
+}
+
+extern "C" uint64_t
+husky_gpu_fence(void)
+{
+	if (gPollLock == NULL) {
+		return 0;
+	}
+	IOLockLock(gPollLock);
+	uint64_t t = gSubmitGen;
+	IOLockUnlock(gPollLock);
+	return t;
+}
+
+extern "C" bool
+husky_gpu_fence_wait(uint64_t token, uint32_t timeout_us)
+{
+	if (gPollLock == NULL || token == 0) {
+		return true;
+	}
+	uint64_t deadline = deadline_in_us(timeout_us);
+	IOLockLock(gPollLock);
+	while (gDoneGen < token && mach_absolute_time() < deadline) {
+		IOLockSleepDeadline(gPollLock, &gDoneGen, deadline, THREAD_UNINT);
+	}
+	bool done = gDoneGen >= token;
+	IOLockUnlock(gPollLock);
+	return done;
+}
+
+void
+IOGPUCommandQueue::pollerMain(void *, wait_result_t)
+{
+	IOLockLock(gPollLock);
+	for (;;) {
+		if (gPollList == NULL) {
+			if (gDoneGen != gSubmitGen) {
+				gDoneGen = gSubmitGen;
+				IOLockWakeup(gPollLock, &gDoneGen, false);
+			}
+			IOLockSleep(gPollLock, &gPollList, THREAD_UNINT);
+			continue;
+		}
+		uint64_t now = mach_absolute_time();
+		uint64_t done = gSubmitGen;
+		IOGPUCommandQueue **pp = &gPollList;
+		while (*pp != NULL) {
+			IOGPUCommandQueue *q = *pp;
+			if (q->service(now)) {
+				uint64_t g = q->fPend[q->fPendHead].gen - 1;
+				done = g < done ? g : done;
+				pp = &q->fPollNext;
+			} else {
+				*pp = q->fPollNext;
+				q->fPollNext = NULL;
+				q->fPolled = false;
+				IOLockWakeup(gPollLock, &q->fPendCount, false);
+			}
+		}
+		if (done != gDoneGen) {
+			gDoneGen = done;
+			IOLockWakeup(gPollLock, &gDoneGen, false);
+		}
+		if (gPollList != NULL) {
+			/* Without urgency the timer is coalesced to ~1 ms, which would cap the UI near 60 fps. */
+			assert_wait_deadline_with_leeway((event_t)&gPollList, THREAD_UNINT, TIMEOUT_URGENCY_SYS_CRITICAL,
+			    deadline_in_us(kPollUS), 0);
+			IOLockUnlock(gPollLock);
+			thread_block(THREAD_CONTINUE_NULL);
+			IOLockLock(gPollLock);
+		}
+	}
+}
+
+void
+IOGPUCommandQueue::pushPending(uint64_t ref, uint64_t t0, uint32_t status)
+{
+	IOLockLock(gPollLock);
+	/* The poller frees a slot within kHangUS: it times out a stuck head. */
+	while (fPendCount == kPendMax) {
+		IOLockSleep(gPollLock, &fPendCount, THREAD_UNINT);
+	}
+	Pending *p = &fPend[(fPendHead + fPendCount) % kPendMax];
+	p->target = fSubmitSeq;
+	p->gen = ++gSubmitGen;
+	p->ref = ref;
+	p->t0 = t0;
+	p->tSubmit = mach_absolute_time();
+	p->status = status;
+	fPendCount++;
+	if (!fPolled) {
+		fPolled = true;
+		fPollNext = gPollList;
+		gPollList = this;
+	}
+	IOLockWakeup(gPollLock, &gPollList, false);
+	IOLockUnlock(gPollLock);
+}
+
+bool
+IOGPUCommandQueue::service(uint64_t now)
+{
+	if (fMaliQueue != NULL) {
+		mali_backend_ops.queue_service(fMaliQueue, 0);
+	}
+	uint64_t v = fSync ? mali_backend_ops.syncobj_read(fSync) : UINT64_MAX;
+	while (fPendCount > 0) {
+		Pending *p = &fPend[fPendHead];
+		uint32_t st = p->status;
+		if (v < p->target) {
+			uint64_t ns;
+			absolutetime_to_nanoseconds(now - p->tSubmit, &ns);
+			if (ns < kHangUS * NSEC_PER_USEC) {
+				break;
+			}
+			IOLog("HUSKY IOGPU: queue 0x%llx: command buffer stuck %llu ms (sync %llu, want %llu)\n",
+			    fTraceId, ns / NSEC_PER_MSEC, v, p->target);
+			if (!fDumped && fMaliQueue != NULL) {
+				fDumped = true;
+				mali_backend_ops.queue_service(fMaliQueue, MALI_QUEUE_SERVICE_DUMP);
+			}
+			st = kIOGPUStatus_ParseError;       /* GPU timeout / hang treated as error */
+		}
+		if (p->ref != 0 && fNotifQueue != NULL) {
+			fNotifQueue->enqueueCompletion(p->ref, p->t0, now, st, 0);
+		}
+		fPendHead = (fPendHead + 1) % kPendMax;
+		fPendCount--;
+		IOLockWakeup(gPollLock, &fPendCount, false);
+	}
+	return fPendCount > 0;
+}
+
+bool
+IOGPUCommandQueue::waitIdle(uint64_t timeout_us)
+{
+	if (gPollLock == NULL) {
+		return true;
+	}
+	uint64_t deadline = deadline_in_us(timeout_us);
+	IOLockLock(gPollLock);
+	while ((fPendCount > 0 || fPolled) && mach_absolute_time() < deadline) {
+		IOLockSleepDeadline(gPollLock, &fPendCount, deadline, THREAD_UNINT);
+	}
+	bool idle = fPendCount == 0;
+	IOLockUnlock(gPollLock);
+	return idle;
+}
+
+void
+IOGPUCommandQueue::setNotificationQueue(IOGPUNotificationQueue *nq)
+{
+	if (nq != NULL) {
+		nq->retain();
+	}
+	IOLockLock(gPollLock);
+	IOGPUNotificationQueue *old = fNotifQueue;
+	fNotifQueue = nq;
+	IOLockUnlock(gPollLock);
+	OSSafeReleaseNULL(old);
+}

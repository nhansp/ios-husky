+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+/*
+ * HUSKY persona trace: who calls the persona syscall, with what, and the
+ * result (first 300 lines). usermanagerd creates the personas that
+ * containermanagerd needs for system-group containers.
+ */
+static int husky_persona_logged;
+#define HUSKY_PERSONA_LOG(fmt, ...) do { \
+	if (husky_persona_logged < 300) { \

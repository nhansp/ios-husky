 	k_idlen = u_idlen;
 	error = persona_find_all(login, kinfo.persona_id, (persona_type_t)kinfo.persona_type, persona, &k_idlen);
+	HUSKY_PERSONA_LOG("find: id %d type %d login \"%s\" -> %lu found, err %d",
+	    kinfo.persona_id, kinfo.persona_type, login ? login : "", (unsigned long)k_idlen, error);
 	if (error) {
 		goto out;
 	}

diff --git a/osfmk/ipc/husky_ipcdump.c b/osfmk/ipc/husky_ipcdump.c
new file mode 100644
index 0000000..7afe103
--- /dev/null
+++ b/osfmk/ipc/husky_ipcdump.c
@@ -0,0 +1,91 @@
+/*
+ * HUSKY sampler port dump (called from bsd/dev/husky_sample.c): every
+ * receive right a sampled task holds, with its queued message count, the
+ * number of outstanding send rights, and the launchd service name for
+ * service ports. Shows whether a daemon owns its MachServices and whether
+ * client messages pile up unread.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+#include <ipc/ipc_space.h>
+#include <ipc/ipc_entry.h>
+#include <ipc/ipc_port.h>
+#include <ipc/ipc_service_port.h>
+#include <kern/task.h>
+
+#define HUSKY_PORTS_MAX 48
+
+void husky_sample_ports(const char *name, task_t task);
+
+void
+husky_sample_ports(const char *name, task_t task)
+{
+	struct {
+		mach_port_name_t name;
+		uint16_t         msgs;
+		uint32_t         srights;
+		char             svc[56];
+	} found[HUSKY_PORTS_MAX];
+	int nfound = 0, nrecv = 0;
+	ipc_space_t space = task->itk_space;
+
+	if (space == IS_NULL) {
+		return;
+	}
+	is_read_lock(space);
+	if (!is_active(space)) {
+		is_read_unlock(space);
+		return;
+	}
+	ipc_entry_table_t table = is_active_table(space);
+	unsigned int count = ipc_entry_table_count(table);
+
+	for (unsigned int i = 1; i < count; i++) {
+		ipc_entry_t entry = ipc_entry_table_get(table, i);
+		if (entry == IE_NULL) {
+			continue;
+		}
+		ipc_entry_bits_t bits = entry->ie_bits;
+		if (!(IE_BITS_TYPE(bits) & MACH_PORT_TYPE_RECEIVE)) {
+			continue;
+		}
+		ipc_port_t port = entry->ie_port;
+		if (port == IP_NULL) {
+			continue;
+		}
+		nrecv++;
+
+		uint16_t msgs;
+		uint32_t srights;
+		char svc[56] = "";
+
+		ip_mq_lock(port);
+		msgs = port->ip_messages.imq_msgcount;
+		srights = port->ip_srights;
+		ipc_object_label_t label = ip_label_get(port);
+		if (ip_is_any_service_port_type(label.io_type) && label.iol_service != NULL &&
+		    label.iol_service->ispl_service_name != NULL) {
+			strlcpy(svc, label.iol_service->ispl_service_name, sizeof(svc));
+		}
+		ip_mq_unlock_label_put(port, &label);
+
+		/* Keep the interesting ones: named services and ports with a backlog. */
+		if ((svc[0] != '\0' || msgs != 0) && nfound < HUSKY_PORTS_MAX) {
+			found[nfound].name = MACH_PORT_MAKE(i, IE_BITS_GEN(bits));
+			found[nfound].msgs = msgs;
+			found[nfound].srights = srights;
+			strlcpy(found[nfound].svc, svc, sizeof(found[nfound].svc));
+			nfound++;
+		}
+	}
+	is_read_unlock(space);
+
+	/* Print outside the space lock (a spinlock). */
+	printf("SMPPORT %s: %d receive rights, %d named or backlogged\n", name, nrecv, nfound);
+	for (int i = 0; i < nfound; i++) {
+		printf("SMPPORT %s 0x%x msgs %u srights %u %s\n", name, found[i].name,
+		    found[i].msgs, found[i].srights, found[i].svc[0] ? found[i].svc : "-");
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_HUSKY */

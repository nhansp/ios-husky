diff --git a/bsd/dev/husky_gpu.c b/bsd/dev/husky_gpu.c
index 1abd2cf..521485b 100644
--- a/bsd/dev/husky_gpu.c
+++ b/bsd/dev/husky_gpu.c
@@ -331,6 +331,8 @@ static const uint32_t gpu_l2_hash[3] = {0x0036DB6D, 0x005B6DB6, 0x0};
 #define COMP_OUT                0x6000u
 #define PROBE_JOB               0x8000u         /* imul_probe job page (GPU-executable) */
 #define PROBE_OUT               0x9000u         /* five 1 KiB output arrays */
+#define I128_JOB                0xe000u         /* i128_probe job page (GPU-executable) */
+#define I128_OUT                0xf000u         /* 256 u32 out */
 #include "husky_gpu_compute.h"
 /*
  * Render jobs (huskygpu=5): one more contiguous area after the job area, mapped at fixed GPU VAs
@@ -627,6 +629,8 @@ _Static_assert(HUSKY_PROBE_JOB_VA == TEST_VA + PROBE_JOB, "probe job page");
 _Static_assert(HUSKY_PROBE_OUT_VA == TEST_VA + PROBE_OUT, "probe out[]");
 _Static_assert(HUSKY_COMP_JOB_BYTES <= GPU_PAGE && HUSKY_PROBE_JOB_BYTES <= GPU_PAGE, "jobs fit a page");
 _Static_assert(HUSKY_COMP_THREADS * 4 == 0x400, "1 KiB per output array");
+_Static_assert(HUSKY_I128_JOB_VA == TEST_VA + I128_JOB, "i128 job page");
+_Static_assert(HUSKY_I128_OUT_VA == TEST_VA + I128_OUT, "i128 out[]");
 
 /*
  * Copy a job page, append its CS words plus a tail (end timestamp at TEST_DATA + ts_off, sync +1)
@@ -744,7 +748,24 @@ husky_gpu_compute_job(vm_offset_t t, vm_offset_t csout, vm_offset_t csgout, unsi
 	pgood += comp_check(t, PROBE_OUT + 0xc00, "probe 3: IADD r4+r4        in*2", want_double);
 	pgood += comp_check(t, PROBE_OUT + 0x1000, "probe 4: in-place mul_add  in*3+7", want_mul_add);
 	cs_state_dump("after the probe", csout, csgout, t);
-	if (!ring_used || good != HUSKY_COMP_THREADS || pgood != 5 * HUSKY_COMP_THREADS) {
+	if (!ring_used) {
+		gpu_fault_dump("compute probe");
+		return 0;
+	}
+
+	/* i128_probe: out[i]=in[i] (reads COMP_IN) via LOAD.i128/STORE.i128. The triangle's vertex
+	 * shader faulted INSTR_INVALID_ENC on this very opcode; here each u32 is checked. */
+	for (unsigned i = 0; i < HUSKY_COMP_THREADS; i++) {
+		*(volatile uint32_t *)(t + I128_OUT + 4 * i) = 0xdeadbeefu;
+	}
+	ring_used = husky_gpu_ring_job(t, ring_used, I128_JOB, husky_i128_job, HUSKY_I128_JOB_BYTES,
+	    husky_i128_cs, sizeof(husky_i128_cs) / 8, 4, 32, ra, rv, waitall, &us);
+	HU_LOG("HUSKY GPU: I128 PROBE %s after %u us: sync %llu\n", ring_used ? "COMPLETED" : "did not complete",
+	    us, rd64(t, TEST_SYNC));
+	unsigned igood = comp_check(t, I128_OUT, "i128 copy  in", comp_in);
+	cs_state_dump("after the i128 probe", csout, csgout, t);
+	if (!ring_used || good != HUSKY_COMP_THREADS || pgood != 5 * HUSKY_COMP_THREADS ||
+	    igood != HUSKY_COMP_THREADS) {
 		gpu_fault_dump("compute probe");
 	}
 	return ring_used;
@@ -1107,8 +1128,8 @@ husky_gpu_mcu_boot(void)
 	test_pa = pt_pa + PT_PAGES * GPU_PAGE;
 	for (uint32_t off = 0; off < TEST_SIZE; off += GPU_PAGE) {
 		/* the compute jobs' pages hold shader code: executable, read-only */
-		uint32_t f = off == COMP_JOB || off == PROBE_JOB ? FW_IFACE_RD | FW_IFACE_EX :
-		    FW_IFACE_RD | FW_IFACE_WR;
+		uint32_t f = off == COMP_JOB || off == PROBE_JOB || off == I128_JOB ?
+		    FW_IFACE_RD | FW_IFACE_EX : FW_IFACE_RD | FW_IFACE_WR;
 		if (!pt_map_page(root, TEST_VA + off, test_pa + off, leaf_attrs_for(f))) {
 			HU_LOG("HUSKY GPU: page-table pool exhausted (job area)\n");
 			return;

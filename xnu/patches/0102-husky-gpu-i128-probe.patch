  *   husky_comp   mul_add: out[i] = in[i] * 3 + 7 (xnu 0098)
  *   husky_probe  imul_probe: five variants of that arithmetic, 1 KiB apart (xnu 0099)
+ *   husky_i128   i128_probe: out[i]=in[i] via LOAD.i128/STORE.i128, 64 threads x 4 u32 (xnu 0102)
  */
 #define HUSKY_COMP_IN_VA        0x6005000u
 #define HUSKY_COMP_THREADS      256u
@@ -111,3 +112,52 @@ static const uint64_t husky_probe_cs[20] = {
 	0x0300000000010000ULL,  /* opcode 3 */
 };
 

diff --git a/bsd/kern/husky_amfi.c b/bsd/kern/husky_amfi.c
index c237dc5..3f4e5c5 100644
--- a/bsd/kern/husky_amfi.c
+++ b/bsd/kern/husky_amfi.c
@@ -320,11 +320,50 @@ husky_sandbox_syscall(struct proc *p, int call, __unused user_addr_t arg)
 		printf("HUSKY Sandbox: containermanagerd op %d\n", call);
 	}
 	switch (call) {
-	case 4:         /* container path (audit token / pid) */
-	case 5:         /* extension issue */
-	case 6:         /* extension consume */
+	case 4:
+		/*
+		 * Container path for a pid / audit token: none. containermanagerd
+		 * also asks this for its clients, and a path would make it enforce
+		 * its client-sandbox rules; "not found" is the permissive answer.
+		 */
 		return ENOENT;
-	default:        /* including 0x43, container expected: none */
+	case 5: {
+		/*
+		 * Extension issue (iOS 26): arg = u64[7] {class, type, subject,
+		 * flags, char *out (0x3ff0 bytes), pid, pidversion}. Userland treats
+		 * the token as opaque (only "invalid" is special); containermanagerd
+		 * hands it to clients (gamed needs one) and truncates at 0x800.
+		 */
+		static uint64_t husky_ext_seq;
+		uint64_t a[7];
+		char cls[96] = "", subj[256] = "", tok[480];
+		size_t got = 0;
+		if (copyin(arg, a, sizeof(a)) != 0 || a[4] == 0) {
+			return EINVAL;
+		}
+		if (a[0] != 0) {
+			(void)copyinstr((user_addr_t)a[0], cls, sizeof(cls), &got);
+		}
+		if (a[2] != 0) {
+			(void)copyinstr((user_addr_t)a[2], subj, sizeof(subj), &got);
+		}
+		cls[sizeof(cls) - 1] = '\0';
+		subj[sizeof(subj) - 1] = '\0';
+		snprintf(tok, sizeof(tok), "husky:%llx;%s;%llu;%llx;%lld;%s",
+		    ++husky_ext_seq, cls, a[1], a[3], (long long)a[5], subj);
+		return copyout(tok, (user_addr_t)a[4], strlen(tok) + 1);
+	}
+	case 6: {
+		/* Extension consume: arg = u64[3] {token, strlen + 1, u64 *handle}; handle >= 0. */
+		static uint64_t husky_ext_handle;
+		uint64_t a[3], h;
+		if (copyin(arg, a, sizeof(a)) != 0) {
+			return EINVAL;
+		}
+		h = ++husky_ext_handle;
+		return a[2] != 0 ? copyout(&h, (user_addr_t)a[2], sizeof(h)) : 0;
+	}
+	default:        /* 7 release (also of unknown handles), 0x43 container expected: none, ... */
 		return 0;
 	}
 }

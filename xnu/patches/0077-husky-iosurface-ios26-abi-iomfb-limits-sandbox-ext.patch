+static void
+husky_fb_set_number(OSDictionary *d, const char *key, uint64_t v)
+{
+	OSNumber *n = OSNumber::withNumber(v, 32);
+	if (n != NULL) {
+		d->setObject(key, n);
+		n->release();
+	}
+}
+
+static void
+husky_fb_set_number_array(OSDictionary *d, const char *key, uint64_t v)
+{
+	OSNumber *n = OSNumber::withNumber(v, 32);
+	OSArray *a = n != NULL ? OSArray::withObjects((const OSObject **)&n, 1, 1) : NULL;
+	if (a != NULL) {
+		d->setObject(key, a);
+	}
+	OSSafeReleaseNULL(a);
+	OSSafeReleaseNULL(n);
+}
+
+/*
+ * Display capabilities QuartzCore reads (AppleDisplay::update_display_limits):
+ * one layer (our swap is a CPU copy of a single surface, no blending or
+ * scaling), source limits that cover the 1344x2992 panel (defaults are
+ * 1920x1200 rects), no multi-plane/YUV/rotation, and the plane base
+ * alignment as the dictionary CA expects (a bare number is dropped).
+ */
+static void
+husky_fb_publish_limits(IOService *fb)
+{
+	OSDictionary *layers = OSDictionary::withCapacity(2);
+	OSDictionary *src = OSDictionary::withCapacity(6);
+	OSDictionary *align = OSDictionary::withCapacity(1);
+
+	if (layers != NULL) {
+		husky_fb_set_number(layers, "MaxNumLayers", 1);
+		husky_fb_set_number(layers, "FullFrameRequired", 0);
+		fb->setProperty("IOMFBNumLayers", layers);
+	}
+	if (src != NULL) {
+		husky_fb_set_number(src, "MaxSrcBufferWidth", 4096);
+		husky_fb_set_number(src, "MaxSrcBufferHeight", 4096);
+		husky_fb_set_number(src, "MaxSrcRectWidth", 4096);
+		husky_fb_set_number_array(src, "MaxSrcRectWidthForPipe", 4096);
+		husky_fb_set_number(src, "MaxSrcRectTotal", 16777216);
+		husky_fb_set_number_array(src, "MaxSrcRectHeightForPipe", 4096);
+		fb->setProperty("IOMFBMaxSrcPixels", src);
+	}
+	if (align != NULL) {
+		husky_fb_set_number(align, "PlaneBaseAlignmentLinear", 64);
+		fb->setProperty("DisplayPipePlaneBaseAlignment", align);
+	}
+	fb->setProperty("IOMFBRGBMultiPlaneSupportKey", false);
+	fb->setProperty("IOMFBYUVSupportKey", false);
+	fb->setProperty("IOMFBSupportsRotation", false);
+	OSSafeReleaseNULL(layers);
+	OSSafeReleaseNULL(src);
+	OSSafeReleaseNULL(align);
+}

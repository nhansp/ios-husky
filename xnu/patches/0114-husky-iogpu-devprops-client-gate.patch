index 07b985c..389ea66 100644
--- a/iokit/Families/IOGPU/IOGPU.cpp
+++ b/iokit/Families/IOGPU/IOGPU.cpp
@@ -18,6 +18,36 @@
 #include "IOGPUEventMachine.h"
 #include "IOGPUMemory.h"     /* needed for IOGPUTask definition; fixes REVIEWS.md:68 */
 #include <pexpert/pexpert.h>
+#include <sys/proc.h>
+
+/* boot-arg huskygpuclients=a,b: only these processes get a device (bring-up isolation). */
+static bool
+iogpu_client_allowed(void)
+{
+	static char allow[128];
+	static int parsed;
+	if (!parsed) {
+		if (!PE_parse_boot_argn("huskygpuclients", allow, sizeof(allow))) {
+			allow[0] = 0;
+		}
+		parsed = 1;
+	}
+	if (!allow[0]) {
+		return true;
+	}
+	char name[64];
+	proc_selfname(name, sizeof(name));
+	size_t n = strlen(name);
+	for (const char *p = allow; *p;) {
+		const char *end = strchr(p, ',');
+		size_t len = end ? (size_t)(end - p) : strlen(p);
+		if (len == n && !strncmp(p, name, n)) {
+			return true;
+		}
+		p += len + (end ? 1 : 0);
+	}
+	return false;
+}
 
 OSDefineMetaClassAndStructors(IOAcceleratorES, IOService);
 OSDefineMetaClassAndAbstractStructors(IOGPU, IOAcceleratorES);

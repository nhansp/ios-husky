+/* DSIM_CMD_TE_CTRL1 at fps: TIME_TE_PROTECT_ON [31:16], TIME_TE_TOUT [15:0]. */
+static uint32_t
+hd_te1(uint32_t fps)
+{
+	uint32_t protect = HD_HS_MHZ * (100 - HD_TE_MARGIN) * 100 / fps / 16;
+	uint32_t tout = HD_HS_MHZ * (100 + 2 * HD_TE_MARGIN) * 100 / fps / 16;
+
+	return protect << 16 | tout;
+}
+
+static uint32_t
+hd_dist(uint32_t a, uint32_t b)
+{
+	return a > b ? a - b : b - a;
+}
+
+/* Both halves of v are nearer to the fps timing than to the other one of 60 and 120. */
+static bool
+hd_te1_is(uint32_t v, uint32_t fps)
+{
+	uint32_t e = hd_te1(fps), o = hd_te1(fps == 60 ? 120 : 60);
+
+	for (uint32_t sh = 0; sh <= 16; sh += 16) {
+		uint32_t x = (v >> sh) & 0xFFFF;
+		if (hd_dist(x, (e >> sh) & 0xFFFF) >= hd_dist(x, (o >> sh) & 0xFFFF)) {
+			return false;
+		}
+	}
+	return true;
+}

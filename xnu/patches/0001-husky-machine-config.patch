diff --git a/pexpert/pexpert/arm64/HUSKY.h b/pexpert/pexpert/arm64/HUSKY.h
new file mode 100644
index 0000000..d0dec6a
--- /dev/null
+++ b/pexpert/pexpert/arm64/HUSKY.h
@@ -0,0 +1,25 @@
+/*
+ * husky (Google Tensor G3 / Pixel 8 Pro) board config.
+ *
+ * Tensor G3 is "VMAPPLE-class": architected GICv3, 16K pages, QARMA5 PAC,
+ * no Apple page-protection monitor, no Apple CTRR. HUSKY is therefore built
+ * at parity with VMAPPLE (it even links the KDK's closed VMAPPLE
+ * KernelSupport archive, aliased to libHUSKY since Apple ships no libHUSKY),
+ * and doconf marks soc "husky" SOC_IS_VIRTUALIZED just like "vm*".
+ *
+ * The real husky divergences are applied as later, targeted patches against
+ * this building baseline, not here:
+ *   - PAC keys programmed in the architected AP*Key_EL1 regs (validated in
+ *     the P0c on-device spike) instead of VMAPPLE's paravirt hvc to a host;
+ *   - the real MMIO / CPU topology, carried in the synthesized Apple DT.
+ * SME/AMX and the other VMAPPLE features the Tensor cores lack stay enabled
+ * in config (XNU gates them on the ID registers at runtime) so the VMAPPLE
+ * KernelSupport objects resolve.
+ */
+#ifndef _PEXPERT_ARM64_HUSKY_H
+#define _PEXPERT_ARM64_HUSKY_H
+
+#define HUSKY 1
+#include <pexpert/arm64/VMAPPLE.h>
+
+#endif /* _PEXPERT_ARM64_HUSKY_H */

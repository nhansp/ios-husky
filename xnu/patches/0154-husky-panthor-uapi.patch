+/* ---- panthor-shaped interface (husky_panthor.c) ---- */
+
+struct husky_pnt_group {
+	mali_vm_t     *vm;
+	mali_group_t  *grp;
+	uint32_t       nq;
+	mali_queue_t  *q[HUSKY_PNT_MAX_QUEUES];
+};
+
+mali_status_t
+husky_pnt_vm_create(mali_gpu_va_t kva_lo, mali_gpu_va_t kva_hi, mali_vm_t **out)
+{
+	if (kva_lo >= kva_hi || (kva_lo & (GPU_PAGE - 1)) || (kva_hi & (GPU_PAGE - 1))) {
+		return EINVAL;
+	}
+	return vm_create_window(kva_lo, kva_hi, out);
+}
+
+mali_status_t
+husky_pnt_vm_map(mali_vm_t *vm, mali_gpu_va_t va, const uint64_t *phys, uint32_t n, uint32_t flags)
+{
+	if (vm == NULL || (va & (GPU_PAGE - 1)) || n == 0 || va_managed(vm, va, 1) ||
+	    va_managed(vm, va + (uint64_t)n * GPU_PAGE - 1, 1)) {
+		return EINVAL;
+	}
+	const uint64_t leaf = bo_leaf_attrs(flags);
+	mali_status_t st = 0;
+	uint32_t i;
+	lck_mtx_lock(&g_vm_lock);
+	for (i = 0; i < n; i++) {
+		if ((phys[i] & (GPU_PAGE - 1)) || !pt_map_page(vm->root_pa, va + (uint64_t)i * GPU_PAGE, phys[i], leaf)) {
+			st = ENOMEM;
+			break;
+		}
+	}
+	husky_gpu_pt_flush();
+	if (st == 0) {
+		st = vm_flush_range(vm, va, (uint64_t)n * GPU_PAGE, AS_CMD_FLUSH_PT);
+	} else if (i != 0) {
+		pt_unmap_range(vm->root_pa, va, (uint64_t)i * GPU_PAGE);
+		husky_gpu_pt_flush();
+		(void)vm_flush_range(vm, va, (uint64_t)i * GPU_PAGE, AS_CMD_FLUSH_MEM);
+	}
+	lck_mtx_unlock(&g_vm_lock);
+	return st;
+}
+
+mali_status_t
+husky_pnt_vm_unmap(mali_vm_t *vm, mali_gpu_va_t va, uint64_t size)
+{
+	if (vm == NULL || ((va | size) & (GPU_PAGE - 1)) || size == 0) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&g_vm_lock);
+	pt_unmap_range(vm->root_pa, va, size);
+	husky_gpu_pt_flush();
+	mali_status_t st = vm_flush_range(vm, va, size, AS_CMD_FLUSH_MEM);
+	lck_mtx_unlock(&g_vm_lock);
+	return st;
+}
+
+/* g_grp_lock held; streams [0, n) of g were started. */
+static bool
+pnt_stop_streams(husky_pnt_group_t *g, uint32_t n)
+{
+	bool ok = true;
+	for (uint32_t i = 0; i < n; i++) {
+		mali_queue_t *q = g->q[i];
+		if (q == NULL) {
+			continue;
+		}
+		if (stream_set_state(q, CS_STATE_STOP)) {
+			queue_free_buffers(q);
+		} else {
+			BR_LOG("HUSKY IOGPU pnt: CSG%u CS%u did not stop; its ring stays\n", q->csg, q->cs);
+			queue_dump_state(q);
+			ok = false;
+		}
+		g->grp->busy &= ~(1u << q->cs);
+		lck_mtx_free(q->lock, &g_bridge_grp);
+		kfree_data(q, sizeof(mali_queue_t));
+		g->q[i] = NULL;
+	}
+	return ok;
+}
+
+mali_status_t
+husky_pnt_group_create(mali_vm_t *vm, const husky_group_cfg_t *cfg, uint32_t nq, const uint32_t *ring_sizes,
+    const uint8_t *priorities, husky_pnt_group_t **out)
+{
+	if (vm == NULL || cfg == NULL || nq == 0 || nq > HUSKY_PNT_MAX_QUEUES || out == NULL) {
+		return EINVAL;
+	}
+	if (husky_gpu_shared_nc == 0 || husky_gpu_gin == 0 || husky_gpu_gout == 0) {
+		return ENXIO;
+	}
+	for (uint32_t i = 0; i < nq; i++) {
+		const uint32_t r = ring_sizes[i];
+		if (r < GPU_PAGE || r > (1u << 20) || (r & (r - 1))) {
+			return EINVAL;
+		}
+	}
+	husky_pnt_group_t *g = (husky_pnt_group_t *)kalloc_data(sizeof(*g), Z_WAITOK | Z_ZERO);
+	if (g == NULL) {
+		return ENOMEM;
+	}
+	g->vm = vm;
+	lck_mtx_lock(&g_grp_lock);
+	mali_status_t st = group_create_ex(vm, cfg, &g->grp);
+	if (st == 0 && nq > g->grp->nstreams) {
+		st = EINVAL;
+	}
+	uint32_t started = 0;
+	for (uint32_t i = 0; st == 0 && i < nq; i++) {
+		mali_queue_t *q = (mali_queue_t *)kalloc_data(sizeof(mali_queue_t), Z_WAITOK | Z_ZERO);
+		lck_mtx_t *lock = lck_mtx_alloc_init(&g_bridge_grp, LCK_ATTR_NULL);
+		if (q == NULL || lock == NULL) {
+			if (q != NULL) {
+				kfree_data(q, sizeof(mali_queue_t));
+			}
+			if (lock != NULL) {
+				lck_mtx_free(lock, &g_bridge_grp);
+			}
+			st = ENOMEM;
+			break;
+		}
+		q->lock = lock;
+		q->vm = vm;
+		q->ring_size = ring_sizes[i];
+		q->refs = 1;
+		q->grp = g->grp;
+		q->csg = g->grp->csg;
+		q->cs = i;
+		g->grp->busy |= 1u << i;
+		g->q[i] = q;
+		bool leaked;
+		st = stream_start(q, priorities[i], &leaked);
+		if (leaked) {
+			g->q[i] = NULL;     /* the stream may still run: nothing of it is freed */
+			break;
+		}
+		started = i + 1;
+		if (st != 0) {
+			break;
+		}
+	}
+	g->nq = nq;
+	if (st == 0) {
+		lck_mtx_unlock(&g_grp_lock);
+		BR_LOG("HUSKY IOGPU pnt: group on CSG%u (AS%d), %u streams\n", g->grp->csg, vm->as_slot, nq);
+		*out = g;
+		return 0;
+	}
+	if (g->grp != NULL) {
+		if (pnt_stop_streams(g, started) && !__atomic_load_n(&vm->wedged, __ATOMIC_ACQUIRE)) {
+			group_destroy(vm, g->grp);
+		} else {
+			__atomic_store_n(&vm->wedged, true, __ATOMIC_RELEASE);
+		}
+	}
+	lck_mtx_unlock(&g_grp_lock);
+	kfree_data(g, sizeof(*g));
+	return st;
+}
+
+bool
+husky_pnt_group_destroy(husky_pnt_group_t *g)
+{
+	if (g == NULL) {
+		return true;
+	}
+	mali_vm_t *vm = g->vm;
+	lck_mtx_lock(&g_grp_lock);
+	bool ok = pnt_stop_streams(g, g->nq);
+	if (ok) {
+		group_destroy(vm, g->grp);
+	} else {
+		__atomic_store_n(&vm->wedged, true, __ATOMIC_RELEASE);
+	}
+	ok = ok && !__atomic_load_n(&vm->wedged, __ATOMIC_ACQUIRE);
+	lck_mtx_unlock(&g_grp_lock);
+	kfree_data(g, sizeof(*g));
+	return ok;
+}
+
+void
+husky_pnt_queue_regs(husky_pnt_group_t *g, uint32_t qi, unsigned *ra, unsigned *rv, uint32_t *waitall)
+{
+	mali_queue_t *q = g->q[qi];
+	*ra = q->ra;
+	*rv = q->rv;
+	*waitall = q->waitall;
+}
+
+mali_status_t
+husky_pnt_queue_emit(husky_pnt_group_t *g, uint32_t qi, const uint64_t *prog, unsigned n)
+{
+	if (g == NULL || qi >= g->nq || g->q[qi] == NULL) {
+		return EINVAL;
+	}
+	mali_queue_t *q = g->q[qi];
+	lck_mtx_lock(q->lock);
+	q->oom_failed = false;
+	mali_status_t st = stream_emit_locked(q, prog, n);
+	lck_mtx_unlock(q->lock);
+	return st;
+}
+
+uint32_t
+husky_pnt_group_service(husky_pnt_group_t *g)
+{
+	uint32_t seen = 0;
+	for (uint32_t i = 0; g != NULL && i < g->nq; i++) {
+		mali_queue_t *q = g->q[i];
+		if (q == NULL || q->csout == 0) {
+			continue;
+		}
+		lck_mtx_lock(q->lock);
+		queue_oom_service(q);
+		const uint32_t pending = (rd32(q->csout, CS_OUT_ACK) ^ rd32(q->csin, CS_IN_REQ)) &
+		    (HUSKY_PNT_CS_FATAL | HUSKY_PNT_CS_FAULT);
+		if (pending) {
+			BR_LOG("HUSKY IOGPU pnt: CSG%u CS%u %s%s: fault 0x%x/0x%llx fatal 0x%x/0x%llx cmd_ptr 0x%llx\n", q->csg, q->cs,
+			    (pending & HUSKY_PNT_CS_FATAL) ? "FATAL " : "", (pending & HUSKY_PNT_CS_FAULT) ? "FAULT" : "",
+			    rd32(q->csout, CS_OUT_FAULT), (unsigned long long)rd64(q->csout, CS_OUT_FAULT_INFO),
+			    rd32(q->csout, CS_OUT_FATAL), (unsigned long long)rd64(q->csout, CS_OUT_FATAL_INFO),
+			    (unsigned long long)rd64(q->csout, CS_OUT_CMD_PTR));
+			seen |= pending;
+			if (pending & HUSKY_PNT_CS_FAULT) {
+				/* the job's ERROR_BARRIER sets the error; the stream goes on with the next job [kbase cs_fault] */
+				wr32(q->csin, CS_IN_REQ, (rd32(q->csin, CS_IN_REQ) & ~HUSKY_PNT_CS_FAULT) |
+				    (rd32(q->csout, CS_OUT_ACK) & HUSKY_PNT_CS_FAULT));
+				__asm__ volatile ("dmb osh" ::: "memory");
+				const uint32_t cs_bit = 1u << q->cs;
+				lck_mtx_lock(&g_glb_lock);
+				wr32(q->csgin, CSG_IN_DB_REQ, (rd32(q->csgin, CSG_IN_DB_REQ) & ~cs_bit) |
+				    (~rd32(q->csgout, CSG_OUT_DB_ACK) & cs_bit));
+				glb_group_doorbell(q->csg);
+				lck_mtx_unlock(&g_glb_lock);
+			}
+		}
+		lck_mtx_unlock(q->lock);
+	}
+	return seen;
+}
+
+uint32_t
+husky_pnt_gpu_reg(uint32_t off)
+{
+	return husky_gpu_get_regs() != 0 ? grd(off) : 0;
+}
+
+uint32_t
+husky_pnt_csg_slots(void)
+{
+	return BRIDGE_CSG_LAST - BRIDGE_CSG_FIRST + 1;
+}
+

+/* Endpoint request of a group (CSG_EP_REQ, CSG_ALLOW_*). */
+typedef struct husky_group_cfg {
+	uint64_t compute_mask, fragment_mask, tiler_mask;
+	uint32_t max_compute, max_fragment, max_tiler;
+	uint32_t priority;              /* CSG_EP_REQ priority, 0 (low) .. 15 */
+} husky_group_cfg_t;
+
+/*
+ * The panthor-shaped interface (husky_panthor.c): a group owns several streams of one CSG, each with its own
+ * ring; the caller builds the whole ring program of a job (waits, flush, CALL, completion).
+ */
+typedef struct husky_pnt_group husky_pnt_group_t;
+
+#define HUSKY_PNT_MAX_QUEUES    8u
+#define HUSKY_PNT_CS_FATAL      (1u << 30)  /* CS_REQ/CS_ACK FATAL */
+#define HUSKY_PNT_CS_FAULT      (1u << 31)
+
+mali_status_t husky_pnt_vm_create(mali_gpu_va_t kva_lo, mali_gpu_va_t kva_hi, mali_vm_t **out);
+/* Map n 4 KiB pages at va (MALI_BO_GPU_* / MALI_BO_NONCACHEABLE / MALI_BO_GPU_CACHED in flags). */
+mali_status_t husky_pnt_vm_map(mali_vm_t *vm, mali_gpu_va_t va, const uint64_t *phys, uint32_t n, uint32_t flags);
+mali_status_t husky_pnt_vm_unmap(mali_vm_t *vm, mali_gpu_va_t va, uint64_t size);
+mali_status_t husky_pnt_group_create(mali_vm_t *vm, const husky_group_cfg_t *cfg, uint32_t nq,
+    const uint32_t *ring_sizes, const uint8_t *priorities, husky_pnt_group_t **out);
+/* False when a stream or the group did not stop: the VM is wedged and keeps its pages. */
+bool husky_pnt_group_destroy(husky_pnt_group_t *g);
+/* r92..r95 belong to the kernel's ring program (csif unpreserved_cs_reg_count 4). */
+void husky_pnt_queue_regs(husky_pnt_group_t *g, uint32_t qi, unsigned *ra, unsigned *rv, uint32_t *waitall);
+mali_status_t husky_pnt_queue_emit(husky_pnt_group_t *g, uint32_t qi, const uint64_t *prog, unsigned n);
+/* Answer tiler OOM requests and acknowledge faults; returns the FATAL/FAULT bits seen on any stream. */
+uint32_t husky_pnt_group_service(husky_pnt_group_t *g);
+uint32_t husky_pnt_gpu_reg(uint32_t off);
+uint32_t husky_pnt_csg_slots(void);

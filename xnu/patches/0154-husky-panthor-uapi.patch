+/* Write prog (n words, padded to whole 64-byte lines) to the ring and ring the stream's doorbell. q->lock held. */
+static mali_status_t
+stream_emit_locked(mali_queue_t *q, const uint64_t *prog, unsigned n)
+{
+	/* Pad to whole 64-byte line (multiple of 8 64-bit words) [husky_gpu.c:658, 938] */
+	unsigned total = (n + 7) & ~7u;
+
+	/* Words the firmware has not consumed yet must not be overwritten. */
+	unsigned us = 0;
+	while (q->ring_out_cpu != NULL && q->ring_insert + 8 * total - q->ring_out_cpu[0] > q->ring_size) {
+		if (us >= 500000) {
+			BR_LOG("HUSKY IOGPU bridge: submit: ring full for 500 ms (insert 0x%llx, extract 0x%llx)\n",
+			    (unsigned long long)q->ring_insert, (unsigned long long)q->ring_out_cpu[0]);
+			if (q->csout != 0 && q->csgout != 0) {
+				queue_dump_state(q);
+			}
+			return ETIMEDOUT;
+		}
+		queue_oom_service(q);
+		delay(10);
+		us += 10;
+	}
+
+	/* The firmware reads the ring modulo its size; a block may straddle the end [panthor_sched.c queue_run_job] */
+	if (q->ring_cpu != 0) {
+		for (unsigned i = 0; i < total; i++) {
+			uint64_t w = (i < n) ? prog[i] : 0;
+			*(volatile uint64_t *)(q->ring_cpu + (vm_offset_t)((q->ring_insert + 8 * i) % q->ring_size)) = w;
+		}
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+
+	uint64_t new_in = q->ring_insert + 8 * total;
+	if (q->ring_in_cpu != NULL) {
+		*q->ring_in_cpu = new_in;
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+

diff --git a/iokit/Families/IOGPU/husky_panthor.cpp b/iokit/Families/IOGPU/husky_panthor.cpp
new file mode 100644
index 0000000..be4ef47
--- /dev/null
+++ b/iokit/Families/IOGPU/husky_panthor.cpp
@@ -0,0 +1,1979 @@
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+/*
+ * husky_panthor.cpp - the Linux panthor DRM driver's ioctl interface over an IOKit user client, so Mesa's
+ * panvk runs with only its transport changed. Semantics follow panthor and drm_syncobj, with these
+ * differences:
+ *   - VM_BIND runs synchronously; its wait syncs are waited for on the CPU first.
+ *   - A submit's waits on fences of the same VM are SYNC_WAIT64 instructions in the ring; others are waited
+ *     for on the CPU before the job is written.
+ *   - Completion is polled (no job IRQ): a thread call samples the per-queue counters every 250 us while work
+ *     is pending and wakes waiters.
+ *   - Fences carry no error code: a job of a group that took a FATAL completes, the group reports FATAL_FAULT.
+ *   - SYNCOBJ wait timeouts are relative (see husky_panthor_uapi.h); there are no sync_file/fd exports.
+ */
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOBufferMemoryDescriptor.h>
+#include <IOKit/IOLib.h>
+#include <IOKit/IOLocks.h>
+#include <kern/thread_call.h>
+#include <kern/clock.h>
+#include <sys/errno.h>
+#include <sys/param.h>
+#include <kern/kalloc.h>
+#include <sys/systm.h>
+#include <pexpert/pexpert.h>
+
+#include "husky_mali_backend_bridge.h"
+#include "husky_panthor_drm.h"
+#include "husky_panthor.h"
+#include "../../Kernel/arm/HuskySurface.h"
+
+extern "C" void husky_dcache_flush(vm_offset_t va, size_t len);
+
+#define PNT_LOG(...)            do { printf(__VA_ARGS__); kprintf(__VA_ARGS__); } while (0)
+
+#define PNT_GPU_PAGE            0x1000ull
+#define PNT_VA_TOP              (1ull << 48)
+#define PNT_KERNEL_WINDOW       (1ull << 32)
+#define PNT_MAX_BO              (1ull << 30)
+#define PNT_MAX_ARRAY           256u
+#define PNT_MAX_SUBMITS         16u
+#define PNT_MAX_WAITS           32u
+#define PNT_POLL_NS             250000ull
+
+/* GPU_CONTROL registers [panthor_regs.h] */
+#define REG_GPU_ID              0x000u
+#define REG_L2_FEATURES         0x004u
+#define REG_CORE_FEATURES       0x008u
+#define REG_TILER_FEATURES      0x00cu
+#define REG_MEM_FEATURES        0x010u
+#define REG_MMU_FEATURES        0x014u
+#define REG_AS_PRESENT          0x018u
+#define REG_CSF_ID              0x01cu
+#define REG_GPU_FEATURES        0x060u
+#define REG_GPU_REVID           0x280u
+#define REG_TIMESTAMP           0x098u
+#define REG_THREAD_MAX_THREADS  0x0a0u
+#define REG_THREAD_MAX_WG       0x0a4u
+#define REG_THREAD_MAX_BARRIER  0x0a8u
+#define REG_THREAD_FEATURES     0x0acu
+#define REG_TEXTURE_FEATURES    0x0b0u
+#define REG_SHADER_PRESENT      0x100u
+#define REG_TILER_PRESENT       0x110u
+#define REG_L2_PRESENT          0x120u
+#define REG_COHERENCY_FEATURES  0x300u
+
+/* CS instructions (genxml v11) */
+#define CS_MOVE48(r, imm)       ((1ULL << 56) | ((uint64_t)(r) << 48) | ((uint64_t)(imm) & 0xffffffffffffULL))
+#define CS_MOVE32(r, imm)       ((2ULL << 56) | ((uint64_t)(r) << 48) | (uint32_t)(imm))
+#define CS_WAIT(mask)           ((3ULL << 56) | ((uint64_t)(mask) << 16))
+#define CS_CALL(a, l)           ((32ULL << 56) | ((uint64_t)(a) << 40) | ((uint64_t)(l) << 32))
+#define CS_FLUSH_CACHE2(r)      ((36ULL << 56) | ((uint64_t)(r) << 40) | 0x233ULL)
+#define CS_ERROR_BARRIER        (47ULL << 56)
+#define CS_SYNC_ADD64(a, v)     ((51ULL << 56) | ((uint64_t)(a) << 40) | ((uint64_t)(v) << 32) | 1ULL)
+#define CS_SYNC_WAIT64_GT(a, v) ((53ULL << 56) | ((uint64_t)(a) << 40) | ((uint64_t)(v) << 32) | (1ULL << 28))
+
+/* ---------------------------------------------------------------------------------------------------- */
+/* Fences: a value of a queue's completion counter. */
+
+struct pnt_ctr {
+	uint32_t           refs;
+	mali_bo_t         *bo;
+	volatile uint64_t *cpu;
+	uint64_t           gpu_va;
+	mali_vm_t         *vm;
+	uint64_t           seq;        /* jobs written; the group's queue lock (f->lock) */
+	bool               dead;       /* the stream stopped: what is pending never completes */
+};
+
+struct pnt_fence {
+	uint32_t  refs;
+	pnt_ctr  *ctr;                 /* NULL: signaled */
+	uint64_t  seq;
+};
+
+static pnt_fence g_signaled = { 1, NULL, 0 };
+
+static void
+ctr_put(pnt_ctr *c)
+{
+	if (c != NULL && __atomic_sub_fetch(&c->refs, 1, __ATOMIC_ACQ_REL) == 0) {
+		mali_backend_ops.bo_free(c->bo);
+		kfree_data(c, sizeof(*c));
+	}
+}
+
+static pnt_fence *
+fence_get(pnt_fence *f)
+{
+	if (f != NULL && f != &g_signaled) {
+		__atomic_add_fetch(&f->refs, 1, __ATOMIC_ACQ_REL);
+	}
+	return f;
+}
+
+static void
+fence_put(pnt_fence *f)
+{
+	if (f != NULL && f != &g_signaled && __atomic_sub_fetch(&f->refs, 1, __ATOMIC_ACQ_REL) == 0) {
+		ctr_put(f->ctr);
+		kfree_data(f, sizeof(*f));
+	}
+}
+
+static bool
+fence_done(const pnt_fence *f)
+{
+	if (f == NULL || f->ctr == NULL) {
+		return true;
+	}
+	return __atomic_load_n(&f->ctr->dead, __ATOMIC_ACQUIRE) || f->ctr->cpu[0] >= f->seq;
+}
+
+/* ---------------------------------------------------------------------------------------------------- */
+/* Syncobjs: a binary fence and a timeline of (point, fence), points <= done_hi signaled. */
+
+struct pnt_point {
+	uint64_t   point;
+	pnt_fence *f;
+};
+
+struct pnt_syncobj {
+	pnt_fence *bin;
+	pnt_point *pts;
+	uint32_t   n, cap;
+	uint64_t   done_hi;
+};
+
+static void
+so_gc(pnt_syncobj *so)
+{
+	uint32_t i = 0;
+	while (i < so->n && fence_done(so->pts[i].f)) {
+		so->done_hi = so->pts[i].point;
+		fence_put(so->pts[i].f);
+		i++;
+	}
+	if (i != 0) {
+		memmove(so->pts, so->pts + i, (so->n - i) * sizeof(pnt_point));
+		so->n -= i;
+	}
+}
+
+static int
+so_add_point(pnt_syncobj *so, uint64_t point, pnt_fence *f)
+{
+	if (so->n == so->cap) {
+		uint32_t cap = so->cap ? so->cap * 2 : 8;
+		pnt_point *p = (pnt_point *)kalloc_data(cap * sizeof(pnt_point), Z_WAITOK_ZERO);
+		if (p == NULL) {
+			return ENOMEM;
+		}
+		if (so->pts != NULL) {
+			memcpy(p, so->pts, so->n * sizeof(pnt_point));
+			kfree_data(so->pts, so->cap * sizeof(pnt_point));
+		}
+		so->pts = p;
+		so->cap = cap;
+	}
+	uint32_t i = so->n;
+	while (i > 0 && so->pts[i - 1].point >= point) {
+		i--;
+	}
+	if (i < so->n && so->pts[i].point == point) {
+		fence_put(so->pts[i].f);
+		so->pts[i].f = fence_get(f);
+		return 0;
+	}
+	memmove(so->pts + i + 1, so->pts + i, (so->n - i) * sizeof(pnt_point));
+	so->pts[i].point = point;
+	so->pts[i].f = fence_get(f);
+	so->n++;
+	return 0;
+}
+
+static void
+so_clear(pnt_syncobj *so)
+{
+	fence_put(so->bin);
+	so->bin = NULL;
+	for (uint32_t i = 0; i < so->n; i++) {
+		fence_put(so->pts[i].f);
+	}
+	so->n = 0;
+}
+
+static void
+so_free(pnt_syncobj *so)
+{
+	so_clear(so);
+	if (so->pts != NULL) {
+		kfree_data(so->pts, so->cap * sizeof(pnt_point));
+	}
+	kfree_data(so, sizeof(*so));
+}
+
+/*
+ * The fences that point (0: the binary payload) waits for. ENOENT: nothing submitted for it yet.
+ * A point waits for every earlier link too (drm dma_fence_chain).
+ */
+static int
+so_fences(pnt_syncobj *so, uint64_t point, pnt_fence **out, uint32_t max, uint32_t *n)
+{
+	*n = 0;
+	if (point == 0) {
+		if (so->bin != NULL) {
+			if (!fence_done(so->bin)) {
+				out[(*n)++] = so->bin;
+			}
+			return 0;
+		}
+		so_gc(so);
+		if (so->n == 0) {
+			return so->done_hi != 0 ? 0 : ENOENT;
+		}
+		point = so->pts[so->n - 1].point;
+	}
+	so_gc(so);
+	if (point <= so->done_hi) {
+		return 0;
+	}
+	uint32_t idx = 0;
+	while (idx < so->n && so->pts[idx].point < point) {
+		idx++;
+	}
+	if (idx == so->n) {
+		return ENOENT;
+	}
+	for (uint32_t i = 0; i <= idx; i++) {
+		pnt_fence *f = so->pts[i].f;
+		if (fence_done(f)) {
+			continue;
+		}
+		uint32_t j;
+		for (j = 0; j < *n; j++) {
+			if (out[j]->ctr == f->ctr) {
+				if (f->seq > out[j]->seq) {
+					out[j] = f;
+				}
+				break;
+			}
+		}
+		if (j == *n) {
+			if (*n == max) {
+				return E2BIG;
+			}
+			out[(*n)++] = f;
+		}
+	}
+	return 0;
+}
+
+/* The single fence a transfer copies: the link at point (or the binary payload). */
+static int
+so_fence_at(pnt_syncobj *so, uint64_t point, pnt_fence **out)
+{
+	if (point == 0 && so->bin != NULL) {
+		*out = so->bin;
+		return 0;
+	}
+	so_gc(so);
+	if (point == 0) {
+		if (so->n == 0) {
+			*out = &g_signaled;
+			return so->done_hi != 0 ? 0 : ENOENT;
+		}
+		*out = so->pts[so->n - 1].f;
+		return 0;
+	}
+	if (point <= so->done_hi) {
+		*out = &g_signaled;
+		return 0;
+	}
+	for (uint32_t i = 0; i < so->n; i++) {
+		if (so->pts[i].point >= point) {
+			*out = so->pts[i].f;
+			return 0;
+		}
+	}
+	return ENOENT;
+}
+
+/* ---------------------------------------------------------------------------------------------------- */
+/* Objects */
+
+struct pnt_bo {
+	uint32_t                  refs;
+	uint64_t                  size;
+	uint32_t                  flags;          /* DRM_PANTHOR_BO_* */
+	IOMemoryDescriptor       *md;
+	uint64_t                  md_off;         /* where the BO starts in md */
+	uint64_t                 *phys;           /* one per 4 KiB GPU page */
+	uint32_t                  npages;
+	vm_offset_t               kva;            /* kernel view for BO_SYNC */
+	IOMemoryMap              *kmap;           /* imports: their kernel view */
+	IOOptionBits              cache;          /* user mapping cache mode */
+	OSObject                 *owner;          /* imports: the surface */
+	bool                      imported;
+};
+
+struct pnt_mapping {
+	uint64_t va, size, bo_off;
+	pnt_bo  *bo;
+};
+
+struct pnt_vm {
+	uint32_t     refs;
+	mali_vm_t   *mvm;
+	uint64_t     user_end;
+	pnt_mapping *maps;
+	uint32_t     nmaps, capmaps;
+};
+
+struct pnt_group {
+	uint32_t            refs;
+	pnt_group          *next;             /* g_groups */
+	husky_pnt_group_t  *hg;
+	pnt_vm             *vm;
+	uint32_t            nq;
+	pnt_ctr            *ctr[HUSKY_PNT_MAX_QUEUES];
+	uint32_t            state;            /* DRM_PANTHOR_GROUP_STATE_* */
+	uint32_t            fatal_queues;
+	bool                destroyed;
+};
+
+struct pnt_heap {
+	mali_tiler_heap_t *h;
+	pnt_vm            *vm;
+};
+
+struct pnt_map_rec {
+	IOMemoryMap *map;
+	pnt_bo      *bo;
+	uint64_t     addr;
+};
+
+enum { T_BO, T_VM, T_GROUP, T_HEAP, T_SYNC, T_MAP, T_COUNT };
+
+struct pnt_table {
+	void   **slot;
+	uint32_t cap;
+};
+
+struct husky_pnt_file {
+	IOLock   *lock;
+	task_t    task;
+	pnt_table t[T_COUNT];
+	bool      wedged;                      /* a VM wedged: no user page goes back to the system */
+};
+
+static int
+tbl_add(pnt_table *t, void *obj, uint32_t *handle)
+{
+	for (uint32_t i = 0; i < t->cap; i++) {
+		if (t->slot[i] == NULL) {
+			t->slot[i] = obj;
+			*handle = i + 1;
+			return 0;
+		}
+	}
+	uint32_t cap = t->cap ? t->cap * 2 : 16;
+	void **s = (void **)kalloc_data(cap * sizeof(void *), Z_WAITOK_ZERO);
+	if (s == NULL) {
+		return ENOMEM;
+	}
+	if (t->slot != NULL) {
+		memcpy(s, t->slot, t->cap * sizeof(void *));
+		kfree_data(t->slot, t->cap * sizeof(void *));
+	}
+	s[t->cap] = obj;
+	*handle = t->cap + 1;
+	t->slot = s;
+	t->cap = cap;
+	return 0;
+}
+
+static void *
+tbl_get(pnt_table *t, uint32_t handle)
+{
+	return handle != 0 && handle <= t->cap ? t->slot[handle - 1] : NULL;
+}
+
+static void *
+tbl_take(pnt_table *t, uint32_t handle)
+{
+	void *o = tbl_get(t, handle);
+	if (o != NULL) {
+		t->slot[handle - 1] = NULL;
+	}
+	return o;
+}
+
+/* ---------------------------------------------------------------------------------------------------- */
+/* Completion poller */
+
+static IOLock      *g_lock;            /* g_groups, g_armed; also the waiters' sleep lock */
+static pnt_group   *g_groups;
+static thread_call_t g_poll_tc;
+static bool         g_armed;
+static int          g_event;
+
+static void
+poll_arm_locked(void)
+{
+	if (!g_armed) {
+		g_armed = true;
+		uint64_t deadline;
+		clock_interval_to_deadline(PNT_POLL_NS, kNanosecondScale, &deadline);
+		thread_call_enter_delayed(g_poll_tc, deadline);
+	}
+}
+
+static void
+pnt_poll(thread_call_param_t, thread_call_param_t)
+{
+	bool pending = false;
+	IOLockLock(g_lock);
+	for (pnt_group *g = g_groups; g != NULL; g = g->next) {
+		const uint32_t bits = husky_pnt_group_service(g->hg);
+		for (uint32_t i = 0; i < g->nq; i++) {
+			pnt_ctr *c = g->ctr[i];
+			if ((bits & HUSKY_PNT_CS_FATAL) && c->cpu[0] < c->seq) {
+				g->state |= DRM_PANTHOR_GROUP_STATE_FATAL_FAULT;
+				g->fatal_queues |= 1u << i;
+				__atomic_store_n(&c->dead, true, __ATOMIC_RELEASE);
+			}
+			if (!c->dead && c->cpu[0] < c->seq) {
+				pending = true;
+			}
+		}
+	}
+	g_armed = false;
+	if (pending) {
+		poll_arm_locked();
+	}
+	IOLockWakeup(g_lock, &g_event, false);
+	IOLockUnlock(g_lock);
+}
+
+/* Sleep until the next poll (or 1 ms, or deadline). False once deadline passed. */
+static bool
+wait_tick(uint64_t deadline)
+{
+	uint64_t now = mach_absolute_time();
+	if (now >= deadline) {
+		return false;
+	}
+	uint64_t tick;
+	clock_interval_to_deadline(1000000, kNanosecondScale, &tick);
+	IOLockLock(g_lock);
+	(void)IOLockSleepDeadline(g_lock, &g_event, tick < deadline ? tick : deadline, THREAD_ABORTSAFE);
+	IOLockUnlock(g_lock);
+	return true;
+}
+
+static uint64_t
+deadline_after(int64_t ns)
+{
+	if (ns <= 0) {
+		return 0;
+	}
+	if ((uint64_t)ns > 3600ull * NSEC_PER_SEC) {
+		return UINT64_MAX;
+	}
+	uint64_t d;
+	clock_interval_to_deadline((uint32_t)(ns / 1000), kMicrosecondScale, &d);
+	return d;
+}
+
+/* CPU wait for fences (refs held by the caller). */
+static int
+fences_wait(pnt_fence **f, uint32_t n, int64_t timeout_ns)
+{
+	const uint64_t deadline = deadline_after(timeout_ns);
+	for (;;) {
+		uint32_t i = 0;
+		while (i < n && fence_done(f[i])) {
+			i++;
+		}
+		if (i == n) {
+			return 0;
+		}
+		IOLockLock(g_lock);
+		poll_arm_locked();
+		IOLockUnlock(g_lock);
+		if (!wait_tick(deadline)) {
+			return ETIME;
+		}
+	}
+}
+
+/* ---------------------------------------------------------------------------------------------------- */
+/* BOs and VMs */
+
+static void
+bo_put(husky_pnt_file *f, pnt_bo *bo)
+{
+	if (bo == NULL || __atomic_sub_fetch(&bo->refs, 1, __ATOMIC_ACQ_REL) != 0) {
+		return;
+	}
+	if (bo->md != NULL) {
+		if (f->wedged) {
+			PNT_LOG("HUSKY panthor: BO of 0x%llx bytes kept for a wedged VM\n", bo->size);
+		} else {
+			OSSafeReleaseNULL(bo->kmap);
+			bo->md->complete();
+			bo->md->release();
+			OSSafeReleaseNULL(bo->owner);
+		}
+	}
+	if (bo->phys != NULL) {
+		kfree_data(bo->phys, bo->npages * sizeof(uint64_t));
+	}
+	kfree_data(bo, sizeof(*bo));
+}
+
+/* bo->md prepared, bo->md_off and bo->size set */
+static bool
+bo_gather_pages(pnt_bo *bo)
+{
+	bo->npages = (uint32_t)(bo->size / PNT_GPU_PAGE);
+	bo->phys = (uint64_t *)kalloc_data(bo->npages * sizeof(uint64_t), Z_WAITOK);
+	bool ok = bo->phys != NULL;
+	for (uint32_t i = 0; ok && i < bo->npages;) {
+		IOByteCount seg = 0;
+		addr64_t pa = bo->md->getPhysicalSegment(bo->md_off + (uint64_t)i * PNT_GPU_PAGE, &seg, kIOMemoryMapperNone);
+		ok = pa != 0 && !(pa & (PNT_GPU_PAGE - 1)) && seg >= PNT_GPU_PAGE;
+		for (; ok && seg >= PNT_GPU_PAGE && i < bo->npages; seg -= PNT_GPU_PAGE, pa += PNT_GPU_PAGE) {
+			bo->phys[i++] = pa;
+		}
+	}
+	return ok;
+}
+
+/*
+ * An IOSurface's pixels as a BO, from the surface's base (every plane: the caller adds the plane offset, returned
+ * in a->offset). Our replacement for panthor's dma-buf import.
+ */
+static int
+bo_import_surface(husky_pnt_file *f, struct drm_husky_bo_import_surface *a)
+{
+	HuskySurface *surf = husky_surface_copy(a->surface_id);
+	if (surf == NULL || surf->memory == NULL || a->plane >= (surf->planeCount ? surf->planeCount : 1) ||
+	    (surf->offset & (PNT_GPU_PAGE - 1))) {
+		OSSafeReleaseNULL(surf);
+		return EINVAL;
+	}
+	const uint64_t len = surf->memory->getLength() > surf->offset ? surf->memory->getLength() - surf->offset : 0;
+	pnt_bo *bo = (pnt_bo *)kalloc_data(sizeof(*bo), Z_WAITOK_ZERO);
+	if (len < PNT_GPU_PAGE || bo == NULL || surf->memory->prepare() != kIOReturnSuccess) {
+		if (bo != NULL) {
+			kfree_data(bo, sizeof(*bo));
+		}
+		surf->release();
+		return len < PNT_GPU_PAGE ? EINVAL : ENOMEM;
+	}
+	bo->refs = 1;
+	bo->md = surf->memory;
+	bo->md->retain();
+	bo->owner = surf;
+	bo->md_off = surf->offset;
+	bo->size = len & ~(PNT_GPU_PAGE - 1);
+	bo->imported = true;
+	bo->cache = surf->mapCache;
+	bo->kmap = bo->md->map();
+	bo->kva = bo->kmap != NULL ? (vm_offset_t)bo->kmap->getVirtualAddress() + (vm_offset_t)bo->md_off : 0;
+	uint32_t h = 0;
+	if (!bo_gather_pages(bo) || tbl_add(&f->t[T_BO], bo, &h) != 0) {
+		bo_put(f, bo);
+		return ENOMEM;
+	}
+	a->handle = h;
+	a->size = bo->size;
+	a->offset = a->plane < HUSKY_SURFACE_MAX_PLANES && surf->planeCount ? surf->planes[a->plane].offset : 0;
+	return 0;
+}
+
+static int
+bo_create(husky_pnt_file *f, struct drm_panthor_bo_create *a)
+{
+	if (a->size == 0 || a->size > PNT_MAX_BO || (a->flags & ~(DRM_PANTHOR_BO_NO_MMAP | DRM_PANTHOR_BO_WB_MMAP))) {
+		return EINVAL;
+	}
+	const uint64_t size = round_page_64(a->size);
+	pnt_bo *bo = (pnt_bo *)kalloc_data(sizeof(*bo), Z_WAITOK_ZERO);
+	if (bo == NULL) {
+		return ENOMEM;
+	}
+	bo->refs = 1;
+	bo->size = size;
+	bo->flags = a->flags;
+	const bool wb = (a->flags & DRM_PANTHOR_BO_WB_MMAP) != 0;
+	bo->md = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryKernelUserShared | (wb ? 0 : kIOMapWriteCombineCache), size, PAGE_SIZE);
+	if (bo->md == NULL || bo->md->prepare() != kIOReturnSuccess) {
+		OSSafeReleaseNULL(bo->md);
+		kfree_data(bo, sizeof(*bo));
+		return ENOMEM;
+	}
+	bo->kva = (vm_offset_t)((IOBufferMemoryDescriptor *)bo->md)->getBytesNoCopy();
+	bo->cache = wb ? kIOMapCopybackCache : kIOMapWriteCombineCache;
+	bzero((void *)bo->kva, size);
+	husky_dcache_flush(bo->kva, size);
+	bool ok = bo_gather_pages(bo);
+	uint32_t h = 0;
+	if (!ok || tbl_add(&f->t[T_BO], bo, &h) != 0) {
+		bo_put(f, bo);
+		return ENOMEM;
+	}
+	a->size = size;
+	a->handle = h;
+	return 0;
+}
+
+static uint32_t
+map_flags(uint32_t op_flags)
+{
+	uint32_t fl = MALI_BO_GPU_READ;
+	if (!(op_flags & DRM_PANTHOR_VM_BIND_OP_MAP_READONLY)) {
+		fl |= MALI_BO_GPU_WRITE;
+	}
+	if (!(op_flags & DRM_PANTHOR_VM_BIND_OP_MAP_NOEXEC)) {
+		fl |= MALI_BO_GPU_EXEC;
+	}
+	if (op_flags & DRM_PANTHOR_VM_BIND_OP_MAP_UNCACHED) {
+		fl |= MALI_BO_NONCACHEABLE;
+	}
+	return fl;
+}
+
+/* Remove [va, va + size) from vm's mappings, splitting the ones it cuts. */
+static int
+vm_unmap_range(husky_pnt_file *f, pnt_vm *vm, uint64_t va, uint64_t size)
+{
+	const uint64_t end = va + size;
+	for (uint32_t i = 0; i < vm->nmaps;) {
+		pnt_mapping *m = &vm->maps[i];
+		const uint64_t mend = m->va + m->size;
+		if (mend <= va || m->va >= end) {
+			i++;
+			continue;
+		}
+		const uint64_t lo = MAX(m->va, va), hi = MIN(mend, end);
+		int st = husky_pnt_vm_unmap(vm->mvm, lo, hi - lo);
+		if (st != 0) {
+			return st;
+		}
+		if (m->va < va && mend > end) {
+			/* cut in the middle: the tail becomes a new mapping */
+			if (vm->nmaps == vm->capmaps) {
+				uint32_t cap = vm->capmaps * 2;
+				pnt_mapping *n = (pnt_mapping *)kalloc_data(cap * sizeof(pnt_mapping), Z_WAITOK_ZERO);
+				if (n == NULL) {
+					return ENOMEM;
+				}
+				memcpy(n, vm->maps, vm->nmaps * sizeof(pnt_mapping));
+				kfree_data(vm->maps, vm->capmaps * sizeof(pnt_mapping));
+				vm->maps = n;
+				vm->capmaps = cap;
+				m = &vm->maps[i];
+			}
+			pnt_mapping tail;
+			tail.va = end;
+			tail.size = mend - end;
+			tail.bo_off = m->bo_off + (end - m->va);
+			tail.bo = m->bo;
+			__atomic_add_fetch(&m->bo->refs, 1, __ATOMIC_ACQ_REL);
+			m->size = va - m->va;
+			vm->maps[vm->nmaps++] = tail;
+			i++;
+		} else if (m->va < va) {
+			m->size = va - m->va;
+			i++;
+		} else if (mend > end) {
+			m->bo_off += end - m->va;
+			m->size = mend - end;
+			m->va = end;
+			i++;
+		} else {
+			bo_put(f, m->bo);
+			vm->maps[i] = vm->maps[--vm->nmaps];
+		}
+	}
+	return 0;
+}
+
+static int
+vm_map(husky_pnt_file *f, pnt_vm *vm, pnt_bo *bo, uint64_t bo_off, uint64_t va, uint64_t size, uint32_t op_flags)
+{
+	if (((va | size | bo_off) & (PNT_GPU_PAGE - 1)) || size == 0 || bo_off + size > bo->size ||
+	    va + size > vm->user_end || va + size < va) {
+		return EINVAL;
+	}
+	int st = vm_unmap_range(f, vm, va, size);
+	if (st != 0) {
+		return st;
+	}
+	if (vm->nmaps == vm->capmaps) {
+		uint32_t cap = vm->capmaps ? vm->capmaps * 2 : 32;
+		pnt_mapping *n = (pnt_mapping *)kalloc_data(cap * sizeof(pnt_mapping), Z_WAITOK_ZERO);
+		if (n == NULL) {
+			return ENOMEM;
+		}
+		if (vm->maps != NULL) {
+			memcpy(n, vm->maps, vm->nmaps * sizeof(pnt_mapping));
+			kfree_data(vm->maps, vm->capmaps * sizeof(pnt_mapping));
+		}
+		vm->maps = n;
+		vm->capmaps = cap;
+	}
+	st = husky_pnt_vm_map(vm->mvm, va, bo->phys + bo_off / PNT_GPU_PAGE, (uint32_t)(size / PNT_GPU_PAGE),
+	    map_flags(op_flags));
+	if (st != 0) {
+		return st;
+	}
+	__atomic_add_fetch(&bo->refs, 1, __ATOMIC_ACQ_REL);
+	pnt_mapping *m = &vm->maps[vm->nmaps++];
+	m->va = va;
+	m->size = size;
+	m->bo_off = bo_off;
+	m->bo = bo;
+	return 0;
+}
+
+static void
+vm_put(husky_pnt_file *f, pnt_vm *vm)
+{
+	if (vm == NULL || --vm->refs != 0) {
+		return;
+	}
+	if (mali_backend_ops.vm_is_wedged(vm->mvm)) {
+		f->wedged = true;
+	}
+	for (uint32_t i = 0; i < vm->nmaps; i++) {
+		if (!f->wedged) {
+			(void)husky_pnt_vm_unmap(vm->mvm, vm->maps[i].va, vm->maps[i].size);
+		}
+		bo_put(f, vm->maps[i].bo);
+	}
+	if (vm->maps != NULL) {
+		kfree_data(vm->maps, vm->capmaps * sizeof(pnt_mapping));
+	}
+	mali_backend_ops.vm_destroy(vm->mvm);
+	kfree_data(vm, sizeof(*vm));
+}
+
+/* ---------------------------------------------------------------------------------------------------- */
+/* Groups */
+
+static const uint32_t k_csg_priority[4] = { 4, 8, 12, 15 };
+
+static void
+group_teardown(husky_pnt_file *f, pnt_group *g)
+{
+	IOLockLock(g_lock);
+	for (pnt_group **p = &g_groups; *p != NULL; p = &(*p)->next) {
+		if (*p == g) {
+			*p = g->next;
+			break;
+		}
+	}
+	IOLockUnlock(g_lock);
+	if (!husky_pnt_group_destroy(g->hg)) {
+		f->wedged = true;
+	}
+	for (uint32_t i = 0; i < g->nq; i++) {
+		pnt_ctr *c = g->ctr[i];
+		if (c != NULL) {
+			__atomic_store_n(&c->dead, true, __ATOMIC_RELEASE);
+			ctr_put(c);
+		}
+	}
+	IOLockLock(g_lock);
+	IOLockWakeup(g_lock, &g_event, false);
+	IOLockUnlock(g_lock);
+	vm_put(f, g->vm);
+	kfree_data(g, sizeof(*g));
+}
+
+static int
+group_create(husky_pnt_file *f, struct drm_panthor_group_create *a)
+{
+	pnt_vm *vm = (pnt_vm *)tbl_get(&f->t[T_VM], a->vm_id);
+	const uint64_t present = ((uint64_t)husky_pnt_gpu_reg(REG_SHADER_PRESENT + 4) << 32) |
+	    husky_pnt_gpu_reg(REG_SHADER_PRESENT);
+	if (vm == NULL || a->queues.count == 0 || a->queues.count > HUSKY_PNT_MAX_QUEUES || a->priority > 3 ||
+	    a->max_tiler_cores != 1 || (a->compute_core_mask & ~present) || (a->fragment_core_mask & ~present) ||
+	    a->max_compute_cores > __builtin_popcountll(a->compute_core_mask) ||
+	    a->max_fragment_cores > __builtin_popcountll(a->fragment_core_mask) || !(a->tiler_core_mask & 1)) {
+		return EINVAL;
+	}
+	struct drm_panthor_queue_create qc[HUSKY_PNT_MAX_QUEUES];
+	bzero(qc, sizeof(qc));
+	const uint32_t stride = a->queues.stride;
+	for (uint32_t i = 0; i < a->queues.count; i++) {
+		if (copyin((user_addr_t)(a->queues.array + (uint64_t)i * stride), &qc[i],
+		    MIN(stride, sizeof(qc[i]))) != 0) {
+			return EFAULT;
+		}
+	}
+	uint32_t rings[HUSKY_PNT_MAX_QUEUES];
+	uint8_t prios[HUSKY_PNT_MAX_QUEUES];
+	for (uint32_t i = 0; i < a->queues.count; i++) {
+		if (qc[i].priority > 15) {
+			return EINVAL;
+		}
+		rings[i] = qc[i].ringbuf_size;
+		prios[i] = qc[i].priority;
+	}
+	pnt_group *g = (pnt_group *)kalloc_data(sizeof(*g), Z_WAITOK_ZERO);
+	if (g == NULL) {
+		return ENOMEM;
+	}
+	g->refs = 1;
+	g->nq = a->queues.count;
+	g->vm = vm;
+	int st = 0;
+	for (uint32_t i = 0; st == 0 && i < g->nq; i++) {
+		pnt_ctr *c = (pnt_ctr *)kalloc_data(sizeof(*c), Z_WAITOK_ZERO);
+		if (c == NULL) {
+			st = ENOMEM;
+			break;
+		}
+		c->refs = 1;
+		c->vm = vm->mvm;
+		st = mali_backend_ops.bo_alloc(vm->mvm, PNT_GPU_PAGE, MALI_BO_GPU_READ | MALI_BO_GPU_WRITE | MALI_BO_CPU_MAP |
+		    MALI_BO_NONCACHEABLE | MALI_BO_ZERO, 0, &c->bo);
+		if (st != 0) {
+			kfree_data(c, sizeof(*c));
+			break;
+		}
+		c->cpu = (volatile uint64_t *)mali_backend_ops.bo_cpu_map(c->bo);
+		c->gpu_va = mali_backend_ops.bo_gpu_va(c->bo);
+		g->ctr[i] = c;
+	}
+	husky_group_cfg_t cfg;
+	cfg.compute_mask = a->compute_core_mask;
+	cfg.fragment_mask = a->fragment_core_mask;
+	cfg.tiler_mask = a->tiler_core_mask;
+	cfg.max_compute = a->max_compute_cores;
+	cfg.max_fragment = a->max_fragment_cores;
+	cfg.max_tiler = a->max_tiler_cores;
+	cfg.priority = k_csg_priority[a->priority];
+	if (st == 0) {
+		st = husky_pnt_group_create(vm->mvm, &cfg, g->nq, rings, prios, &g->hg);
+	}
+	uint32_t h = 0;
+	if (st == 0) {
+		vm->refs++;
+		st = tbl_add(&f->t[T_GROUP], g, &h);
+		if (st != 0) {
+			group_teardown(f, g);
+			return st;
+		}
+		IOLockLock(g_lock);
+		g->next = g_groups;
+		g_groups = g;
+		IOLockUnlock(g_lock);
+		a->group_handle = h;
+		return 0;
+	}
+	for (uint32_t i = 0; i < g->nq; i++) {
+		ctr_put(g->ctr[i]);
+	}
+	kfree_data(g, sizeof(*g));
+	return st;
+}
+
+static void
+group_put(husky_pnt_file *f, pnt_group *g)
+{
+	if (g != NULL && --g->refs == 0) {
+		group_teardown(f, g);
+	}
+}
+
+/* ---------------------------------------------------------------------------------------------------- */
+/* Sync ops of submits and binds */
+
+struct pnt_syncs {
+	struct drm_panthor_sync_op op[PNT_MAX_ARRAY];
+	uint32_t n;
+};
+
+static int
+syncs_copyin(const struct drm_panthor_obj_array *arr, pnt_syncs *s)
+{
+	if (arr->count > PNT_MAX_ARRAY) {
+		return EINVAL;
+	}
+	bzero(s->op, sizeof(s->op[0]) * arr->count);
+	for (uint32_t i = 0; i < arr->count; i++) {
+		if (copyin((user_addr_t)(arr->array + (uint64_t)i * arr->stride), &s->op[i],
+		    MIN(arr->stride, sizeof(s->op[i]))) != 0) {
+			return EFAULT;
+		}
+		const uint32_t type = s->op[i].flags & DRM_PANTHOR_SYNC_OP_HANDLE_TYPE_MASK;
+		if (s->op[i].flags & ~(DRM_PANTHOR_SYNC_OP_HANDLE_TYPE_MASK | (uint32_t)DRM_PANTHOR_SYNC_OP_SIGNAL) ||
+		    type > DRM_PANTHOR_SYNC_OP_HANDLE_TYPE_TIMELINE_SYNCOBJ ||
+		    (type == DRM_PANTHOR_SYNC_OP_HANDLE_TYPE_TIMELINE_SYNCOBJ && s->op[i].timeline_value == 0)) {
+			return EINVAL;
+		}
+	}
+	s->n = arr->count;
+	return 0;
+}
+
+static uint64_t
+sync_point(const struct drm_panthor_sync_op *op)
+{
+	return (op->flags & DRM_PANTHOR_SYNC_OP_HANDLE_TYPE_MASK) == DRM_PANTHOR_SYNC_OP_HANDLE_TYPE_TIMELINE_SYNCOBJ ?
+	       op->timeline_value : 0;
+}
+
+/* Collect (with refs) the fences the wait ops of s stand for. f->lock held. */
+static int
+syncs_wait_fences(husky_pnt_file *f, const pnt_syncs *s, pnt_fence **out, uint32_t *n)
+{
+	*n = 0;
+	for (uint32_t i = 0; i < s->n; i++) {
+		if (s->op[i].flags & DRM_PANTHOR_SYNC_OP_SIGNAL) {
+			continue;
+		}
+		pnt_syncobj *so = (pnt_syncobj *)tbl_get(&f->t[T_SYNC], s->op[i].handle);
+		if (so == NULL) {
+			return ENOENT;
+		}
+		pnt_fence *fs[PNT_MAX_WAITS];
+		uint32_t k = 0;
+		int st = so_fences(so, sync_point(&s->op[i]), fs, PNT_MAX_WAITS, &k);
+		if (st != 0) {
+			return st == ENOENT ? EINVAL : st;
+		}
+		for (uint32_t j = 0; j < k; j++) {
+			if (*n == PNT_MAX_WAITS) {
+				return E2BIG;
+			}
+			out[(*n)++] = fence_get(fs[j]);
+		}
+	}
+	return 0;
+}
+
+static int
+syncs_check_signals(husky_pnt_file *f, const pnt_syncs *s)
+{
+	for (uint32_t i = 0; i < s->n; i++) {
+		if ((s->op[i].flags & DRM_PANTHOR_SYNC_OP_SIGNAL) && tbl_get(&f->t[T_SYNC], s->op[i].handle) == NULL) {
+			return ENOENT;
+		}
+	}
+	return 0;
+}
+
+/* f->lock held */
+static void
+syncs_signal(husky_pnt_file *f, const pnt_syncs *s, pnt_fence *fence)
+{
+	for (uint32_t i = 0; i < s->n; i++) {
+		if (!(s->op[i].flags & DRM_PANTHOR_SYNC_OP_SIGNAL)) {
+			continue;
+		}
+		pnt_syncobj *so = (pnt_syncobj *)tbl_get(&f->t[T_SYNC], s->op[i].handle);
+		if (so == NULL) {
+			continue;
+		}
+		const uint64_t p = sync_point(&s->op[i]);
+		if (p == 0) {
+			fence_put(so->bin);
+			so->bin = fence_get(fence);
+		} else {
+			(void)so_add_point(so, p, fence);
+		}
+	}
+}
+
+static void
+fences_put(pnt_fence **fs, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		fence_put(fs[i]);
+	}
+}
+
+/* ---------------------------------------------------------------------------------------------------- */
+/* ioctls. Each runs with f->lock held unless noted. */
+
+static int
+dev_query(husky_pnt_file *, struct drm_panthor_dev_query *a)
+{
+	union {
+		struct drm_panthor_gpu_info gpu;
+		struct drm_panthor_csif_info csif;
+		struct drm_panthor_timestamp_info ts;
+		struct drm_panthor_group_priorities_info prio;
+		struct drm_panthor_mmu_info mmu;
+	} u;
+	bzero(&u, sizeof(u));
+	uint32_t size;
+	switch (a->type) {
+	case DRM_PANTHOR_DEV_QUERY_GPU_INFO: {
+		size = sizeof(u.gpu);
+		u.gpu.gpu_id = husky_pnt_gpu_reg(REG_GPU_ID);
+		u.gpu.gpu_rev = husky_pnt_gpu_reg(REG_GPU_REVID);
+		u.gpu.csf_id = husky_pnt_gpu_reg(REG_CSF_ID);
+		u.gpu.l2_features = husky_pnt_gpu_reg(REG_L2_FEATURES);
+		u.gpu.tiler_features = husky_pnt_gpu_reg(REG_TILER_FEATURES);
+		u.gpu.mem_features = husky_pnt_gpu_reg(REG_MEM_FEATURES);
+		u.gpu.mmu_features = husky_pnt_gpu_reg(REG_MMU_FEATURES);
+		u.gpu.thread_features = husky_pnt_gpu_reg(REG_THREAD_FEATURES);
+		u.gpu.max_threads = husky_pnt_gpu_reg(REG_THREAD_MAX_THREADS);
+		u.gpu.thread_max_workgroup_size = husky_pnt_gpu_reg(REG_THREAD_MAX_WG);
+		u.gpu.thread_max_barrier_size = husky_pnt_gpu_reg(REG_THREAD_MAX_BARRIER);
+		u.gpu.coherency_features = husky_pnt_gpu_reg(REG_COHERENCY_FEATURES);
+		for (uint32_t i = 0; i < 4; i++) {
+			u.gpu.texture_features[i] = husky_pnt_gpu_reg(REG_TEXTURE_FEATURES + 4 * i);
+		}
+		u.gpu.as_present = husky_pnt_gpu_reg(REG_AS_PRESENT);
+		u.gpu.selected_coherency = DRM_PANTHOR_GPU_COHERENCY_NONE;
+		u.gpu.shader_present = ((uint64_t)husky_pnt_gpu_reg(REG_SHADER_PRESENT + 4) << 32) |
+		    husky_pnt_gpu_reg(REG_SHADER_PRESENT);
+		u.gpu.l2_present = ((uint64_t)husky_pnt_gpu_reg(REG_L2_PRESENT + 4) << 32) | husky_pnt_gpu_reg(REG_L2_PRESENT);
+		u.gpu.tiler_present = ((uint64_t)husky_pnt_gpu_reg(REG_TILER_PRESENT + 4) << 32) |
+		    husky_pnt_gpu_reg(REG_TILER_PRESENT);
+		u.gpu.core_features = husky_pnt_gpu_reg(REG_CORE_FEATURES);
+		u.gpu.gpu_features = ((uint64_t)husky_pnt_gpu_reg(REG_GPU_FEATURES + 4) << 32) |
+		    husky_pnt_gpu_reg(REG_GPU_FEATURES);
+		break;
+	}
+	case DRM_PANTHOR_DEV_QUERY_CSIF_INFO: {
+		size = sizeof(u.csif);
+		u.csif.csg_slot_count = husky_pnt_csg_slots();
+		u.csif.cs_slot_count = HUSKY_PNT_MAX_QUEUES;
+		u.csif.cs_reg_count = 96;
+		u.csif.scoreboard_slot_count = 16;
+		u.csif.unpreserved_cs_reg_count = 4;
+		break;
+	}
+	case DRM_PANTHOR_DEV_QUERY_TIMESTAMP_INFO: {
+		size = sizeof(u.ts);
+		uint32_t hi, lo;
+		do {
+			hi = husky_pnt_gpu_reg(REG_TIMESTAMP + 4);
+			lo = husky_pnt_gpu_reg(REG_TIMESTAMP);
+		} while (husky_pnt_gpu_reg(REG_TIMESTAMP + 4) != hi);
+		u.ts.timestamp_frequency = gPEClockFrequencyInfo.timebase_frequency_hz;
+		u.ts.current_timestamp = ((uint64_t)hi << 32) | lo;
+		u.ts.timestamp_offset = 0;
+		u.ts.cycle_count = husky_gpu_cycles();
+		break;
+	}
+	case DRM_PANTHOR_DEV_QUERY_GROUP_PRIORITIES_INFO:
+		size = sizeof(u.prio);
+		u.prio.allowed_mask = (1u << PANTHOR_GROUP_PRIORITY_LOW) | (1u << PANTHOR_GROUP_PRIORITY_MEDIUM) |
+		    (1u << PANTHOR_GROUP_PRIORITY_HIGH);
+		break;
+	case DRM_PANTHOR_DEV_QUERY_MMU_INFO:
+		size = sizeof(u.mmu);
+		u.mmu.page_size_bitmap = PNT_GPU_PAGE;
+		break;
+	default:
+		return EINVAL;
+	}
+	if (a->pointer == 0) {
+		a->size = size;
+		return 0;
+	}
+	return copyout(&u, (user_addr_t)a->pointer, MIN(a->size, size)) != 0 ? EFAULT : 0;
+}
+
+static int
+vm_create(husky_pnt_file *f, struct drm_panthor_vm_create *a)
+{
+	if (a->flags != 0) {
+		return EINVAL;
+	}
+	uint64_t user = a->user_va_range ? a->user_va_range : PNT_VA_TOP / 2;
+	user = (user + PNT_KERNEL_WINDOW - 1) & ~(PNT_KERNEL_WINDOW - 1);
+	if (user + PNT_KERNEL_WINDOW > PNT_VA_TOP) {
+		return EINVAL;
+	}
+	pnt_vm *vm = (pnt_vm *)kalloc_data(sizeof(*vm), Z_WAITOK_ZERO);
+	if (vm == NULL) {
+		return ENOMEM;
+	}
+	vm->refs = 1;
+	vm->user_end = user;
+	int st = husky_pnt_vm_create(user, user + PNT_KERNEL_WINDOW, &vm->mvm);
+	uint32_t h = 0;
+	if (st == 0 && (st = tbl_add(&f->t[T_VM], vm, &h)) != 0) {
+		mali_backend_ops.vm_destroy(vm->mvm);
+	}
+	if (st != 0) {
+		kfree_data(vm, sizeof(*vm));
+		return st;
+	}
+	a->id = h;
+	a->user_va_range = user;
+	return 0;
+}
+
+static int
+vm_bind(husky_pnt_file *f, struct drm_panthor_vm_bind *a)
+{
+	pnt_vm *vm = (pnt_vm *)tbl_get(&f->t[T_VM], a->vm_id);
+	if (vm == NULL || a->ops.count > PNT_MAX_ARRAY || (a->flags & ~DRM_PANTHOR_VM_BIND_ASYNC)) {
+		return EINVAL;
+	}
+	pnt_syncs *s = (pnt_syncs *)kalloc_data(sizeof(*s), Z_WAITOK);
+	if (s == NULL) {
+		return ENOMEM;
+	}
+	int st = 0;
+	for (uint32_t i = 0; st == 0 && i < a->ops.count; i++) {
+		struct drm_panthor_vm_bind_op op;
+		bzero(&op, sizeof(op));
+		if (copyin((user_addr_t)(a->ops.array + (uint64_t)i * a->ops.stride), &op, MIN(a->ops.stride, sizeof(op))) != 0) {
+			st = EFAULT;
+			break;
+		}
+		if ((st = syncs_copyin(&op.syncs, s)) != 0 || (st = syncs_check_signals(f, s)) != 0) {
+			break;
+		}
+		if (!(a->flags & DRM_PANTHOR_VM_BIND_ASYNC) && s->n != 0) {
+			st = EINVAL;
+			break;
+		}
+		pnt_fence *w[PNT_MAX_WAITS];
+		uint32_t nw = 0;
+		if ((st = syncs_wait_fences(f, s, w, &nw)) != 0) {
+			fences_put(w, nw);
+			break;
+		}
+		if (nw != 0) {
+			IOLockUnlock(f->lock);
+			st = fences_wait(w, nw, 10ll * NSEC_PER_SEC);
+			IOLockLock(f->lock);
+			fences_put(w, nw);
+			if (st != 0 || (vm = (pnt_vm *)tbl_get(&f->t[T_VM], a->vm_id)) == NULL) {
+				st = st ? st : ENOENT;
+				break;
+			}
+		}
+		switch (op.flags & DRM_PANTHOR_VM_BIND_OP_TYPE_MASK) {
+		case DRM_PANTHOR_VM_BIND_OP_TYPE_MAP: {
+			pnt_bo *bo = (pnt_bo *)tbl_get(&f->t[T_BO], op.bo_handle);
+			if (bo == NULL || (op.flags & DRM_PANTHOR_VM_BIND_OP_MAP_SPARSE) ||
+			    (op.flags & ~(DRM_PANTHOR_VM_BIND_OP_TYPE_MASK | DRM_PANTHOR_VM_BIND_OP_MAP_READONLY |
+			    DRM_PANTHOR_VM_BIND_OP_MAP_NOEXEC | DRM_PANTHOR_VM_BIND_OP_MAP_UNCACHED))) {
+				st = EINVAL;
+				break;
+			}
+			st = vm_map(f, vm, bo, op.bo_offset, op.va, op.size, op.flags);
+			break;
+		}
+		case DRM_PANTHOR_VM_BIND_OP_TYPE_UNMAP:
+			st = ((op.va | op.size) & (PNT_GPU_PAGE - 1)) || op.size == 0 || op.va + op.size > vm->user_end ? EINVAL :
+			    vm_unmap_range(f, vm, op.va, op.size);
+			break;
+		case DRM_PANTHOR_VM_BIND_OP_TYPE_SYNC_ONLY:
+			break;
+		default:
+			st = EINVAL;
+			break;
+		}
+		if (st == 0) {
+			syncs_signal(f, s, &g_signaled);
+		}
+	}
+	kfree_data(s, sizeof(*s));
+	return st;
+}
+
+static int
+group_submit(husky_pnt_file *f, struct drm_panthor_group_submit *a)
+{
+	pnt_group *g = (pnt_group *)tbl_get(&f->t[T_GROUP], a->group_handle);
+	if (g == NULL || a->queue_submits.count > PNT_MAX_SUBMITS) {
+		return EINVAL;
+	}
+	if (g->state & DRM_PANTHOR_GROUP_STATE_FATAL_FAULT) {
+		return ECANCELED;
+	}
+	const uint32_t n = a->queue_submits.count;
+	struct drm_panthor_queue_submit qs[PNT_MAX_SUBMITS];
+	bzero(qs, sizeof(qs));
+	pnt_syncs *s = (pnt_syncs *)kalloc_data(sizeof(pnt_syncs) * PNT_MAX_SUBMITS, Z_WAITOK);
+	pnt_fence **w = (pnt_fence **)kalloc_data(sizeof(pnt_fence *) * PNT_MAX_WAITS * PNT_MAX_SUBMITS, Z_WAITOK);
+	uint32_t nw[PNT_MAX_SUBMITS];
+	bzero(nw, sizeof(nw));
+	int st = (s != NULL && w != NULL) ? 0 : ENOMEM;
+	for (uint32_t i = 0; st == 0 && i < n; i++) {
+		if (copyin((user_addr_t)(a->queue_submits.array + (uint64_t)i * a->queue_submits.stride), &qs[i],
+		    MIN(a->queue_submits.stride, sizeof(qs[i]))) != 0) {
+			st = EFAULT;
+		} else if (qs[i].queue_index >= g->nq || (qs[i].stream_size & 7) || (qs[i].stream_addr & 63) ||
+		    (qs[i].stream_size != 0 && qs[i].stream_addr == 0)) {
+			st = EINVAL;
+		} else if ((st = syncs_copyin(&qs[i].syncs, &s[i])) == 0 && (st = syncs_check_signals(f, &s[i])) == 0) {
+			st = syncs_wait_fences(f, &s[i], &w[i * PNT_MAX_WAITS], &nw[i]);
+		}
+	}
+
+	/* waits the ring cannot express (another VM's counters) are taken on the CPU */
+	pnt_fence *cpu_w[PNT_MAX_WAITS];
+	uint32_t ncpu = 0;
+	for (uint32_t i = 0; st == 0 && i < n; i++) {
+		for (uint32_t j = 0; j < nw[i]; j++) {
+			pnt_fence *fe = w[i * PNT_MAX_WAITS + j];
+			if (fe->ctr != NULL && fe->ctr->vm != g->vm->mvm && ncpu < PNT_MAX_WAITS) {
+				cpu_w[ncpu++] = fe;
+			}
+		}
+	}
+	if (st == 0 && ncpu != 0) {
+		g->refs++;
+		IOLockUnlock(f->lock);
+		st = fences_wait(cpu_w, ncpu, 10ll * NSEC_PER_SEC);
+		IOLockLock(f->lock);
+		if (g->destroyed) {
+			st = ENOENT;
+		}
+		group_put(f, g);
+	}
+
+	for (uint32_t i = 0; st == 0 && i < n; i++) {
+		const uint32_t qi = qs[i].queue_index;
+		pnt_ctr *c = g->ctr[qi];
+		unsigned ra, rv;
+		uint32_t waitall;
+		husky_pnt_queue_regs(g->hg, qi, &ra, &rv, &waitall);
+		uint64_t prog[16 + 3 * PNT_MAX_WAITS];
+		unsigned k = 0;
+		for (uint32_t j = 0; j < nw[i]; j++) {
+			pnt_fence *fe = w[i * PNT_MAX_WAITS + j];
+			if (fe->ctr != NULL && fe->ctr->vm == g->vm->mvm && !fence_done(fe)) {
+				prog[k++] = CS_MOVE48(ra, fe->ctr->gpu_va);
+				prog[k++] = CS_MOVE48(rv, fe->seq - 1);
+				prog[k++] = CS_SYNC_WAIT64_GT(ra, rv);
+			}
+		}
+		prog[k++] = CS_MOVE32(rv, qs[i].latest_flush);
+		prog[k++] = CS_FLUSH_CACHE2(rv);
+		prog[k++] = CS_WAIT(waitall);
+		if (qs[i].stream_size != 0) {
+			prog[k++] = CS_MOVE48(ra, qs[i].stream_addr);
+			prog[k++] = CS_MOVE32(rv, qs[i].stream_size);
+			prog[k++] = CS_CALL(ra, rv);
+			prog[k++] = CS_WAIT(waitall);
+			prog[k++] = CS_MOVE32(rv, 0);
+			prog[k++] = CS_FLUSH_CACHE2(rv);
+			prog[k++] = CS_WAIT(waitall);
+		}
+		prog[k++] = CS_MOVE48(ra, c->gpu_va);
+		prog[k++] = CS_MOVE48(rv, 1);
+		prog[k++] = CS_SYNC_ADD64(ra, rv);
+		prog[k++] = CS_ERROR_BARRIER;
+		pnt_fence *fe = (pnt_fence *)kalloc_data(sizeof(*fe), Z_WAITOK_ZERO);
+		if (fe == NULL) {
+			st = ENOMEM;
+			break;
+		}
+		st = husky_pnt_queue_emit(g->hg, qi, prog, k);
+		if (st != 0) {
+			kfree_data(fe, sizeof(*fe));
+			break;
+		}
+		c->seq++;
+		fe->refs = 1;
+		fe->seq = c->seq;
+		fe->ctr = c;
+		__atomic_add_fetch(&c->refs, 1, __ATOMIC_ACQ_REL);
+		syncs_signal(f, &s[i], fe);
+		fence_put(fe);
+	}
+	if (st == 0 && n != 0) {
+		IOLockLock(g_lock);
+		poll_arm_locked();
+		IOLockUnlock(g_lock);
+	}
+	for (uint32_t i = 0; i < n; i++) {
+		fences_put(&w[i * PNT_MAX_WAITS], nw[i]);
+	}
+	if (s != NULL) {
+		kfree_data(s, sizeof(pnt_syncs) * PNT_MAX_SUBMITS);
+	}
+	if (w != NULL) {
+		kfree_data(w, sizeof(pnt_fence *) * PNT_MAX_WAITS * PNT_MAX_SUBMITS);
+	}
+	return st;
+}
+
+static int
+heap_create(husky_pnt_file *f, struct drm_panthor_tiler_heap_create *a)
+{
+	pnt_vm *vm = (pnt_vm *)tbl_get(&f->t[T_VM], a->vm_id);
+	if (vm == NULL) {
+		return EINVAL;
+	}
+	pnt_heap *h = (pnt_heap *)kalloc_data(sizeof(*h), Z_WAITOK_ZERO);
+	if (h == NULL) {
+		return ENOMEM;
+	}
+	mali_gpu_va_t ctx = 0, first = 0;
+	int st = mali_backend_ops.tiler_heap_create(vm->mvm, a->chunk_size, a->initial_chunk_count, a->max_chunks, &h->h,
+	    &ctx, &first);
+	uint32_t handle = 0;
+	if (st == 0 && (st = tbl_add(&f->t[T_HEAP], h, &handle)) != 0) {
+		mali_backend_ops.tiler_heap_destroy(h->h);
+	}
+	if (st != 0) {
+		kfree_data(h, sizeof(*h));
+		return st;
+	}
+	h->vm = vm;
+	vm->refs++;
+	a->handle = handle;
+	a->tiler_heap_ctx_gpu_va = ctx;
+	a->first_heap_chunk_gpu_va = first;
+	return 0;
+}
+
+static void
+heap_free(husky_pnt_file *f, pnt_heap *h)
+{
+	mali_backend_ops.tiler_heap_destroy(h->h);
+	vm_put(f, h->vm);
+	kfree_data(h, sizeof(*h));
+}
+
+static int
+bo_sync(husky_pnt_file *f, struct drm_panthor_bo_sync *a)
+{
+	if (a->ops.count > PNT_MAX_ARRAY) {
+		return EINVAL;
+	}
+	for (uint32_t i = 0; i < a->ops.count; i++) {
+		struct drm_panthor_bo_sync_op op;
+		bzero(&op, sizeof(op));
+		if (copyin((user_addr_t)(a->ops.array + (uint64_t)i * a->ops.stride), &op, MIN(a->ops.stride, sizeof(op))) != 0) {
+			return EFAULT;
+		}
+		pnt_bo *bo = (pnt_bo *)tbl_get(&f->t[T_BO], op.handle);
+		if (bo == NULL || op.type > DRM_PANTHOR_BO_SYNC_CPU_CACHE_FLUSH_AND_INVALIDATE || op.offset + op.size > bo->size ||
+		    op.offset + op.size < op.offset) {
+			return EINVAL;
+		}
+		/* DC CIVAC: clean and invalidate either way */
+		if (bo->kva != 0) {
+			husky_dcache_flush(bo->kva + (vm_offset_t)op.offset, (size_t)op.size);
+		}
+	}
+	return 0;
+}
+
+static pnt_syncobj *
+so_lookup(husky_pnt_file *f, uint32_t h)
+{
+	return (pnt_syncobj *)tbl_get(&f->t[T_SYNC], h);
+}
+
+static int
+syncobj_create(husky_pnt_file *f, struct drm_syncobj_create *a)
+{
+	if (a->flags & ~DRM_SYNCOBJ_CREATE_SIGNALED) {
+		return EINVAL;
+	}
+	pnt_syncobj *so = (pnt_syncobj *)kalloc_data(sizeof(*so), Z_WAITOK_ZERO);
+	if (so == NULL) {
+		return ENOMEM;
+	}
+	if (a->flags & DRM_SYNCOBJ_CREATE_SIGNALED) {
+		so->bin = &g_signaled;
+	}
+	uint32_t h = 0;
+	int st = tbl_add(&f->t[T_SYNC], so, &h);
+	if (st != 0) {
+		kfree_data(so, sizeof(*so));
+		return st;
+	}
+	a->handle = h;
+	return 0;
+}
+
+static int
+copyin_u32s(uint64_t ptr, uint32_t n, uint32_t *out)
+{
+	return n > PNT_MAX_ARRAY ? EINVAL : (copyin((user_addr_t)ptr, out, n * sizeof(uint32_t)) != 0 ? EFAULT : 0);
+}
+
+static int
+copyin_u64s(uint64_t ptr, uint32_t n, uint64_t *out)
+{
+	return n > PNT_MAX_ARRAY ? EINVAL : (copyin((user_addr_t)ptr, out, n * sizeof(uint64_t)) != 0 ? EFAULT : 0);
+}
+
+/*
+ * SYNCOBJ_WAIT / TIMELINE_WAIT, with f->lock held on entry and exit; dropped while sleeping.
+ * points == NULL: binary waits.
+ */
+static int
+syncobj_wait(husky_pnt_file *f, uint64_t handles_ptr, uint64_t points_ptr, uint32_t count, uint32_t flags,
+    int64_t timeout_ns, uint32_t *first)
+{
+	if (count == 0 || count > PNT_MAX_ARRAY ||
+	    (flags & ~(DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL | DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT |
+	    DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE | DRM_SYNCOBJ_WAIT_FLAGS_WAIT_DEADLINE))) {
+		return EINVAL;
+	}
+	uint32_t *h = (uint32_t *)kalloc_data(count * sizeof(uint32_t), Z_WAITOK);
+	uint64_t *p = (uint64_t *)kalloc_data(count * sizeof(uint64_t), Z_WAITOK_ZERO);
+	int st = (h != NULL && p != NULL) ? copyin_u32s(handles_ptr, count, h) : ENOMEM;
+	if (st == 0 && points_ptr != 0) {
+		st = copyin_u64s(points_ptr, count, p);
+	}
+	const bool all = flags & DRM_SYNCOBJ_WAIT_FLAGS_WAIT_ALL;
+	const bool for_submit = flags & (DRM_SYNCOBJ_WAIT_FLAGS_WAIT_FOR_SUBMIT | DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE);
+	const bool available = flags & DRM_SYNCOBJ_WAIT_FLAGS_WAIT_AVAILABLE;
+	const uint64_t deadline = deadline_after(timeout_ns);
+	while (st == 0) {
+		uint32_t done = 0, firstdone = UINT32_MAX;
+		for (uint32_t i = 0; st == 0 && i < count; i++) {
+			pnt_syncobj *so = so_lookup(f, h[i]);
+			if (so == NULL) {
+				st = ENOENT;
+				break;
+			}
+			pnt_fence *fs[PNT_MAX_WAITS];
+			uint32_t k = 0;
+			int r = so_fences(so, p[i], fs, PNT_MAX_WAITS, &k);
+			if (r == ENOENT) {
+				if (!for_submit) {
+					st = EINVAL;
+				}
+				continue;
+			}
+			if (r != 0) {
+				st = r;
+				break;
+			}
+			if (k == 0 || available) {
+				done++;
+				if (firstdone == UINT32_MAX) {
+					firstdone = i;
+				}
+			}
+		}
+		if (st != 0) {
+			break;
+		}
+		if (all ? done == count : done != 0) {
+			*first = firstdone;
+			break;
+		}
+		IOLockUnlock(f->lock);
+		IOLockLock(g_lock);
+		poll_arm_locked();
+		IOLockUnlock(g_lock);
+		const bool more = wait_tick(deadline);
+		IOLockLock(f->lock);
+		if (!more) {
+			st = ETIME;
+		}
+	}
+	if (h != NULL) {
+		kfree_data(h, count * sizeof(uint32_t));
+	}
+	if (p != NULL) {
+		kfree_data(p, count * sizeof(uint64_t));
+	}
+	return st;
+}
+
+static int
+syncobj_array_op(husky_pnt_file *f, uint64_t handles_ptr, uint64_t points_ptr, uint32_t count, bool signal,
+    uint32_t query_flags, bool query)
+{
+	if (count == 0 || count > PNT_MAX_ARRAY) {
+		return EINVAL;
+	}
+	uint32_t *h = (uint32_t *)kalloc_data(count * sizeof(uint32_t), Z_WAITOK);
+	uint64_t *p = (uint64_t *)kalloc_data(count * sizeof(uint64_t), Z_WAITOK_ZERO);
+	int st = (h != NULL && p != NULL) ? copyin_u32s(handles_ptr, count, h) : ENOMEM;
+	if (st == 0 && points_ptr != 0 && !query) {
+		st = copyin_u64s(points_ptr, count, p);
+	}
+	for (uint32_t i = 0; st == 0 && i < count; i++) {
+		if (so_lookup(f, h[i]) == NULL) {
+			st = ENOENT;
+		}
+	}
+	for (uint32_t i = 0; st == 0 && i < count; i++) {
+		pnt_syncobj *so = so_lookup(f, h[i]);
+		if (query) {
+			so_gc(so);
+			p[i] = (query_flags & DRM_SYNCOBJ_QUERY_FLAGS_LAST_SUBMITTED) && so->n != 0 ? so->pts[so->n - 1].point :
+			    so->done_hi;
+		} else if (!signal) {
+			so_clear(so);
+		} else if (p[i] == 0) {
+			fence_put(so->bin);
+			so->bin = &g_signaled;
+		} else {
+			st = so_add_point(so, p[i], &g_signaled);
+		}
+	}
+	if (st == 0 && query && copyout(p, (user_addr_t)points_ptr, count * sizeof(uint64_t)) != 0) {
+		st = EFAULT;
+	}
+	if (h != NULL) {
+		kfree_data(h, count * sizeof(uint32_t));
+	}
+	if (p != NULL) {
+		kfree_data(p, count * sizeof(uint64_t));
+	}
+	if (signal || query) {
+		IOLockLock(g_lock);
+		IOLockWakeup(g_lock, &g_event, false);
+		IOLockUnlock(g_lock);
+	}
+	return st;
+}
+
+static int
+syncobj_transfer(husky_pnt_file *f, struct drm_syncobj_transfer *a)
+{
+	pnt_syncobj *src = so_lookup(f, a->src_handle), *dst = so_lookup(f, a->dst_handle);
+	if (src == NULL || dst == NULL || a->flags != 0) {
+		return src == NULL || dst == NULL ? ENOENT : EINVAL;
+	}
+	pnt_fence *fe = NULL;
+	int st = so_fence_at(src, a->src_point, &fe);
+	if (st != 0) {
+		return EINVAL;
+	}
+	if (a->dst_point == 0) {
+		pnt_fence *old = dst->bin;
+		dst->bin = fence_get(fe);
+		fence_put(old);
+		return 0;
+	}
+	return so_add_point(dst, a->dst_point, fe);
+}
+
+/* ---------------------------------------------------------------------------------------------------- */
+
+static void
+file_init_globals(void)
+{
+	static bool inited;
+	if (!inited) {
+		inited = true;
+		g_lock = IOLockAlloc();
+		g_poll_tc = thread_call_allocate_with_options(pnt_poll, NULL, THREAD_CALL_PRIORITY_KERNEL_HIGH, 0);
+	}
+}
+
+husky_pnt_file *
+husky_pnt_open(task_t task)
+{
+	file_init_globals();
+	husky_pnt_file *f = (husky_pnt_file *)kalloc_data(sizeof(*f), Z_WAITOK_ZERO);
+	if (f == NULL) {
+		return NULL;
+	}
+	f->lock = IOLockAlloc();
+	f->task = task;
+	if (f->lock == NULL) {
+		kfree_data(f, sizeof(*f));
+		return NULL;
+	}
+	return f;
+}
+
+void
+husky_pnt_close(husky_pnt_file *f)
+{
+	if (f == NULL) {
+		return;
+	}
+	IOLockLock(f->lock);
+	pnt_table *t = f->t;
+	for (uint32_t i = 0; i < t[T_MAP].cap; i++) {
+		pnt_map_rec *m = (pnt_map_rec *)t[T_MAP].slot[i];
+		if (m != NULL) {
+			m->map->release();
+			bo_put(f, m->bo);
+			kfree_data(m, sizeof(*m));
+		}
+	}
+	for (uint32_t i = 0; i < t[T_GROUP].cap; i++) {
+		pnt_group *g = (pnt_group *)t[T_GROUP].slot[i];
+		if (g != NULL) {
+			g->destroyed = true;
+			group_put(f, g);
+		}
+	}
+	for (uint32_t i = 0; i < t[T_HEAP].cap; i++) {
+		if (t[T_HEAP].slot[i] != NULL) {
+			heap_free(f, (pnt_heap *)t[T_HEAP].slot[i]);
+		}
+	}
+	for (uint32_t i = 0; i < t[T_SYNC].cap; i++) {
+		if (t[T_SYNC].slot[i] != NULL) {
+			so_free((pnt_syncobj *)t[T_SYNC].slot[i]);
+		}
+	}
+	for (uint32_t i = 0; i < t[T_VM].cap; i++) {
+		if (t[T_VM].slot[i] != NULL) {
+			vm_put(f, (pnt_vm *)t[T_VM].slot[i]);
+		}
+	}
+	for (uint32_t i = 0; i < t[T_BO].cap; i++) {
+		if (t[T_BO].slot[i] != NULL) {
+			bo_put(f, (pnt_bo *)t[T_BO].slot[i]);
+		}
+	}
+	for (uint32_t i = 0; i < T_COUNT; i++) {
+		if (t[i].slot != NULL) {
+			kfree_data(t[i].slot, t[i].cap * sizeof(void *));
+		}
+	}
+	IOLockUnlock(f->lock);
+	IOLockFree(f->lock);
+	kfree_data(f, sizeof(*f));
+}
+
+/* One request; args is the in/out argument struct of size len. Returns an errno. */
+int
+husky_pnt_ioctl(husky_pnt_file *f, uint32_t request, void *args, uint32_t len)
+{
+	const uint32_t nr = request & 0xff;
+	uint32_t need;
+	switch (nr) {
+	case DRM_IOCTL_PANTHOR_DEV_QUERY:          need = sizeof(struct drm_panthor_dev_query); break;
+	case DRM_IOCTL_PANTHOR_VM_CREATE:          need = sizeof(struct drm_panthor_vm_create); break;
+	case DRM_IOCTL_PANTHOR_VM_DESTROY:         need = sizeof(struct drm_panthor_vm_destroy); break;
+	case DRM_IOCTL_PANTHOR_VM_BIND:            need = sizeof(struct drm_panthor_vm_bind); break;
+	case DRM_IOCTL_PANTHOR_VM_GET_STATE:       need = sizeof(struct drm_panthor_vm_get_state); break;
+	case DRM_IOCTL_PANTHOR_BO_CREATE:          need = sizeof(struct drm_panthor_bo_create); break;
+	case DRM_IOCTL_PANTHOR_BO_MMAP_OFFSET:     need = sizeof(struct drm_panthor_bo_mmap_offset); break;
+	case DRM_IOCTL_PANTHOR_GROUP_CREATE:       need = sizeof(struct drm_panthor_group_create); break;
+	case DRM_IOCTL_PANTHOR_GROUP_DESTROY:      need = sizeof(struct drm_panthor_group_destroy); break;
+	case DRM_IOCTL_PANTHOR_GROUP_SUBMIT:       need = sizeof(struct drm_panthor_group_submit); break;
+	case DRM_IOCTL_PANTHOR_GROUP_GET_STATE:    need = sizeof(struct drm_panthor_group_get_state); break;
+	case DRM_IOCTL_PANTHOR_TILER_HEAP_CREATE:  need = sizeof(struct drm_panthor_tiler_heap_create); break;
+	case DRM_IOCTL_PANTHOR_TILER_HEAP_DESTROY: need = sizeof(struct drm_panthor_tiler_heap_destroy); break;
+	case DRM_IOCTL_PANTHOR_BO_SET_LABEL:       need = sizeof(struct drm_panthor_bo_set_label); break;
+	case DRM_IOCTL_PANTHOR_SET_USER_MMIO_OFFSET: need = sizeof(struct drm_panthor_set_user_mmio_offset); break;
+	case DRM_IOCTL_PANTHOR_BO_SYNC:            need = sizeof(struct drm_panthor_bo_sync); break;
+	case DRM_IOCTL_PANTHOR_BO_QUERY_INFO:      need = sizeof(struct drm_panthor_bo_query_info); break;
+	case DRM_IOCTL_GEM_CLOSE:                  need = sizeof(struct drm_gem_close); break;
+	case DRM_IOCTL_SYNCOBJ_CREATE:             need = sizeof(struct drm_syncobj_create); break;
+	case DRM_IOCTL_SYNCOBJ_DESTROY:            need = sizeof(struct drm_syncobj_destroy); break;
+	case DRM_IOCTL_SYNCOBJ_WAIT:               need = sizeof(struct drm_syncobj_wait); break;
+	case DRM_IOCTL_SYNCOBJ_TIMELINE_WAIT:      need = sizeof(struct drm_syncobj_timeline_wait); break;
+	case DRM_IOCTL_SYNCOBJ_RESET:
+	case DRM_IOCTL_SYNCOBJ_SIGNAL:             need = sizeof(struct drm_syncobj_array); break;
+	case DRM_IOCTL_SYNCOBJ_QUERY:
+	case DRM_IOCTL_SYNCOBJ_TIMELINE_SIGNAL:    need = sizeof(struct drm_syncobj_timeline_array); break;
+	case DRM_IOCTL_SYNCOBJ_TRANSFER:           need = sizeof(struct drm_syncobj_transfer); break;
+	case DRM_IOCTL_HUSKY_BO_IMPORT_SURFACE:    need = sizeof(struct drm_husky_bo_import_surface); break;
+	default:
+		return ENOTTY;
+	}
+	if (len != need) {
+		return EINVAL;
+	}
+	int st = 0;
+	IOLockLock(f->lock);
+	switch (nr) {
+	case DRM_IOCTL_PANTHOR_DEV_QUERY:
+		st = dev_query(f, (struct drm_panthor_dev_query *)args);
+		break;
+	case DRM_IOCTL_PANTHOR_VM_CREATE:
+		st = vm_create(f, (struct drm_panthor_vm_create *)args);
+		break;
+	case DRM_IOCTL_PANTHOR_VM_DESTROY: {
+		pnt_vm *vm = (pnt_vm *)tbl_take(&f->t[T_VM], ((struct drm_panthor_vm_destroy *)args)->id);
+		st = vm != NULL ? 0 : EINVAL;
+		vm_put(f, vm);
+		break;
+	}
+	case DRM_IOCTL_PANTHOR_VM_BIND:
+		st = vm_bind(f, (struct drm_panthor_vm_bind *)args);
+		break;
+	case DRM_IOCTL_PANTHOR_VM_GET_STATE: {
+		struct drm_panthor_vm_get_state *a = (struct drm_panthor_vm_get_state *)args;
+		pnt_vm *vm = (pnt_vm *)tbl_get(&f->t[T_VM], a->vm_id);
+		st = vm != NULL ? 0 : EINVAL;
+		a->state = vm != NULL && mali_backend_ops.vm_is_wedged(vm->mvm) ? DRM_PANTHOR_VM_STATE_UNUSABLE :
+		    DRM_PANTHOR_VM_STATE_USABLE;
+		break;
+	}
+	case DRM_IOCTL_PANTHOR_BO_CREATE:
+		st = bo_create(f, (struct drm_panthor_bo_create *)args);
+		break;
+	case DRM_IOCTL_PANTHOR_BO_MMAP_OFFSET: {
+		struct drm_panthor_bo_mmap_offset *a = (struct drm_panthor_bo_mmap_offset *)args;
+		st = tbl_get(&f->t[T_BO], a->handle) != NULL ? 0 : ENOENT;
+		a->offset = (uint64_t)a->handle << 32;
+		break;
+	}
+	case DRM_IOCTL_PANTHOR_GROUP_CREATE:
+		st = group_create(f, (struct drm_panthor_group_create *)args);
+		break;
+	case DRM_IOCTL_PANTHOR_GROUP_DESTROY: {
+		pnt_group *g = (pnt_group *)tbl_take(&f->t[T_GROUP], ((struct drm_panthor_group_destroy *)args)->group_handle);
+		st = g != NULL ? 0 : EINVAL;
+		if (g != NULL) {
+			g->destroyed = true;
+			group_put(f, g);
+		}
+		break;
+	}
+	case DRM_IOCTL_PANTHOR_GROUP_SUBMIT:
+		st = group_submit(f, (struct drm_panthor_group_submit *)args);
+		break;
+	case DRM_IOCTL_PANTHOR_GROUP_GET_STATE: {
+		struct drm_panthor_group_get_state *a = (struct drm_panthor_group_get_state *)args;
+		pnt_group *g = (pnt_group *)tbl_get(&f->t[T_GROUP], a->group_handle);
+		st = g != NULL ? 0 : EINVAL;
+		if (g != NULL) {
+			IOLockLock(g_lock);
+			a->state = g->state;
+			a->fatal_queues = g->fatal_queues;
+			IOLockUnlock(g_lock);
+		}
+		break;
+	}
+	case DRM_IOCTL_PANTHOR_TILER_HEAP_CREATE:
+		st = heap_create(f, (struct drm_panthor_tiler_heap_create *)args);
+		break;
+	case DRM_IOCTL_PANTHOR_TILER_HEAP_DESTROY: {
+		pnt_heap *h = (pnt_heap *)tbl_take(&f->t[T_HEAP], ((struct drm_panthor_tiler_heap_destroy *)args)->handle);
+		st = h != NULL ? 0 : EINVAL;
+		if (h != NULL) {
+			heap_free(f, h);
+		}
+		break;
+	}
+	case DRM_IOCTL_PANTHOR_BO_SET_LABEL:
+	case DRM_IOCTL_PANTHOR_SET_USER_MMIO_OFFSET:
+		break;
+	case DRM_IOCTL_PANTHOR_BO_SYNC:
+		st = bo_sync(f, (struct drm_panthor_bo_sync *)args);
+		break;
+	case DRM_IOCTL_PANTHOR_BO_QUERY_INFO: {
+		struct drm_panthor_bo_query_info *a = (struct drm_panthor_bo_query_info *)args;
+		pnt_bo *bo = (pnt_bo *)tbl_get(&f->t[T_BO], a->handle);
+		st = bo != NULL ? 0 : ENOENT;
+		a->extra_flags = bo != NULL && bo->imported ? DRM_PANTHOR_BO_IS_IMPORTED : 0;
+		a->create_flags = bo != NULL ? bo->flags : 0;
+		break;
+	}
+	case DRM_IOCTL_GEM_CLOSE: {
+		pnt_bo *bo = (pnt_bo *)tbl_take(&f->t[T_BO], ((struct drm_gem_close *)args)->handle);
+		st = bo != NULL ? 0 : EINVAL;
+		bo_put(f, bo);
+		break;
+	}
+	case DRM_IOCTL_SYNCOBJ_CREATE:
+		st = syncobj_create(f, (struct drm_syncobj_create *)args);
+		break;
+	case DRM_IOCTL_SYNCOBJ_DESTROY: {
+		pnt_syncobj *so = (pnt_syncobj *)tbl_take(&f->t[T_SYNC], ((struct drm_syncobj_destroy *)args)->handle);
+		st = so != NULL ? 0 : EINVAL;
+		if (so != NULL) {
+			so_free(so);
+		}
+		break;
+	}
+	case DRM_IOCTL_SYNCOBJ_WAIT: {
+		struct drm_syncobj_wait *a = (struct drm_syncobj_wait *)args;
+		st = syncobj_wait(f, a->handles, 0, a->count_handles, a->flags, a->timeout_nsec, &a->first_signaled);
+		break;
+	}
+	case DRM_IOCTL_SYNCOBJ_TIMELINE_WAIT: {
+		struct drm_syncobj_timeline_wait *a = (struct drm_syncobj_timeline_wait *)args;
+		st = a->points == 0 ? EINVAL : syncobj_wait(f, a->handles, a->points, a->count_handles, a->flags,
+		    a->timeout_nsec, &a->first_signaled);
+		break;
+	}
+	case DRM_IOCTL_SYNCOBJ_RESET:
+	case DRM_IOCTL_SYNCOBJ_SIGNAL: {
+		struct drm_syncobj_array *a = (struct drm_syncobj_array *)args;
+		st = syncobj_array_op(f, a->handles, 0, a->count_handles, nr == DRM_IOCTL_SYNCOBJ_SIGNAL, 0, false);
+		break;
+	}
+	case DRM_IOCTL_SYNCOBJ_TIMELINE_SIGNAL: {
+		struct drm_syncobj_timeline_array *a = (struct drm_syncobj_timeline_array *)args;
+		st = a->points == 0 || a->flags != 0 ? EINVAL :
+		    syncobj_array_op(f, a->handles, a->points, a->count_handles, true, 0, false);
+		break;
+	}
+	case DRM_IOCTL_SYNCOBJ_QUERY: {
+		struct drm_syncobj_timeline_array *a = (struct drm_syncobj_timeline_array *)args;
+		st = a->points == 0 ? EINVAL : syncobj_array_op(f, a->handles, a->points, a->count_handles, false, a->flags, true);
+		break;
+	}
+	case DRM_IOCTL_SYNCOBJ_TRANSFER:
+		st = syncobj_transfer(f, (struct drm_syncobj_transfer *)args);
+		break;
+	case DRM_IOCTL_HUSKY_BO_IMPORT_SURFACE:
+		st = bo_import_surface(f, (struct drm_husky_bo_import_surface *)args);
+		break;
+	}
+	IOLockUnlock(f->lock);
+	return st;
+}
+
+int
+husky_pnt_mmap(husky_pnt_file *f, uint32_t handle, uint64_t *addr, uint64_t *size)
+{
+	IOLockLock(f->lock);
+	pnt_bo *bo = (pnt_bo *)tbl_get(&f->t[T_BO], handle);
+	int st = bo == NULL ? ENOENT : (bo->flags & DRM_PANTHOR_BO_NO_MMAP) ? EINVAL : 0;
+	pnt_map_rec *m = NULL;
+	if (st == 0) {
+		m = (pnt_map_rec *)kalloc_data(sizeof(*m), Z_WAITOK_ZERO);
+		st = m != NULL ? 0 : ENOMEM;
+	}
+	if (st == 0) {
+		m->map = bo->md->createMappingInTask(f->task, 0, kIOMapAnywhere | bo->cache);
+		uint32_t h = 0;
+		if (m->map == NULL) {
+			st = ENOMEM;
+		} else if ((st = tbl_add(&f->t[T_MAP], m, &h)) != 0) {
+			m->map->release();
+		}
+		if (st != 0) {
+			kfree_data(m, sizeof(*m));
+		} else {
+			m->bo = bo;
+			__atomic_add_fetch(&bo->refs, 1, __ATOMIC_ACQ_REL);
+			m->addr = m->map->getAddress() + bo->md_off;
+			*addr = m->addr;
+			*size = bo->size;
+		}
+	}
+	IOLockUnlock(f->lock);
+	return st;
+}
+
+int
+husky_pnt_munmap(husky_pnt_file *f, uint64_t addr)
+{
+	IOLockLock(f->lock);
+	int st = EINVAL;
+	pnt_table *t = &f->t[T_MAP];
+	for (uint32_t i = 0; i < t->cap; i++) {
+		pnt_map_rec *m = (pnt_map_rec *)t->slot[i];
+		if (m != NULL && m->addr == addr) {
+			t->slot[i] = NULL;
+			m->map->release();
+			bo_put(f, m->bo);
+			kfree_data(m, sizeof(*m));
+			st = 0;
+			break;
+		}
+	}
+	IOLockUnlock(f->lock);
+	return st;
+}
+
+/* ---------------------------------------------------------------------------------------------------- */
+/* The user client */
+
+class HuskyPanthorUserClient : public IOUserClient
+{
+	OSDeclareDefaultStructors(HuskyPanthorUserClient);
+	husky_pnt_file *fFile;
+	task_t          fTask;
+public:
+	virtual bool initWithTask(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+	virtual IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+	    IOExternalMethodDispatch *dispatch, OSObject *target, void *reference) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(HuskyPanthorUserClient, IOUserClient);
+
+bool
+HuskyPanthorUserClient::initWithTask(task_t owningTask, void *securityID, UInt32 type, OSDictionary *properties)
+{
+	if (!IOUserClient::initWithTask(owningTask, securityID, type, properties)) {
+		return false;
+	}
+	fTask = owningTask;
+	fFile = husky_pnt_open(owningTask);
+	return fFile != NULL;
+}
+
+IOReturn
+HuskyPanthorUserClient::clientClose(void)
+{
+	husky_pnt_close(fFile);
+	fFile = NULL;
+	terminate();
+	return kIOReturnSuccess;
+}
+
+IOReturn
+HuskyPanthorUserClient::externalMethod(uint32_t selector, IOExternalMethodArguments *a,
+    IOExternalMethodDispatch *, OSObject *, void *)
+{
+	if (fFile == NULL || current_task() != fTask) {
+		return kIOReturnNotPermitted;
+	}
+	switch (selector) {
+	case HUSKY_PNT_SEL_IOCTL: {
+		uint64_t buf[16];
+		if (a->scalarInputCount != 1 || a->scalarOutputCount != 1 || a->structureInputDescriptor != NULL ||
+		    a->structureOutputDescriptor != NULL ||
+		    a->structureInputSize > sizeof(buf) || a->structureOutputSize != a->structureInputSize) {
+			return kIOReturnBadArgument;
+		}
+		memcpy(buf, a->structureInput, a->structureInputSize);
+		const int err = husky_pnt_ioctl(fFile, (uint32_t)a->scalarInput[0], buf, a->structureInputSize);
+		memcpy(a->structureOutput, buf, a->structureInputSize);
+		a->scalarOutput[0] = (uint64_t)err;
+		return kIOReturnSuccess;
+	}
+	case HUSKY_PNT_SEL_MMAP: {
+		if (a->scalarInputCount != 1 || a->scalarOutputCount != 2) {
+			return kIOReturnBadArgument;
+		}
+		uint64_t addr = 0, size = 0;
+		const int err = husky_pnt_mmap(fFile, (uint32_t)a->scalarInput[0], &addr, &size);
+		a->scalarOutput[0] = addr;
+		a->scalarOutput[1] = size;
+		return err == 0 ? kIOReturnSuccess : kIOReturnNoMemory;
+	}
+	case HUSKY_PNT_SEL_MUNMAP:
+		if (a->scalarInputCount != 1) {
+			return kIOReturnBadArgument;
+		}
+		return husky_pnt_munmap(fFile, a->scalarInput[0]) == 0 ? kIOReturnSuccess : kIOReturnBadArgument;
+	default:
+		return kIOReturnUnsupported;
+	}
+}
+
+IOReturn
+husky_pnt_new_user_client(IOService *provider, task_t owningTask, void *securityID, UInt32 type,
+    OSDictionary *properties, IOUserClient **handler)
+{
+	HuskyPanthorUserClient *uc = OSTypeAlloc(HuskyPanthorUserClient);
+	if (uc == NULL) {
+		return kIOReturnNoMemory;
+	}
+	if (!uc->initWithTask(owningTask, securityID, type, properties) || !uc->attach(provider) || !uc->start(provider)) {
+		uc->detach(provider);
+		uc->release();
+		return kIOReturnError;
+	}
+	*handler = uc;
+	return kIOReturnSuccess;
+}
+#endif /* ARM64_BOARD_CONFIG_HUSKY */

 }
+/*
+ * HUSKY port trace: one launchd service port (boot-arg huskyporttrace, default
+ * com.apple.mobile.usermanagerd.xpc) and one process (boot-arg huskymsgtrace,
+ * default usermanagerd). Logs as "PTR ...": every message sent to or received
+ * from the service port, and every message the process sends or receives, with
+ * the sender/receiver, msgh_id, bits and size. First 500 lines.
+ */
+extern void proc_selfname(char *buf, int size);
+extern int proc_selfpid(void);
+extern void *get_bsdtask_info(task_t);
+
+static char husky_ptr_svc[MACH_SERVICE_PORT_INFO_STRING_NAME_MAX_BUF_LEN];
+static char husky_ptr_proc[32];
+static bool husky_ptr_parsed;
+static ipc_port_t volatile husky_ptr_port;
+static void * volatile husky_ptr_procp;
+static int husky_ptr_ctor_pid = -1;
+static bool husky_ptr_announced;
+static int husky_ptr_lines;
+
+#define HUSKY_PTR_MAX 500
+
+static void
+husky_ptr_parse(void)
+{
+	if (husky_ptr_parsed) {
+		return;
+	}
+	if (!PE_parse_boot_argn("huskyporttrace", husky_ptr_svc, sizeof(husky_ptr_svc))) {
+		strlcpy(husky_ptr_svc, "com.apple.mobile.usermanagerd.xpc", sizeof(husky_ptr_svc));
+	}
+	if (!PE_parse_boot_argn("huskymsgtrace", husky_ptr_proc, sizeof(husky_ptr_proc))) {
+		strlcpy(husky_ptr_proc, "usermanagerd", sizeof(husky_ptr_proc));
+	}
+	husky_ptr_parsed = true;
+}
+
+/* Called from mach_port_construct with the new port locked: record only. */
+void husky_porttrace_construct(ipc_port_t port, const char *svc);
+
+void
+husky_porttrace_construct(ipc_port_t port, const char *svc)
+{
+	husky_ptr_parse();
+	if (svc != NULL && strncmp(svc, husky_ptr_svc, sizeof(husky_ptr_svc)) == 0) {
+		husky_ptr_port = port;
+		husky_ptr_ctor_pid = proc_selfpid();
+		husky_ptr_announced = false;
+	}
+}
+
+/* Called from set_proc_name during image activation. */
+void husky_porttrace_exec(const char *comm, void *p, int pid);
+
+void
+husky_porttrace_exec(const char *comm, void *p, int pid)
+{
+	husky_ptr_parse();
+	if (comm != NULL && strncmp(comm, husky_ptr_proc, sizeof(husky_ptr_proc)) == 0) {
+		husky_ptr_procp = p;
+		printf("PTR exec %s pid %d: tracing its messages\n", comm, pid);
+	}
+}
+
+static bool
+husky_ptr_begin(void)
+{
+	if (husky_ptr_lines >= HUSKY_PTR_MAX) {
+		return false;
+	}
+	husky_ptr_lines++;
+	if (!husky_ptr_announced && husky_ptr_port != IP_NULL) {
+		husky_ptr_announced = true;
+		printf("PTR service %s constructed by pid %d (port %p)\n", husky_ptr_svc,
+		    husky_ptr_ctor_pid, husky_ptr_port);
+	}
+	return true;
+}
+
+/* Called from ipc_kmsg_send before the destination is locked. */
+void husky_porttrace_send(ipc_port_t dest, mach_msg_header_t *hdr);
+
+void
+husky_porttrace_send(ipc_port_t dest, mach_msg_header_t *hdr)
+{
+	bool to_svc = (dest != IP_NULL && dest == husky_ptr_port);
+	bool by_proc = (husky_ptr_procp != NULL && get_bsdtask_info(current_task()) == husky_ptr_procp);
+
+	if (!(to_svc || by_proc) || !husky_ptr_begin()) {
+		return;
+	}
+	char name[20];
+	proc_selfname(name, sizeof(name));
+	printf("PTR send %s[%d] -> %s id %d bits 0x%x size %u\n", name, proc_selfpid(),
+	    to_svc ? "SERVICE" : (MACH_MSGH_BITS_REMOTE(hdr->msgh_bits) == MACH_MSG_TYPE_PORT_SEND_ONCE ? "send-once" : "other"),
+	    hdr->msgh_id, hdr->msgh_bits, hdr->msgh_size);
+}
+
+/* Called from mach_msg_receive_results before copyout; dest = the receive port. */
+void husky_porttrace_recv(ipc_port_t dest, mach_msg_header_t *hdr);
+
+void
+husky_porttrace_recv(ipc_port_t dest, mach_msg_header_t *hdr)
+{
+	bool from_svc = (dest != IP_NULL && dest == husky_ptr_port);
+	bool by_proc = (husky_ptr_procp != NULL && get_bsdtask_info(current_task()) == husky_ptr_procp);
+
+	if (!(from_svc || by_proc) || !husky_ptr_begin()) {
+		return;
+	}
+	char name[20];
+	proc_selfname(name, sizeof(name));
+	printf("PTR recv %s[%d] <- %s id %d bits 0x%x size %u\n", name, proc_selfpid(),
+	    from_svc ? "SERVICE" : "other", hdr->msgh_id, hdr->msgh_bits, hdr->msgh_size);
+}
 #endif /* ARM64_BOARD_CONFIG_HUSKY */

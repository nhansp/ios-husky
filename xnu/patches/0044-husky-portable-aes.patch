diff --git a/libkern/crypto/register_crypto.c b/libkern/crypto/register_crypto.c
index 816f9c7..26e7eac 100644
--- a/libkern/crypto/register_crypto.c
+++ b/libkern/crypto/register_crypto.c
@@ -51,7 +51,8 @@ register_crypto_functions(const crypto_functions_t funcs)
 /*
  * husky bring-up: the standalone kernel has no corecrypto kext, so nothing
  * registers g_crypto_funcs and the first crypto_* / SHA* caller faults on it.
- * Register what xnu's in-tree corecrypto provides (SHA-256/512, HMAC)
+ * Register what xnu's in-tree corecrypto provides (SHA-256/512, HMAC),
+ * portable BearSSL AES-CBC (husky_aes.c)
  * plus the random hooks over the bring-up PRNG. Everything else stays NULL
  * until the real corecrypto (kernelcache) replaces this table.
  */
@@ -102,6 +103,9 @@ husky_random_kmem_init(crypto_random_ctx_t ctx __unused)
 {
 }
 
+extern const struct ccmode_cbc husky_aes_cbc_encrypt;
+extern const struct ccmode_cbc husky_aes_cbc_decrypt;
+
 static struct crypto_functions husky_crypto_funcs;
 
 void husky_register_bringup_crypto(void);
@@ -118,6 +122,9 @@ husky_register_bringup_crypto(void)
 	husky_crypto_funcs.cchmac_update_fn = cchmac_update;
 	husky_crypto_funcs.cchmac_final_fn = cchmac_final;
 	husky_crypto_funcs.cchmac_fn = cchmac;
+	/* AES (legacy aes_encrypt/decrypt API): BearSSL constant-time, husky_aes.c */
+	husky_crypto_funcs.ccaes_cbc_encrypt = &husky_aes_cbc_encrypt;
+	husky_crypto_funcs.ccaes_cbc_decrypt = &husky_aes_cbc_decrypt;
 	husky_crypto_funcs.random_generate_fn = husky_random_generate;
 	husky_crypto_funcs.random_uniform_fn = husky_random_uniform;
 	husky_crypto_funcs.random_kmem_ctx_size_fn = husky_random_kmem_ctx_size;

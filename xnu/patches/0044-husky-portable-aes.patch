diff --git a/libkern/conf/Makefile.template b/libkern/conf/Makefile.template
index 6ef0911..b6ea01d 100644
--- a/libkern/conf/Makefile.template
+++ b/libkern/conf/Makefile.template
@@ -19,6 +19,24 @@ include $(MakeInc_def)
 CFLAGS+= -include meta_features.h -DLIBKERN_KERNEL_PRIVATE -DOSALLOCDEBUG=1
 SFLAGS+= -include meta_features.h
 
+# Portable BearSSL AES for the HUSKY built-in crypto table (no corecrypto kext).
+ifeq ($(CURRENT_MACHINE_CONFIG),HUSKY)
+HUSKY_AES_ROOT = $(SRCROOT)/libkern/crypto/husky_bearssl
+HUSKY_AES_INC = -I$(HUSKY_AES_ROOT)/inc -I$(HUSKY_AES_ROOT)/src
+husky_aes.o_INCFLAGS = $(HUSKY_AES_INC)
+husky_aes_ct.o_INCFLAGS = $(HUSKY_AES_INC)
+husky_aes_ct_enc.o_INCFLAGS = $(HUSKY_AES_INC)
+husky_aes_ct_dec.o_INCFLAGS = $(HUSKY_AES_INC)
+husky_aes_ct_cbcenc.o_INCFLAGS = $(HUSKY_AES_INC)
+husky_aes_ct_cbcdec.o_INCFLAGS = $(HUSKY_AES_INC)
+husky_aes.o_CFLAGS_ADD += -mgeneral-regs-only
+husky_aes_ct.o_CFLAGS_ADD += -mgeneral-regs-only
+husky_aes_ct_enc.o_CFLAGS_ADD += -mgeneral-regs-only
+husky_aes_ct_dec.o_CFLAGS_ADD += -mgeneral-regs-only
+husky_aes_ct_cbcenc.o_CFLAGS_ADD += -mgeneral-regs-only
+husky_aes_ct_cbcdec.o_CFLAGS_ADD += -mgeneral-regs-only
+endif
+
 # Runtime support functions don't interact well with LTO (9294679)
 stack_protector.o_CFLAGS_ADD += $(CFLAGS_NOLTO_FLAG)
 

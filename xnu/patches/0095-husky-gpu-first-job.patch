+	    TEST_VA, test_pa, pt_used);
 	/* Push everything to DRAM: the GPU walks and reads non-coherently. */
 	husky_dcache_flush(kva, region);
 
@@ -638,6 +914,7 @@ husky_gpu_mcu_boot(void)
 	}
 	HU_LOG("HUSKY GPU: L2 ready in %u us\n", took);
 
+	mcu_root = root;
 	HU_LOG("HUSKY GPU: AS0 TRANSTAB 0x%llx\n", root);
 	if (!gpoll(AS0 + AS_STATUS, 3, 0, 100000, NULL)) {
 		gpu_fault_dump("AS0 busy before update");
@@ -718,7 +995,9 @@ husky_gpu_mcu_boot(void)
 	    us < 100000 ? "ANSWERED" : "unanswered", us, grd(MCU_STATUS));
 	if (us >= 100000) {
 		gpu_fault_dump("ping");
+		return;
 	}
+	husky_gpu_first_job(shared_nc, shared_size, gin, gout);
 }
 
 void

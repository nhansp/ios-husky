+int
+husky_dvfs_get(uint32_t domain, uint32_t *khz)
+{
+	uint32_t cmd[4] = {domain & 0xffffu, 0, DVFS_FREQ_GET, 0};
+	uint32_t reply[4] = {0, 0, 0, 0};
+	int err = acpm_send(&ch_dvfs, cmd, reply);
+	if (err) {
+		return err;
+	}
+	*khz = reply[3] ? reply[3] : reply[1];
+	return 0;
+}
+
+int
+husky_dvfs_set(uint32_t domain, uint32_t khz)
+{
+	uint32_t cmd[4] = {domain & 0xffffu, khz, DVFS_FREQ_REQ, 0};
+	/* Fire and forget, like Linux for CPU/MIF/INT; the next send drains. */
+	return acpm_send(&ch_dvfs, cmd, NULL);
+}
+
+static const struct {
+	uint32_t domain;
+	const char *name;
+	const char *bootarg;
+} dvfs_domains[] = {
+	{HUSKY_DVFS_MIF, "MIF", "huskymif"},
+	{HUSKY_DVFS_INT, "INT", NULL},
+	{HUSKY_DVFS_CPUCL0, "CPUCL0 A510", "huskycl0"},
+	{HUSKY_DVFS_CPUCL1, "CPUCL1 A715", "huskycl1"},
+	{HUSKY_DVFS_CPUCL2, "CPUCL2 X3", "huskycl2"},
+	{HUSKY_DVFS_DSU, "DSU", "huskydsu"},
+	{HUSKY_DVFS_G3D, "G3D", NULL},
+};
+
+static void
+dvfs_log(const char *when)
+{
+	for (unsigned i = 0; i < sizeof(dvfs_domains) / sizeof(dvfs_domains[0]); i++) {
+		uint32_t khz = 0;
+		int err = husky_dvfs_get(dvfs_domains[i].domain, &khz);
+		HU_LOG("HUSKY DVFS: %s %s %u kHz (err %d)\n", when, dvfs_domains[i].name, khz, err);
+	}
+}
+
+void
+husky_dvfs_report(void)
+{
+	bool changed = false;
+
+	if (husky_acpm_init() || !ch_dvfs.ready) {
+		HU_LOG("HUSKY DVFS: ACPM DVFS channel unavailable\n");
+		return;
+	}
+	dvfs_log("boot");
+
+	/* Opt-in rate requests, kHz: huskycl0/huskycl1/huskycl2/huskydsu/huskymif. */
+	for (unsigned i = 0; i < sizeof(dvfs_domains) / sizeof(dvfs_domains[0]); i++) {
+		uint32_t khz = 0;
+		if (!dvfs_domains[i].bootarg ||
+		    !PE_parse_boot_argn(dvfs_domains[i].bootarg, &khz, sizeof(khz)) || khz == 0) {
+			continue;
+		}
+		int err = husky_dvfs_set(dvfs_domains[i].domain, khz);
+		HU_LOG("HUSKY DVFS: request %s %u kHz (err %d)\n", dvfs_domains[i].name, khz, err);
+		changed = true;
+	}
+	if (changed) {
+		delay(50000);
+		dvfs_log("after request");
+	}
+}

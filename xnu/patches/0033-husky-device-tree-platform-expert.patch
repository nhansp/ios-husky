diff --git a/iokit/Kernel/arm/HuskyPlatformExpert.cpp b/iokit/Kernel/arm/HuskyPlatformExpert.cpp
new file mode 100644
index 0000000..7901581
--- /dev/null
+++ b/iokit/Kernel/arm/HuskyPlatformExpert.cpp
@@ -0,0 +1,90 @@
+/*
+ * Minimal device-tree platform expert for Pixel 8 Pro (husky), ported from
+ * ios-sweet's SweetPlatformExpert. A real kernelcache gets its platform expert
+ * from the AppleARMPlatform kext; the standalone kernel matches this one on the
+ * root "google,husky" compatible instead. Uses XNU's normal platform, power
+ * domain and nub initialization; interrupt and power-management services come
+ * from separate drivers.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(HUSKY)
+#include <IOKit/IOPlatformExpert.h>
+#include <IOKit/IODeviceTreeSupport.h>
+#include <IOKit/IOLib.h>
+
+class HuskyPlatformExpert : public IODTPlatformExpert {
+	OSDeclareDefaultStructors(HuskyPlatformExpert);
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void processTopLevel(IORegistryEntry *root) APPLE_KEXT_OVERRIDE;
+	const char *deleteList(void) APPLE_KEXT_OVERRIDE;
+	const char *excludeList(void) APPLE_KEXT_OVERRIDE;
+	bool getTargetName(char *name, int maxLength) APPLE_KEXT_OVERRIDE;
+	bool getProductName(char *name, int maxLength) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(HuskyPlatformExpert, IODTPlatformExpert);
+
+bool
+HuskyPlatformExpert::start(IOService *provider)
+{
+	IOLog("HUSKY: starting device-tree platform expert\n");
+	if (!IODTPlatformExpert::start(provider)) {
+		return false;
+	}
+	registerService();
+	IOLog("HUSKY: platform expert registered\n");
+	return true;
+}
+
+const char *
+HuskyPlatformExpert::deleteList(void)
+{
+	return "()";
+}
+
+const char *
+HuskyPlatformExpert::excludeList(void)
+{
+	return "('chosen', 'defaults', 'cpus', 'options')";
+}
+
+void
+HuskyPlatformExpert::processTopLevel(IORegistryEntry *root)
+{
+	/*
+	 * The stock implementation requires an Apple NVRAM /options node, which
+	 * husky does not have. Publish the CPU and device nodes without inventing
+	 * one; createNubs adds the topology's logical CPU/cluster IDs.
+	 */
+	IORegistryEntry *cpus = root->childFromPath("cpus", gIODTPlane);
+	if (cpus != NULL) {
+		createNubs(this, IODTFindMatchingEntries(cpus, kIODTExclusive, NULL));
+		cpus->release();
+	}
+	createNubs(this, IODTFindMatchingEntries(root, kIODTExclusive, excludeList()));
+}
+
+/* Userland identity is the iPhone 11 Pro Max the ADT poses as (hw.target). */
+bool
+HuskyPlatformExpert::getTargetName(char *name, int maxLength)
+{
+	if (name == NULL || maxLength <= 0) {
+		return false;
+	}
+	strlcpy(name, "D431AP", (size_t)maxLength);
+	return true;
+}
+
+bool
+HuskyPlatformExpert::getProductName(char *name, int maxLength)
+{
+	if (name == NULL || maxLength <= 0) {
+		return false;
+	}
+	strlcpy(name, "iPhone 11 Pro Max", (size_t)maxLength);
+	return true;
+}
+#endif /* HUSKY */

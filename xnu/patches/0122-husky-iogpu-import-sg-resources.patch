+/* Map the GPU pages of md covering [offset, offset + length) into the client VM; md stays prepared until free(). */
+IOReturn
+IOGPUResource::importMemory(IOMemoryDescriptor *md, uint64_t offset, uint64_t length, uint32_t flags)
+{
+	const uint64_t start = offset & ~(uint64_t)(IOGPU_GPU_PAGE - 1);
+	const uint64_t end = (offset + length + IOGPU_GPU_PAGE - 1) & ~(uint64_t)(IOGPU_GPU_PAGE - 1);
+	if (end > round_page_64(md->getLength()) || md->prepare() != kIOReturnSuccess) {
+		return kIOGPUReturnBadArgument;
+	}
+	const uint32_t n = (uint32_t)((end - start) / IOGPU_GPU_PAGE);
+	uint64_t *phys = (uint64_t *)IOMallocData(n * sizeof(uint64_t));
+	bool ok = phys != NULL;
+	for (uint32_t i = 0; ok && i < n;) {
+		IOByteCount seg = 0;
+		addr64_t pa = md->getPhysicalSegment(start + (uint64_t)i * IOGPU_GPU_PAGE, &seg, kIOMemoryMapperNone);
+		ok = pa != 0 && !(pa & (IOGPU_GPU_PAGE - 1)) && seg >= IOGPU_GPU_PAGE;
+		for (; ok && seg >= IOGPU_GPU_PAGE && i < n; seg -= IOGPU_GPU_PAGE, pa += IOGPU_GPU_PAGE) {
+			phys[i++] = pa;
+		}
+	}
+	mali_vm_t *vm = fDevice->task()->vm();
+	ok = ok && mali_backend_ops.bo_import_pages(vm, phys, n, flags & ~MALI_BO_CPU_MAP, &fBO) == 0;
+	if (phys != NULL) {
+		IOFreeData(phys, n * sizeof(uint64_t));
+	}
+	if (!ok) {
+		md->complete();
+		return kIOGPUReturnNoMemory;
+	}
+	md->retain();
+	fImport = md;
+	fImportOffset = offset;
+	fGpuOffset = offset - start;
+	return kIOGPUReturnSuccess;
+}
+
+void *
+IOGPUResource::kernelAddress()
+{
+	if (fImport == NULL) {
+		return fBO != NULL ? mali_backend_ops.bo_cpu_map(fBO) : NULL;
+	}
+	if (IOBufferMemoryDescriptor *buf = OSDynamicCast(IOBufferMemoryDescriptor, fImportOwner)) {
+		return (uint8_t *)buf->getBytesNoCopy() + fImportOffset;
+	}
+	if (HuskySurface *surf = OSDynamicCast(HuskySurface, fImportOwner)) {
+		const uintptr_t base = surf->kernelAddress();
+		return base != 0 ? (void *)(base + fImportOffset) : NULL;
+	}
+	return fKernelMap != NULL ? (void *)(fKernelMap->getVirtualAddress() + fImportOffset) : NULL;
+}

@@ -34,8 +34,19 @@
 #include <pexpert/pexpert.h>
 
 extern "C" void husky_log_final_flush(void);
-/* Each line goes to the on-disk log immediately: a hard freeze still leaves the last step on disk. */
-#define HU_LOG(...) do { printf(__VA_ARGS__); kprintf(__VA_ARGS__); husky_log_final_flush(); } while (0)
+/* boot-arg huskygpuflush=1: each line goes to the on-disk log immediately (0110 bisect toggle). */
+static uint32_t
+selftest_flush_on(void)
+{
+	static int v = -1;
+	if (v < 0) {
+		uint32_t f = 0;
+		(void)PE_parse_boot_argn("huskygpuflush", &f, sizeof(f));
+		v = (int)f;
+	}
+	return (uint32_t)v;
+}
+#define HU_LOG(...) do { printf(__VA_ARGS__); kprintf(__VA_ARGS__); if (selftest_flush_on()) husky_log_final_flush(); } while (0)
 

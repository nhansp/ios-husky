diff --git a/iokit/Kernel/arm/HuskyCPU.cpp b/iokit/Kernel/arm/HuskyCPU.cpp
new file mode 100644
index 0000000..704d9c3
--- /dev/null
+++ b/iokit/Kernel/arm/HuskyCPU.cpp
@@ -0,0 +1,166 @@
+/*
+ * Single-CPU bring-up for husky using XNU's legacy IOCPU interface, ported
+ * from ios-sweet's SweetCPU. A kernelcache registers processors from a CPU
+ * driver kext; without one, nothing calls ml_set_max_cpus() and
+ * kperf_init_early() blocks in ml_wait_max_cpus() forever. The architected
+ * timer and the IPI SGI already enter through pe_init_fiq/sleh_irq.
+ * Secondary CPU startup and system suspend need separate platform work.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(HUSKY)
+#include <IOKit/IOCPU.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSData.h>
+#include <libkern/c++/OSNumber.h>
+#include <arm64/proc_reg.h>
+#include <kern/processor.h>
+
+class HuskyCPU : public IOCPU {
+	OSDeclareDefaultStructors(HuskyCPU);
+	const OSSymbol *cpuName = NULL;
+
+public:
+	bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+	void free(void) APPLE_KEXT_OVERRIDE;
+	void initCPU(bool boot) APPLE_KEXT_OVERRIDE;
+	void quiesceCPU(void) APPLE_KEXT_OVERRIDE;
+	kern_return_t startCPU(vm_offset_t start_paddr, vm_offset_t arg_paddr) APPLE_KEXT_OVERRIDE;
+	void haltCPU(void) APPLE_KEXT_OVERRIDE;
+	void signalCPU(IOCPU *target) APPLE_KEXT_OVERRIDE;
+	const OSSymbol *getCPUName(void) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(HuskyCPU, IOCPU);
+
+bool
+HuskyCPU::start(IOService *provider)
+{
+	const ml_topology_info_t *topology = ml_get_topology_info();
+	const ml_topology_cpu_t *cpu = topology->boot_cpu;
+	OSNumber *logical = OSDynamicCast(OSNumber, provider->getProperty("logical-cpu-id"));
+	OSData *reg = OSDynamicCast(OSData, provider->getProperty("reg"));
+
+	/* Only the boot CPU's nub is ours; decline the others. */
+	if (logical == NULL || reg == NULL || reg->getLength() != sizeof(uint32_t) ||
+	    logical->unsigned32BitValue() != cpu->cpu_id ||
+	    *(const uint32_t *)reg->getBytesNoCopy() != cpu->phys_id) {
+		return false;
+	}
+	if (topology->num_cpus != 1) {
+		panic("HUSKY CPU: only single-CPU bring-up is supported (boot with cpus=1)");
+	}
+	if (!IOCPU::start(provider)) {
+		return false;
+	}
+	cpuName = OSSymbol::withCStringNoCopy("Cortex-A510");
+	if (cpuName == NULL) {
+		return false;
+	}
+	setCPUNumber(cpu->cpu_id);
+
+	ml_processor_info_t info = {};
+	info.cpu_id = reinterpret_cast<cpu_id_t>(this);
+	info.phys_id = cpu->phys_id;
+	info.log_id = cpu->cpu_id;
+	info.cluster_id = cpu->cluster_id;
+	info.cluster_type = cpu->cluster_type;
+	info.l2_cache_id = cpu->l2_cache_id;
+	info.l2_cache_size = cpu->l2_cache_size;
+	info.l3_cache_id = cpu->l3_cache_id;
+	info.l3_cache_size = cpu->l3_cache_size;
+	perfmon_interrupt_handler_func pmi_handler = NULL;
+	kern_return_t result = ml_processor_register(&info, &machProcessor, &ipi_handler, &pmi_handler);
+	if (result != KERN_SUCCESS) {
+		panic("HUSKY CPU: ml_processor_register failed: %d", result);
+	}
+	if (pmi_handler != NULL) {
+		panic("HUSKY CPU: PMI routing is not implemented");
+	}
+
+	/* Re-enter the boot CPU through cpu_machine_init -> PE_cpu_machine_init. */
+	result = processor_start(machProcessor);
+	if (result != KERN_SUCCESS || getCPUState() != kIOCPUStateRunning) {
+		panic("HUSKY CPU: processor_start failed: %d", result);
+	}
+	ml_cpu_init_completed();
+	cpusRunning();
+	registerService();
+	IOService::publishResource(gIOAllCPUInitializedKey, kOSBooleanTrue);
+
+	/* Announce completion only after registration, startup and SGI validation. */
+	ml_set_max_cpus(topology->max_cpu_id + 1);
+	IOLog("HUSKY CPU: boot CPU %u registered, SGI%u verified, initialization complete\n",
+	    getCPUNumber(), HUSKY_IPI_SGI);
+	return true;
+}
+
+void
+HuskyCPU::free(void)
+{
+	OSSafeReleaseNULL(cpuName);
+	IOCPU::free();
+}
+
+void
+HuskyCPU::initCPU(bool boot)
+{
+	if (!boot) {
+		panic("HUSKY CPU: resume is not implemented");
+	}
+	assert(cpu_number() == (int)getCPUNumber());
+	assert(ml_get_interrupts_enabled());
+	ml_broadcast_cpu_event(CPU_BOOTED, getCPUNumber());
+
+	/* A real GIC interrupt clears SIGPdisabled in cpu_signal_handler. */
+	IOLog("HUSKY CPU: SGI%u self-test\n", HUSKY_IPI_SGI);
+	signalCPU(this);
+	ml_wait_for_cpu_signal_to_enable();
+	setCPUState(kIOCPUStateRunning);
+}
+
+void
+HuskyCPU::signalCPU(IOCPU *target)
+{
+	/* Only the boot CPU is registered by this driver. */
+	if (target != this || cpu_number() != (int)getCPUNumber()) {
+		panic("HUSKY CPU: secondary CPU signalling is not implemented");
+	}
+	uint64_t mpidr = __builtin_arm_rsr64("MPIDR_EL1");
+	unsigned int aff0 = mpidr & 0xff;
+	if (aff0 >= 16) {
+		panic("HUSKY CPU: SGI target requires unsupported range selector");
+	}
+	uint64_t sgi = (((mpidr >> 32) & 0xff) << 48) |
+	    (((mpidr >> 16) & 0xff) << 32) |
+	    (((mpidr >> 8) & 0xff) << 16) |
+	    ((uint64_t)HUSKY_IPI_SGI << 24) | (1ULL << aff0);
+	__builtin_arm_dsb(DSB_ISHST);
+	__builtin_arm_wsr64("ICC_SGI1R_EL1", sgi);
+	__builtin_arm_isb(ISB_SY);
+}
+
+kern_return_t
+HuskyCPU::startCPU(vm_offset_t start_paddr __unused, vm_offset_t arg_paddr __unused)
+{
+	return KERN_NOT_SUPPORTED;
+}
+
+void
+HuskyCPU::quiesceCPU(void)
+{
+	panic("HUSKY CPU: CPU quiesce is not implemented");
+}
+
+void
+HuskyCPU::haltCPU(void)
+{
+	panic("HUSKY CPU: CPU halt/suspend is not implemented");
+}
+
+const OSSymbol *
+HuskyCPU::getCPUName(void)
+{
+	return cpuName;
+}
+#endif /* HUSKY */

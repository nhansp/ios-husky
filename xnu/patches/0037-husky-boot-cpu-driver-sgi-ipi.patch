--- a/pexpert/pexpert/arm64/HUSKY.h
+++ b/pexpert/pexpert/arm64/HUSKY.h
@@ -22,6 +22,12 @@
 #define HUSKY 1
 /* Tensor cores have no Apple CPU_OVRD power-management SPR. */
 #define NO_CPU_OVRD 1
+/*
+ * GIC Group 1 NS interrupts XNU takes in sleh_irq (EL3 owns Group 0): the
+ * architected virtual timer PPI, and the SGI used for cross-CPU signals.
+ */
+#define HUSKY_VTIMER_INTID 27
+#define HUSKY_IPI_SGI      1

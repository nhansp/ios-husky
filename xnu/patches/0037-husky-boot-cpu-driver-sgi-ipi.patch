+			    cdp->interrupt_refCon,
+			    cdp->interrupt_nub,
+			    intid);
+		} else {
+			kprintf("husky: unhandled IRQ %u\n", intid);
+		}
+		__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
 	}
-	__builtin_arm_wsr64("ICC_EOIR1_EL1", iar);
 #else

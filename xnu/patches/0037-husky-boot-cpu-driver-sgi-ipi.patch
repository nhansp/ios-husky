 	/*
-	 * GIC Group 1 NS (see pe_init_fiq): the vtimer PPI arrives here rather
-	 * than at sleh_fiq. Ack it and run the timer path sleh_fiq would.
+	 * GIC Group 1 NS (see pe_init_fiq): the vtimer and the cross-CPU signal
+	 * SGI arrive here rather than at sleh_fiq.
 	 */
 	uint64_t iar = __builtin_arm_rsr64("ICC_IAR1_EL1");

diff --git a/bsd/husky_hfs/husky_hfs_compat.h b/bsd/husky_hfs/husky_hfs_compat.h
new file mode 100644
index 0000000..4edcd85
--- /dev/null
+++ b/bsd/husky_hfs/husky_hfs_compat.h
@@ -0,0 +1,36 @@
+/*
+ * Compile Apple's HFS kext sources inside HUSKY the way the kext is built
+ * (ported from ios-sweet 0026): with the kext (KPI) view of the kernel
+ * headers, and with only HFS's own kext-config.h deciding features. The
+ * kernel's -DCONFIG_* options are not visible to a kext build, so the ones
+ * HFS tests are cleared first. HUSKY has no AppleKeyStore, so content
+ * protection stays off.
+ */
+#ifndef HUSKY_HFS_COMPAT_H
+#define HUSKY_HFS_COMPAT_H
+#undef BSD_KERNEL_PRIVATE
+#undef XNU_KERNEL_PRIVATE
+#undef CONFIG_PROTECT
+#undef CONFIG_SEARCHFS
+#undef CONFIG_HFS_DIRLINK
+#undef CONFIG_SECLUDED_RENAME
+#undef CONFIG_MACF
+#undef CONFIG_HFS_RBTREE
+#undef QUOTA
+#undef NAMEDSTREAMS
+#undef FIFO
+#undef HFS_COMPRESSION
+#include "core/kext-config.h"
+
+/*
+ * HUSKY is VMAPPLE-class with CONFIG_PV_TICKET, so kern/locks.h declares
+ * lck_init_pv() __startup_func; that macro comes from kern/startup.h's
+ * XNU_KERNEL_PRIVATE view, which this kext view does not have (as 0043).
+ */
+#ifndef __startup_func
+#define __startup_func
+#endif
+
+/* Built in, not a loadable kext (see husky_hfs_iokit.c). */
+#define OSKextGetCurrentLoadTag husky_hfs_current_load_tag
+#endif
diff --git a/bsd/husky_hfs/husky_hfs_iokit.c b/bsd/husky_hfs/husky_hfs_iokit.c
new file mode 100644
index 0000000..e93f0d6
--- /dev/null
+++ b/bsd/husky_hfs/husky_hfs_iokit.c
@@ -0,0 +1,133 @@
+/*
+ * Built-in replacement for HFS's IOKit glue (core/hfs_iokit.cpp and
+ * hfs_encodings/hfs_encodings_kext.cpp) on HUSKY, ported from ios-sweet 0026.
+ *
+ * On Apple platforms HFS is a kext: IOKit matches its IOService on
+ * IOResources and start() registers the filesystem. HUSKY links HFS into
+ * the kernel instead, so bsd_init calls husky_hfs_register() right after
+ * vfsinit(), before the root filesystem is mounted. The registration is the
+ * kext's start() sequence.
+ *
+ * The helpers that query IOKit storage keep their answers for HUSKY, which
+ * has no IOStorageFamily and therefore no IOMedia objects: nothing is
+ * ejectable and no media carries an external journal. The platform expert
+ * publishes no serial number. Content protection (AppleKeyStore) is not
+ * built (husky_hfs_compat.h).
+ */
+#include <libkern/OSKextLib.h>
+#include <pexpert/pexpert.h>
+#include <sys/sysctl.h>
+
+#include "hfs.h"
+#include "hfs_cnode.h"
+#include "hfs_dbg.h"
+#include "hfs_iokit.h"
+#include "hfs_encodings/hfs_encodings_internal.h"
+
+#ifndef panic_on_assert
+bool panic_on_assert;
+#endif
+
+#if DEBUG
+bool hfs_corruption_panics = true;
+#endif
+
+extern struct vnodeopv_desc hfs_vnodeop_opv_desc;
+extern struct vnodeopv_desc hfs_specop_opv_desc;
+extern struct vnodeopv_desc hfs_fifoop_opv_desc;
+extern struct vfsops hfs_vfsops;
+
+void husky_hfs_register(void);
+
+static vfstable_t husky_hfs_vfs_handle;
+
+void
+husky_hfs_register(void)
+{
+#ifndef panic_on_assert
+	panic_on_assert = PE_i_can_has_kernel_configuration() & kPEICanHasAssertions;
+#endif
+
+#if DEBUG
+	PE_parse_boot_argn("hfs_corruption_panics", &hfs_corruption_panics, sizeof(hfs_corruption_panics));
+#endif
+
+	/* The HFSEncodings kext's start(): its converters must exist before any mount. */
+	hfs_converterinit();
+
+	struct vnodeopv_desc *op_descs[] = {
+		&hfs_vnodeop_opv_desc,
+		&hfs_specop_opv_desc,
+#if FIFO
+		&hfs_fifoop_opv_desc,
+#endif
+	};
+
+#ifndef VFS_TBLVNOP_SECLUDE_RENAME
+#define VFS_TBLVNOP_SECLUDE_RENAME 0
+#endif
+
+	struct vfs_fsentry vfe = {
+		.vfe_vfsops = &hfs_vfsops,
+		.vfe_vopcnt = sizeof(op_descs) / sizeof(op_descs[0]),
+		.vfe_opvdescs = op_descs,
+		.vfe_fsname = "hfs",
+		.vfe_flags = (VFS_TBLNOTYPENUM | VFS_TBLLOCALVOL | VFS_TBLREADDIR_EXTENDED
+		    | VFS_TBL64BITREADY | VFS_TBLVNOP_PAGEOUTV2 | VFS_TBLVNOP_PAGEINV2
+		    | VFS_TBLTHREADSAFE | VFS_TBLCANMOUNTROOT | VFS_TBLVNOP_SECLUDE_RENAME
+		    | VFS_TBLNATIVEXATTR)
+	};
+
+	int ret = vfs_fsadd(&vfe, &husky_hfs_vfs_handle);
+	if (ret) {
+		panic("HUSKY HFS: vfs_fsadd failed: %d", ret);
+	}
+
+	hfs_init_zones();
+	hfs_sysctl_register();
+
+	uint32_t num_cpus;
+	size_t sz = sizeof(num_cpus);
+
+	if (sysctlbyname("hw.physicalcpu", &num_cpus, &sz, NULL, 0) == 0) {
+		if ((2 * num_cpus) > MAX_CACHED_ORIGINS_DEFAULT) {
+			_hfs_max_origins = 2 * num_cpus;
+			_hfs_max_file_origins = 2 * num_cpus;
+		} else if ((2 * num_cpus) > MAX_CACHED_FILE_ORIGINS_DEFAULT) {
+			_hfs_max_file_origins = 2 * num_cpus;
+		}
+	}
+
+	printf("HUSKY HFS: hfs-715.120.4 registered\n");
+	kprintf("HUSKY HFS: hfs-715.120.4 registered\n");
+}
+
+/* Built in, not a loadable kext: there is no kext to retain per mount. */
+OSKextLoadTag
+husky_hfs_current_load_tag(void)
+{
+	return kOSKextInvalidLoadTag;
+}
+
+int
+hfs_is_ejectable(__unused const char *cdev_name)
+{
+	return 0;
+}
+
+void
+hfs_iterate_media_with_content(__unused const char *content_uuid_cstring,
+    __unused int (*func)(const char *bsd_name, const char *uuid_str, void *arg),
+    __unused void *arg)
+{
+}
+
+kern_return_t
+hfs_get_platform_serial_number(char *serial_number_str, uint32_t len)
+{
+	if (len < 1) {
+		return 0;
+	}
+	serial_number_str[0] = '\0';
+	return KERN_NOT_SUPPORTED;
+}
diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
index 0823297..c138ca4 100644
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -705,6 +705,12 @@ bsd_init(void)
 	bsd_init_kprintf("calling vfsinit\n");
 	vfsinit();
 
+#if HUSKY_HFS
+	/* HFS is built in on HUSKY: register it like its kext would, before mounting root. */
+	extern void husky_hfs_register(void);
+	husky_hfs_register();
+#endif
+
 #if CONFIG_PROC_UUID_POLICY
 	/* Initial proc_uuid_policy subsystem */
 	bsd_init_kprintf("calling proc_uuid_policy_init()\n");
@@ -951,9 +957,20 @@ bsd_init(void)
 		if (require_rootauth) {
 			/* enforce sealedness */
 			int autherr = VNOP_IOCTL(rootvnode, FSIOC_KERNEL_ROOTAUTH, NULL, 0, vfs_context_kernel());
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+			/*
+			 * HUSKY has no chain of trust to extend: the kernel itself is
+			 * booted unsigned with no Image4, and its HFS root cannot be a
+			 * sealed volume. Report it instead of panicking.
+			 */
+			if (autherr) {
+				printf("HUSKY: root volume is not authenticated (error %d); continuing unsealed\n", autherr);
+			}
+#else
 			if (autherr) {
 				panic("rootvp not authenticated after mounting");
 			}
+#endif
 		}
 	}
 

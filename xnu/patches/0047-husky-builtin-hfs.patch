diff --git a/bsd/conf/Makefile.template b/bsd/conf/Makefile.template
index fab9506..dbe3e23 100644
--- a/bsd/conf/Makefile.template
+++ b/bsd/conf/Makefile.template
@@ -51,6 +51,15 @@ HUSKY_PTHREAD_INC = -I$(HUSKY_PTHREAD_ROOT) -I$(HUSKY_PTHREAD_ROOT)/private -I$(
 husky_pthread_init.o_INCFLAGS = $(HUSKY_PTHREAD_INC)
 husky_pthread_support.o_INCFLAGS = $(HUSKY_PTHREAD_INC)
 husky_pthread_synch.o_INCFLAGS = $(HUSKY_PTHREAD_INC)
+
+# Apple OSS HFS built in (bsd/husky_hfs): compiled like the kext, see husky_hfs_compat.h.
+# The compat header must come after the kernel's -D options, hence _CFLAGS_ADD.
+HUSKY_HFS_ROOT = $(SRCROOT)/bsd/husky_hfs
+HUSKY_HFS_OBJS = BTree.o BTreeAllocate.o BTreeMiscOps.o BTreeNodeOps.o BTreeNodeReserve.o BTreeScanner.o BTreeTreeOps.o BTreeWrapper.o CatalogUtilities.o FileExtentMapping.o FileIDsServices.o MacOSStubs.o UnicodeWrappers.o VolumeAllocation.o hfs_attrlist.o hfs_btreeio.o hfs_catalog.o hfs_chash.o hfs_cnode.o hfs_cprotect.o hfs_endian.o hfs_extents.o hfs_fsinfo.o hfs_hotfiles.o hfs_journal.o hfs_link.o hfs_lookup.o hfs_notification.o hfs_quota.o hfs_readwrite.o hfs_resize.o hfs_search.o hfs_vfsops.o hfs_vfsutils.o hfs_vnops.o hfs_xattr.o rangelist.o hfs_encodinghint.o hfs_encodings.o husky_hfs_iokit.o
+$(foreach o,$(HUSKY_HFS_OBJS),$(eval $(o)_CFLAGS_ADD += -include $(HUSKY_HFS_ROOT)/husky_hfs_compat.h -I$(HUSKY_HFS_ROOT) -I$(HUSKY_HFS_ROOT)/core))
+# HFSEncodings is a separate kext on Apple with its own allocation counter.
+hfs_encodings.o_CFLAGS_ADD += -Dhfs_allocated=hfs_encodings_allocated
+hfs_encodinghint.o_CFLAGS_ADD += -Dhfs_allocated=hfs_encodings_allocated
 endif
 
 #

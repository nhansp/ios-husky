+static bool
+husky_iolog(char *name, size_t len)
+{
+	if (!husky_iolog_parsed) {
+		if (!PE_parse_boot_argn("huskyiolog", husky_iolog_names, sizeof(husky_iolog_names))) {
+			strlcpy(husky_iolog_names, "backboardd,SpringBoard", sizeof(husky_iolog_names));

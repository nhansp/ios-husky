+		husky_iolog_parsed = 1;
+	}
+	if (husky_iolog_lines >= 400) {
+		return false;
+	}
+	proc_selfname(name, (int)len);
+	size_t n = strlen(name);
+	for (const char *t = husky_iolog_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			husky_iolog_lines++;
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;

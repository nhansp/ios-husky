@@ -389,8 +390,46 @@ static struct mac_policy_conf husky_amfi_syscall_conf = {
 
 static mac_policy_handle_t husky_amfi_syscall_handle;
 
+/*
+ * Privileges for non-root processes come from MAC policies (priv_check_cred
+ * -> mac_priv_grant); on iOS Sandbox/AMFI grant them. Without a grant UIKit
+ * apps die in CoreAnimation setup: work_interval_create(CA_CLIENT) needs
+ * PRIV_WORK_INTERVAL ("Failed to create work interval", SpringBoard).
+ * Grant that one; log the first denial of each other privilege per process.
+ */
+#define HUSKY_PRIV_LOG_MAX      64
+static struct {
+	int  priv;
+	char name[20];
+} husky_priv_logged[HUSKY_PRIV_LOG_MAX];
+static int husky_priv_logged_count;
+
+static int
+husky_sandbox_priv_grant(kauth_cred_t cred __unused, int priv)
+{
+	if (priv == PRIV_WORK_INTERVAL) {
+		return 0;
+	}
+	char name[20];
+	proc_selfname(name, sizeof(name));
+	for (int i = 0; i < husky_priv_logged_count; i++) {
+		if (husky_priv_logged[i].priv == priv &&
+		    strncmp(husky_priv_logged[i].name, name, sizeof(name)) == 0) {
+			return EPERM;
+		}
+	}
+	if (husky_priv_logged_count < HUSKY_PRIV_LOG_MAX) {
+		husky_priv_logged[husky_priv_logged_count].priv = priv;
+		strlcpy(husky_priv_logged[husky_priv_logged_count].name, name, sizeof(name));
+		husky_priv_logged_count++;
+		printf("HUSKY Sandbox: %s privilege %d denied\n", name, priv);
+	}
+	return EPERM;
+}
+
 static const struct mac_policy_ops husky_sandbox_mac_ops = {
 	.mpo_policy_syscall = husky_sandbox_syscall,
+	.mpo_priv_grant = husky_sandbox_priv_grant,
 };
 
 static struct mac_policy_conf husky_sandbox_mac_conf = {

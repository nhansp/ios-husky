+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+/*
+ * HUSKY: daemons started by launchd write stdout/stderr to /dev/null, and
+ * pointing a launchd job at /dev/console stops it from launching at all
+ * (backboardd, v8 image). Instead, what the processes named in boot-arg
+ * huskynull (comma separated, default "backboardd,SpringBoard") write to
+ * /dev/null goes to the console (and so to the persistent log) as
+ * "|name| text". huskynull=- turns it off.
+ */
+static char husky_null_names[128];
+static int husky_null_parsed;
+
+static bool
+husky_null_tee(char *name, size_t len)
+{
+	if (!husky_null_parsed) {
+		if (!PE_parse_boot_argn("huskynull", husky_null_names, sizeof(husky_null_names))) {
+			strlcpy(husky_null_names, "backboardd,SpringBoard", sizeof(husky_null_names));
+		}
+		husky_null_parsed = 1;
+	}
+	proc_selfname(name, (int)len);
+	size_t n = strlen(name);
+	for (const char *t = husky_null_names; *t;) {
+		const char *end = strchr(t, ',');
+		size_t tl = end ? (size_t)(end - t) : strlen(t);
+		if (tl == n && n > 0 && strncmp(t, name, n) == 0) {
+			return true;
+		}
+		if (!end) {
+			break;
+		}
+		t = end + 1;
+	}
+	return false;
+}
+#endif
+
 int
 mmrw(dev_t dev, struct uio *uio, enum uio_rw rw)
 {
@@ -216,6 +254,22 @@ mmrw(dev_t dev, struct uio *uio, enum uio_rw rw)
 			if (rw == UIO_READ) {
 				return 0;
 			}
+#if defined(ARM64_BOARD_CONFIG_HUSKY)
+			{
+				char name[32];
+				if (husky_null_tee(name, sizeof(name))) {
+					char buf[256];
+					c = MIN(uio_curriovlen(uio), sizeof(buf));
+					error = uiomove(buf, (int)c, uio);
+					if (error) {
+						break;
+					}
+					printf("|%s| %.*s%s", name, (int)c, buf,
+					    (c > 0 && buf[c - 1] == '\n') ? "" : "\n");
+					continue;
+				}
+			}
+#endif
 			c = uio_curriovlen(uio);
 
 			error = 0; /* Always succeeds, always consumes all input */

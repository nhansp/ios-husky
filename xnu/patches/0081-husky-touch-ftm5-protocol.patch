+/* Read len bytes of hardware register space at addr (after the dummy byte). */
+static int
+fts_hw_read(uint32_t addr, uint8_t *out, size_t len)
+{
+	uint8_t cmd[5] = {FTM5_CMD_HW_REG_R, (uint8_t)(addr >> 24), (uint8_t)(addr >> 16),
+		          (uint8_t)(addr >> 8), (uint8_t)addr};
+	return husky_spi_write_read_dummy(cmd, sizeof(cmd), out, len, 1);
+}
+
+/* Read one FIFO event; a NO_EVENT packet means the FIFO is empty. */
+static int
+fts_fifo_read(uint8_t ev[FTS_EVENT_SIZE])
+{
+	uint8_t cmd = FTM5_CMD_FIFO_READ;
+	bzero(ev, FTS_EVENT_SIZE);
+	return husky_spi_write_read_dummy(&cmd, 1, ev, FTS_EVENT_SIZE, 1);
+}
+
+/*
+ * Common bring-up: USI/SPI, reset line, reset pulse, wait for
+ * CONTROLLER_READY, chip ID. Returns 0 when the chip ID matches.
+ */
+static int
+fts_bringup(void)
+{
+	uint8_t ev[FTS_EVENT_SIZE];
+	uint8_t id[3];
+	bool ready = false;
+	int err;
+
+	err = husky_spi_init();
+	if (err) {
+		HU_LOG("HUSKY TOUCH: SPI init failed (%d)\n", err);
+		return err;
+	}
+	err = husky_gpio_init();
+	if (err) {
+		HU_LOG("HUSKY TOUCH: GPIO init failed (%d)\n", err);
+		return err;
+	}
+
+	HU_LOG("HUSKY TOUCH: reset pulse (gpp21-2 low 10 ms, high)\n");
+	husky_gpio_reset_set(0);
+	fts_sleep_ms(10);
+	husky_gpio_reset_set(1);
+
+	/* The IC queues CONTROLLER_READY once its firmware is up. */
+	for (unsigned t = 0; t < 50 && !ready; t++) {
+		fts_sleep_ms(10);
+		err = fts_fifo_read(ev);
+		if (err) {
+			HU_LOG("HUSKY TOUCH: FIFO read err %d\n", err);
+			break;
+		}
+		if (ev[0] != FTM5_EVT_NO_EVENT) {
+			HU_LOG("HUSKY TOUCH: event %02x %02x %02x %02x %02x %02x %02x %02x\n",
+			    ev[0], ev[1], ev[2], ev[3], ev[4], ev[5], ev[6], ev[7]);
+		}
+		ready = ev[0] == FTM5_EVT_CONTROLLER_READY;
+	}
+	HU_LOG("HUSKY TOUCH: controller ready: %s (irq line %d)\n", ready ? "yes" : "no",
+	    husky_gpio_irq_get());
+
+	bzero(id, sizeof(id));
+	err = fts_hw_read(FTM5_ADDR_DCHIP_ID, id, sizeof(id));
+	HU_LOG("HUSKY TOUCH: chip ID %02x %02x %02x (err %d, expected %02x %02x)\n",
+	    id[0], id[1], id[2], err, FTS_CHIP_ID_0, FTS_CHIP_ID_1);
+	if (err) {
+		return err;
+	}
+	return (id[0] == FTS_CHIP_ID_0 && id[1] == FTS_CHIP_ID_1) ? 0 : ENODEV;
+}

diff --git a/osfmk/arm64/amcc_rorgn_common.c b/osfmk/arm64/amcc_rorgn_common.c
new file mode 100644
index 0000000..fb3f565
--- /dev/null
+++ b/osfmk/arm64/amcc_rorgn_common.c
@@ -0,0 +1,7 @@
+/*
+ * husky: amcc_rorgn_common.c ships only in Apple's closed per-SoC KernelSupport library. It
+ * implements AMCC/CTRR read-only-region lockdown, which husky does not use
+ * (SOC_IS_VIRTUALIZED leaves KERNEL_INTEGRITY_{KTRR,CTRR,PV_CTRR} undefined, so
+ * nothing references these symbols). Empty translation unit.
+ */
+static const unsigned char husky_no_amcc_rorgn_common __attribute__((unused)) = 0;

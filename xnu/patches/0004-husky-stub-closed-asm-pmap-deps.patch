+/*
+ * husky: Apple's per-SoC CPU tunables (implementation-defined HID/ACC register
+ * settings applied in start.s) are not in the open-source drop and none exist
+ * on the Cortex-A510/A715/X3. APPLY_TUNABLES does nothing.
+ */
+.macro APPLY_TUNABLES midr, tmp1, tmp2
+.endmacro

+static bool
+husky_surface_allow_compressed(void)
+{
+	static int allow = -1;
+	if (allow < 0) {
+		uint32_t v = 0;
+		allow = (PE_parse_boot_argn("huskysurfcompressed", &v, sizeof(v)) && v) ? 1 : 0;
+	}
+	return allow == 1;
+}
